// this should not be required: [type.Type1 => ...] and [this.type.Type1 => ...] mean the same.

Clafer1
    xor type
        Type1
        Type2

Clafer2
    clafer1 -> Clafer1
    xor type
        Type1
        Type2

    [type.Type1 => clafer1.type.Type2]
    [this.type.Type1 => clafer1.type.Type2]
