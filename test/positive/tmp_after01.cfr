// Test for after scope
a ?
 xor b 1
  c ?
  d ?
  [never d after c ]

// The constraint is one of its instance of b, whose obligations last while a exists: a may
// replace its b with another instance, and a may disappear and reappear, and then the
// constraint starts again, so these assertions do not hold
// assert [never a.b.c after a.b.d ]
// assert [never a.b.d after a.b.c ]
// While an instance of b exists, its d does not follow its c
assert [all b1 : a.b | never (b1.c && X b1.d) ]
