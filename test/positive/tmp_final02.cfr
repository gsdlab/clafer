// Test for final (immutable) constraint

a
 b ?
  c ?
  d ?
  final e ?

/* final is lowered to two constraints of the core, in the context of e:
   [all e_1 : this | X (e_1 in this.parent.e)]
     an instance of e is not lost while its parent b exists, and
   [all e_1 : this | (previous ((#this.parent) >= 1)) => (previous (e_1 in this.parent.e))]
     an instance of e is not added while its parent b exists. */
