// Equal strings must be represented by equal integers: references initialized with the same string compare equal.

text -> string = "some text"
text1 -> string = "some text"
text2 -> string = "some text"

equal1 ?

[ text = text1 => equal1 ]

equal2 ?

[ text1 = text2 => equal2]

assert [ equal1 ]
assert [ equal2 ]
