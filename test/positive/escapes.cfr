abstract Person
    spouse -> Person ?

Alice : Person
  [ spouse = Bob ]

Bob : Person
assert [ Bob.spouse = Alice ]

Carol : Person
  [ no spouse ]

Dave : Person
assert [ no Dave.spouse ]

[alloy|
open util/relation

fact {
symmetric[r_spouse . spouse_ref]
irreflexive[r_spouse . spouse_ref]
}
|]

[choco|
//symmetric[r_spouse . spouse_ref]
//irreflexive[r_spouse . spouse_ref]
|]
