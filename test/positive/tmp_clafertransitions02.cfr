// Test for multi-step transition

a
  xor b ?
    c -->> d
    d
    e

// The transition is a constraint of c, whose obligations last while its parent b exists.
// As in Juodisius et al. 2019, section 6.1, the source c has to exist until the target d
// holds, but only while b exists: b may disappear before d.
assert[all b1 : a.b | b1.c => F (b1.d || no (b1 ** a.b))]
