// Integer references inherited by a nested subclafer, and its own, had the parent-child relation missing in the output.
// (The child of Contractor was named since, which is a keyword since 0.5.9, gsdlab/clafer#127.)

abstract Person
    Age -> integer

Team
    Contractor : Person
        hiredIn -> integer
    Member -> Person 2..*

Alice : Person
Bob : Person
