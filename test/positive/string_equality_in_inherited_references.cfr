// Equal strings must be represented by equal integers: string references inherited from an abstract clafer compared with a constant.

abstract Entity
    type -> string

E1 : Entity
    [ type = "E1T" ]

E2 : Entity
    [ type = "E1T" ]

E3 : Entity
    [ type = "E1T" ]

E1TEntities -> Entity *
    [ type = "E1T" ]

[ # E1TEntities = 3 ]

// assertion
// [ E1TEntities = E1, E2, E3 ]
