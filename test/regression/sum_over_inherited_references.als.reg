open util/integer
pred show {}


abstract sig Component
{ r_energy : one energy }

sig energy
{ energy_ref : one Int }
{ one @r_energy.this }

one sig c1 extends Component
{}
{ ((this.@r_energy).@energy_ref) = 1 }

one sig c2 extends Component
{}
{ ((this.@r_energy).@energy_ref) = 1 }

one sig c3 extends Component
{}
{ ((this.@r_energy).@energy_ref) = 1 }

one sig total
{ total_ref : one Int }

fact { (some total) => ((total.@total_ref) = (sum temp : (Component.@r_energy) | temp.@energy_ref)) }
assert assertAt_17_10 { (total.@total_ref) = 3 }
check assertAt_17_10 for 1 but 3 Component, 3 energy

