scope({$Dimension:2, $DimensionLevel:2, $belongsTo:2, $levels:4});
defaultScope(1);
stringLength(16);

$Dimension = Abstract("Dimension");
$levels = $Dimension.addChild("levels");
$DimensionLevel = Abstract("DimensionLevel");
$belongsTo = $DimensionLevel.addChild("belongsTo").withCard(1, 1);
$dim1 = Clafer("dim1").withCard(1, 1);
$dim2 = Clafer("dim2").withCard(1, 1);
$dimLevel1 = Clafer("dimLevel1").withCard(1, 1);
$dimLevel2 = Clafer("dimLevel2").withCard(1, 1);
$dim1.extending($Dimension);
$dim2.extending($Dimension);
$dimLevel1.extending($DimensionLevel);
$dimLevel2.extending($DimensionLevel);
$levels.refToUnique($DimensionLevel);
$belongsTo.refToUnique($Dimension);
$Dimension.addConstraint(all([decl([$_dl = local("dl")], join($this(), $levels))], equal(joinRef(join(joinRef($_dl), $belongsTo)), $this())));
Constraint(some([disjDecl([$_dl1 = local("dl1"), $_dl2 = local("dl2")], global($DimensionLevel))], equal(joinRef(join($_dl1, $belongsTo)), joinRef(join($_dl2, $belongsTo)))));
