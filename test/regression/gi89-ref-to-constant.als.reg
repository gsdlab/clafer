open util/integer
pred show {}


abstract sig ASIL
{ ASIL_ref : one Int }

one sig A extends ASIL
{ A_ref : one Int }
{ A_ref in ASIL_ref }

fact { (some A) => ((A.@A_ref) = 1) }
one sig B extends ASIL
{ B_ref : one Int }
{ B_ref in ASIL_ref }

fact { (some B) => ((B.@B_ref) = 2) }
one sig C extends ASIL
{ C_ref : one Int }
{ C_ref in ASIL_ref }

fact { (some C) => ((C.@C_ref) = 3) }
one sig D extends ASIL
{ D_ref : one Int }
{ D_ref in ASIL_ref }

fact { (some D) => ((D.@D_ref) = 4) }
assert assertAt_7_10 { (A.@A_ref) = 1 }
check assertAt_7_10 for 1 but 4 ASIL

assert assertAt_8_10 { (B.@B_ref) = 2 }
check assertAt_8_10 for 1 but 4 ASIL

assert assertAt_9_10 { (C.@C_ref) = 3 }
check assertAt_9_10 for 1 but 4 ASIL

assert assertAt_10_10 { (D.@D_ref) = 4 }
check assertAt_10_10 for 1 but 4 ASIL

