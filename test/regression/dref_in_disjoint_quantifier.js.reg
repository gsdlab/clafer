scope({$Car:4, $Person:4, $owner:4});
defaultScope(1);
stringLength(16);

$Car = Clafer("Car").withCard(4, 4);
$owner = $Car.addChild("owner").withCard(1, 1);
$Person = Clafer("Person").withCard(4, 4);
$owner.refToUnique($Person);
Constraint(all([disjDecl([$_c1 = local("c1"), $_c2 = local("c2")], global($Car))], notEqual(joinRef(join($_c1, $owner)), joinRef(join($_c2, $owner)))));
