//# OPTIONS --explicit
[all e : Exam | (e.examinee.dref = ada) => (e in examineeAda.dref)]
[all e : Exam | (e.recorder.dref = ada) => (e in recorderAda.dref)]
[all e : Exam | (e.examiner.dref = ada) => (e in examinerAda.dref)]
[all e : Exam | (e.examiner.dref = ada) => (e.examinee.dref in examineeOfAdaAsExaminer.dref)]
[all e : Exam | (e.recorder.dref = ada) => (e.examinee.dref in examineeOfAdaAsRecorder.dref)]
[all e : Exam | (e.examinee.dref = ada) => (e.examiner.dref in examinerOfAdaAsExaminee.dref)]
[all e : Exam | (e.recorder.dref = ada) => (e.examiner.dref in examinerOfAdaAsRecorder.dref)]
[all e : Exam | (e.examinee.dref = ada) => (e.recorder.dref in recorderOfAdaAsExaminee.dref)]
[all e : Exam | (e.examiner.dref = ada) => (e.recorder.dref in recorderOfAdaAsExaminer.dref)]
abstract 0..* Person 0..* {}
0..* ada : Person 1..1 {}
0..* cyd : Person 1..1 {}
0..* eve : Person 1..1 {}
0..* bob : Person 1..1 {}
0..* dan : Person 1..1 {}
abstract 0..* Exam 0..* {
  0..* date -> string 1..1 {
    [this.dref != ""]
  }
  0..* recorder -> Person 1..1 {}
  0..* examiner -> Person 1..1 {}
  0..* examinee -> Person 1..1 {}
}
0..* ada_bob_cyd : Exam 1..1 {
  [(((this.date.dref = "20001023") && (this.recorder.dref = cyd)) && (this.examiner.dref = bob)) && (this.examinee.dref = ada)]
}
0..* dan_bob_ada : Exam 1..1 {
  [(((this.date.dref = "20040817") && (this.recorder.dref = ada)) && (this.examiner.dref = bob)) && (this.examinee.dref = dan)]
}
0..* eve_ada_dan : Exam 1..1 {
  [(((this.date.dref = "20080331") && (this.recorder.dref = dan)) && (this.examiner.dref = ada)) && (this.examinee.dref = eve)]
}
0..* examineeAda -> Exam 0..* {
  [this.dref.examinee.dref = ada]
}
0..* recorderAda -> Exam 0..* {
  [this.dref.recorder.dref = ada]
}
0..* examinerAda -> Exam 0..* {
  [this.dref.examiner.dref = ada]
}
0..* examineeOfAdaAsExaminer -> Person 0..* {
  [one e : Exam | (e.examiner.dref = ada) && (e.examinee.dref = this.dref)]
}
0..* examineeOfAdaAsRecorder -> Person 0..* {
  [one e : Exam | (e.recorder.dref = ada) && (e.examinee.dref = this.dref)]
}
0..* examinerOfAdaAsExaminee -> Person 0..* {
  [one e : Exam | (e.examinee.dref = ada) && (e.examiner.dref = this.dref)]
}
0..* examinerOfAdaAsRecorder -> Person 0..* {
  [one e : Exam | (e.recorder.dref = ada) && (e.examiner.dref = this.dref)]
}
0..* recorderOfAdaAsExaminee -> Person 0..* {
  [one e : Exam | (e.examinee.dref = ada) && (e.recorder.dref = this.dref)]
}
0..* recorderOfAdaAsExaminer -> Person 0..* {
  [one e : Exam | (e.examiner.dref = ada) && (e.recorder.dref = this.dref)]
}
