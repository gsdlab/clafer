//# OPTIONS --explicit --core
abstract 0..* Thing 0..* {}
0..* a : Thing 0..2 {}
0..* b : Thing 0..1 {}
0..* c 0..1 {
  0..* d 0..1 {}
}

assert [(((Thing ++ c) ++ c.d) -- noclafer) = ((Thing ++ c) ++ c.d)]
assert [(((Thing ++ c) ++ c.d) ++ noclafer) = ((Thing ++ c) ++ c.d)]
assert [(((Thing ++ c) ++ c.d) ** noclafer) = noclafer]
assert [a in ((Thing ++ c) ++ c.d)]
assert [c.d in ((Thing ++ c) ++ c.d)]
assert [(#((Thing ++ c) ++ c.d)) = (((#Thing) + (#c)) + (#c.d))]
assert [no noclafer]
assert [(#noclafer) = 0]
assert [(a ++ noclafer) = a]
assert [(noclafer ++ a) = a]
assert [(#(a ++ noclafer)) = (#a)]
assert [(a ** noclafer) = noclafer]
assert [(noclafer ** a) = noclafer]
assert [no (Thing ** noclafer)]
assert [(a -- noclafer) = a]
assert [(noclafer -- a) = noclafer]
assert [noclafer in a]
assert [noclafer in Thing]
assert [(no a) || (!(a in noclafer))]
assert [(some c) => ((if (some c) then a else noclafer) = a)]
assert [(no c) => (no (if (some c) then a else noclafer))]
assert [(no c) => ((if (no c) then noclafer else b) = noclafer)]
assert [(#(if (some c) then a else noclafer)) <= (#a)]
assert [noclafer = noclafer]
assert [!(noclafer != noclafer)]
assert [no noclafer]
assert [no noclafer]
assert [noclafer = noclafer]
assert [(#noclafer) = 0]
