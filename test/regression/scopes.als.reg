open util/integer
pred show {}


fact { #a = 0 }
sig a
{}

lone sig b
{}

one sig c
{}

sig d
{}

some sig e
{}

fact { 2 <= #f and #f <= 4 }
sig f
{}

fact { 3 <= #g }
sig g
{}

fact { 2 <= #gs and #gs <= 2 }
sig gs
{ gs_ref : one g }

fact {  all disj x, y : gs | (x.@gs_ref) != (y.@gs_ref)  }
abstract sig H
{ r_i : lone i
, r_j : set j
, r_k : set k }
{ 2 <= #r_k and #r_k <= 2 }

sig i
{}
{ one @r_i.this }

sig j
{}
{ one @r_j.this }

sig k
{}
{ one @r_k.this }

fact { 3 <= #Hs }
sig Hs
{ Hs_ref : one H }

fact {  all disj x, y : Hs | (x.@Hs_ref) != (y.@Hs_ref)  }
fact { 2 <= #H1 and #H1 <= 2 }
sig H1 extends H
{ r_H12 : set H12 }
{ 2 <= #r_H12 and #r_H12 <= 2 }

sig H12 extends H
{}
{ one @r_H12.this }

fact { 4 <= #H2 and #H2 <= 4 }
sig H2 extends H
{}

fact { 1 <= #H3 and #H3 <= 2 }
sig H3 extends H
{}

fact { 5 <= #H4 }
sig H4 extends H
{}

sig Hs2
{ Hs2_ref : one H }

fact {  all disj x, y : Hs2 | (x.@Hs2_ref) != (y.@Hs2_ref)  }
fact { 5 <= #Hs3 and #Hs3 <= 8 }
sig Hs3
{ Hs3_ref : one H
, r_l : lone l }

sig l
{}
{ one @r_l.this }

fact {  all disj x, y : Hs3 | (x.@Hs3_ref) != (y.@Hs3_ref)  }
abstract sig FF extends H
{}

fact { 2 <= #f1 and #f1 <= 5 }
sig f1 extends FF
{ r_m : set m }
{ #r_m = 0 }

sig m
{}
{ one @r_m.this }

