open util/integer
pred show {}


abstract sig Service
{ r_requirements : one requirements
, r_machine : one machine }
{ this in ((((this.@r_machine).@machine_ref).@r_services).@services_ref) }

sig requirements extends Requirements
{}
{ one @r_requirements.this }

sig machine
{ machine_ref : one Machine }
{ one @r_machine.this }

abstract sig Requirements
{ r_cpu : one cpu }

sig cpu
{ cpu_ref : one Int }
{ one @r_cpu.this }

abstract sig Resources extends Requirements
{}

abstract sig Machine
{ r_services : set services
, r_isFree : lone isFree
, r_limits : one limits
, r_utilization : one utilization }
{ all disj x, y : this.@r_services | (x.@services_ref) != (y.@services_ref) 
  all  s : this.@r_services | (((s.@services_ref).@r_machine).@machine_ref) = this
  (some this.@r_isFree) <=> (no this.@r_services) }

sig services
{ services_ref : one Service }
{ one @r_services.this }

sig isFree
{}
{ one @r_isFree.this }

sig limits extends Resources
{}
{ one @r_limits.this }

sig utilization extends Resources
{}
{ one @r_utilization.this
  ((this.@r_cpu).@cpu_ref) = (sum temp : (((((this.~@r_utilization).@r_services).@services_ref).@r_requirements).@r_cpu) | temp.@cpu_ref)
  ((this.@r_cpu).@cpu_ref) < ((((this.~@r_utilization).@r_limits).@r_cpu).@cpu_ref) }

abstract sig Task
{ r_total_free : one total_free }
{ (some this.@r_total_free) => (((this.@r_total_free).@total_free_ref) = (#(Machine.@r_isFree))) }

sig total_free
{ total_free_ref : one Int }
{ one @r_total_free.this }

one sig MyTask extends Task
{ r_GoogleCA : one GoogleCA
, r_GoogleNY : one GoogleNY
, r_GoogleTX : one GoogleTX
, r_MailService : one MailService
, r_SearchService : one SearchService
, r_CalendarService : one CalendarService
, r_DriveService : one DriveService }

one sig GoogleCA extends Machine
{}
{ (((this.@r_limits).@r_cpu).@cpu_ref) = 10 }

one sig GoogleNY extends Machine
{}
{ (((this.@r_limits).@r_cpu).@cpu_ref) = 16 }

one sig GoogleTX extends Machine
{}
{ (((this.@r_limits).@r_cpu).@cpu_ref) = 14 }

one sig MailService extends Service
{}
{ (((this.@r_requirements).@r_cpu).@cpu_ref) = 4 }

one sig SearchService extends Service
{}
{ (((this.@r_requirements).@r_cpu).@cpu_ref) = 3 }

one sig CalendarService extends Service
{}
{ (((this.@r_requirements).@r_cpu).@cpu_ref) = 1 }

one sig DriveService extends Service
{}
{ (((this.@r_requirements).@r_cpu).@cpu_ref) = 2 }

