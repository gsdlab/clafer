<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/references_to_same_object.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Dimension">Dimension</span>
  <div class="indent">
  <span class="claferDecl" id="levels">levels</span><span class="keyword"> -> </span><a href="#DimensionLevel"><span class="reference">DimensionLevel</span></a> *</div>
  <div class="indent">
  <span class="keyword">[</span> all dl<span class="keyword"> : </span><span class="keyword">this</span>.<a href="#levels"><span class="reference">levels</span></a> | <a href="#dl"><span class="reference">dl</span></a>.<a href="#belongsTo"><span class="reference">belongsTo</span></a> = <span class="keyword">this</span> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="DimensionLevel">DimensionLevel</span>
  <div class="indent">
  <span class="claferDecl" id="belongsTo">belongsTo</span><span class="keyword"> -> </span><a href="#Dimension"><span class="reference">Dimension</span></a></div>
</div>


<div>
<span class="claferDecl" id="dim1">dim1</span><span class="keyword"> : </span><a href="#Dimension"><span class="reference">Dimension</span></a></div>


<div>
<span class="claferDecl" id="dim2">dim2</span><span class="keyword"> : </span><a href="#Dimension"><span class="reference">Dimension</span></a></div>


<div>
<span class="claferDecl" id="dimLevel1">dimLevel1</span><span class="keyword"> : </span><a href="#DimensionLevel"><span class="reference">DimensionLevel</span></a></div>


<div>
<span class="claferDecl" id="dimLevel2">dimLevel2</span><span class="keyword"> : </span><a href="#DimensionLevel"><span class="reference">DimensionLevel</span></a></div>


<div>
<span class="keyword">[</span> <span class="keyword">some</span> disjdl1; dl2<span class="keyword"> : </span><a href="#DimensionLevel"><span class="reference">DimensionLevel</span></a> | <a href="#dl1"><span class="reference">dl1</span></a>.<a href="#belongsTo"><span class="reference">belongsTo</span></a>.<span class="keyword">dref</span> = <a href="#dl2"><span class="reference">dl2</span></a>.<a href="#belongsTo"><span class="reference">belongsTo</span></a>.<span class="keyword">dref</span> <span class="keyword">]</span></div>

</body>
</html>