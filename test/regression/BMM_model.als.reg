open util/integer
pred show {}


fact { #Element = 0 }
abstract sig Element
{}

fact { #End = 0 }
abstract sig End extends Element
{ r_attainable : lone attainable
, r_End__term : one End__term
, r_focusedOn : one focusedOn }

sig attainable
{}
{ one @r_attainable.this }

sig End__term
{ r_End__term__short : lone End__term__short
, r_End__term__long : lone End__term__long }
{ one @r_End__term.this
  let children = (r_End__term__short + r_End__term__long) | one children }

sig End__term__short
{}
{ one @r_End__term__short.this }

sig End__term__long
{}
{ one @r_End__term__long.this }

sig focusedOn
{ r_enterprise : lone enterprise
, r_businessArea : lone businessArea }
{ one @r_focusedOn.this
  let children = (r_enterprise + r_businessArea) | one children }

sig enterprise
{}
{ one @r_enterprise.this }

sig businessArea
{}
{ one @r_businessArea.this }

fact { #Mean = 0 }
abstract sig Mean extends Element
{}

fact { #Vision = 0 }
abstract sig Vision extends End
{ r_amplifiedBy : some amplifiedBy
, r_madeOperativeBy : one madeOperativeBy }
{ some (this.@r_focusedOn).@r_enterprise
  some (this.@r_End__term).@r_End__term__long
  all disj x, y : this.@r_amplifiedBy | (x.@amplifiedBy_ref) != (y.@amplifiedBy_ref)  }

sig amplifiedBy
{ amplifiedBy_ref : one Goal }
{ one @r_amplifiedBy.this }

sig madeOperativeBy
{ madeOperativeBy_ref : one Mission }
{ one @r_madeOperativeBy.this }

fact { #DesiredResult = 0 }
abstract sig DesiredResult extends End
{ r_supportedBy : some supportedBy
, r_kind : one kind }
{ all disj x, y : this.@r_supportedBy | (x.@supportedBy_ref) != (y.@supportedBy_ref)  }

sig supportedBy
{ supportedBy_ref : one CourseOfAction }
{ one @r_supportedBy.this }

sig kind
{ r_qualitative : lone qualitative
, r_quantitative : lone quantitative }
{ one @r_kind.this
  let children = (r_qualitative + r_quantitative) | one children }

sig qualitative
{}
{ one @r_qualitative.this }

sig quantitative
{}
{ one @r_quantitative.this }

fact { #Goal = 0 }
abstract sig Goal extends DesiredResult
{ r_amplifies : one amplifies
, r_general : one general
, r_ongoing : one ongoing }
{ some (this.@r_focusedOn).@r_businessArea
  some this.@r_attainable
  some (this.@r_kind).@r_qualitative
  some (this.@r_End__term).@r_End__term__long }

sig amplifies
{ amplifies_ref : one Vision }
{ one @r_amplifies.this }

sig general
{}
{ one @r_general.this }

sig ongoing
{}
{ one @r_ongoing.this }

fact { #Objective = 0 }
abstract sig Objective extends DesiredResult
{ r_SMART : one SMART
, r_limitedInTimeframe : one limitedInTimeframe
, r_quantifies : some quantifies }
{ some (this.@r_focusedOn).@r_businessArea
  some (this.@r_kind).@r_quantitative
  some (this.@r_End__term).@r_End__term__short
  all disj x, y : this.@r_quantifies | (x.@quantifies_ref) != (y.@quantifies_ref)  }

sig SMART
{ r_specific : one specific
, r_relevant : one relevant
, r_timeBound : one timeBound }
{ one @r_SMART.this
  some (this.~@r_SMART).@r_attainable }

sig specific
{}
{ one @r_specific.this }

sig relevant
{}
{ one @r_relevant.this }

sig timeBound
{}
{ one @r_timeBound.this }

sig limitedInTimeframe
{ r_cyclical : lone cyclical }
{ one @r_limitedInTimeframe.this }

sig cyclical
{}
{ one @r_cyclical.this }

sig quantifies
{ quantifies_ref : one Goal }
{ one @r_quantifies.this }

fact { #CourseOfAction = 0 }
abstract sig CourseOfAction extends Mean
{ r_channelsEffortsToward : one channelsEffortsToward
, r_governedBy : one governedBy
, r_formulatedBasedOn : one formulatedBasedOn
, r_scope : one scope
, r_CourseOfAction__term : one CourseOfAction__term
, r_CourseOfAction__includes : set CourseOfAction__includes
, r_enables : set enables }
{ ((some (this.@r_scope).@r_broad) && (some (this.@r_CourseOfAction__term).@r_CourseOfAction__term__long)) || ((some (this.@r_scope).@r_narrow) && (some (this.@r_CourseOfAction__term).@r_CourseOfAction__term__short))
  all disj x, y : this.@r_CourseOfAction__includes | (x.@CourseOfAction__includes_ref) != (y.@CourseOfAction__includes_ref) 
  all disj x, y : this.@r_enables | (x.@enables_ref) != (y.@enables_ref)  }

sig channelsEffortsToward
{ channelsEffortsToward_ref : one DesiredResult }
{ one @r_channelsEffortsToward.this }

sig governedBy
{ governedBy_ref : one Directive }
{ one @r_governedBy.this }

sig formulatedBasedOn
{ formulatedBasedOn_ref : one Directive }
{ one @r_formulatedBasedOn.this }

sig scope
{ r_broad : lone broad
, r_narrow : lone narrow }
{ one @r_scope.this
  let children = (r_broad + r_narrow) | one children }

sig broad
{}
{ one @r_broad.this }

sig narrow
{}
{ one @r_narrow.this }

sig CourseOfAction__term
{ r_CourseOfAction__term__short : lone CourseOfAction__term__short
, r_CourseOfAction__term__long : lone CourseOfAction__term__long }
{ one @r_CourseOfAction__term.this
  let children = (r_CourseOfAction__term__short + r_CourseOfAction__term__long) | one children }

sig CourseOfAction__term__short
{}
{ one @r_CourseOfAction__term__short.this }

sig CourseOfAction__term__long
{}
{ one @r_CourseOfAction__term__long.this }

sig CourseOfAction__includes
{ CourseOfAction__includes_ref : one CourseOfAction }
{ one @r_CourseOfAction__includes.this }

sig enables
{ enables_ref : one CourseOfAction }
{ one @r_enables.this }

fact { #Strategy = 0 }
abstract sig Strategy extends CourseOfAction
{ r_implementedBy : one implementedBy
, r_aComponentOfThePlanFor : one aComponentOfThePlanFor
, r_rightApproachGiven : one rightApproachGiven }

sig implementedBy
{ implementedBy_ref : one Tactic }
{ one @r_implementedBy.this }

sig aComponentOfThePlanFor
{ aComponentOfThePlanFor_ref : one Mission }
{ one @r_aComponentOfThePlanFor.this }

sig rightApproachGiven
{}
{ one @r_rightApproachGiven.this }

fact { #Tactic = 0 }
abstract sig Tactic extends CourseOfAction
{ r_implements : one implements
, r_effectsEnforcementLevelOf : one effectsEnforcementLevelOf }

sig implements
{ implements_ref : one Strategy }
{ one @r_implements.this }

sig effectsEnforcementLevelOf
{ effectsEnforcementLevelOf_ref : one BusinessRule }
{ one @r_effectsEnforcementLevelOf.this }

fact { #Mission = 0 }
abstract sig Mission extends Mean
{ r_makesOperative : one makesOperative
, r_plannedByMeansOf : one plannedByMeansOf }

sig makesOperative
{ makesOperative_ref : one Vision }
{ one @r_makesOperative.this }

sig plannedByMeansOf
{ plannedByMeansOf_ref : one Strategy }
{ one @r_plannedByMeansOf.this }

fact { #Directive = 0 }
abstract sig Directive extends Mean
{ r_Directive__governs : one Directive__governs
, r_sourceOf : one sourceOf
, r_supportsTheAchievementOf : one supportsTheAchievementOf
, r_influencesAspectOfEnterprise : one influencesAspectOfEnterprise
, r_declarative : one declarative
, r_actsAs : one actsAs
, r_degreeOfStructure : one degreeOfStructure
, r_granularity : one granularity
, r_actionable : lone actionable
, r_automatable : lone automatable }

sig Directive__governs
{ Directive__governs_ref : one CourseOfAction }
{ one @r_Directive__governs.this }

sig sourceOf
{ sourceOf_ref : one CourseOfAction }
{ one @r_sourceOf.this }

sig supportsTheAchievementOf
{ supportsTheAchievementOf_ref : one DesiredResult }
{ one @r_supportsTheAchievementOf.this }

sig influencesAspectOfEnterprise
{ r_defines : lone defines
, r_constraints : lone constraints
, r_liberates : lone liberates
, r_asserts : lone asserts
, r_controls : lone controls }
{ one @r_influencesAspectOfEnterprise.this
  let children = (r_defines + r_constraints + r_liberates + r_asserts + r_controls) | one children }

sig defines
{}
{ one @r_defines.this }

sig constraints
{}
{ one @r_constraints.this }

sig liberates
{}
{ one @r_liberates.this }

sig asserts
{}
{ one @r_asserts.this }

sig controls
{}
{ one @r_controls.this }

sig declarative
{}
{ one @r_declarative.this }

sig actsAs
{ actsAs_ref : one Regulation }
{ one @r_actsAs.this }

sig degreeOfStructure
{ r_lessStructured : lone lessStructured
, r_highlyStructured : lone highlyStructured }
{ one @r_degreeOfStructure.this
  let children = (r_lessStructured + r_highlyStructured) | one children }

sig lessStructured
{}
{ one @r_lessStructured.this }

sig highlyStructured
{}
{ one @r_highlyStructured.this }

sig granularity
{ r_lessDiscreteAndComposite : lone lessDiscreteAndComposite
, r_discreteAndAtomic : lone discreteAndAtomic }
{ one @r_granularity.this
  let children = (r_lessDiscreteAndComposite + r_discreteAndAtomic) | one children }

sig lessDiscreteAndComposite
{}
{ one @r_lessDiscreteAndComposite.this }

sig discreteAndAtomic
{}
{ one @r_discreteAndAtomic.this }

sig actionable
{}
{ one @r_actionable.this }

sig automatable
{}
{ one @r_automatable.this }

fact { #BusinessPolicy = 0 }
abstract sig BusinessPolicy extends Directive
{ r_providesBasisFor : some providesBasisFor
, r_BusinessPolicy__governs : set BusinessPolicy__governs
, r_BusinessPolicy__includes : set BusinessPolicy__includes }
{ all disj x, y : this.@r_providesBasisFor | (x.@providesBasisFor_ref) != (y.@providesBasisFor_ref) 
  all disj x, y : this.@r_BusinessPolicy__governs | (x.@BusinessPolicy__governs_ref) != (y.@BusinessPolicy__governs_ref) 
  some (this.@r_degreeOfStructure).@r_lessStructured
  some (this.@r_granularity).@r_lessDiscreteAndComposite
  no this.@r_actionable
  no this.@r_automatable
  all disj x, y : this.@r_BusinessPolicy__includes | (x.@BusinessPolicy__includes_ref) != (y.@BusinessPolicy__includes_ref)  }

sig providesBasisFor
{ providesBasisFor_ref : one BusinessRule }
{ one @r_providesBasisFor.this }

sig BusinessPolicy__governs
{ BusinessPolicy__governs_ref : one CourseOfAction
, r_control : one control
, r_guide : one guide
, r_shape : one shape }
{ one @r_BusinessPolicy__governs.this }

sig control
{}
{ one @r_control.this }

sig guide
{}
{ one @r_guide.this }

sig shape
{}
{ one @r_shape.this }

sig BusinessPolicy__includes
{ BusinessPolicy__includes_ref : one BusinessPolicy }
{ one @r_BusinessPolicy__includes.this }

fact { #BusinessRule = 0 }
abstract sig BusinessRule extends Directive
{ r_enforcementLevel : one enforcementLevel
, r_hasEnforcementLevelEffectedBy : one hasEnforcementLevelEffectedBy
, r_expressedUsingStandardBusinessVocabulary : one expressedUsingStandardBusinessVocabulary }
{ all  o : this.@r_supportsTheAchievementOf | (o.@supportsTheAchievementOf_ref) in Objective
  some (this.@r_degreeOfStructure).@r_highlyStructured
  some (this.@r_granularity).@r_discreteAndAtomic
  some this.@r_actionable }

sig enforcementLevel
{ r_strictlyEnforced : lone strictlyEnforced
, r_deferredEnforcement : lone deferredEnforcement
, r_preAuthorizedOverride : lone preAuthorizedOverride
, r_postJustifiedOverride : lone postJustifiedOverride
, r_overrideWithExplanation : lone overrideWithExplanation
, r_guideline : lone guideline }
{ one @r_enforcementLevel.this
  let children = (r_strictlyEnforced + r_deferredEnforcement + r_preAuthorizedOverride + r_postJustifiedOverride + r_overrideWithExplanation + r_guideline) | one children }

sig strictlyEnforced
{}
{ one @r_strictlyEnforced.this }

sig deferredEnforcement
{}
{ one @r_deferredEnforcement.this }

sig preAuthorizedOverride
{}
{ one @r_preAuthorizedOverride.this }

sig postJustifiedOverride
{}
{ one @r_postJustifiedOverride.this }

sig overrideWithExplanation
{}
{ one @r_overrideWithExplanation.this }

sig guideline
{}
{ one @r_guideline.this }

sig hasEnforcementLevelEffectedBy
{ hasEnforcementLevelEffectedBy_ref : one Tactic }
{ one @r_hasEnforcementLevelEffectedBy.this }

sig expressedUsingStandardBusinessVocabulary
{}
{ one @r_expressedUsingStandardBusinessVocabulary.this }

fact { #Regulation = 0 }
abstract sig Regulation extends Element
{ r_aRolePlayedBy : one aRolePlayedBy }

sig aRolePlayedBy
{ aRolePlayedBy_ref : one Directive }
{ one @r_aRolePlayedBy.this }

fact { #Influencer = 0 }
abstract sig Influencer extends Element
{ r_externalInfluencer : lone externalInfluencer
, r_internalInfluencer : lone internalInfluencer }

sig externalInfluencer
{ r_environment : lone environment
, r_technology : lone technology
, r_regulation : lone regulation
, r_supplier : lone supplier
, r_customer : lone customer
, r_competitor : lone competitor
, r_partner : lone partner }
{ one @r_externalInfluencer.this
  let children = (r_environment + r_technology + r_regulation + r_supplier + r_customer + r_competitor + r_partner) | some children }

sig environment
{}
{ one @r_environment.this }

sig technology
{}
{ one @r_technology.this }

sig regulation
{ r_prescribedBy : one prescribedBy }
{ one @r_regulation.this }

sig prescribedBy
{ r_government : lone government
, r_management : lone management }
{ one @r_prescribedBy.this
  let children = (r_government + r_management) | one children }

sig government
{}
{ one @r_government.this }

sig management
{}
{ one @r_management.this }

sig supplier
{ r_provides : one provides }
{ one @r_supplier.this }

sig provides
{ r_products : lone products
, r_services : lone services }
{ one @r_provides.this
  let children = (r_products + r_services) | one children }

sig products
{}
{ one @r_products.this }

sig services
{}
{ one @r_services.this }

sig customer
{ r_productsOrServices : one productsOrServices }
{ one @r_customer.this }

sig productsOrServices
{ r_investigated : lone investigated
, r_ordered : lone ordered
, r_received : lone received
, r_paidFor : lone paidFor }
{ one @r_productsOrServices.this
  let children = (r_investigated + r_ordered + r_received + r_paidFor) | one children }

sig investigated
{}
{ one @r_investigated.this }

sig ordered
{}
{ one @r_ordered.this }

sig received
{}
{ one @r_received.this }

sig paidFor
{}
{ one @r_paidFor.this }

sig competitor
{}
{ one @r_competitor.this }

sig partner
{}
{ one @r_partner.this }

sig internalInfluencer
{ r_infrastructure : lone infrastructure
, r_issue : lone issue
, r_assumption : lone assumption
, r_resource : lone resource
, r_habit : lone habit
, r_managementPrerogative : lone managementPrerogative
, r_corporateValue : lone corporateValue }
{ one @r_internalInfluencer.this
  let children = (r_infrastructure + r_issue + r_assumption + r_resource + r_habit + r_managementPrerogative + r_corporateValue) | some children }

sig infrastructure
{}
{ one @r_infrastructure.this }

sig issue
{}
{ one @r_issue.this }

sig assumption
{}
{ one @r_assumption.this }

sig resource
{}
{ one @r_resource.this }

sig habit
{}
{ one @r_habit.this }

sig managementPrerogative
{}
{ one @r_managementPrerogative.this }

sig corporateValue
{ r_explicitCorporateValue : lone explicitCorporateValue
, r_implicitCorporateValue : lone implicitCorporateValue }
{ one @r_corporateValue.this
  let children = (r_explicitCorporateValue + r_implicitCorporateValue) | one children }

sig explicitCorporateValue
{}
{ one @r_explicitCorporateValue.this }

sig implicitCorporateValue
{}
{ one @r_implicitCorporateValue.this }

fact { #Assessment = 0 }
abstract sig Assessment extends Element
{ r_identifies : one identifies
, r_about : one about
, r_affects : one affects
, r_madeBy : one madeBy
, r_uses : set uses
, r_SWOT : one SWOT }
{ all disj x, y : this.@r_uses | (x.@uses_ref) != (y.@uses_ref)  }

sig identifies
{ identifies_ref : one PotentialImpact }
{ one @r_identifies.this }

sig about
{ about_ref : one Influencer }
{ one @r_about.this }

sig affects
{ r_employmentOf : some employmentOf
, r_achievementOf : some achievementOf }
{ one @r_affects.this
  let children = (r_employmentOf + r_achievementOf) | some children
  all disj x, y : this.@r_employmentOf | (x.@employmentOf_ref) != (y.@employmentOf_ref) 
  all disj x, y : this.@r_achievementOf | (x.@achievementOf_ref) != (y.@achievementOf_ref)  }

sig employmentOf
{ employmentOf_ref : one Mean }
{ one @r_employmentOf.this }

sig achievementOf
{ achievementOf_ref : one End }
{ one @r_achievementOf.this }

sig madeBy
{ madeBy_ref : one OrganizationUnit }
{ one @r_madeBy.this }

sig uses
{ uses_ref : one Assessment }
{ one @r_uses.this }

sig SWOT
{ r_strength : lone strength
, r_weakness : lone weakness
, r_opportunity : lone opportunity
, r_threat : lone threat }
{ one @r_SWOT.this
  let children = (r_strength + r_weakness + r_opportunity + r_threat) | one children }

sig strength
{}
{ one @r_strength.this }

sig weakness
{}
{ one @r_weakness.this }

sig opportunity
{}
{ one @r_opportunity.this }

sig threat
{}
{ one @r_threat.this }

fact { #PotentialImpact = 0 }
abstract sig PotentialImpact extends Element
{ r_significantTo : one significantTo
, r_providesImpetusFor : one providesImpetusFor
, r_type : one type }

sig significantTo
{ significantTo_ref : one Assessment }
{ one @r_significantTo.this }

sig providesImpetusFor
{ providesImpetusFor_ref : one Directive }
{ one @r_providesImpetusFor.this }

sig type
{ r_risk : lone risk
, r_potentialReward : lone potentialReward }
{ one @r_type.this
  let children = (r_risk + r_potentialReward) | one children }

sig risk
{ r_probabilityOfLoss : one probabilityOfLoss
, r_potentialLoss : one potentialLoss
, r_risk__unitOfMeasure : one risk__unitOfMeasure }
{ one @r_risk.this }

sig probabilityOfLoss
{ probabilityOfLoss_ref : one Int }
{ one @r_probabilityOfLoss.this }

sig potentialLoss
{ potentialLoss_ref : one Int }
{ one @r_potentialLoss.this }

sig risk__unitOfMeasure
{ risk__unitOfMeasure_ref : one Currency }
{ one @r_risk__unitOfMeasure.this }

sig potentialReward
{ r_probabilityOfGain : one probabilityOfGain
, r_potentialGain : one potentialGain
, r_potentialReward__unitOfMeasure : one potentialReward__unitOfMeasure }
{ one @r_potentialReward.this }

sig probabilityOfGain
{ probabilityOfGain_ref : one Int }
{ one @r_probabilityOfGain.this }

sig potentialGain
{ potentialGain_ref : one Int }
{ one @r_potentialGain.this }

sig potentialReward__unitOfMeasure
{ potentialReward__unitOfMeasure_ref : one Currency }
{ one @r_potentialReward__unitOfMeasure.this }

fact { #Metric = 0 }
abstract sig Metric extends Element
{}

fact { #KeyPerformanceIndicator = 0 }
abstract sig KeyPerformanceIndicator extends Metric
{}

fact { #CriticalSuccessFactor = 0 }
abstract sig CriticalSuccessFactor extends Metric
{}

abstract sig Currency
{}

one sig USD extends Currency
{}

one sig EUR extends Currency
{}

one sig CAD extends Currency
{}

fact { #OrganizationUnit = 0 }
abstract sig OrganizationUnit
{}

fact { #BusinessProcess = 0 }
abstract sig BusinessProcess
{}

