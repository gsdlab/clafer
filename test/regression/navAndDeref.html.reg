<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/navAndDeref.cfr</div>

<div>
<span class="claferDecl" id="a">a</span>
  <div class="indent">
  <span class="claferDecl" id="b">b</span><span class="keyword"> -> </span><a href="#e"><span class="reference">e</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#f"><span class="reference">f</span></a> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#f"><span class="reference">f</span></a> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#f"><span class="reference">f</span></a>.<span class="keyword">dref</span> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#f"><span class="reference">f</span></a>.<span class="keyword">dref</span>.<span class="keyword">dref</span> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#b"><span class="reference">b</span></a>.<a href="#f"><span class="reference">f</span></a> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#b"><span class="reference">b</span></a>.<a href="#f"><span class="reference">f</span></a> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#b"><span class="reference">b</span></a>.<a href="#f"><span class="reference">f</span></a>.<span class="keyword">dref</span> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#b"><span class="reference">b</span></a>.<a href="#f"><span class="reference">f</span></a>.<span class="keyword">dref</span>.<span class="keyword">dref</span> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="c">c</span>
    <div class="indent">
    <span class="claferDecl" id="d">d</span>
      <div class="indent">
      <span class="keyword">[</span> <a href="#b"><span class="reference">b</span></a> = <a href="#e"><span class="reference">e</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">parent</span>.<span class="keyword">parent</span>.<a href="#b"><span class="reference">b</span></a> = <a href="#e"><span class="reference">e</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">parent</span>.<span class="keyword">parent</span>.<a href="#b"><span class="reference">b</span></a>.<span class="keyword">dref</span> = <a href="#e"><span class="reference">e</span></a> <span class="keyword">]</span></div>
    </div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#b"><span class="reference">b</span></a>.<a href="#f"><span class="reference">f</span></a> = <a href="#g"><span class="reference">g</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">parent</span>.<a href="#b"><span class="reference">b</span></a>.<a href="#f"><span class="reference">f</span></a> = <a href="#g"><span class="reference">g</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">parent</span>.<a href="#b"><span class="reference">b</span></a>.<a href="#f"><span class="reference">f</span></a>.<span class="keyword">dref</span> = <a href="#g"><span class="reference">g</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">parent</span>.<a href="#b"><span class="reference">b</span></a>.<a href="#f"><span class="reference">f</span></a>.<span class="keyword">dref</span>.<span class="keyword">dref</span> = <a href="#h"><span class="reference">h</span></a> <span class="keyword">]</span></div>
  </div>
</div>


<div>
<span class="claferDecl" id="e">e</span>
  <div class="indent">
  <span class="claferDecl" id="f">f</span><span class="keyword"> -> </span><a href="#g"><span class="reference">g</span></a> ?</div>
</div>


<div>
<span class="claferDecl" id="g">g</span><span class="keyword"> -> </span><a href="#h"><span class="reference">h</span></a></div>


<div>
<span class="claferDecl" id="h">h</span></div>

</body>
</html>