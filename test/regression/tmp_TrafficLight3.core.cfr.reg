//# OPTIONS --explicit --core --tl=10
abstract 0..* event 0..* {}
0..1 events 1..1 {
  0..* e_on_off : event 0..1 {}
  0..* e_police : event 0..1 {}
  0..* e_after_5 : event 0..1 {}
  0..* e_after_7 : event 0..1 {}
  0..* e_after_0_5 : event 0..1 {}
}
abstract 1..1 TrafficLight_3 0..* {
  1..1 on 0..1 {
    1..1 normal 0..1 {
      0..* green 0..1 {
        [(some this) => (X (some this.parent.yellow))] // -->, tmp_TrafficLight3.cfr:24:21
      }
      0..* yellow 0..1 {
        [(some this) => (X (some this.parent.red))] // -->, tmp_TrafficLight3.cfr:25:13
      }
      0..* red 0..1 {
        [(some this) => (X (some this.parent.green))] // -->, tmp_TrafficLight3.cfr:26:13
      }
      [((some this) && (some events.e_police)) => ((some this) U (some this.parent.flashing))] // -[]->>, tmp_TrafficLight3.cfr:23:21
      [(!(previous (some this))) => (some this.green)] // initial, tmp_TrafficLight3.cfr:24:13
    }
    1..1 flashing 0..1 {
      0..* yellow_on 0..1 {
        [((some this) && (some events.e_after_0_5)) => ((some this) U (some this.parent.yellow_off))] // -[]->>, tmp_TrafficLight3.cfr:28:21
      }
      0..* yellow_off 0..1 {
        [((some this) && (some events.e_after_0_5)) => ((some this) U (some this.parent.yellow_on))] // -[]->>, tmp_TrafficLight3.cfr:31:13
      }
      [((some this) && (some events.e_police)) => ((some this) U (some this.parent.normal))] // -[]->>, tmp_TrafficLight3.cfr:27:13
      [(!(previous (some this))) => (some this.yellow_on)] // initial, tmp_TrafficLight3.cfr:28:13
    }
    [((some this) && (some events.e_on_off)) => ((some this) U (some this.parent.off))] // -[]->>, tmp_TrafficLight3.cfr:20:17
    [(!(previous (some this))) => (some this.normal)] // initial, tmp_TrafficLight3.cfr:23:9
  }
  0..* off 0..1 {
    [(some this) => (X (some this.parent.on))] // -->, tmp_TrafficLight3.cfr:32:5
  }
  [(!(previous (some this))) => (some this.on)] // initial, tmp_TrafficLight3.cfr:20:5
}
