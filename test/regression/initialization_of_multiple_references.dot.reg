digraph "initialization_of_multiple_references"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"x" [label="x -&gt; integer * = 1, 2, 3" URL="#x" tooltip="x -&gt; integer * = 1, 2, 3&#10;"];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;"];
"p1" [label="p1 : Person" URL="#p1" tooltip="p1 : Person&#10;"];
"p2" [label="p2 : Person" URL="#p2" tooltip="p2 : Person&#10;"];
"p3" [label="p3 : Person" URL="#p3" tooltip="p3 : Person&#10;"];
"people" [label="people -&gt; Person * = p1, p1, p3" URL="#people" tooltip="people -&gt; Person * = p1, p1, p3&#10;"];
"people" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}