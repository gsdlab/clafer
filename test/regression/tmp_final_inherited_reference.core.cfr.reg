//# OPTIONS --explicit --core --tl=10
abstract 0..* Engine 0..* {}
0..* gas : Engine 1..1 {}
0..* electric : Engine 1..1 {}
abstract 0..* Car 0..* {
  abstract 0..* engine -> Engine 0..* {}
  1..1 gear 1..1 {
    [(!(previous ((#this) >= 1))) => ((#this.park) >= 1)] // initial, tmp_final_inherited_reference.cfr:13:9
    0..* park 0..1 {
      [((#this) >= 1) => (X ((#this.parent.drive) >= 1))] // transition, tmp_final_inherited_reference.cfr:13:17
    }
    0..* drive 0..1 {}
  }
}
0..* tesla : Car 1..1 {
  0..* motor : engine 1..1 {
    [all motor_1 : this | X (motor_1 in this.parent.motor)] // final, tmp_final_inherited_reference.cfr:16:5
    [all motor_1 : this | (previous ((#this.parent) >= 1)) => (previous (motor_1 in this.parent.motor))] // final, tmp_final_inherited_reference.cfr:16:5
    [all motor_1 : this | all motor_2 : motor_1.dref | X (((#motor_1.dref) >= 1) => (motor_2 in motor_1.dref))] // final, tmp_final_inherited_reference.cfr:16:5
  }
}
0..* leaf : Car 1..1 {
  0..* motor2 : engine 1..1 {
    [all motor2_1 : this | all motor2_2 : motor2_1.dref | X (((#motor2_1.dref) >= 1) => (motor2_2 in motor2_1.dref))] // finalref, tmp_final_inherited_reference.cfr:18:5
  }
}
0..* bolt : Car 1..1 {
  0..* motor3 : engine 1..1 {
    [all motor3_2 : this.dref | X (motor3_2 in this.parent.motor3.dref)] // finaltarget, tmp_final_inherited_reference.cfr:20:5
    [all motor3_2 : this.dref | (previous ((#this.parent) >= 1)) => (previous (motor3_2 in this.parent.motor3.dref))] // finaltarget, tmp_final_inherited_reference.cfr:20:5
  }
}
0..* mini : Car 1..1 {
  0..* motor4 : engine 1..1 {}
}
0..* volt : Car 1..1 {
  0..* motor5 : engine 1..1 {
    [all motor5_1 : this | all motor5_2 : motor5_1.dref | X (((#motor5_1.dref) >= 1) => (motor5_2 in motor5_1.dref))] // finalref, tmp_final_inherited_reference.cfr:26:5
    [all motor5_2 : this.dref | X (motor5_2 in this.parent.motor5.dref)] // finaltarget, tmp_final_inherited_reference.cfr:26:5
    [all motor5_2 : this.dref | (previous ((#this.parent) >= 1)) => (previous (motor5_2 in this.parent.motor5.dref))] // finaltarget, tmp_final_inherited_reference.cfr:26:5
  }
}
0..* prius : Car 1..1 {
  0..* motor6 -> Engine 1..1 {
    [all motor6_1 : this | all motor6_2 : motor6_1.dref | X (((#motor6_1.dref) >= 1) => (motor6_2 in motor6_1.dref))] // finalref, tmp_final_inherited_reference.cfr:28:5
    [all motor6_2 : this.dref | X (motor6_2 in this.parent.motor6.dref)] // finaltarget, tmp_final_inherited_reference.cfr:28:5
    [all motor6_2 : this.dref | (previous ((#this.parent) >= 1)) => (previous (motor6_2 in this.parent.motor6.dref))] // finaltarget, tmp_final_inherited_reference.cfr:28:5
  }
}
0..* garage 1..1 {
  0..* spare : Engine 1..1 {}
}
0..* corolla : Car 1..1 {
  0..* motor7 -> Engine 1..1 {
    [this.dref in (garage.spare ++ gas)]
    [all motor7_1 : this | all motor7_2 : motor7_1.dref | X (((#motor7_1.dref) >= 1) => (motor7_2 in motor7_1.dref))] // finalref, tmp_final_inherited_reference.cfr:33:5
  }
}

assert [(tesla.motor.dref = gas) => (G (tesla.motor.dref = gas))]
assert [(leaf.motor2.dref = gas) => (G (leaf.motor2.dref = gas))]
assert [(bolt.motor3.dref = gas) => (G (bolt.motor3.dref = gas))]
assert [(volt.motor5.dref = gas) => (G (volt.motor5.dref = gas))]
assert [(prius.motor6.dref = gas) => (G (prius.motor6.dref = gas))]
assert [(corolla.motor7.dref = gas) => (G (corolla.motor7.dref = gas))]
