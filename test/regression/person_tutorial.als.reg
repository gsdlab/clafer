open util/integer
pred show {}


abstract sig date
{ date_ref : one Int }

abstract sig NorthAmericanCountry
{}

one sig Canada extends NorthAmericanCountry
{}

one sig USA extends NorthAmericanCountry
{}

abstract sig Person
{ r_Name : one Name
, r_Surname : one Surname
, r_DateOfBirth : one DateOfBirth
, r_Gender : one Gender
, r_MaritalStatus : one MaritalStatus
, r_Address : one Address }

sig Name
{ Name_ref : one Int }
{ one @r_Name.this }

sig Surname
{ Surname_ref : one Int }
{ one @r_Surname.this }

sig DateOfBirth extends date
{}
{ one @r_DateOfBirth.this }

sig Gender
{ r_Male : lone Male
, r_Female : lone Female }
{ one @r_Gender.this
  let children = (r_Male + r_Female) | some children }

sig Male
{}
{ one @r_Male.this }

sig Female
{}
{ one @r_Female.this }

sig MaritalStatus
{ r_NeverMarried : lone NeverMarried
, r_Married : lone Married
, r_Divorced : lone Divorced }
{ one @r_MaritalStatus.this
  let children = (r_NeverMarried + r_Married + r_Divorced) | one children }

sig NeverMarried
{}
{ one @r_NeverMarried.this }

sig Married
{}
{ one @r_Married.this }

sig Divorced
{}
{ one @r_Divorced.this }

sig Address
{ r_Street : one Street
, r_City : one City
, r_Country : one Country
, r_PostalCode : one PostalCode }
{ one @r_Address.this }

sig Street
{ Street_ref : one Int
, r_UnitNo : lone UnitNo }
{ one @r_Street.this }

sig UnitNo
{ UnitNo_ref : one Int }
{ one @r_UnitNo.this }

sig City
{ City_ref : one Int }
{ one @r_City.this }

sig Country
{ Country_ref : one NorthAmericanCountry }
{ one @r_Country.this }

sig PostalCode
{ PostalCode_ref : one Int }
{ one @r_PostalCode.this }

one sig JohnDoe extends Person
{}
{ ((((((((((this.@r_Name).@Name_ref) = 0) && (((this.@r_Surname).@Surname_ref) = 1)) && (((this.@r_DateOfBirth).@date_ref) = 2)) && (some (this.@r_Gender).@r_Male)) && (some (this.@r_MaritalStatus).@r_Married)) && ((((this.@r_Address).@r_Street).@Street_ref) = 3)) && ((((this.@r_Address).@r_City).@City_ref) = 4)) && ((((this.@r_Address).@r_Country).@Country_ref) = Canada)) && ((((this.@r_Address).@r_PostalCode).@PostalCode_ref) = 5) }

abstract sig Student extends Person
{ r_StudentId : one StudentId }

sig StudentId
{ StudentId_ref : one Int }
{ one @r_StudentId.this }

abstract sig WaitingLine
{ r_participants : set participants }
{ all disj x, y : this.@r_participants | (x.@participants_ref) != (y.@participants_ref)  }

sig participants
{ participants_ref : one Person }
{ one @r_participants.this }

one sig MaryJane extends Student
{}
{ ((this.@r_StudentId).@StudentId_ref) = 6 }

one sig BusLine extends WaitingLine
{}
{ (JohnDoe in ((this.@r_participants).@participants_ref)) && (MaryJane in ((this.@r_participants).@participants_ref)) }

one sig JohnAndMaryLine extends WaitingLine
{}
{ ((this.@r_participants).@participants_ref) = (JohnDoe + MaryJane) }

fact { #TwoPersonLine = 0 }
abstract sig TwoPersonLine extends WaitingLine
{}
{ (#(this.@r_participants)) = 2 }

fact { #OneToTenPersonLine = 0 }
abstract sig OneToTenPersonLine extends WaitingLine
{}
{ ((#(this.@r_participants)) >= 1) && ((#(this.@r_participants)) <= 10) }

