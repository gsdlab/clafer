open util/integer
pred show {}


one sig a
{ a_ref : one Int }

fact { (some a) => ((a.@a_ref) = (6.rem[4])) }
assert assertAt_2_10 { (a.@a_ref) = 2 }
check assertAt_2_10 for 1

one sig b
{ b_ref : one Int }

fact { (some b) => ((b.@b_ref) = (0.rem[4])) }
assert assertAt_5_10 { (b.@b_ref) = 0 }
check assertAt_5_10 for 1

one sig c
{ c_ref : one Int }

fact { (some c) => ((c.@c_ref) = (4.rem[2])) }
assert assertAt_8_10 { (c.@c_ref) = 0 }
check assertAt_8_10 for 1

