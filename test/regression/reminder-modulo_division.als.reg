open util/integer
pred show {}


one sig c0_a
{ c0_a_ref : one Int }

fact { (some c0_a) => ((c0_a.@c0_a_ref) = (6.rem[4])) }
assert assertAt_2_10 { (c0_a.@c0_a_ref) = 2 }
check assertAt_2_10 for 1

one sig c0_b
{ c0_b_ref : one Int }

fact { (some c0_b) => ((c0_b.@c0_b_ref) = (0.rem[4])) }
assert assertAt_5_10 { (c0_b.@c0_b_ref) = 0 }
check assertAt_5_10 for 1

one sig c0_c
{ c0_c_ref : one Int }

fact { (some c0_c) => ((c0_c.@c0_c_ref) = (4.rem[2])) }
assert assertAt_8_10 { (c0_c.@c0_c_ref) = 0 }
check assertAt_8_10 for 1

