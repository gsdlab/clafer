<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_initialValue07.cfr</div>

<div>
<span class="claferDecl" id="Box">Box</span> ?
  <div class="indent">
  <span class="claferDecl" id="flag">flag</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="x">x</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> := <span class="keyword">if </span>X <span class="keyword">some</span> <a href="#flag"><span class="reference">flag</span></a><span class="keyword"> then </span>1<span class="keyword"> else </span>2</div>
</div>


<div>
<span class="keyword">[</span> <span class="tKeyword">initially </span><span class="keyword">some</span> <a href="#Box"><span class="reference">Box</span></a> &amp;&amp; X <span class="keyword">no</span> <a href="#Box"><span class="reference">Box</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> <span class="tKeyword">initially </span><a href="#Box"><span class="reference">Box</span></a>.<a href="#x"><span class="reference">x</span></a> = 2 <span class="keyword">]</span></div>

</body>
</html>