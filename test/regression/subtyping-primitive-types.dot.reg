digraph "subtyping-primitive-types"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"percent" [label="abstract percent -&gt;&gt; integer" URL="#percent" tooltip="abstract percent -&gt;&gt; integer&#10;  [ this >= 0 &amp;&amp; this <= 5 ]&#10;"];
"twoPercent" [label="twoPercent : percent = 2" URL="#twoPercent" tooltip="twoPercent : percent = 2&#10;"];
"threePercent" [label="threePercent : percent = twoPercent + 1" URL="#threePercent" tooltip="threePercent : percent = twoPercent + 1&#10;"];
"date" [label="abstract date -&gt;&gt; string" URL="#date" tooltip="abstract date -&gt;&gt; string&#10;"];
"today" [label="today : date = &quot;Mar 20, 2012&quot;" URL="#today" tooltip="today : date = &quot;Mar 20, 2012&quot;&#10;"];
"time" [label="abstract time -&gt;&gt; integer = minute + hour" URL="#time" tooltip="abstract time -&gt;&gt; integer = minute + hour&#10;  minute -&gt; integer&#10;    [ this >= 0 &amp;&amp; this <= 5 ]&#10;  hour -&gt; integer&#10;    [ this >= 0 &amp;&amp; this <= 5 ]&#10;"];
"now" [label="now : time" URL="#now" tooltip="now : time&#10;  [ minute = 3 ]&#10;  [ hour = 1 ]&#10;"];
}