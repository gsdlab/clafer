digraph "mutually_recursive_abstract_clafers"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"A" [label="abstract A" URL="#A" tooltip="abstract A&#10;  b : B&#10;"];
"B" [label="abstract B" URL="#B" tooltip="abstract B&#10;  a : A&#10;"];
"x" [label="x : A" URL="#x" tooltip="x : A&#10;"];
}