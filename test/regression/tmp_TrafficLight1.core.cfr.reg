//# OPTIONS --explicit --core --tl=10
abstract 1..1 TrafficLight_1 0..* {
  [initially ((#this.on) >= 1)] // initial, tmp_TrafficLight1.cfr:4:9
  1..1 on 0..1 {
    [((#this) >= 1) => (((#this) >= 1) U ((#this.parent.off) >= 1))] // transition, tmp_TrafficLight1.cfr:4:21
    [initially ((#this.normal) >= 1)] // initial, tmp_TrafficLight1.cfr:5:17
    1..1 normal 0..1 {
      [initially ((#this.green) >= 1)] // initial, tmp_TrafficLight1.cfr:6:25
      0..* green 0..1 {
        [((#this) >= 1) => (X ((#this.parent.yellow) >= 1))] // transition, tmp_TrafficLight1.cfr:6:33
      }
      0..* yellow 0..1 {
        [((#this) >= 1) => (X ((#this.parent.red) >= 1))] // transition, tmp_TrafficLight1.cfr:7:25
      }
      0..* red 0..1 {
        [((#this) >= 1) => (X ((#this.parent.green) >= 1))] // transition, tmp_TrafficLight1.cfr:8:25
      }
    }
    1..1 flashing 0..1 {
      [((#this) >= 1) => (((#this) >= 1) U ((#this.parent.normal) >= 1))] // transition, tmp_TrafficLight1.cfr:9:21
      [initially ((#this.yellow_on) >= 1)] // initial, tmp_TrafficLight1.cfr:10:25
      0..* yellow_on 0..1 {
        [((#this) >= 1) => (X ((#this.parent.yellow_off) >= 1))] // transition, tmp_TrafficLight1.cfr:10:33
      }
      0..* yellow_off 0..1 {
        [((#this) >= 1) => (X ((#this.parent.yellow_on) >= 1))] // transition, tmp_TrafficLight1.cfr:11:25
      }
    }
  }
  0..* off 0..1 {
    [((#this) >= 1) => (X ((#this.parent.on) >= 1))] // transition, tmp_TrafficLight1.cfr:12:9
  }
}
