scope({$x:3});
defaultScope(1);
stringLength(16);

$x = Clafer("x").withCard(3, 3);
$total_x = Clafer("total_x").withCard(1, 1);
$y = Clafer("y").withCard(1, 1);
$total_y = $y.addChild("total_y").withCard(1, 1);
$x.refToUnique(Int);
$total_x.refToUnique(Int);
Constraint(implies(some(global($total_x)), equal(joinRef(global($total_x)), sum(global($x)))));
$total_y.refToUnique(Int);
$y.addConstraint(implies(some(join($this(), $total_y)), equal(joinRef(join($this(), $total_y)), sum(global($x)))));
min(maximum(joinRef(global($x))));
min(maximum(joinRef(global($x))));
max(minimum(joinRef(global($x))));
max(minimum(joinRef(global($x))));
min(sum(global($x)));
max(product(global($x)));
min(card(global($x)));
min(joinRef(global($total_x)));
min(joinRef(join(global($y), $total_y)));
