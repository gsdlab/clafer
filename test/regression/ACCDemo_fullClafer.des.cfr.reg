//# OPTIONS --explicit
abstract 0..* car 0..* {
  1..1 transmission 1..1 {
    0..* automatic 0..1 {}
    0..* manual 0..1 {}
  }
  0..* car__fca : root__fca 0..1 {}
  0..* car__cc : root__cc 1..1 {}
  [(some this.car__cc.acc) => (some this.car__fca)]
}
abstract 0..* root__fca 0..* {
  1..1 sensor 1..1 {
    0..* radar 0..1 {}
    0..* lidar 0..1 {}
  }
}
abstract 0..* root__cc 0..* {
  0..* switches 2..3 {
    0..* backlight 0..1 {}
  }
  0..* acc 0..1 {}
}
abstract 0..* camaro : car 0..* {
  [all s : this.car__cc.switches | some s.backlight]
  0..* transformer 0..1 {
    [(#this.parent.car__cc.switches) = 3]
  }
}
0..* bumbleBee : camaro 1..1 {
  [some this.transformer]
  [some this.transmission.manual]
}
