open util/integer
pred show {}


abstract sig Hardware
{}

one sig h1 extends Hardware
{}

one sig h2 extends Hardware
{}

abstract sig Software
{ r_target : one target }

sig target
{ target_ref : one Hardware }
{ one @r_target.this }

one sig s1 extends Software
{}
{ ((this.@r_target).@target_ref) = h1 }

one sig s2 extends Software
{}
{ ((this.@r_target).@target_ref) = h2 }

fact { #noHardware = 0 }
sig noHardware
{ noHardware_ref : one Hardware }

sig uses
{ uses_ref : one Hardware }

fact {  all disj x, y : uses | (x.@uses_ref) != (y.@uses_ref)  }
fact { (uses.@uses_ref) = (((#Software) > 0) => (((s1.@r_target).@target_ref) + ((s2.@r_target).@target_ref)) else (noHardware.@noHardware_ref)) }
