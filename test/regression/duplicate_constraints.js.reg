defaultScope(1);
stringLength(16);

$D = Clafer("D").withCard(1, 1);
$b = $D.addChild("b").withCard(0, 1);
$c = $D.addChild("c").withCard(0, 1);
$c.refToUnique(Int);
$D.addConstraint(equal(joinRef(join($this(), $c)), constant(5)));
$D.addConstraint(equal(joinRef(join($this(), $c)), constant(5)));
$D.addConstraint(some(join($this(), $b)));
