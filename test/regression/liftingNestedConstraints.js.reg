defaultScope(1);
stringLength(16);

$a = Clafer("a");
$b = $a.addChild("b");
$c = $b.addChild("c");
$d = $c.addChild("d").withCard(0, 1);
$b.addConstraint(one(join(join($this(), $c), $d)));
$a.addConstraint(all([decl([$_x = local("x")], join(join($this(), $b), $c))], one(join($_x, $d))));
Constraint(all([decl([$_x = local("x")], join(join(global($a), $b), $c))], one(join($_x, $d))));
assert(all([decl([$_x = local("x")], join(join(global($a), $b), $c))], some(join($_x, $d))));
