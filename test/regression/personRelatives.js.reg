scope({$Person:3, $age:3, $childs:9, $divorced:3, $maritalStatus:3, $married:3, $neverMarried:3, $parents:6, $spouse:3});
defaultScope(1);
stringLength(16);

$Person = Abstract("Person");
$age = $Person.addChild("age").withCard(1, 1);
$maritalStatus = $Person.addChild("maritalStatus").withCard(1, 1).withGroupCard(1, 1);
$neverMarried = $maritalStatus.addChild("neverMarried").withCard(0, 1);
$married = $maritalStatus.addChild("married").withCard(0, 1);
$spouse = $married.addChild("spouse").withCard(1, 1);
$divorced = $maritalStatus.addChild("divorced").withCard(0, 1);
$childs = $Person.addChild("childs");
$parents = $Person.addChild("parents").withCard(0, 2);
$Alice = Clafer("Alice").withCard(1, 1);
$Bob = Clafer("Bob").withCard(1, 1);
$Carol = Clafer("Carol").withCard(1, 1);
$Alice.extending($Person);
$Bob.extending($Person);
$Carol.extending($Person);
$age.refToUnique(Int);
$spouse.refToUnique($Person);
$childs.refToUnique($Person);
$parents.refToUnique($Person);
$age.addConstraint(greaterThanEqual(joinRef($this()), constant(0)));
$spouse.addConstraint(equal(joinRef(join(join(join(joinRef($this()), $maritalStatus), $married), $spouse)), joinParent(joinParent(joinParent($this())))));
$married.addConstraint(notEqual(joinRef(join($this(), $spouse)), joinParent(joinParent($this()))));
$maritalStatus.addConstraint(implies(or(some(join($this(), $married)), some(join($this(), $divorced))), greaterThanEqual(joinRef(join(joinParent($this()), $age)), constant(5))));
$childs.addConstraint($in(joinParent($this()), joinRef(join(joinRef($this()), $parents))));
$childs.addConstraint($in(joinRef(join(join(join(joinParent($this()), $maritalStatus), $married), $spouse)), joinRef(join(joinRef($this()), $parents))));
$childs.addConstraint(lessThan(joinRef(join(joinRef($this()), $age)), joinRef(join(joinParent($this()), $age))));
$parents.addConstraint($in(joinParent($this()), joinRef(join(joinRef($this()), $childs))));
$Alice.addConstraint(equal(joinRef(join($this(), $age)), constant(6)));
$Alice.addConstraint(equal(joinRef(join(join(join($this(), $maritalStatus), $married), $spouse)), global($Bob)));
Constraint(equal(joinRef(join(global($Person), $childs)), global($Carol)));
assert(greaterThanEqual(joinRef(join(global($Bob), $age)), constant(5)));
assert(equal(joinRef(join(join(join(global($Bob), $maritalStatus), $married), $spouse)), global($Alice)));
assert(equal(joinRef(join(global($Bob), $childs)), global($Carol)));
$Carol.addConstraint(equal(joinRef(join($this(), $age)), constant(1)));
assert(equal(joinRef(join(global($Carol), $parents)), union(global($Alice), global($Bob))));
