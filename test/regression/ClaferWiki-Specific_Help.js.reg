scope({$B:0, $C:2, $c:2});
defaultScope(1);
stringLength(16);

$A = Abstract("A");
$c = $A.addChild("c");
$A1 = Clafer("A1").withCard(1, 1);
$B = Abstract("B");
$C = Abstract("C");
$C1 = Clafer("C1").withCard(1, 1);
$C2 = Clafer("C2").withCard(1, 1);
$c.refToUnique($C);
$A1.extending($A);
$A1.addConstraint(equal(card(join($this(), $c)), constant(2)));
$B.extending($A);
$C1.extending($C);
$C2.extending($C);
