open util/integer
pred show {}


abstract sig Person
{ r_age : one age
, r_married : lone married }

sig age
{ age_ref : one Int }
{ one @r_age.this }

sig married
{}
{ one @r_married.this }

abstract sig NewBorn
{ NewBorn_ref : one Person }
{ ((((this.@NewBorn_ref).@r_age).@age_ref) = 0) && (no (this.@NewBorn_ref).@r_married) }

fact {  all disj x, y : NewBorn | (x.@NewBorn_ref) != (y.@NewBorn_ref)  }
one sig Alice extends Person
{}

one sig baby extends NewBorn
{}

assert assertAt_15_10 { (baby.@NewBorn_ref) = Alice }
check assertAt_15_10 for 1

assert assertAt_16_10 { ((Alice.@r_age).@age_ref) = 0 }
check assertAt_16_10 for 1

assert assertAt_17_10 { no Alice.@r_married }
check assertAt_17_10 for 1

