open util/integer
pred show {}


abstract sig c0_Person
{ r_c0_age : one c0_age
, r_c0_married : lone c0_married }

sig c0_age
{ c0_age_ref : one Int }
{ one @r_c0_age.this }

sig c0_married
{}
{ one @r_c0_married.this }

abstract sig c0_NewBorn
{ c0_NewBorn_ref : one c0_Person }
{ ((((this.@c0_NewBorn_ref).@r_c0_age).@c0_age_ref) = 0) && (no (this.@c0_NewBorn_ref).@r_c0_married) }

fact {  all disj x, y : c0_NewBorn | (x.@c0_NewBorn_ref) != (y.@c0_NewBorn_ref)  }
one sig c0_Alice extends c0_Person
{}

one sig c0_baby extends c0_NewBorn
{}

assert assertAt_15_10 { (c0_baby.@c0_NewBorn_ref) = c0_Alice }
check assertAt_15_10 for 1

assert assertAt_16_10 { ((c0_Alice.@r_c0_age).@c0_age_ref) = 0 }
check assertAt_16_10 for 1

assert assertAt_17_10 { no c0_Alice.@r_c0_married }
check assertAt_17_10 for 1

