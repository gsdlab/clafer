  always (this in alive_c0_flashing implies (lone this.@r_c0_yellow_on))
  always (this in alive_c0_flashing implies (lone this.@r_c0_yellow_off))
  always (this in alive_c0_flashing implies (((some this.@r_c0_yellow_on) && (some alive_c0_events.@r_c0_e_after_0_5)) => ((some (this & alive_c0_flashing) and ((some (this & alive_c0_flashing)) && (some this.@r_c0_yellow_on))) until (not some (this & alive_c0_flashing) or (some this.@r_c0_yellow_off)))))
  always (this in alive_c0_flashing implies (((some this.@r_c0_yellow_off) && (some alive_c0_events.@r_c0_e_after_0_5)) => ((some (this & alive_c0_flashing) and ((some (this & alive_c0_flashing)) && (some this.@r_c0_yellow_off))) until (not some (this & alive_c0_flashing) or (some this.@r_c0_yellow_on)))))
  always (this in alive_c0_flashing and not before this in alive_c0_flashing implies (some this.@r_c0_yellow_on)) }
