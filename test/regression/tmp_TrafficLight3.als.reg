open util/integer
pred show {}


one sig root
{ var r_events : set events }
fact { all self_ : root | always (one self_.@r_events) }


abstract sig event
{}
fun alive_event : set event { alive_e_on_off + alive_e_police + alive_e_after_5 + alive_e_after_7 + alive_e_after_0_5 }

sig events
{ p_events : lone root
, var r_e_on_off : set e_on_off
, var r_e_police : set e_police
, var r_e_after_5 : set e_after_5
, var r_e_after_7 : set e_after_7
, var r_e_after_0_5 : set e_after_0_5 }
{ always (this in alive_events implies (let children = (this.@r_e_on_off + this.@r_e_police + this.@r_e_after_5 + this.@r_e_after_7 + this.@r_e_after_0_5) | lone children)) }
fun alive_events : set events { root.@r_events }
fact { always ~@r_events in @p_events }

fact { all self_ : events | always (self_ in alive_events implies (lone self_.@r_e_on_off)) }
fact { all self_ : events | always (self_ in alive_events implies (lone self_.@r_e_police)) }
fact { all self_ : events | always (self_ in alive_events implies (lone self_.@r_e_after_5)) }
fact { all self_ : events | always (self_ in alive_events implies (lone self_.@r_e_after_7)) }
fact { all self_ : events | always (self_ in alive_events implies (lone self_.@r_e_after_0_5)) }


sig e_on_off extends event
{ p_e_on_off : lone events }
fun alive_e_on_off : set e_on_off { events.@r_e_on_off }
fact { always ~@r_e_on_off in @p_e_on_off
  always @r_e_on_off.univ in alive_events }


sig e_police extends event
{ p_e_police : lone events }
fun alive_e_police : set e_police { events.@r_e_police }
fact { always ~@r_e_police in @p_e_police
  always @r_e_police.univ in alive_events }


sig e_after_5 extends event
{ p_e_after_5 : lone events }
fun alive_e_after_5 : set e_after_5 { events.@r_e_after_5 }
fact { always ~@r_e_after_5 in @p_e_after_5
  always @r_e_after_5.univ in alive_events }


sig e_after_7 extends event
{ p_e_after_7 : lone events }
fun alive_e_after_7 : set e_after_7 { events.@r_e_after_7 }
fact { always ~@r_e_after_7 in @p_e_after_7
  always @r_e_after_7.univ in alive_events }


sig e_after_0_5 extends event
{ p_e_after_0_5 : lone events }
fun alive_e_after_0_5 : set e_after_0_5 { events.@r_e_after_0_5 }
fact { always ~@r_e_after_0_5 in @p_e_after_0_5
  always @r_e_after_0_5.univ in alive_events }


abstract sig TrafficLight_3
{ var r_on : set on
, var r_off : set off }
{ always (this in alive_TrafficLight_3 and not before this in alive_TrafficLight_3 implies (some this.@r_on)) }
fun alive_TrafficLight_3 : set TrafficLight_3 { none }
fact { all self_ : TrafficLight_3 | always (self_ in alive_TrafficLight_3 implies (lone self_.@r_on)) }
fact { all self_ : TrafficLight_3 | always (self_ in alive_TrafficLight_3 implies (lone self_.@r_off)) }


sig on
{ p_on : lone TrafficLight_3
, var r_normal : set normal
, var r_flashing : set flashing }
{ always (this in alive_on implies (let children = (this.@r_normal + this.@r_flashing) | one children))
  always (this in alive_on and not before this in alive_on implies (some this.@r_normal)) }
fun alive_on : set on { TrafficLight_3.@r_on }
fact { always ~@r_on in @p_on
  always @r_on.univ in alive_TrafficLight_3 }

fact { all self_ : on | always (self_ in alive_on implies (lone self_.@r_normal)) }
fact { all self_ : on | always (self_ in alive_on implies (lone self_.@r_flashing)) }
fact { all self_ : on | always (self_ in alive_on implies (((some (self_ & alive_on)) && (some alive_events.@r_e_on_off)) => ((some self_.(@p_on :> alive_TrafficLight_3) and (some (self_ & alive_on))) until (not some self_.(@p_on :> alive_TrafficLight_3) or (some (self_.(@p_on :> alive_TrafficLight_3)).@r_off))))) }


sig normal
{ p_normal : lone on
, var r_green : set green
, var r_yellow : set yellow
, var r_red : set red }
{ always (this in alive_normal implies (let children = (this.@r_green + this.@r_yellow + this.@r_red) | one children))
  always (this in alive_normal and not before this in alive_normal implies (some this.@r_green)) }
fun alive_normal : set normal { on.@r_normal }
fact { always ~@r_normal in @p_normal
  always @r_normal.univ in alive_on }

fact { all self_ : normal | always (self_ in alive_normal implies (lone self_.@r_green)) }
fact { all self_ : normal | always (self_ in alive_normal implies (lone self_.@r_yellow)) }
fact { all self_ : normal | always (self_ in alive_normal implies (lone self_.@r_red)) }
fact { all self_ : normal | always (self_ in alive_normal implies (((some (self_ & alive_normal)) && (some alive_events.@r_e_police)) => ((some self_.(@p_normal :> alive_on) and (some (self_ & alive_normal))) until (not some self_.(@p_normal :> alive_on) or (some (self_.(@p_normal :> alive_on)).@r_flashing))))) }


sig green
{ p_green : lone normal }
fun alive_green : set green { normal.@r_green }
fact { always ~@r_green in @p_green
  always @r_green.univ in alive_normal }

fact { all self_ : green | always (self_ in alive_green implies ((some (self_ & alive_green)) => (after (not some self_.(@p_green :> alive_normal) or (some (self_.(@p_green :> alive_normal)).@r_yellow))))) }


sig yellow
{ p_yellow : lone normal }
fun alive_yellow : set yellow { normal.@r_yellow }
fact { always ~@r_yellow in @p_yellow
  always @r_yellow.univ in alive_normal }

fact { all self_ : yellow | always (self_ in alive_yellow implies ((some (self_ & alive_yellow)) => (after (not some self_.(@p_yellow :> alive_normal) or (some (self_.(@p_yellow :> alive_normal)).@r_red))))) }


sig red
{ p_red : lone normal }
fun alive_red : set red { normal.@r_red }
fact { always ~@r_red in @p_red
  always @r_red.univ in alive_normal }

fact { all self_ : red | always (self_ in alive_red implies ((some (self_ & alive_red)) => (after (not some self_.(@p_red :> alive_normal) or (some (self_.(@p_red :> alive_normal)).@r_green))))) }


sig flashing
{ p_flashing : lone on
, var r_yellow_on : set yellow_on
, var r_yellow_off : set yellow_off }
{ always (this in alive_flashing implies (let children = (this.@r_yellow_on + this.@r_yellow_off) | one children))
  always (this in alive_flashing and not before this in alive_flashing implies (some this.@r_yellow_on)) }
fun alive_flashing : set flashing { on.@r_flashing }
fact { always ~@r_flashing in @p_flashing
  always @r_flashing.univ in alive_on }

fact { all self_ : flashing | always (self_ in alive_flashing implies (lone self_.@r_yellow_on)) }
fact { all self_ : flashing | always (self_ in alive_flashing implies (lone self_.@r_yellow_off)) }
fact { all self_ : flashing | always (self_ in alive_flashing implies (((some (self_ & alive_flashing)) && (some alive_events.@r_e_police)) => ((some self_.(@p_flashing :> alive_on) and (some (self_ & alive_flashing))) until (not some self_.(@p_flashing :> alive_on) or (some (self_.(@p_flashing :> alive_on)).@r_normal))))) }


sig yellow_on
{ p_yellow_on : lone flashing }
fun alive_yellow_on : set yellow_on { flashing.@r_yellow_on }
fact { always ~@r_yellow_on in @p_yellow_on
  always @r_yellow_on.univ in alive_flashing }

fact { all self_ : yellow_on | always (self_ in alive_yellow_on implies (((some (self_ & alive_yellow_on)) && (some alive_events.@r_e_after_0_5)) => ((some self_.(@p_yellow_on :> alive_flashing) and (some (self_ & alive_yellow_on))) until (not some self_.(@p_yellow_on :> alive_flashing) or (some (self_.(@p_yellow_on :> alive_flashing)).@r_yellow_off))))) }


sig yellow_off
{ p_yellow_off : lone flashing }
fun alive_yellow_off : set yellow_off { flashing.@r_yellow_off }
fact { always ~@r_yellow_off in @p_yellow_off
  always @r_yellow_off.univ in alive_flashing }

fact { all self_ : yellow_off | always (self_ in alive_yellow_off implies (((some (self_ & alive_yellow_off)) && (some alive_events.@r_e_after_0_5)) => ((some self_.(@p_yellow_off :> alive_flashing) and (some (self_ & alive_yellow_off))) until (not some self_.(@p_yellow_off :> alive_flashing) or (some (self_.(@p_yellow_off :> alive_flashing)).@r_yellow_on))))) }


sig off
{ p_off : lone TrafficLight_3 }
fun alive_off : set off { TrafficLight_3.@r_off }
fact { always ~@r_off in @p_off
  always @r_off.univ in alive_TrafficLight_3 }

fact { all self_ : off | always (self_ in alive_off implies ((some (self_ & alive_off)) => (after (not some self_.(@p_off :> alive_TrafficLight_3) or (some (self_.(@p_off :> alive_TrafficLight_3)).@r_on))))) }


