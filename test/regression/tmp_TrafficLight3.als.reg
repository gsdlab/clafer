open util/integer
pred show {}


one sig root
{ var r_c0_events : set c0_events }
{ always (one this.@r_c0_events) }

abstract sig c0_event
{}
fun alive_c0_event : set c0_event { alive_c0_e_on_off + alive_c0_e_police + alive_c0_e_after_5 + alive_c0_e_after_7 + alive_c0_e_after_0_5 }

sig c0_events
{ p_c0_events : lone root
, var r_c0_e_on_off : set c0_e_on_off
, var r_c0_e_police : set c0_e_police
, var r_c0_e_after_5 : set c0_e_after_5
, var r_c0_e_after_7 : set c0_e_after_7
, var r_c0_e_after_0_5 : set c0_e_after_0_5 }
{ always (this in alive_c0_events implies (let children = (this.@r_c0_e_on_off + this.@r_c0_e_police + this.@r_c0_e_after_5 + this.@r_c0_e_after_7 + this.@r_c0_e_after_0_5) | lone children))
  always (this in alive_c0_events implies (lone this.@r_c0_e_on_off))
  always (this in alive_c0_events implies (lone this.@r_c0_e_police))
  always (this in alive_c0_events implies (lone this.@r_c0_e_after_5))
  always (this in alive_c0_events implies (lone this.@r_c0_e_after_7))
  always (this in alive_c0_events implies (lone this.@r_c0_e_after_0_5)) }
fun alive_c0_events : set c0_events { root.@r_c0_events }
fact { always ~@r_c0_events in @p_c0_events }


sig c0_e_on_off extends c0_event
{ p_c0_e_on_off : lone c0_events }
fun alive_c0_e_on_off : set c0_e_on_off { c0_events.@r_c0_e_on_off }
fact { always ~@r_c0_e_on_off in @p_c0_e_on_off
  always @r_c0_e_on_off.univ in alive_c0_events }


sig c0_e_police extends c0_event
{ p_c0_e_police : lone c0_events }
fun alive_c0_e_police : set c0_e_police { c0_events.@r_c0_e_police }
