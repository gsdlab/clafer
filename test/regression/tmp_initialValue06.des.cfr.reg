//# OPTIONS --explicit --tl=10
[F (v1.dref = 4)]
0..* A 1..1 {
  [F ((this.x.dref = 5) && (this.x.x__y.dref = 7))]
  0..* A__y -> int 1..1 {}
  0..* x -> int 0..1 {
    [initially (this.dref = (this.parent.A__y.dref + 1))]
    0..* x__y -> int 1..1 {}
  }
  0..* z -> int 1..1 {
    [initially (this.dref = this.parent.A__y.dref)]
  }
}
abstract 0..* Val -> int 0..* {
  [initially (this.dref = 2)]
}
