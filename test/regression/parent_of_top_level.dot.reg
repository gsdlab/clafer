digraph "parent_of_top_level"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"c0_a" [label="a" URL="#c0_a" tooltip="a&#10;  x -&gt; integer&#10;"];
"c0_extra" [label="extra ?" URL="#c0_extra" tooltip="extra ?&#10;"];
"c0_b" [label="b" URL="#c0_b" tooltip="b&#10;  [ some parent.a ]&#10;  [ some this.parent ]&#10;  [ # parent = 1 ]&#10;  [ parent.a.x = 2 ]&#10;  [ all v : b | some v.parent.a ]&#10;  [ some a.parent.a ]&#10;  [ some extra.parent <=> some extra ]&#10;  [ # extra.parent = 1 => some extra ]&#10;  [ some extra.parent.a => some extra ]&#10;"];
"c0_Top" [label="abstract Top" URL="#c0_Top" tooltip="abstract Top&#10;  [ some parent ]&#10;"];
"c0_top1" [label="top1 : Top" URL="#c0_top1" tooltip="top1 : Top&#10;"];
"c0_top1" -> "c0_Top" [arrowhead=onormal constraint=true weight=100];
"c0_top2" [label="top2 : Top" URL="#c0_top2" tooltip="top2 : Top&#10;"];
"c0_top2" -> "c0_Top" [arrowhead=onormal constraint=true weight=100];
"c0_Feat" [label="abstract Feat" URL="#c0_Feat" tooltip="abstract Feat&#10;  [ some parent ]&#10;  [ # parent = 1 ]&#10;"];
"c0_f1" [label="f1 : Feat" URL="#c0_f1" tooltip="f1 : Feat&#10;"];
"c0_f1" -> "c0_Feat" [arrowhead=onormal constraint=true weight=100];
"c0_g" [label="g" URL="#c0_g" tooltip="g&#10;  f2 : Feat&#10;"];
"c0_g" -> "c0_Feat" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_h" [label="h 2" URL="#c0_h" tooltip="h 2&#10;  i&#10;    f3 : Feat&#10;"];
"c0_h" -> "c0_Feat" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
}