open util/integer
pred show {}


one sig root
{ var r_c0_s : set c0_s }
fact { all self_ : root | always (one self_.@r_c0_s) }

assert assertAt_8_10 { all self_ : root | always (always (some alive_c0_s)) }
check assertAt_8_10 for 1 but 10 steps



sig c0_s
{ p_c0_s : lone root
, var r_c0_a : set c0_a
, var r_c0_b : set c0_b }
{ always (this in alive_c0_s implies (let children = (this.@r_c0_a + this.@r_c0_b) | one children))
  always (this in alive_c0_s and not before this in alive_c0_s implies (some this.@r_c0_a)) }
fun alive_c0_s : set c0_s { root.@r_c0_s }
fact { always ~@r_c0_s in @p_c0_s }

fact { all self_ : c0_s | always (self_ in alive_c0_s implies (lone self_.@r_c0_a)) }
fact { all self_ : c0_s | always (self_ in alive_c0_s implies (lone self_.@r_c0_b)) }

assert assertAt_6_14 { all self_ : c0_s | always (self_ in alive_c0_s implies ((some self_.@r_c0_a) => (after (some self_.@r_c0_b)))) }
check assertAt_6_14 for 1 but 10 steps

assert assertAt_6_35 { all self_ : c0_s | always (self_ in alive_c0_s implies ((some self_.@r_c0_b) => (after (some self_.@r_c0_a)))) }
check assertAt_6_35 for 1 but 10 steps



sig c0_a
{ p_c0_a : lone c0_s }
fun alive_c0_a : set c0_a { c0_s.@r_c0_a }
fact { always ~@r_c0_a in @p_c0_a
  always @r_c0_a.univ in alive_c0_s }

fact { all self_ : c0_a | always (self_ in alive_c0_a implies ((some (self_ & alive_c0_a)) => (after (not some self_.(@p_c0_a :> alive_c0_s) or (some (self_.(@p_c0_a :> alive_c0_s)).@r_c0_b))))) }


sig c0_b
{ p_c0_b : lone c0_s }
fun alive_c0_b : set c0_b { c0_s.@r_c0_b }
fact { always ~@r_c0_b in @p_c0_b
  always @r_c0_b.univ in alive_c0_s }

fact { all self_ : c0_b | always (self_ in alive_c0_b implies ((some (self_ & alive_c0_b)) => (after (not some self_.(@p_c0_b :> alive_c0_s) or (some (self_.(@p_c0_b :> alive_c0_s)).@r_c0_a))))) }


