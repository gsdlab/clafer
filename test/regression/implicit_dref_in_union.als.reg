open util/integer
pred show {}


sig AlicePicks
{ AlicePicks_ref : one Int }

sig BobPicks
{ BobPicks_ref : one Int }

fact { (AlicePicks.@AlicePicks_ref) = ((BobPicks.@BobPicks_ref) + 3) }
fact { (3 + (BobPicks.@BobPicks_ref)) = (AlicePicks.@AlicePicks_ref) }
abstract sig Person
{}

one sig p1 extends Person
{}

one sig p2 extends Person
{}

one sig p3 extends Person
{}

sig friends
{ friends_ref : one Person }

fact {  all disj x, y : friends | (x.@friends_ref) != (y.@friends_ref)  }
sig others
{ others_ref : one Person }

fact {  all disj x, y : others | (x.@others_ref) != (y.@others_ref)  }
fact { (friends.@friends_ref) = ((others.@others_ref) + p1) }
fact { (others.@others_ref) = p2 }
