//# OPTIONS --explicit --tl=10
0..* go 0..1 {}
0..* ready 0..1 {}
0..* done 0..1 {}
[G (((#done) >= 1) => (once ((#go) >= 1)))]
[G (((#done) >= 1) => (((#ready) >= 1) since ((#go) >= 1)))]
[G (((#go) >= 1) => (!(previous ((#go) >= 1))))]
[initially ((((#go) >= 1) && ((#ready) = 0)) && ((#done) = 0))]
[initially (X (((#ready) >= 1) && ((#go) = 0)))]
[initially (X (X (((#ready) >= 1) && ((#done) >= 1))))]

assert [initially (!(previous ((#go) >= 1)))]
assert [initially (X (X (once ((#go) >= 1))))]
assert [initially (X (X (((#ready) >= 1) since ((#go) >= 1))))]
assert [initially (X (X (!(historically ((#ready) >= 1)))))]
assert [G ((!(once ((#go) >= 1))) => (((#done) = 0) triggered ((#go) = 0)))]
