open util/integer
pred show {}


abstract sig tristate
{ r_module_1 : lone module_1 }

sig module_1
{}
{ one @r_module_1.this }

lone sig MISC_FILESYSTEMS
{ r_MISC_FILESYSTEMS__display : one MISC_FILESYSTEMS__display
, r_JFFS2_FS : lone JFFS2_FS }
{ (some this.@r_MISC_FILESYSTEMS__display) => (((this.@r_MISC_FILESYSTEMS__display).@MISC_FILESYSTEMS__display_ref) = 0) }

lone sig MISC_FILESYSTEMS__display
{ MISC_FILESYSTEMS__display_ref : one Int }
{ one r_MISC_FILESYSTEMS__display }

lone sig JFFS2_FS extends tristate
{ r_JFFS2_FS__display : one JFFS2_FS__display
, r_FFS2_FS_DEBUG : one FFS2_FS_DEBUG
, r_JFFS2_FS_WRITEBUFFER : lone JFFS2_FS_WRITEBUFFER
, r_JFFS2_COMPRESS : lone JFFS2_COMPRESS }
{ one r_JFFS2_FS
  (some this.@r_JFFS2_FS__display) => (((this.@r_JFFS2_FS__display).@JFFS2_FS__display_ref) = 1)
  some MTD
  (some MTD) => (some CRC32)
  (some this.@r_JFFS2_FS_WRITEBUFFER) <=> (some HAS_IOMEM) }

lone sig JFFS2_FS__display
{ JFFS2_FS__display_ref : one Int }
{ one r_JFFS2_FS__display }

lone sig FFS2_FS_DEBUG
{ FFS2_FS_DEBUG_ref : one Int
, r_FFS2_FS_DEBUG__display : one FFS2_FS_DEBUG__display }
{ one r_FFS2_FS_DEBUG
  (this.@FFS2_FS_DEBUG_ref) = 0
  (some this.@r_FFS2_FS_DEBUG__display) => (((this.@r_FFS2_FS_DEBUG__display).@FFS2_FS_DEBUG__display_ref) = 2)
  (0 <= (this.@FFS2_FS_DEBUG_ref)) && ((this.@FFS2_FS_DEBUG_ref) <= 2) }

lone sig FFS2_FS_DEBUG__display
{ FFS2_FS_DEBUG__display_ref : one Int }
{ one r_FFS2_FS_DEBUG__display }

lone sig JFFS2_FS_WRITEBUFFER
{}
{ one r_JFFS2_FS_WRITEBUFFER }

lone sig JFFS2_COMPRESS
{ r_JFFS2_COMPRESS__display : one JFFS2_COMPRESS__display
, r_JFFS2_ZLIB : lone JFFS2_ZLIB
, r_CompressionChoice : one CompressionChoice }
{ one r_JFFS2_COMPRESS
  (some this.@r_JFFS2_COMPRESS__display) => (((this.@r_JFFS2_COMPRESS__display).@JFFS2_COMPRESS__display_ref) = 3)
  some this.@r_JFFS2_ZLIB }

lone sig JFFS2_COMPRESS__display
{ JFFS2_COMPRESS__display_ref : one Int }
{ one r_JFFS2_COMPRESS__display }

lone sig JFFS2_ZLIB
{ r_JFFS2_ZLIB__display : one JFFS2_ZLIB__display }
{ one r_JFFS2_ZLIB
  (some this.@r_JFFS2_ZLIB__display) => (((this.@r_JFFS2_ZLIB__display).@JFFS2_ZLIB__display_ref) = 4)
  some ZLIB_INFLATE }

lone sig JFFS2_ZLIB__display
{ JFFS2_ZLIB__display_ref : one Int }
{ one r_JFFS2_ZLIB__display }

lone sig CompressionChoice
{ r_CompressionChoice__display : one CompressionChoice__display
, r_choice : one choice }
{ one r_CompressionChoice
  (some this.@r_CompressionChoice__display) => (((this.@r_CompressionChoice__display).@CompressionChoice__display_ref) = 5)
  some (this.@r_choice).@r_JFFS2_CMODE_PRIORITY }

lone sig CompressionChoice__display
{ CompressionChoice__display_ref : one Int }
{ one r_CompressionChoice__display }

lone sig choice
{ r_JFFS2_CMODE_NONE : lone JFFS2_CMODE_NONE
, r_JFFS2_CMODE_PRIORITY : lone JFFS2_CMODE_PRIORITY
, r_JFFS2_CMODE_SIZE : lone JFFS2_CMODE_SIZE }
{ one r_choice
  let children = (r_JFFS2_CMODE_NONE + r_JFFS2_CMODE_PRIORITY + r_JFFS2_CMODE_SIZE) | one children }

lone sig JFFS2_CMODE_NONE
{ r_JFFS2_CMODE_NONE__display : one JFFS2_CMODE_NONE__display }
{ one r_JFFS2_CMODE_NONE
  (some this.@r_JFFS2_CMODE_NONE__display) => (((this.@r_JFFS2_CMODE_NONE__display).@JFFS2_CMODE_NONE__display_ref) = 6) }

lone sig JFFS2_CMODE_NONE__display
{ JFFS2_CMODE_NONE__display_ref : one Int }
{ one r_JFFS2_CMODE_NONE__display }

lone sig JFFS2_CMODE_PRIORITY
{ r_JFFS2_CMODE_PRIORITY__display : one JFFS2_CMODE_PRIORITY__display }
{ one r_JFFS2_CMODE_PRIORITY
  (some this.@r_JFFS2_CMODE_PRIORITY__display) => (((this.@r_JFFS2_CMODE_PRIORITY__display).@JFFS2_CMODE_PRIORITY__display_ref) = 7) }

lone sig JFFS2_CMODE_PRIORITY__display
{ JFFS2_CMODE_PRIORITY__display_ref : one Int }
{ one r_JFFS2_CMODE_PRIORITY__display }

lone sig JFFS2_CMODE_SIZE
{ r_JFFS2_CMODE_SIZE__display : one JFFS2_CMODE_SIZE__display }
{ one r_JFFS2_CMODE_SIZE
  (some this.@r_JFFS2_CMODE_SIZE__display) => (((this.@r_JFFS2_CMODE_SIZE__display).@JFFS2_CMODE_SIZE__display_ref) = 8) }

lone sig JFFS2_CMODE_SIZE__display
{ JFFS2_CMODE_SIZE__display_ref : one Int }
{ one r_JFFS2_CMODE_SIZE__display }

one sig MTD
{}

one sig CRC32
{}

one sig HAS_IOMEM
{}

