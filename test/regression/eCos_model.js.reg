defaultScope(1);
stringLength(34);

$MISC_FILESYSTEMS = Clafer("MISC_FILESYSTEMS").withCard(0, 1);
$MISC_FILESYSTEMS__display = $MISC_FILESYSTEMS.addChild("MISC_FILESYSTEMS__display").withCard(1, 1);
$CYGPKG_FS_JFFS2 = $MISC_FILESYSTEMS.addChild("CYGPKG_FS_JFFS2").withCard(0, 1);
$CYGPKG_FS_JFFS2__display = $CYGPKG_FS_JFFS2.addChild("CYGPKG_FS_JFFS2__display").withCard(1, 1);
$CYGOPT_FS_JFFS2_DEBUG = $CYGPKG_FS_JFFS2.addChild("CYGOPT_FS_JFFS2_DEBUG").withCard(1, 1);
$CYGOPT_FS_JFFS2_DEBUG__display = $CYGOPT_FS_JFFS2_DEBUG.addChild("CYGOPT_FS_JFFS2_DEBUG__display").withCard(1, 1);
$description = $CYGOPT_FS_JFFS2_DEBUG.addChild("description").withCard(1, 1);
$CYGOPT_FS_JFFS2_NAND = $CYGPKG_FS_JFFS2.addChild("CYGOPT_FS_JFFS2_NAND").withCard(0, 1);
$CYGOPT_FS_JFFS2_COMPRESS = $CYGPKG_FS_JFFS2.addChild("CYGOPT_FS_JFFS2_COMPRESS").withCard(0, 1);
$CYGOPT_FS_JFFS2_COMPRESS__display = $CYGOPT_FS_JFFS2_COMPRESS.addChild("CYGOPT_FS_JFFS2_COMPRESS__display").withCard(1, 1);
$CYGOPT_FS_JFFS2_COMPRESS_ZLIB = $CYGOPT_FS_JFFS2_COMPRESS.addChild("CYGOPT_FS_JFFS2_COMPRESS_ZLIB").withCard(0, 1);
$CYGOPT_FS_JFFS2_COMPRESS_ZLIB__display = $CYGOPT_FS_JFFS2_COMPRESS_ZLIB.addChild("CYGOPT_FS_JFFS2_COMPRESS_ZLIB__display").withCard(1, 1);
$CYGOPT_FS_JFFS2_COMPRESS_CMODE = $CYGOPT_FS_JFFS2_COMPRESS.addChild("CYGOPT_FS_JFFS2_COMPRESS_CMODE").withCard(1, 1);
$CYGOPT_FS_JFFS2_COMPRESS_CMODE__display = $CYGOPT_FS_JFFS2_COMPRESS_CMODE.addChild("CYGOPT_FS_JFFS2_COMPRESS_CMODE__display").withCard(1, 1);
$CYGPKG_CRC = Clafer("CYGPKG_CRC").withCard(1, 1);
$MTD = Clafer("MTD").withCard(1, 1);
$CYGPKG_COMPRESS_ZLIB = Clafer("CYGPKG_COMPRESS_ZLIB").withCard(1, 1);
$HAS_IOMEM = Clafer("HAS_IOMEM").withCard(1, 1);
$MISC_FILESYSTEMS__display.refToUnique(string);
$CYGPKG_FS_JFFS2__display.refToUnique(string);
$CYGOPT_FS_JFFS2_DEBUG.refToUnique(Int);
$CYGOPT_FS_JFFS2_DEBUG__display.refToUnique(string);
$description.refToUnique(string);
$CYGOPT_FS_JFFS2_COMPRESS__display.refToUnique(string);
$CYGOPT_FS_JFFS2_COMPRESS_ZLIB__display.refToUnique(string);
$CYGOPT_FS_JFFS2_COMPRESS_CMODE.refToUnique(string);
$CYGOPT_FS_JFFS2_COMPRESS_CMODE__display.refToUnique(string);
$MISC_FILESYSTEMS.addConstraint(implies(some(join($this(), $MISC_FILESYSTEMS__display)), equal(joinRef(join($this(), $MISC_FILESYSTEMS__display)), constant("\"Miscellaneous filesystems\""))));
$CYGPKG_FS_JFFS2.addConstraint(implies(some(join($this(), $CYGPKG_FS_JFFS2__display)), equal(joinRef(join($this(), $CYGPKG_FS_JFFS2__display)), constant("\"Journalling Flash File System\""))));
$CYGPKG_FS_JFFS2.addConstraint(some(global($CYGPKG_CRC)));
$CYGPKG_FS_JFFS2.addConstraint(some(global($MTD)));
$CYGOPT_FS_JFFS2_DEBUG.addConstraint(equal(joinRef($this()), constant(0)));
$CYGOPT_FS_JFFS2_DEBUG.addConstraint(implies(some(join($this(), $CYGOPT_FS_JFFS2_DEBUG__display)), equal(joinRef(join($this(), $CYGOPT_FS_JFFS2_DEBUG__display)), constant("\"Debug level\""))));
$CYGOPT_FS_JFFS2_DEBUG.addConstraint(and(lessThanEqual(constant(0), joinRef($this())), lessThanEqual(joinRef($this()), constant(2))));
$CYGOPT_FS_JFFS2_DEBUG.addConstraint(implies(some(join($this(), $description)), equal(joinRef(join($this(), $description)), constant("\"Debug verbosity of....\""))));
$CYGPKG_FS_JFFS2.addConstraint(ifOnlyIf(some(join($this(), $CYGOPT_FS_JFFS2_NAND)), some(global($HAS_IOMEM))));
$CYGPKG_FS_JFFS2.addConstraint(some(join($this(), $CYGOPT_FS_JFFS2_COMPRESS)));
$CYGOPT_FS_JFFS2_COMPRESS.addConstraint(implies(some(join($this(), $CYGOPT_FS_JFFS2_COMPRESS__display)), equal(joinRef(join($this(), $CYGOPT_FS_JFFS2_COMPRESS__display)), constant("\"Compress data\""))));
$CYGOPT_FS_JFFS2_COMPRESS.addConstraint(some(join($this(), $CYGOPT_FS_JFFS2_COMPRESS_ZLIB)));
$CYGOPT_FS_JFFS2_COMPRESS_ZLIB.addConstraint(implies(some(join($this(), $CYGOPT_FS_JFFS2_COMPRESS_ZLIB__display)), equal(joinRef(join($this(), $CYGOPT_FS_JFFS2_COMPRESS_ZLIB__display)), constant("\"Compress data using zlib\""))));
$CYGOPT_FS_JFFS2_COMPRESS_ZLIB.addConstraint(some(global($CYGPKG_COMPRESS_ZLIB)));
$CYGOPT_FS_JFFS2_COMPRESS_CMODE.addConstraint(equal(joinRef($this()), constant("\"PRIORITY\"")));
$CYGOPT_FS_JFFS2_COMPRESS_CMODE.addConstraint(implies(some(join($this(), $CYGOPT_FS_JFFS2_COMPRESS_CMODE__display)), equal(joinRef(join($this(), $CYGOPT_FS_JFFS2_COMPRESS_CMODE__display)), constant("\"Set the default compression mode\""))));
$CYGOPT_FS_JFFS2_COMPRESS_CMODE.addConstraint(or(or(equal(joinRef($this()), constant("\"NONE\"")), equal(joinRef($this()), constant("\"PRIORITY\""))), equal(joinRef($this()), constant("\"SIZE\""))));
