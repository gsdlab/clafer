  <div class="indent">
  <span class="keyword">[</span> # <a href="#memberEnd"><span class="reference">memberEnd</span></a> &gt; 2 =&gt; <a href="#memberEnd"><span class="reference">memberEnd</span></a> in <a href="#ownedEnd"><span class="reference">ownedEnd</span></a> <span class="keyword">]</span></div>
</div>


