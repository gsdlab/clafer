defaultScope(1);
stringLength(16);

$A = Clafer("A").withCard(1, 1);
$i = $A.addChild("i").withCard(1, 1);
$i.refToUnique(Int);
$i.addConstraint(equal(joinRef($this()), constant(1)));
$A.addConstraint(equal(joinRef(join($this(), $i)), constant(1)));
$A.addConstraint(equal(joinRef(join($this(), $i)), constant(1)));
