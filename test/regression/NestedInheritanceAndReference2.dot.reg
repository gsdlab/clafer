digraph "NestedInheritanceAndReference2"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Component" [label="abstract Component" URL="#Component" tooltip="abstract Component&#10;  abstract or Port&#10;    input&#10;    output&#10;  abstract TemperaturePort : Port -&gt; integer&#10;"];
"Port" [label="abstract or Port" URL="#Port" tooltip="abstract or Port&#10;  input&#10;  output&#10;"];
"TemperaturePort" [label="abstract TemperaturePort : Port -> integer" URL="#TemperaturePort" tooltip="abstract TemperaturePort : Port -&gt; integer&#10;"];
"TemperatureConnector" [label="abstract TemperatureConnector" URL="#TemperatureConnector" tooltip="abstract TemperatureConnector&#10;  from -&gt; TemperaturePort&#10;    [ this.output ]&#10;  to -&gt; TemperaturePort&#10;    [ this.input ]&#10;  [ to.dref.dref = from.dref.dref ]&#10;"];
"TemperatureConnector" -> "TemperaturePort" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="from"];
"TemperatureConnector" -> "TemperaturePort" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="to"];
"sensor" [label="sensor : Component" URL="#sensor" tooltip="sensor : Component&#10;  temperature : TemperaturePort&#10;    [ output ]&#10;"];
"controller" [label="controller : Component" URL="#controller" tooltip="controller : Component&#10;  temperature : TemperaturePort&#10;    [ input ]&#10;"];
"con1" [label="con1 : TemperatureConnector" URL="#con1" tooltip="con1 : TemperatureConnector&#10;  [ from = sensor.temperature ]&#10;  [ to = controller.temperature ]&#10;"];
}