//# OPTIONS --explicit --core --tl=10
abstract 0..* Val ->> int 0..* {
  [(!(previous (some this))) => (this.dref = 1)] // := each, tmp_initializerClocks.cfr:8:1
}
[(#Val) <= 3] // abstract multiplicity, tmp_initializerClocks.cfr:8:1
abstract 0..* Wal ->> int 0..* {}
[(#Wal) <= 3] // abstract multiplicity, tmp_initializerClocks.cfr:9:1
[(!(previous (some root))) => ((some Wal) => (Wal.dref = 1))] // := together, tmp_initializerClocks.cfr:9:1
0..* Vi : Val 0..* {}
0..* Wi : Wal 0..* {}
[(!(previous (some root))) => ((no Vi) && (no Wi))]
[(F (some Vi)) && (F (some Wi))]
0..* A 1..1 {
  0..* xs ->> int 0..2 {
    [(!(previous (some this))) => (this.dref = 2)] // := each, tmp_initializerClocks.cfr:16:5
  }
  0..* ys ->> int 0..2 {}
  [(!(previous (some this))) => ((some this.ys) => (this.ys.dref = 3))] // := together, tmp_initializerClocks.cfr:17:5
  [F ((#this.xs) = 2)]
}
