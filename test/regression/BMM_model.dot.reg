digraph "BMM_model"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Element" [label="abstract Element" URL="#Element" tooltip="abstract Element&#10;"];
"End" [label="abstract End : Element" URL="#End" tooltip="abstract End : Element&#10;  attainable ?&#10;  xor term&#10;    short&#10;    long&#10;  xor focusedOn&#10;    enterprise&#10;    businessArea&#10;"];
"Mean" [label="abstract Mean : Element" URL="#Mean" tooltip="abstract Mean : Element&#10;"];
"Vision" [label="abstract Vision : End" URL="#Vision" tooltip="abstract Vision : End&#10;  [ enterprise ]&#10;  [ long ]&#10;  amplifiedBy -&gt; Goal +&#10;  madeOperativeBy -&gt; Mission&#10;"];
"Vision" -> "Goal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=amplifiedBy];
"Vision" -> "Mission" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=madeOperativeBy];
"DesiredResult" [label="abstract DesiredResult : End" URL="#DesiredResult" tooltip="abstract DesiredResult : End&#10;  supportedBy -&gt; CourseOfAction +&#10;  xor kind&#10;    qualitative&#10;    quantitative&#10;"];
"DesiredResult" -> "CourseOfAction" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=supportedBy];
"Goal" [label="abstract Goal : DesiredResult" URL="#Goal" tooltip="abstract Goal : DesiredResult&#10;  amplifies -&gt; Vision&#10;  general&#10;  ongoing&#10;  [ businessArea ]&#10;  [ attainable ]&#10;  [ qualitative ]&#10;  [ long ]&#10;"];
"Goal" -> "Vision" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=amplifies];
"Objective" [label="abstract Objective : DesiredResult" URL="#Objective" tooltip="abstract Objective : DesiredResult&#10;  SMART&#10;    specific&#10;    [ attainable ]&#10;    relevant&#10;    timeBound&#10;  limitedInTimeframe&#10;    cyclical ?&#10;  [ businessArea ]&#10;  [ quantitative ]&#10;  [ short ]&#10;  quantifies -&gt; Goal +&#10;"];
"Objective" -> "Goal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=quantifies];
"CourseOfAction" [label="abstract CourseOfAction : Mean" URL="#CourseOfAction" tooltip="abstract CourseOfAction : Mean&#10;  channelsEffortsToward -&gt; DesiredResult&#10;  governedBy -&gt; Directive&#10;  formulatedBasedOn -&gt; Directive&#10;  xor scope&#10;    broad&#10;    narrow&#10;  xor term&#10;    short&#10;    long&#10;  [ broad &amp;&amp; long || narrow &amp;&amp; short ]&#10;  includes -&gt; CourseOfAction *&#10;  enables -&gt; CourseOfAction *&#10;"];
"CourseOfAction" -> "DesiredResult" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=channelsEffortsToward];
"CourseOfAction" -> "Directive" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=governedBy];
"CourseOfAction" -> "Directive" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=formulatedBasedOn];
"CourseOfAction" -> "CourseOfAction" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=includes];
"CourseOfAction" -> "CourseOfAction" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=enables];
"Strategy" [label="abstract Strategy : CourseOfAction" URL="#Strategy" tooltip="abstract Strategy : CourseOfAction&#10;  implementedBy -&gt; Tactic&#10;  aComponentOfThePlanFor -&gt; Mission&#10;  rightApproachGiven&#10;"];
"Strategy" -> "Tactic" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=implementedBy];
"Strategy" -> "Mission" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=aComponentOfThePlanFor];
"Tactic" [label="abstract Tactic : CourseOfAction" URL="#Tactic" tooltip="abstract Tactic : CourseOfAction&#10;  implements -&gt; Strategy&#10;  effectsEnforcementLevelOf -&gt; BusinessRule&#10;"];
"Tactic" -> "Strategy" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=implements];
"Tactic" -> "BusinessRule" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=effectsEnforcementLevelOf];
"Mission" [label="abstract Mission : Mean" URL="#Mission" tooltip="abstract Mission : Mean&#10;  makesOperative -&gt; Vision&#10;  plannedByMeansOf -&gt; Strategy&#10;"];
"Mission" -> "Vision" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=makesOperative];
"Mission" -> "Strategy" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=plannedByMeansOf];
"Directive" [label="abstract Directive : Mean" URL="#Directive" tooltip="abstract Directive : Mean&#10;  governs -&gt; CourseOfAction&#10;  sourceOf -&gt; CourseOfAction&#10;  supportsTheAchievementOf -&gt; DesiredResult&#10;  xor influencesAspectOfEnterprise&#10;    defines&#10;    constraints&#10;    liberates&#10;    asserts&#10;    controls&#10;  declarative&#10;  actsAs -&gt; Regulation&#10;  xor degreeOfStructure&#10;    lessStructured&#10;    highlyStructured&#10;  xor granularity&#10;    lessDiscreteAndComposite&#10;    discreteAndAtomic&#10;  actionable ?&#10;  automatable ?&#10;"];
"Directive" -> "CourseOfAction" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=governs];
"Directive" -> "CourseOfAction" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=sourceOf];
"Directive" -> "DesiredResult" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=supportsTheAchievementOf];
"Directive" -> "Regulation" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=actsAs];
"BusinessPolicy" [label="abstract BusinessPolicy : Directive" URL="#BusinessPolicy" tooltip="abstract BusinessPolicy : Directive&#10;  providesBasisFor -&gt; BusinessRule +&#10;  governs -&gt; CourseOfAction *&#10;    control&#10;    guide&#10;    shape&#10;  [ lessStructured ]&#10;  [ lessDiscreteAndComposite ]&#10;  [  ! actionable ]&#10;  [  ! automatable ]&#10;  includes -&gt; BusinessPolicy *&#10;"];
"BusinessPolicy" -> "BusinessRule" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=providesBasisFor];
"BusinessPolicy" -> "CourseOfAction" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=governs];
"BusinessPolicy" -> "BusinessPolicy" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=includes];
"BusinessRule" [label="abstract BusinessRule : Directive" URL="#BusinessRule" tooltip="abstract BusinessRule : Directive&#10;  [ all o : supportsTheAchievementOf | o.ref in Objective ]&#10;  xor enforcementLevel&#10;    strictlyEnforced&#10;    deferredEnforcement&#10;    preAuthorizedOverride&#10;    postJustifiedOverride&#10;    overrideWithExplanation&#10;    guideline&#10;  hasEnforcementLevelEffectedBy -&gt; Tactic&#10;  [ highlyStructured ]&#10;  [ discreteAndAtomic ]&#10;  [ actionable ]&#10;  expressedUsingStandardBusinessVocabulary&#10;"];
"BusinessRule" -> "Tactic" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=hasEnforcementLevelEffectedBy];
"Regulation" [label="abstract Regulation : Element" URL="#Regulation" tooltip="abstract Regulation : Element&#10;  aRolePlayedBy -&gt; Directive&#10;"];
"Regulation" -> "Directive" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=aRolePlayedBy];
"Influencer" [label="abstract or Influencer : Element" URL="#Influencer" tooltip="abstract or Influencer : Element&#10;  or externalInfluencer&#10;    environment&#10;    technology&#10;    regulation&#10;      xor prescribedBy&#10;        government&#10;        management&#10;    supplier&#10;      xor provides&#10;        products&#10;        services&#10;    customer&#10;      xor productsOrServices&#10;        investigated&#10;        ordered&#10;        received&#10;        paidFor&#10;    competitor&#10;    partner&#10;  or internalInfluencer&#10;    infrastructure&#10;    issue&#10;    assumption&#10;    resource&#10;    habit&#10;    managementPrerogative&#10;    xor corporateValue&#10;      explicitCorporateValue&#10;      implicitCorporateValue&#10;"];
"Assessment" [label="abstract Assessment : Element" URL="#Assessment" tooltip="abstract Assessment : Element&#10;  identifies -&gt; PotentialImpact&#10;  about -&gt; Influencer&#10;  or affects&#10;    employmentOf -&gt; Mean +&#10;    achievementOf -&gt; End +&#10;  madeBy -&gt; OrganizationUnit&#10;  uses -&gt; Assessment *&#10;  xor SWOT&#10;    strength&#10;    weakness&#10;    opportunity&#10;    threat&#10;"];
"Assessment" -> "PotentialImpact" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=identifies];
"Assessment" -> "Influencer" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=about];
"Assessment" -> "Mean" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=employmentOf];
"Assessment" -> "End" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=achievementOf];
"Assessment" -> "OrganizationUnit" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=madeBy];
"Assessment" -> "Assessment" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=uses];
"PotentialImpact" [label="abstract PotentialImpact : Element" URL="#PotentialImpact" tooltip="abstract PotentialImpact : Element&#10;  significantTo -&gt; Assessment&#10;  providesImpetusFor -&gt; Directive&#10;  xor type&#10;    risk&#10;      probabilityOfLoss -&gt; integer&#10;      potentialLoss -&gt; integer&#10;      unitOfMeasure -&gt; Currency&#10;    potentialReward&#10;      probabilityOfGain -&gt; integer&#10;      potentialGain -&gt; integer&#10;      unitOfMeasure -&gt; Currency&#10;"];
"PotentialImpact" -> "Assessment" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=significantTo];
"PotentialImpact" -> "Directive" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=providesImpetusFor];
"PotentialImpact" -> "Currency" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=unitOfMeasure];
"PotentialImpact" -> "Currency" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=unitOfMeasure];
"Metric" [label="abstract Metric : Element" URL="#Metric" tooltip="abstract Metric : Element&#10;"];
"KeyPerformanceIndicator" [label="abstract KeyPerformanceIndicator : Metric" URL="#KeyPerformanceIndicator" tooltip="abstract KeyPerformanceIndicator : Metric&#10;"];
"CriticalSuccessFactor" [label="abstract CriticalSuccessFactor : Metric" URL="#CriticalSuccessFactor" tooltip="abstract CriticalSuccessFactor : Metric&#10;"];
"OrganizationUnit" [label="abstract OrganizationUnit" URL="#OrganizationUnit" tooltip="abstract OrganizationUnit&#10;"];
"BusinessProcess" [label="abstract BusinessProcess" URL="#BusinessProcess" tooltip="abstract BusinessProcess&#10;"];
}