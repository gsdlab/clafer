<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/group_children_optionality.cfr</div>

<div>
2..3 <span class="claferDecl" id="A">A</span>
  <div class="indent">
  <span class="claferDecl" id="b">b</span></div>
  <div class="indent">
  <span class="claferDecl" id="c">c</span> 1</div>
  <div class="indent">
  <span class="claferDecl" id="d">d</span></div>
</div>


<div>
<span class="keyword">xor</span> <span class="claferDecl" id="E">E</span>
  <div class="indent">
  <span class="claferDecl" id="f">f</span></div>
  <div class="indent">
  <span class="claferDecl" id="g">g</span></div>
</div>


<div>
<span class="keyword">assert [</span> <a href="#f"><span class="reference">f</span></a> &#124;&#124; <a href="#g"><span class="reference">g</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span>  ! (<a href="#f"><span class="reference">f</span></a> &amp;&amp; <a href="#g"><span class="reference">g</span></a>) <span class="keyword">]</span></div>


<div>
<span class="claferDecl" id="D">D</span>
  <div class="indent">
  <span class="claferDecl" id="Z">Z</span></div>
  <div class="indent">
  <span class="claferDecl" id="K">K</span> ?</div>
</div>


<div>
<span class="keyword">assert [</span> <span class="keyword">one</span> <a href="#D"><span class="reference">D</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> <span class="keyword">one</span> <a href="#Z"><span class="reference">Z</span></a> <span class="keyword">]</span></div>


<div>
0..* <span class="claferDecl" id="L">L</span>
  <div class="indent">
  <span class="claferDecl" id="M">M</span></div>
  <div class="indent">
  <span class="claferDecl" id="N">N</span></div>
</div>

</body>
</html>