open util/integer
pred show {}


abstract sig root__options
{ r_options__size : one options__size
, r_cache : lone cache }
{ ((some (this.@r_options__size).@r_options__size__small) && (some this.@r_cache)) => (some ((this.@r_cache).@r_cache__size).@r_fixed) }

sig options__size
{ r_options__size__small : lone options__size__small
, r_options__size__large : lone options__size__large }
{ one @r_options__size.this
  let children = (r_options__size__small + r_options__size__large) | one children }

sig options__size__small
{}
{ one @r_options__size__small.this }

sig options__size__large
{}
{ one @r_options__size__large.this }

sig cache
{ r_cache__size : one cache__size }
{ one @r_cache.this }

sig cache__size
{ cache__size_ref : one Int
, r_fixed : lone fixed }
{ one @r_cache__size.this }

sig fixed
{}
{ one @r_fixed.this }

abstract sig comp
{ r_version : one version }
{ (some this.@r_version) => (((this.@r_version).@version_ref) = (1.plus[2])) }

sig version
{ version_ref : one Int }
{ one @r_version.this }

abstract sig ECU extends comp
{}

abstract sig root__display extends comp
{ r_server : one server
, r_display__options : one display__options }
{ ((this.@r_version).@version_ref) >= ((((this.@r_server).@server_ref).@r_version).@version_ref) }

sig server
{ server_ref : one ECU }
{ one @r_server.this }

sig display__options extends root__options
{}
{ one @r_display__options.this }

abstract sig plaECU extends ECU
{ r_plaECU__display : set plaECU__display }
{ 1 <= #r_plaECU__display and #r_plaECU__display <= 2 }

sig plaECU__display extends root__display
{}
{ one @r_plaECU__display.this
  (((this.@r_server).@server_ref) = (this.~@r_plaECU__display)) && (no (this.@r_display__options).@r_cache) }

one sig ECU1 extends plaECU
{}

lone sig ECU2 extends plaECU
{ r_master : one master }

lone sig master
{ master_ref : one ECU1 }
{ one r_master }

one sig telematicsSystem
{ r_channel : one channel
, r_extraDisplay : lone extraDisplay
, r_telematicsSystem__size : one telematicsSystem__size }
{ (((((some (this.@r_channel).@r_dual) <=> (some ECU2)) && ((some this.@r_extraDisplay) <=> ((#(ECU1.@r_plaECU__display)) = 2))) && ((some this.@r_extraDisplay) <=> ((some ECU2) => ((#(ECU2.@r_plaECU__display)) = 2)))) && ((some (this.@r_telematicsSystem__size).@r_telematicsSystem__size__large) <=> (no (((plaECU.@r_plaECU__display).@r_display__options).@r_options__size).@r_options__size__small))) && ((some (this.@r_telematicsSystem__size).@r_telematicsSystem__size__small) <=> (no (((plaECU.@r_plaECU__display).@r_display__options).@r_options__size).@r_options__size__large)) }

one sig channel
{ r_single : lone single
, r_dual : lone dual }
{ let children = (r_single + r_dual) | one children }

lone sig single
{}
{ one r_single }

lone sig dual
{}
{ one r_dual }

lone sig extraDisplay
{}
{ one r_extraDisplay }

one sig telematicsSystem__size
{ r_telematicsSystem__size__small : lone telematicsSystem__size__small
, r_telematicsSystem__size__large : lone telematicsSystem__size__large }
{ let children = (r_telematicsSystem__size__small + r_telematicsSystem__size__large) | one children }

lone sig telematicsSystem__size__small
{}
{ one r_telematicsSystem__size__small }

lone sig telematicsSystem__size__large
{}
{ one r_telematicsSystem__size__large }

fact { ((some (telematicsSystem.@r_channel).@r_dual) && (some telematicsSystem.@r_extraDisplay)) && (some (telematicsSystem.@r_telematicsSystem__size).@r_telematicsSystem__size__large) }
