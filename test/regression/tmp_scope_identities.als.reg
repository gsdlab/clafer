open util/integer
pred show {}


one sig root
{ var r_c0_item : set c0_item }
fact { all self_ : root | always (one self_.@r_c0_item) }
fact { all self_ : root | always ((not before some root) implies (all  x : alive_c0_item | after (no x & alive_c0_item))) }


sig c0_item
{ p_c0_item : lone root }
fun alive_c0_item : set c0_item { root.@r_c0_item }
fact { always ~@r_c0_item in @p_c0_item }


