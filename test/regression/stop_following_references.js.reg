defaultScope(1);
stringLength(16);

$A = Abstract("A");
$A__b = $A.addChild("A__b").withCard(0, 1);
$A1 = Clafer("A1").withCard(1, 1);
$C = Clafer("C").withCard(1, 1);
$C__b = $C.addChild("C__b").withCard(0, 1);
$a = $C.addChild("a").withCard(1, 1);
$d = $a.addChild("d").withCard(1, 1);
$d__b = $d.addChild("d__b").withCard(0, 1);
$A1.extending($A);
$a.refToUnique($A);
$A1.addConstraint(none(join($this(), $A__b)));
$C.addConstraint(some(join(global($C), $C__b)));
$a.addConstraint(some(join(join($this(), $d), $d__b)));
