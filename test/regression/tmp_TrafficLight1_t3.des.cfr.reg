//# OPTIONS --explicit --tl=10
abstract 1..1 TrafficLight_1 0..* {
  initial 1..1 on 0..1 {
    [((#this) >= 1) => (((#this) >= 1) U ((#this . parent . off) >= 1))]
    initial 1..1 normal 0..1 {
      initial 0..* green 0..1 {
        [((#this) >= 1) => (X ((#this . parent . yellow) >= 1))]
      }
      0..* yellow 0..1 {
        [((#this) >= 1) => (X ((#this . parent . red) >= 1))]
      }
      0..* red 0..1 {
        [((#this) >= 1) => (X ((#this . parent . green) >= 1))]
      }
    }
    1..1 flashing 0..1 {
      [((#this) >= 1) => (((#this) >= 1) U ((#this . parent . normal) >= 1))]
      initial 0..* yellow_on 0..1 {
        [((#this) >= 1) => (X ((#this . parent . yellow_off) >= 1))]
      }
      0..* yellow_off 0..1 {
        [((#this) >= 1) => (X ((#this . parent . yellow_on) >= 1))]
      }
    }
  }
  0..* off 0..1 {
    [((#this) >= 1) => (X ((#this . parent . on) >= 1))]
  }
}
1..1 t3 : TrafficLight_1 1..1 {
  [initially (((#this . on) >= 1) => ((((#this) >= 1) && ((#this . on) >= 1)) U (((#this . on . flashing . yellow_off) >= 1) && (X (((#this . on . flashing . yellow_on) >= 1) && (X ((#this . on . flashing . yellow_off) >= 1)))))))]
}
