scope({$Course:2, $TA:2, $assistants:4, $first:2});
defaultScope(1);
stringLength(16);

$Course = Abstract("Course");
$assistants = $Course.addChild("assistants");
$TA = Abstract("TA");
$first = $TA.addChild("first").withCard(0, 1);
$CompilerGradStudent = Clafer("CompilerGradStudent").withCard(1, 1);
$AIGradStudent = Clafer("AIGradStudent").withCard(1, 1);
$CompilerCourse = Clafer("CompilerCourse").withCard(1, 1);
$MachineLearningCourse = Clafer("MachineLearningCourse").withCard(1, 1);
$numerOfAssistants = Clafer("numerOfAssistants").withCard(1, 1);
$assistants.refToUnique($TA);
$first.refToUnique($Course);
$first.addConstraint($in(joinParent($this()), joinRef(join(joinRef($this()), $assistants))));
$CompilerGradStudent.extending($TA);
$AIGradStudent.extending($TA);
$CompilerCourse.extending($Course);
$MachineLearningCourse.extending($Course);
Constraint(equal(joinRef(join(global($CompilerGradStudent), $first)), global($CompilerCourse)));
Constraint(equal(joinRef(join(global($AIGradStudent), $first)), global($MachineLearningCourse)));
$numerOfAssistants.refToUnique(Int);
Constraint(implies(some(global($numerOfAssistants)), equal(joinRef(global($numerOfAssistants)), card(join(global($Course), $assistants)))));
