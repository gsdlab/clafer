<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/ACCDemo_fullClafer.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="car">car</span>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="transmission">transmission</span>
    <div class="indent">
    <span class="claferDecl" id="automatic">automatic</span></div>
    <div class="indent">
    <span class="claferDecl" id="manual">manual</span></div>
  </div>
  <div class="indent">
  `<a href="#root__fca"><span class="reference">fca</span></a> ?</div>
  <div class="indent">
  `<a href="#root__cc"><span class="reference">cc</span></a></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#acc"><span class="reference">acc</span></a> =&gt; <a href="#car__fca"><span class="reference">fca</span></a> <span class="keyword">]</span></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="root__fca">fca</span>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="sensor">sensor</span>
    <div class="indent">
    <span class="claferDecl" id="radar">radar</span></div>
    <div class="indent">
    <span class="claferDecl" id="lidar">lidar</span></div>
  </div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="root__cc">cc</span>
  <div class="indent">
  <span class="claferDecl" id="switches">switches</span> 2..3
    <div class="indent">
    <span class="claferDecl" id="backlight">backlight</span> ?</div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="acc">acc</span> ?</div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="camaro">camaro</span><span class="keyword"> : </span><a href="#car"><span class="reference">car</span></a>
  <div class="indent">
  <span class="keyword">[</span> all s<span class="keyword"> : </span><a href="#switches"><span class="reference">switches</span></a> | <a href="#s"><span class="reference">s</span></a>.<a href="#backlight"><span class="reference">backlight</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="transformer">transformer</span> ?
    <div class="indent">
    <span class="keyword">[</span> # <a href="#switches"><span class="reference">switches</span></a> = 3 <span class="keyword">]</span></div>
  </div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="claferDecl" id="bumbleBee">bumbleBee</span><span class="keyword"> : </span><a href="#camaro"><span class="reference">camaro</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#transformer"><span class="reference">transformer</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#manual"><span class="reference">manual</span></a> <span class="keyword">]</span></div>
</div>

</body>
</html>