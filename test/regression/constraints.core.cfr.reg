//# OPTIONS --explicit --core
abstract 0..* Phone 0..* {
  0..* networking 1..1 {
    0..* wifi 0..1 {
      0..* typeB 0..1 {}
      0..* typeG 0..1 {}
      0..* typeN 0..1 {}
    }
    0..* bluetooth 0..1 {}
    0..* mobile 0..1 {}
    0..* nfc 0..1 {}
  }
  1..1 location 0..1 {
    0..* gps 0..1 {}
    0..* agps 0..1 {}
  }
  0..* gpu 0..* {}
}
0..* PhoneWithGps : Phone 1..1 {
  [some this.location.gps]
}
0..* PhoneWithWifi : Phone 1..1 {
  [some this.networking.wifi.typeN]
}
0..* PhonewithWifiAndGpsNoBluetoothOrNfc : Phone 1..1 {
  [((some this.networking.wifi) && (some this.location.gps)) && (!((some this.networking.bluetooth) || (some this.networking.nfc)))]
}
0..* PhoneWithGpu : Phone 1..1 {
  [some this.gpu]
}
[all p : Phone | some p.networking.mobile]
