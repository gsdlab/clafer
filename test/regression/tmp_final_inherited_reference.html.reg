<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_final_inherited_reference.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Engine">Engine</span></div>


<div>
<span class="claferDecl" id="c0_gas">gas</span><span class="keyword"> : </span><a href="#c0_Engine"><span class="reference">Engine</span></a></div>


<div>
<span class="claferDecl" id="c0_electric">electric</span><span class="keyword"> : </span><a href="#c0_Engine"><span class="reference">Engine</span></a></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Car">Car</span>
  <div class="indent">
  <span class="keyword">abstract</span> <span class="claferDecl" id="c0_engine">engine</span><span class="keyword"> -> </span><a href="#c0_Engine"><span class="reference">Engine</span></a></div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="c0_gear">gear</span>
    <div class="indent">
    <span class="tKeyword">initial</span> <span class="claferDecl" id="c0_park">park</span><span class="tKeyword"> --&gt; </span><a href="#c0_drive"><span class="reference">drive</span></a></div>
    <div class="indent">
    <span class="claferDecl" id="c0_drive">drive</span></div>
  </div>
</div>


<div>
<span class="claferDecl" id="c0_tesla">tesla</span><span class="keyword"> : </span><a href="#c0_Car"><span class="reference">Car</span></a>
  <div class="indent">
  <span class="tKeyword">final</span> <span class="claferDecl" id="c0_motor">motor</span><span class="keyword"> : </span><a href="#c0_engine"><span class="reference">engine</span></a></div>
</div>


<div>
<span class="claferDecl" id="c0_leaf">leaf</span><span class="keyword"> : </span><a href="#c0_Car"><span class="reference">Car</span></a>
  <div class="indent">
  <span class="tKeyword">finalref</span> <span class="claferDecl" id="c0_motor2">motor2</span><span class="keyword"> : </span><a href="#c0_engine"><span class="reference">engine</span></a></div>
</div>


<div>
<span class="claferDecl" id="c0_bolt">bolt</span><span class="keyword"> : </span><a href="#c0_Car"><span class="reference">Car</span></a>
  <div class="indent">
  <span class="tKeyword">finaltarget</span> <span class="claferDecl" id="c0_motor3">motor3</span><span class="keyword"> : </span><a href="#c0_engine"><span class="reference">engine</span></a></div>
</div>


<div>
<span class="claferDecl" id="c0_mini">mini</span><span class="keyword"> : </span><a href="#c0_Car"><span class="reference">Car</span></a>
  <div class="indent">
  <span class="claferDecl" id="c0_motor4">motor4</span><span class="keyword"> : </span><a href="#c0_engine"><span class="reference">engine</span></a></div>
</div>


<div>
<span class="keyword">assert [</span> <a href="#c0_tesla"><span class="reference">tesla</span></a>.<a href="#c0_motor"><span class="reference">motor</span></a> = <a href="#c0_gas"><span class="reference">gas</span></a> =&gt; G <a href="#c0_tesla"><span class="reference">tesla</span></a>.<a href="#c0_motor"><span class="reference">motor</span></a> = <a href="#c0_gas"><span class="reference">gas</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> <a href="#c0_leaf"><span class="reference">leaf</span></a>.<a href="#c0_motor2"><span class="reference">motor2</span></a> = <a href="#c0_gas"><span class="reference">gas</span></a> =&gt; G <a href="#c0_leaf"><span class="reference">leaf</span></a>.<a href="#c0_motor2"><span class="reference">motor2</span></a> = <a href="#c0_gas"><span class="reference">gas</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> <a href="#c0_bolt"><span class="reference">bolt</span></a>.<a href="#c0_motor3"><span class="reference">motor3</span></a> = <a href="#c0_gas"><span class="reference">gas</span></a> =&gt; G <a href="#c0_bolt"><span class="reference">bolt</span></a>.<a href="#c0_motor3"><span class="reference">motor3</span></a> = <a href="#c0_gas"><span class="reference">gas</span></a> <span class="keyword">]</span></div>

</body>
</html>