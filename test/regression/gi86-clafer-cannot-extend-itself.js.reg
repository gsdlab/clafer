defaultScope(1);
stringLength(16);

$FunctionalArchitecture = Abstract("FunctionalArchitecture");
$Deployment = Abstract("Deployment");
$Deployment__fa = $Deployment.addAbstractChild("Deployment__fa");
$PowerWindowFAA = Abstract("PowerWindowFAA");
$PowerWindowDpl = Abstract("PowerWindowDpl");
$PowerWindowDpl__fa = $PowerWindowDpl.addAbstractChild("PowerWindowDpl__fa");
$System = Clafer("System").withCard(1, 1);
$DriverPowerWindowFAA = $System.addChild("DriverPowerWindowFAA").withCard(1, 1);
$DriverPowerWindowDpl = $System.addChild("DriverPowerWindowDpl").withCard(1, 1);
$DriverPowerWindowDpl__fa = $DriverPowerWindowDpl.addChild("DriverPowerWindowDpl__fa").withCard(1, 1);
$Deployment__fa.refToUnique($FunctionalArchitecture);
$PowerWindowFAA.extending($FunctionalArchitecture);
$PowerWindowDpl.extending($Deployment);
$PowerWindowDpl__fa.extending($Deployment__fa).refToUnique($PowerWindowFAA);
$DriverPowerWindowFAA.extending($PowerWindowFAA);
$DriverPowerWindowDpl.extending($PowerWindowDpl);
$DriverPowerWindowDpl__fa.extending($PowerWindowDpl__fa).refToUnique($DriverPowerWindowFAA);
