open util/integer
pred show {}


abstract sig Person
{}

one sig ada extends Person
{}

one sig cyd extends Person
{}

one sig eve extends Person
{}

one sig bob extends Person
{}

one sig dan extends Person
{}

abstract sig Exam
{ r_date : one date
, r_recorder : one recorder
, r_examiner : one examiner
, r_examinee : one examinee }

sig date
{ date_ref : one Int }
{ one @r_date.this
  (this.@date_ref) != 0 }

sig recorder
{ recorder_ref : one Person }
{ one @r_recorder.this }

sig examiner
{ examiner_ref : one Person }
{ one @r_examiner.this }

sig examinee
{ examinee_ref : one Person }
{ one @r_examinee.this }

one sig ada_bob_cyd extends Exam
{}
{ (((((this.@r_date).@date_ref) = 1) && (((this.@r_recorder).@recorder_ref) = cyd)) && (((this.@r_examiner).@examiner_ref) = bob)) && (((this.@r_examinee).@examinee_ref) = ada) }

one sig dan_bob_ada extends Exam
{}
{ (((((this.@r_date).@date_ref) = 2) && (((this.@r_recorder).@recorder_ref) = ada)) && (((this.@r_examiner).@examiner_ref) = bob)) && (((this.@r_examinee).@examinee_ref) = dan) }

one sig eve_ada_dan extends Exam
{}
{ (((((this.@r_date).@date_ref) = 3) && (((this.@r_recorder).@recorder_ref) = dan)) && (((this.@r_examiner).@examiner_ref) = ada)) && (((this.@r_examinee).@examinee_ref) = eve) }

sig examineeAda
{ examineeAda_ref : one Exam }
{ (((this.@examineeAda_ref).@r_examinee).@examinee_ref) = ada }

fact {  all disj x, y : examineeAda | (x.@examineeAda_ref) != (y.@examineeAda_ref)  }
fact { all  e : Exam | (((e.@r_examinee).@examinee_ref) = ada) => (e in (examineeAda.@examineeAda_ref)) }
sig recorderAda
{ recorderAda_ref : one Exam }
{ (((this.@recorderAda_ref).@r_recorder).@recorder_ref) = ada }

fact {  all disj x, y : recorderAda | (x.@recorderAda_ref) != (y.@recorderAda_ref)  }
fact { all  e : Exam | (((e.@r_recorder).@recorder_ref) = ada) => (e in (recorderAda.@recorderAda_ref)) }
sig examinerAda
{ examinerAda_ref : one Exam }
{ (((this.@examinerAda_ref).@r_examiner).@examiner_ref) = ada }

fact {  all disj x, y : examinerAda | (x.@examinerAda_ref) != (y.@examinerAda_ref)  }
fact { all  e : Exam | (((e.@r_examiner).@examiner_ref) = ada) => (e in (examinerAda.@examinerAda_ref)) }
sig examineeOfAdaAsExaminer
{ examineeOfAdaAsExaminer_ref : one Person }
{ one  e : Exam | (((e.@r_examiner).@examiner_ref) = ada) && (((e.@r_examinee).@examinee_ref) = (this.@examineeOfAdaAsExaminer_ref)) }

fact {  all disj x, y : examineeOfAdaAsExaminer | (x.@examineeOfAdaAsExaminer_ref) != (y.@examineeOfAdaAsExaminer_ref)  }
fact { all  e : Exam | (((e.@r_examiner).@examiner_ref) = ada) => (((e.@r_examinee).@examinee_ref) in (examineeOfAdaAsExaminer.@examineeOfAdaAsExaminer_ref)) }
sig examineeOfAdaAsRecorder
{ examineeOfAdaAsRecorder_ref : one Person }
{ one  e : Exam | (((e.@r_recorder).@recorder_ref) = ada) && (((e.@r_examinee).@examinee_ref) = (this.@examineeOfAdaAsRecorder_ref)) }

fact {  all disj x, y : examineeOfAdaAsRecorder | (x.@examineeOfAdaAsRecorder_ref) != (y.@examineeOfAdaAsRecorder_ref)  }
fact { all  e : Exam | (((e.@r_recorder).@recorder_ref) = ada) => (((e.@r_examinee).@examinee_ref) in (examineeOfAdaAsRecorder.@examineeOfAdaAsRecorder_ref)) }
sig examinerOfAdaAsExaminee
{ examinerOfAdaAsExaminee_ref : one Person }
{ one  e : Exam | (((e.@r_examinee).@examinee_ref) = ada) && (((e.@r_examiner).@examiner_ref) = (this.@examinerOfAdaAsExaminee_ref)) }

fact {  all disj x, y : examinerOfAdaAsExaminee | (x.@examinerOfAdaAsExaminee_ref) != (y.@examinerOfAdaAsExaminee_ref)  }
fact { all  e : Exam | (((e.@r_examinee).@examinee_ref) = ada) => (((e.@r_examiner).@examiner_ref) in (examinerOfAdaAsExaminee.@examinerOfAdaAsExaminee_ref)) }
sig examinerOfAdaAsRecorder
{ examinerOfAdaAsRecorder_ref : one Person }
{ one  e : Exam | (((e.@r_recorder).@recorder_ref) = ada) && (((e.@r_examiner).@examiner_ref) = (this.@examinerOfAdaAsRecorder_ref)) }

fact {  all disj x, y : examinerOfAdaAsRecorder | (x.@examinerOfAdaAsRecorder_ref) != (y.@examinerOfAdaAsRecorder_ref)  }
fact { all  e : Exam | (((e.@r_recorder).@recorder_ref) = ada) => (((e.@r_examiner).@examiner_ref) in (examinerOfAdaAsRecorder.@examinerOfAdaAsRecorder_ref)) }
sig recorderOfAdaAsExaminee
{ recorderOfAdaAsExaminee_ref : one Person }
{ one  e : Exam | (((e.@r_examinee).@examinee_ref) = ada) && (((e.@r_recorder).@recorder_ref) = (this.@recorderOfAdaAsExaminee_ref)) }

fact {  all disj x, y : recorderOfAdaAsExaminee | (x.@recorderOfAdaAsExaminee_ref) != (y.@recorderOfAdaAsExaminee_ref)  }
fact { all  e : Exam | (((e.@r_examinee).@examinee_ref) = ada) => (((e.@r_recorder).@recorder_ref) in (recorderOfAdaAsExaminee.@recorderOfAdaAsExaminee_ref)) }
sig recorderOfAdaAsExaminer
{ recorderOfAdaAsExaminer_ref : one Person }
{ one  e : Exam | (((e.@r_examiner).@examiner_ref) = ada) && (((e.@r_recorder).@recorder_ref) = (this.@recorderOfAdaAsExaminer_ref)) }

fact {  all disj x, y : recorderOfAdaAsExaminer | (x.@recorderOfAdaAsExaminer_ref) != (y.@recorderOfAdaAsExaminer_ref)  }
fact { all  e : Exam | (((e.@r_examiner).@examiner_ref) = ada) => (((e.@r_recorder).@recorder_ref) in (recorderOfAdaAsExaminer.@recorderOfAdaAsExaminer_ref)) }
