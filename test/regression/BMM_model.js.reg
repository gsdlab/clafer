$Vision.addConstraint(some(join(join($this(), $focusedOn), $enterprise)));
$Vision.addConstraint(some(join(join($this(), $End__term), $End__term__long)));
$Goal.addConstraint(some(join(join($this(), $focusedOn), $businessArea)));
$Goal.addConstraint(some(join($this(), $attainable)));
$Goal.addConstraint(some(join(join($this(), $kind), $qualitative)));
$Goal.addConstraint(some(join(join($this(), $End__term), $End__term__long)));
$SMART.addConstraint(some(join(joinParent($this()), $attainable)));
$Objective.addConstraint(some(join(join($this(), $focusedOn), $businessArea)));
$Objective.addConstraint(some(join(join($this(), $kind), $quantitative)));
$Objective.addConstraint(some(join(join($this(), $End__term), $End__term__short)));
$CourseOfAction.addConstraint(or(and(some(join(join($this(), $scope), $broad)), some(join(join($this(), $CourseOfAction__term), $CourseOfAction__term__long))), and(some(join(join($this(), $scope), $narrow)), some(join(join($this(), $CourseOfAction__term), $CourseOfAction__term__short)))));
$BusinessPolicy.addConstraint(some(join(join($this(), $degreeOfStructure), $lessStructured)));
$BusinessPolicy.addConstraint(some(join(join($this(), $granularity), $lessDiscreteAndComposite)));
$BusinessPolicy.addConstraint(none(join($this(), $actionable)));
$BusinessPolicy.addConstraint(none(join($this(), $automatable)));
$BusinessRule.addConstraint(all([decl([$_o = local("o")], join($this(), $supportsTheAchievementOf))], $in(joinRef($_o), global($Objective))));
$BusinessRule.addConstraint(some(join(join($this(), $degreeOfStructure), $highlyStructured)));
$BusinessRule.addConstraint(some(join(join($this(), $granularity), $discreteAndAtomic)));
$BusinessRule.addConstraint(some(join($this(), $actionable)));
