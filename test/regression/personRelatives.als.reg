open util/integer
pred show {}


abstract sig Person
{ r_age : one age
, r_maritalStatus : one maritalStatus
, r_childs : set childs
, r_parents : set parents }
{ all disj x, y : this.@r_childs | (x.@childs_ref) != (y.@childs_ref) 
  #r_parents <= 2
  all disj x, y : this.@r_parents | (x.@parents_ref) != (y.@parents_ref)  }

sig age
{ age_ref : one Int }
{ one @r_age.this
  (this.@age_ref) >= 0 }

sig maritalStatus
{ r_neverMarried : lone neverMarried
, r_married : lone married
, r_divorced : lone divorced }
{ one @r_maritalStatus.this
  let children = (r_neverMarried + r_married + r_divorced) | one children
  ((some this.@r_married) || (some this.@r_divorced)) => ((((this.~@r_maritalStatus).@r_age).@age_ref) >= 5) }

sig neverMarried
{}
{ one @r_neverMarried.this }

sig married
{ r_spouse : one spouse }
{ one @r_married.this
  ((this.@r_spouse).@spouse_ref) != ((this.~@r_married).~@r_maritalStatus) }

sig spouse
{ spouse_ref : one Person }
{ one @r_spouse.this
  (((((this.@spouse_ref).@r_maritalStatus).@r_married).@r_spouse).@spouse_ref) = (((this.~@r_spouse).~@r_married).~@r_maritalStatus) }

sig divorced
{}
{ one @r_divorced.this }

sig childs
{ childs_ref : one Person }
{ one @r_childs.this
  (this.~@r_childs) in (((this.@childs_ref).@r_parents).@parents_ref)
  (((((this.~@r_childs).@r_maritalStatus).@r_married).@r_spouse).@spouse_ref) in (((this.@childs_ref).@r_parents).@parents_ref)
  (((this.@childs_ref).@r_age).@age_ref) < (((this.~@r_childs).@r_age).@age_ref) }

sig parents
{ parents_ref : one Person }
{ one @r_parents.this
  (this.~@r_parents) in (((this.@parents_ref).@r_childs).@childs_ref) }

one sig Alice extends Person
{}
{ ((this.@r_age).@age_ref) = 6
  ((((this.@r_maritalStatus).@r_married).@r_spouse).@spouse_ref) = Bob }

fact { ((Person.@r_childs).@childs_ref) = Carol }
one sig Bob extends Person
{}

assert assertAt_28_10 { ((Bob.@r_age).@age_ref) >= 5 }
check assertAt_28_10 for 1 but 3 Person, 3 age, 9 childs, 3 divorced, 3 maritalStatus, 3 married, 3 neverMarried, 6 parents, 3 spouse

assert assertAt_29_10 { ((((Bob.@r_maritalStatus).@r_married).@r_spouse).@spouse_ref) = Alice }
check assertAt_29_10 for 1 but 3 Person, 3 age, 9 childs, 3 divorced, 3 maritalStatus, 3 married, 3 neverMarried, 6 parents, 3 spouse

assert assertAt_30_10 { ((Bob.@r_childs).@childs_ref) = Carol }
check assertAt_30_10 for 1 but 3 Person, 3 age, 9 childs, 3 divorced, 3 maritalStatus, 3 married, 3 neverMarried, 6 parents, 3 spouse

one sig Carol extends Person
{}
{ ((this.@r_age).@age_ref) = 1 }

assert assertAt_35_10 { ((Carol.@r_parents).@parents_ref) = (Alice + Bob) }
check assertAt_35_10 for 1 but 3 Person, 3 age, 9 childs, 3 divorced, 3 maritalStatus, 3 married, 3 neverMarried, 6 parents, 3 spouse

