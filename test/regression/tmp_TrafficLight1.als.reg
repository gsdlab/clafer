open util/integer
pred show {}


one sig root
{}

abstract sig c0_TrafficLight_1
{ var r_c0_on : set c0_on
, var r_c0_off : set c0_off }
{ always (this in alive_c0_TrafficLight_1 and not before this in alive_c0_TrafficLight_1 implies (some this.@r_c0_on)) }
fun alive_c0_TrafficLight_1 : set c0_TrafficLight_1 { none }
fact { all self_ : c0_TrafficLight_1 | always (self_ in alive_c0_TrafficLight_1 implies (lone self_.@r_c0_on)) }
fact { all self_ : c0_TrafficLight_1 | always (self_ in alive_c0_TrafficLight_1 implies (lone self_.@r_c0_off)) }
fact { all self_ : c0_TrafficLight_1 | always (self_ in alive_c0_TrafficLight_1 implies ((some self_.@r_c0_on) => ((some (self_ & alive_c0_TrafficLight_1) and ((some (self_ & alive_c0_TrafficLight_1)) && (some self_.@r_c0_on))) until (not some (self_ & alive_c0_TrafficLight_1) or (some self_.@r_c0_off))))) }
fact { all self_ : c0_TrafficLight_1 | always (self_ in alive_c0_TrafficLight_1 implies ((some self_.@r_c0_off) => (after (not some (self_ & alive_c0_TrafficLight_1) or (some self_.@r_c0_on))))) }


sig c0_on
{ p_c0_on : lone c0_TrafficLight_1
, var r_c0_normal : set c0_normal
, var r_c0_flashing : set c0_flashing }
{ always (this in alive_c0_on implies (let children = (this.@r_c0_normal + this.@r_c0_flashing) | one children))
  always (this in alive_c0_on and not before this in alive_c0_on implies (some this.@r_c0_normal)) }
fun alive_c0_on : set c0_on { c0_TrafficLight_1.@r_c0_on }
fact { always ~@r_c0_on in @p_c0_on
  always @r_c0_on.univ in alive_c0_TrafficLight_1 }

fact { all self_ : c0_on | always (self_ in alive_c0_on implies (lone self_.@r_c0_normal)) }
fact { all self_ : c0_on | always (self_ in alive_c0_on implies (lone self_.@r_c0_flashing)) }
fact { all self_ : c0_on | always (self_ in alive_c0_on implies ((some self_.@r_c0_flashing) => ((some (self_ & alive_c0_on) and ((some (self_ & alive_c0_on)) && (some self_.@r_c0_flashing))) until (not some (self_ & alive_c0_on) or (some self_.@r_c0_normal))))) }


