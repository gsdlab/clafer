digraph "afm_check"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"a" [label="a" URL="#a" tooltip="a&#10;  b ?&#10;  c 0..1&#10;"];
"d" [label="d 1..1" URL="#d" tooltip="d 1..1&#10;"];
"e" [label="e 0..0" URL="#e" tooltip="e 0..0&#10;"];
"f" [label="f 1" URL="#f" tooltip="f 1&#10;"];
}