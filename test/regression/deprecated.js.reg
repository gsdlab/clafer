defaultScope(1);
stringLength(16);

$Component = Abstract("Component");
$link = $Component.addChild("link").withCard(0, 1);
$Comp1 = Clafer("Comp1").withCard(1, 1);
$link.refToUnique($Component);
$Comp1.extending($Component);
$Comp1.addConstraint(equal(joinRef(join($this(), $link)), global($Comp1)));
$Comp1.addConstraint(equal(joinRef(join($this(), $link)), global($Comp1)));
Constraint(some(inter(global($Comp1), global($Component))));
Constraint(some(inter(global($Comp1), global($Component))));
