open util/integer
pred show {}


abstract sig Course
{ r_taughtBy : set taughtBy }
{ all disj x, y : this.@r_taughtBy | (x.@taughtBy_ref) != (y.@taughtBy_ref)  }

sig taughtBy
{ taughtBy_ref : one Teacher
, r_x : lone x }
{ one @r_taughtBy.this }

sig x
{}
{ one @r_x.this }

abstract sig Teacher
{ r_teaches : set teaches }
{ all disj x, y : this.@r_teaches | (x.@teaches_ref) != (y.@teaches_ref)  }

sig teaches
{ teaches_ref : one Course }
{ one @r_teaches.this }

fact { all  c : Course | all  t : c.@r_taughtBy | (some t.@r_x) && (c in (((t.@taughtBy_ref).@r_teaches).@teaches_ref)) }
fact { 5 <= #course and #course <= 5 }
sig course extends Course
{}

fact { 3 <= #teacher and #teacher <= 3 }
sig teacher extends Teacher
{}

