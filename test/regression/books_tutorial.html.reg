<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/books_tutorial.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Book">Book</span>
  <div class="indent">
  <span class="claferDecl" id="title">title</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a>
    <div class="indent">
    <span class="claferDecl" id="subtitle">subtitle</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> ?</div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="year">year</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="page">page</span> 2..* </div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="format">format</span>
    <div class="indent">
    <span class="claferDecl" id="paper">paper</span>
      <div class="indent">
      <span class="claferDecl" id="hardcover">hardcover</span> ?</div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="electronic">electronic</span></div>
  </div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="kind">kind</span>
    <div class="indent">
    <span class="claferDecl" id="textbook">textbook</span></div>
    <div class="indent">
    <span class="claferDecl" id="manual">manual</span></div>
    <div class="indent">
    <span class="claferDecl" id="reference">reference</span></div>
    <div class="indent">
    <span class="claferDecl" id="fiction">fiction</span></div>
    <div class="indent">
    <span class="claferDecl" id="nonfiction">nonfiction</span></div>
    <div class="indent">
    <span class="claferDecl" id="other">other</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="authors">authors</span><span class="keyword"> -> </span><a href="#Author"><span class="reference">Author</span></a> +</div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#year"><span class="reference">year</span></a> &gt;= 5 =&gt; <a href="#ISBN"><span class="reference">ISBN</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="ISBN">ISBN</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> ?
    <div class="indent">
    <span class="claferDecl" id="GS1">GS1</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> ?</div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#year"><span class="reference">year</span></a> &gt;= 6 =&gt; <a href="#GS1"><span class="reference">GS1</span></a> <span class="keyword">]</span></div>
  </div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Person">Person</span>
  <div class="indent">
  <span class="claferDecl" id="name">name</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="dob">dob</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> ?</div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Author">Author</span><span class="keyword"> : </span><a href="#Person"><span class="reference">Person</span></a>
  <div class="indent">
  <span class="claferDecl" id="books">books</span><span class="keyword"> -> </span><a href="#Book"><span class="reference">Book</span></a> +</div>
</div>


<div>
<span class="claferDecl" id="GenerativeProgramming">GenerativeProgramming</span><span class="keyword"> : </span><a href="#Book"><span class="reference">Book</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#title"><span class="reference">title</span></a> = "name" <span class="keyword">]</span><span class="keyword">[</span> <span class="keyword">no</span> <a href="#subtitle"><span class="reference">subtitle</span></a> <span class="keyword">]</span><span class="keyword">[</span> <a href="#year"><span class="reference">year</span></a> = 5 <span class="keyword">]</span><span class="keyword">[</span> # <a href="#page"><span class="reference">page</span></a> = 4 <span class="keyword">]</span><span class="keyword">[</span> <a href="#paper"><span class="reference">paper</span></a> <span class="keyword">]</span><span class="keyword">[</span> <a href="#nonfiction"><span class="reference">nonfiction</span></a> <span class="keyword">]</span><span class="keyword">[</span> <a href="#authors"><span class="reference">authors</span></a> = <a href="#Czarnecki"><span class="reference">Czarnecki</span></a>, <a href="#Eisenecker"><span class="reference">Eisenecker</span></a> <span class="keyword">]</span><span class="keyword">[</span> <a href="#ISBN"><span class="reference">ISBN</span></a> = "name" <span class="keyword">]</span><span class="keyword">[</span> <span class="keyword">no</span> <a href="#GS1"><span class="reference">GS1</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="Czarnecki">Czarnecki</span><span class="keyword"> : </span><a href="#Author"><span class="reference">Author</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#name"><span class="reference">name</span></a> = "name" <span class="keyword">]</span><span class="keyword">[</span> <a href="#GenerativeProgramming"><span class="reference">GenerativeProgramming</span></a> in <a href="#books"><span class="reference">books</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="Eisenecker">Eisenecker</span><span class="keyword"> : </span><a href="#Author"><span class="reference">Author</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#name"><span class="reference">name</span></a> = "name" <span class="keyword">]</span><span class="keyword">[</span> <a href="#GenerativeProgramming"><span class="reference">GenerativeProgramming</span></a> in <a href="#books"><span class="reference">books</span></a> <span class="keyword">]</span></div>
</div>

</body>
</html>