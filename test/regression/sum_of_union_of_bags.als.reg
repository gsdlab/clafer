open util/integer
pred show {}


fact { 2 <= #x }
sig x
{ x_ref : one Int }
{ ((this.@x_ref) >= (-1.mul[2])) && ((this.@x_ref) <= 2) }

fact { 2 <= #y }
sig y
{ y_ref : one Int }
{ ((this.@y_ref) >= (-1.mul[2])) && ((this.@y_ref) <= 2) }

one sig z
{ z_ref : one Int }

fact { (some z) => ((z.@z_ref) = ((sum temp : x | temp.@x_ref).plus[(sum temp : y | temp.@y_ref)])) }
