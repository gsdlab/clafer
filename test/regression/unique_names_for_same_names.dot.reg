digraph "unique_names_for_same_names"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"A" [label="abstract A" URL="#A" tooltip="abstract A&#10;  b&#10;"];
"root__a" [label="a : A" URL="#root__a" tooltip="a : A&#10;  b&#10;"];
"root__b" [label="abstract b" URL="#root__b" tooltip="abstract b&#10;"];
"c" [label="c" URL="#c" tooltip="c&#10;  `b&#10;    a&#10;"];
"c" -> "root__b" [arrowhead=vee arrowtail=diamond dir=both style=solid constraint=true weight=5 minlen=2 arrowsize=0.6 penwidth=0.5 ];
}