scope({$Hardware:2, $Software:2, $noHardware:0, $target:2, $uses:2});
defaultScope(1);
stringLength(16);

$Hardware = Abstract("Hardware");
$h1 = Clafer("h1").withCard(1, 1);
$h2 = Clafer("h2").withCard(1, 1);
$Software = Abstract("Software");
$target = $Software.addChild("target").withCard(1, 1);
$s1 = Clafer("s1").withCard(1, 1);
$s2 = Clafer("s2").withCard(1, 1);
$noHardware = Clafer("noHardware").withCard(0, 0);
$uses = Clafer("uses");
$h1.extending($Hardware);
$h2.extending($Hardware);
$target.refToUnique($Hardware);
$s1.extending($Software);
$s1.addConstraint(equal(joinRef(join($this(), $target)), global($h1)));
$s2.extending($Software);
$s2.addConstraint(equal(joinRef(join($this(), $target)), global($h2)));
$noHardware.refToUnique($Hardware);
$uses.refToUnique($Hardware);
Constraint(equal(joinRef(global($uses)), ifThenElse(greaterThan(card(global($Software)), constant(0)), union(joinRef(join(global($s1), $target)), joinRef(join(global($s2), $target))), joinRef(global($noHardware)))));
