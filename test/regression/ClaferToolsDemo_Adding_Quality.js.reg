scope({$Feature:10, $batterylife:10, $cost:10, $productivity:10, $security:10});
defaultScope(1);
stringLength(16);

$Feature = Abstract("Feature");
$productivity = $Feature.addChild("productivity").withCard(1, 1);
$cost = $Feature.addChild("cost").withCard(1, 1);
$batterylife = $Feature.addChild("batterylife").withCard(1, 1);
$security = $Feature.addChild("security").withCard(1, 1);
$MobilePhone = Abstract("MobilePhone");
$Connectivity = $MobilePhone.addChild("Connectivity").withCard(1, 1);
$Bluetooth = $Connectivity.addChild("Bluetooth").withCard(1, 1).withGroupCard(1, 1);
$Bluetooth20EDR = $Bluetooth.addChild("Bluetooth20EDR").withCard(0, 1);
$Bluetooth21EDR = $Bluetooth.addChild("Bluetooth21EDR").withCard(0, 1);
$Bluetooth40 = $Bluetooth.addChild("Bluetooth40").withCard(0, 1);
$GSM = $Connectivity.addChild("GSM").withCard(1, 1);
$LTE = $Connectivity.addChild("LTE").withCard(0, 1);
$WiFi = $Connectivity.addChild("WiFi").withCard(0, 1);
$USB = $Connectivity.addChild("USB").withCard(0, 1);
$Battery = $MobilePhone.addChild("Battery").withCard(1, 1).withGroupCard(1, 1);
$LiBattery1150 = $Battery.addChild("LiBattery1150").withCard(0, 1);
$LiBattery1400 = $Battery.addChild("LiBattery1400").withCard(0, 1);
$total_productivity = $MobilePhone.addChild("total_productivity").withCard(1, 1);
$total_batterylife = $MobilePhone.addChild("total_batterylife").withCard(1, 1);
$total_security = $MobilePhone.addChild("total_security").withCard(1, 1);
$total_cost = $MobilePhone.addChild("total_cost").withCard(1, 1);
$OptimalPhone = Clafer("OptimalPhone").withCard(1, 1);
$Connectivity.extending($Feature);
$Bluetooth20EDR.extending($Feature);
$Bluetooth21EDR.extending($Feature);
$Bluetooth40.extending($Feature);
$GSM.extending($Feature);
$LTE.extending($Feature);
$WiFi.extending($Feature);
$USB.extending($Feature);
$LiBattery1150.extending($Feature);
$LiBattery1400.extending($Feature);
$OptimalPhone.extending($MobilePhone);
$productivity.refToUnique(Int);
$cost.refToUnique(Int);
$batterylife.refToUnique(Int);
$security.refToUnique(Int);
$total_productivity.refToUnique(Int);
$total_batterylife.refToUnique(Int);
$total_security.refToUnique(Int);
$total_cost.refToUnique(Int);
$Connectivity.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(-12)));
$Connectivity.addConstraint(equal(joinRef(join($this(), $productivity)), constant(14)));
$Connectivity.addConstraint(equal(joinRef(join($this(), $security)), constant(43)));
$Connectivity.addConstraint(equal(joinRef(join($this(), $cost)), constant(101)));
$Bluetooth20EDR.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(-4)));
$Bluetooth20EDR.addConstraint(equal(joinRef(join($this(), $productivity)), constant(1)));
$Bluetooth20EDR.addConstraint(equal(joinRef(join($this(), $security)), constant(-15)));
$Bluetooth20EDR.addConstraint(equal(joinRef(join($this(), $cost)), constant(1)));
$Bluetooth21EDR.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(-2)));
$Bluetooth21EDR.addConstraint(equal(joinRef(join($this(), $productivity)), constant(4)));
$Bluetooth21EDR.addConstraint(equal(joinRef(join($this(), $security)), constant(-10)));
$Bluetooth21EDR.addConstraint(equal(joinRef(join($this(), $cost)), constant(1)));
$Bluetooth40.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(-1)));
$Bluetooth40.addConstraint(equal(joinRef(join($this(), $productivity)), constant(16)));
$Bluetooth40.addConstraint(equal(joinRef(join($this(), $security)), constant(-2)));
$Bluetooth40.addConstraint(equal(joinRef(join($this(), $cost)), constant(2)));
$GSM.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(-2)));
$GSM.addConstraint(equal(joinRef(join($this(), $productivity)), constant(2)));
$GSM.addConstraint(equal(joinRef(join($this(), $security)), constant(-10)));
$GSM.addConstraint(equal(joinRef(join($this(), $cost)), constant(1)));
$LTE.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(-1)));
$LTE.addConstraint(equal(joinRef(join($this(), $productivity)), constant(16)));
$LTE.addConstraint(equal(joinRef(join($this(), $security)), constant(-3)));
$LTE.addConstraint(equal(joinRef(join($this(), $cost)), constant(3)));
$WiFi.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(-10)));
$WiFi.addConstraint(equal(joinRef(join($this(), $productivity)), constant(20)));
$WiFi.addConstraint(equal(joinRef(join($this(), $security)), constant(-15)));
$WiFi.addConstraint(equal(joinRef(join($this(), $cost)), constant(20)));
$USB.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(10)));
$USB.addConstraint(equal(joinRef(join($this(), $productivity)), constant(20)));
$USB.addConstraint(equal(joinRef(join($this(), $security)), constant(0)));
$USB.addConstraint(equal(joinRef(join($this(), $cost)), constant(3)));
$LiBattery1150.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(60)));
$LiBattery1150.addConstraint(equal(joinRef(join($this(), $productivity)), constant(0)));
$LiBattery1150.addConstraint(equal(joinRef(join($this(), $security)), constant(0)));
$LiBattery1150.addConstraint(equal(joinRef(join($this(), $cost)), constant(10)));
$LiBattery1400.addConstraint(equal(joinRef(join($this(), $batterylife)), constant(70)));
$LiBattery1400.addConstraint(equal(joinRef(join($this(), $productivity)), constant(0)));
$LiBattery1400.addConstraint(equal(joinRef(join($this(), $security)), constant(0)));
$LiBattery1400.addConstraint(equal(joinRef(join($this(), $cost)), constant(15)));
$MobilePhone.addConstraint(implies(some(join($this(), $total_productivity)), equal(joinRef(join($this(), $total_productivity)), sum(join(global($Feature), $productivity)))));
$MobilePhone.addConstraint(implies(some(join($this(), $total_batterylife)), equal(joinRef(join($this(), $total_batterylife)), sum(join(global($Feature), $batterylife)))));
$MobilePhone.addConstraint(implies(some(join($this(), $total_security)), equal(joinRef(join($this(), $total_security)), sum(join(global($Feature), $security)))));
$MobilePhone.addConstraint(implies(some(join($this(), $total_cost)), equal(joinRef(join($this(), $total_cost)), sum(join(global($Feature), $cost)))));
max(joinRef(join(global($OptimalPhone), $total_batterylife)));
max(joinRef(join(global($OptimalPhone), $total_productivity)));
max(joinRef(join(global($OptimalPhone), $total_security)));
min(joinRef(join(global($OptimalPhone), $total_cost)));
