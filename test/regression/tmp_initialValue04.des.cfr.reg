//# OPTIONS --explicit --tl=10
[initially ((#level) = 0)]
[F ((#level) >= 1)]
[F (((#level) >= 1) && (level.dref != y.dref))]
0..* y -> int 1..1 {
  [initially (this.dref = 2)]
}
finalref 0..* level -> int 0..1 {
  [initially (this.dref = y.dref)]
}
final 0..* mode -> int 1..1 {
  [initially (this.dref = 1)]
}
