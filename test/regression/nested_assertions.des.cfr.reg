//# OPTIONS --explicit
0..* a 0..1 {}
0..* b 0..1 {}
abstract 0..* P 0..* {
  [this . age . dref >= 0]
  0..* age -> int 1..1 {}
}
0..* x : P 1..1 {}

assert [((#a) >= 1) => ((#a) >= 1)]
assert [((#b) >= 1) => ((#b) >= 1)]
assert [all this_ : P | this_ . age . dref >= 0]
assert [all this_ : x | this_ . age . dref >= 0]
