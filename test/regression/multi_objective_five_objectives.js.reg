scope({$Feature:6, $SecurityFeature:2, $cost:6, $energy:6, $mass:6, $performance:6, $security:2});
defaultScope(1);
stringLength(16);

$Feature = Abstract("Feature");
$performance = $Feature.addChild("performance").withCard(1, 1);
$energy = $Feature.addChild("energy").withCard(1, 1);
$mass = $Feature.addChild("mass").withCard(1, 1);
$cost = $Feature.addChild("cost").withCard(1, 1);
$SecurityFeature = Abstract("SecurityFeature");
$security = $SecurityFeature.addChild("security").withCard(1, 1);
$MobilePhone = Abstract("MobilePhone");
$Connectivity = $MobilePhone.addChild("Connectivity").withCard(1, 1).withGroupCard(1);
$Bluetooth = $Connectivity.addChild("Bluetooth").withCard(0, 1);
$USB = $Connectivity.addChild("USB").withCard(0, 1);
$Wifi = $Connectivity.addChild("Wifi").withCard(0, 1);
$PasswordProtection = $MobilePhone.addChild("PasswordProtection").withCard(0, 1);
$FingerprintProtection = $MobilePhone.addChild("FingerprintProtection").withCard(0, 1);
$total_performance = $MobilePhone.addChild("total_performance").withCard(1, 1);
$total_energy = $MobilePhone.addChild("total_energy").withCard(1, 1);
$total_security = $MobilePhone.addChild("total_security").withCard(1, 1);
$total_mass = $MobilePhone.addChild("total_mass").withCard(1, 1);
$total_cost = $MobilePhone.addChild("total_cost").withCard(1, 1);
$MyPhone = Clafer("MyPhone").withCard(1, 1);
$SecurityFeature.extending($Feature);
$Connectivity.extending($Feature);
$Bluetooth.extending($Feature);
$USB.extending($Feature);
$Wifi.extending($Feature);
$PasswordProtection.extending($SecurityFeature);
$FingerprintProtection.extending($SecurityFeature);
$MyPhone.extending($MobilePhone);
$performance.refToUnique(Int);
$energy.refToUnique(Int);
$mass.refToUnique(Int);
$cost.refToUnique(Int);
$security.refToUnique(Int);
$total_performance.refToUnique(Int);
$total_energy.refToUnique(Int);
$total_security.refToUnique(Int);
$total_mass.refToUnique(Int);
$total_cost.refToUnique(Int);
$Feature.addConstraint(greaterThanEqual(joinRef(join($this(), $mass)), constant(0)));
$Feature.addConstraint(greaterThanEqual(joinRef(join($this(), $cost)), constant(0)));
$Connectivity.addConstraint(equal(joinRef(join($this(), $performance)), constant(0)));
$Connectivity.addConstraint(equal(joinRef(join($this(), $energy)), constant(0)));
$Connectivity.addConstraint(equal(joinRef(join($this(), $mass)), constant(0)));
$Connectivity.addConstraint(equal(joinRef(join($this(), $cost)), constant(12)));
$Bluetooth.addConstraint(equal(joinRef(join($this(), $performance)), constant(9)));
$Bluetooth.addConstraint(equal(joinRef(join($this(), $energy)), constant(10)));
$Bluetooth.addConstraint(equal(joinRef(join($this(), $mass)), constant(2)));
$Bluetooth.addConstraint(equal(joinRef(join($this(), $cost)), constant(3)));
$USB.addConstraint(equal(joinRef(join($this(), $performance)), constant(10)));
$USB.addConstraint(equal(joinRef(join($this(), $energy)), constant(5)));
$USB.addConstraint(equal(joinRef(join($this(), $mass)), constant(3)));
$USB.addConstraint(equal(joinRef(join($this(), $cost)), constant(5)));
$Wifi.addConstraint(equal(joinRef(join($this(), $performance)), constant(22)));
$Wifi.addConstraint(equal(joinRef(join($this(), $energy)), constant(17)));
$Wifi.addConstraint(equal(joinRef(join($this(), $mass)), constant(6)));
$Wifi.addConstraint(equal(joinRef(join($this(), $cost)), constant(5)));
$PasswordProtection.addConstraint(equal(joinRef(join($this(), $security)), constant(5)));
$PasswordProtection.addConstraint(equal(joinRef(join($this(), $performance)), constant(1)));
$PasswordProtection.addConstraint(equal(joinRef(join($this(), $energy)), constant(2)));
$PasswordProtection.addConstraint(equal(joinRef(join($this(), $mass)), constant(0)));
$PasswordProtection.addConstraint(equal(joinRef(join($this(), $cost)), constant(2)));
$FingerprintProtection.addConstraint(equal(joinRef(join($this(), $mass)), constant(0)));
$FingerprintProtection.addConstraint(equal(joinRef(join($this(), $security)), constant(5)));
$FingerprintProtection.addConstraint(equal(joinRef(join($this(), $performance)), constant(3)));
$FingerprintProtection.addConstraint(equal(joinRef(join($this(), $energy)), constant(1)));
$FingerprintProtection.addConstraint(equal(joinRef(join($this(), $cost)), constant(13)));
$MobilePhone.addConstraint(implies(some(join($this(), $total_performance)), equal(joinRef(join($this(), $total_performance)), sum(join(global($Feature), $performance)))));
$MobilePhone.addConstraint(implies(some(join($this(), $total_energy)), equal(joinRef(join($this(), $total_energy)), sum(join(global($Feature), $energy)))));
$MobilePhone.addConstraint(implies(some(join($this(), $total_security)), equal(joinRef(join($this(), $total_security)), sum(join(global($SecurityFeature), $security)))));
$MobilePhone.addConstraint(implies(some(join($this(), $total_mass)), equal(joinRef(join($this(), $total_mass)), sum(join(global($Feature), $mass)))));
$MobilePhone.addConstraint(implies(some(join($this(), $total_cost)), equal(joinRef(join($this(), $total_cost)), sum(join(global($Feature), $cost)))));
min(joinRef(join(global($MyPhone), $total_energy)));
max(joinRef(join(global($MyPhone), $total_performance)));
max(joinRef(join(global($MyPhone), $total_security)));
min(joinRef(join(global($MyPhone), $total_mass)));
min(joinRef(join(global($MyPhone), $total_cost)));
