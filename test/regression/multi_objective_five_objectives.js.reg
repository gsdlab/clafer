scope({c0_Feature:6, c0_SecurityFeature:2, c0_cost:6, c0_energy:6, c0_mass:6, c0_performance:6, c0_security:2});
defaultScope(1);
stringLength(16);

c0_Feature = Abstract("c0_Feature");
c0_performance = c0_Feature.addChild("c0_performance").withCard(1, 1);
c0_energy = c0_Feature.addChild("c0_energy").withCard(1, 1);
c0_mass = c0_Feature.addChild("c0_mass").withCard(1, 1);
c0_cost = c0_Feature.addChild("c0_cost").withCard(1, 1);
c0_SecurityFeature = Abstract("c0_SecurityFeature");
c0_security = c0_SecurityFeature.addChild("c0_security").withCard(1, 1);
c0_MobilePhone = Abstract("c0_MobilePhone");
c0_Connectivity = c0_MobilePhone.addChild("c0_Connectivity").withCard(1, 1).withGroupCard(1);
c0_Bluetooth = c0_Connectivity.addChild("c0_Bluetooth").withCard(0, 1);
c0_USB = c0_Connectivity.addChild("c0_USB").withCard(0, 1);
c0_Wifi = c0_Connectivity.addChild("c0_Wifi").withCard(0, 1);
c0_PasswordProtection = c0_MobilePhone.addChild("c0_PasswordProtection").withCard(0, 1);
c0_FingerprintProtection = c0_MobilePhone.addChild("c0_FingerprintProtection").withCard(0, 1);
c0_total_performance = c0_MobilePhone.addChild("c0_total_performance").withCard(1, 1);
c0_total_energy = c0_MobilePhone.addChild("c0_total_energy").withCard(1, 1);
c0_total_security = c0_MobilePhone.addChild("c0_total_security").withCard(1, 1);
c0_total_mass = c0_MobilePhone.addChild("c0_total_mass").withCard(1, 1);
c0_total_cost = c0_MobilePhone.addChild("c0_total_cost").withCard(1, 1);
c0_MyPhone = Clafer("c0_MyPhone").withCard(1, 1);
c0_performance.refToUnique(Int);
c0_energy.refToUnique(Int);
c0_mass.refToUnique(Int);
c0_Feature.addConstraint(greaterThanEqual(joinRef(join($this(), c0_mass)), constant(0)));
c0_cost.refToUnique(Int);
c0_Feature.addConstraint(greaterThanEqual(joinRef(join($this(), c0_cost)), constant(0)));
c0_SecurityFeature.extending(c0_Feature);
c0_security.refToUnique(Int);
c0_Connectivity.extending(c0_Feature);
c0_Connectivity.addConstraint(equal(joinRef(join($this(), c0_performance)), constant(0)));
c0_Connectivity.addConstraint(equal(joinRef(join($this(), c0_energy)), constant(0)));
c0_Connectivity.addConstraint(equal(joinRef(join($this(), c0_mass)), constant(0)));
c0_Connectivity.addConstraint(equal(joinRef(join($this(), c0_cost)), constant(12)));
c0_Bluetooth.extending(c0_Feature);
c0_Bluetooth.addConstraint(equal(joinRef(join($this(), c0_performance)), constant(9)));
c0_Bluetooth.addConstraint(equal(joinRef(join($this(), c0_energy)), constant(10)));
c0_Bluetooth.addConstraint(equal(joinRef(join($this(), c0_mass)), constant(2)));
c0_Bluetooth.addConstraint(equal(joinRef(join($this(), c0_cost)), constant(3)));
c0_USB.extending(c0_Feature);
c0_USB.addConstraint(equal(joinRef(join($this(), c0_performance)), constant(10)));
c0_USB.addConstraint(equal(joinRef(join($this(), c0_energy)), constant(5)));
c0_USB.addConstraint(equal(joinRef(join($this(), c0_mass)), constant(3)));
c0_USB.addConstraint(equal(joinRef(join($this(), c0_cost)), constant(5)));
c0_Wifi.extending(c0_Feature);
c0_Wifi.addConstraint(equal(joinRef(join($this(), c0_performance)), constant(22)));
c0_Wifi.addConstraint(equal(joinRef(join($this(), c0_energy)), constant(17)));
c0_Wifi.addConstraint(equal(joinRef(join($this(), c0_mass)), constant(6)));
c0_Wifi.addConstraint(equal(joinRef(join($this(), c0_cost)), constant(5)));
c0_PasswordProtection.extending(c0_SecurityFeature);
c0_PasswordProtection.addConstraint(equal(joinRef(join($this(), c0_security)), constant(5)));
c0_PasswordProtection.addConstraint(equal(joinRef(join($this(), c0_performance)), constant(1)));
c0_PasswordProtection.addConstraint(equal(joinRef(join($this(), c0_energy)), constant(2)));
c0_PasswordProtection.addConstraint(equal(joinRef(join($this(), c0_mass)), constant(0)));
c0_PasswordProtection.addConstraint(equal(joinRef(join($this(), c0_cost)), constant(2)));
c0_FingerprintProtection.extending(c0_SecurityFeature);
c0_FingerprintProtection.addConstraint(equal(joinRef(join($this(), c0_mass)), constant(0)));
c0_FingerprintProtection.addConstraint(equal(joinRef(join($this(), c0_security)), constant(5)));
c0_FingerprintProtection.addConstraint(equal(joinRef(join($this(), c0_performance)), constant(3)));
c0_FingerprintProtection.addConstraint(equal(joinRef(join($this(), c0_energy)), constant(1)));
c0_FingerprintProtection.addConstraint(equal(joinRef(join($this(), c0_cost)), constant(13)));
c0_total_performance.refToUnique(Int);
c0_MobilePhone.addConstraint(implies(some(join($this(), c0_total_performance)), equal(joinRef(join($this(), c0_total_performance)), sum(join(global(c0_Feature), c0_performance)))));
c0_total_energy.refToUnique(Int);
c0_MobilePhone.addConstraint(implies(some(join($this(), c0_total_energy)), equal(joinRef(join($this(), c0_total_energy)), sum(join(global(c0_Feature), c0_energy)))));
c0_total_security.refToUnique(Int);
c0_MobilePhone.addConstraint(implies(some(join($this(), c0_total_security)), equal(joinRef(join($this(), c0_total_security)), sum(join(global(c0_SecurityFeature), c0_security)))));
c0_total_mass.refToUnique(Int);
c0_MobilePhone.addConstraint(implies(some(join($this(), c0_total_mass)), equal(joinRef(join($this(), c0_total_mass)), sum(join(global(c0_Feature), c0_mass)))));
c0_total_cost.refToUnique(Int);
c0_MobilePhone.addConstraint(implies(some(join($this(), c0_total_cost)), equal(joinRef(join($this(), c0_total_cost)), sum(join(global(c0_Feature), c0_cost)))));
c0_MyPhone.extending(c0_MobilePhone);
min(joinRef(join(global(c0_MyPhone), c0_total_energy)));
max(joinRef(join(global(c0_MyPhone), c0_total_performance)));
max(joinRef(join(global(c0_MyPhone), c0_total_security)));
min(joinRef(join(global(c0_MyPhone), c0_total_mass)));
min(joinRef(join(global(c0_MyPhone), c0_total_cost)));
