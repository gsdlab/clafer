open util/integer
pred show {}


fact { #Value = 0 }
abstract sig Value
{}

fact { #Attribute = 0 }
abstract sig Attribute
{ r_value : one value }

sig value
{ value_ref : one Value }
{ one @r_value.this }

fact { #ActionName = 0 }
abstract sig ActionName extends Attribute
{}

fact { #Role = 0 }
abstract sig Role extends Attribute
{}

fact { #ResourceName = 0 }
abstract sig ResourceName extends Attribute
{}

fact { #Element = 0 }
abstract sig Element
{ r_attributes : set attributes }

abstract sig attributes extends Attribute
{}
{ one @r_attributes.this }

abstract sig Effect
{}

one sig Permit extends Effect
{}

one sig Deny extends Effect
{}

one sig NotApplicable extends Effect
{}

one sig Indeterminate extends Effect
{}

abstract sig CombiningAlgo
{}

one sig PermitOverrides extends CombiningAlgo
{}

one sig DenyOverrides extends CombiningAlgo
{}

one sig OnlyOneApplicable extends CombiningAlgo
{}

