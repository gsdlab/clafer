defaultScope(1);
stringLength(16);

$a = Clafer("a").withCard(1, 1);
$b = Clafer("b").withCard(1, 1);
$c = Clafer("c").withCard(1, 1);
$spread = Clafer("spread").withCard(1, 1);
$range = Clafer("range").withCard(1, 1);
$above = Clafer("above").withCard(1, 1);
$a.refToUnique(Int);
$b.refToUnique(Int);
$c.refToUnique(Int);
$spread.refToUnique(Int);
$range.refToUnique(Int);
$above.refToUnique(Int);
Constraint(implies(some(global($spread)), equal(joinRef(global($spread)), sub(maximum(union(union(joinRef(global($a)), joinRef(global($b))), joinRef(global($c)))), minimum(union(union(joinRef(global($a)), joinRef(global($b))), joinRef(global($c))))))));
Constraint(implies(some(global($range)), equal(joinRef(global($range)), sub(maximum(union(union(joinRef(global($a)), joinRef(global($b))), joinRef(global($c)))), minimum(union(union(joinRef(global($a)), joinRef(global($b))), joinRef(global($c))))))));
Constraint(implies(some(global($above)), equal(joinRef(global($above)), add(maximum(union(joinRef(global($a)), constant(3))), constant(1)))));
Constraint(equal(joinRef(global($a)), constant(5)));
Constraint(equal(joinRef(global($b)), constant(2)));
Constraint(equal(joinRef(global($c)), constant(9)));
Constraint(equal(joinRef(global($spread)), constant(7)));
Constraint(equal(joinRef(global($range)), constant(7)));
Constraint(equal(joinRef(global($above)), constant(6)));
