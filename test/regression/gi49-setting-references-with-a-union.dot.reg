digraph "gi49-setting-references-with-a-union"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"x" [label="abstract x -&gt; integer" URL="#x" tooltip="abstract x -&gt; integer&#10;"];
"A" [label="A : x = 1" URL="#A" tooltip="A : x = 1&#10;"];
"B" [label="B : x = 2" URL="#B" tooltip="B : x = 2&#10;"];
"C" [label="C : x = 3" URL="#C" tooltip="C : x = 3&#10;"];
"xs" [label="xs -&gt;&gt; x *" URL="#xs" tooltip="xs -&gt;&gt; x *&#10;"];
"xs" -> "x" [arrowhead=veevee arrowsize=0.6 minlen=1.5 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}