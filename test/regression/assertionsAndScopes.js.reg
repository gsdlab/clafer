scope({$a:2, $b:6, $c:0});
defaultScope(1);
stringLength(16);

$a = Clafer("a").withCard(2, 2);
$b = $a.addChild("b").withCard(3, 3);
$c = $b.addChild("c").withCard(0, 0);
assert(none(join(join(global($a), $b), $c)));
assert(some(join(global($a), $b)));
assert(none(join(join(global($a), $b), $c)));
assert(equal(card(join(global($a), $b)), constant(6)));
