//# OPTIONS --explicit
abstract 0..* Person 0..* {
  0..* Name -> string 1..1 {}
  0..* Surname -> string 1..1 {}
  0..* DateOfBirth : date 1..1 {}
  1..* Gender 1..1 {
    0..* Male 0..1 {}
    0..* Female 0..1 {}
  }
  1..1 MaritalStatus 1..1 {
    0..* NeverMarried 0..1 {}
    0..* Married 0..1 {}
    0..* Divorced 0..1 {}
  }
  0..* Address 1..1 {
    0..* Street -> string 1..1 {
      0..* UnitNo -> string 0..1 {}
    }
    0..* City -> string 1..1 {}
    0..* Address__Country -> string 1..1 {}
    0..* PostalCode -> string 1..1 {}
  }
}
abstract 0..* date ->> string 0..* {}
0..* JohnDoe : Person 1..1 {
  [this.Name.dref = "John"]
  [this.Surname.dref = "Doe"]
  [this.DateOfBirth.dref = "01/02/1985"]
  [(#this.Gender.Male) >= 1]
  [(#this.MaritalStatus.Married) >= 1]
  [this.Address.Street.dref = "123 Main St."]
  [this.Address.City.dref = "Great Town"]
  [this.Address.Address__Country.dref = "Canada"]
  [this.Address.PostalCode.dref = "A1B 2C3"]
}
abstract 0..* Student : Person 0..* {
  0..* StudentId -> string 1..1 {}
}
abstract 0..* WaitingLine 0..* {
  0..* participants -> Person 0..* {}
}
0..* MaryJane : Student 1..1 {
  [this.Name.dref = "Mary Jane"]
  [this.StudentId.dref = "MJ13421354"]
}
0..* BusLine : WaitingLine 1..1 {
  [JohnDoe in this.participants.dref]
  [MaryJane in this.participants.dref]
}
0..* JohnAndMaryLine : WaitingLine 1..1 {
  [this.participants.dref = (JohnDoe ++ MaryJane)]
}
abstract 0..* TwoPersonLine : WaitingLine 0..* {
  [(#this.participants) = 2]
}
abstract 0..* OneToTenPersonLine : WaitingLine 0..* {
  [(#this.participants) >= 1]
  [(#this.participants) <= 10]
}
abstract 0..* NorthAmericanCountry 0..* {}
0..* Canada : NorthAmericanCountry 1..1 {}
0..* USA : NorthAmericanCountry 1..1 {}
0..* Mexico : NorthAmericanCountry 1..1 {}
abstract 0..* Person2 0..* {
  0..* Person2__Country -> NorthAmericanCountry 1..1 {}
}
0..* JohnDoe2 : Person2 1..1 {
  [this.Person2__Country.dref = Canada]
}
