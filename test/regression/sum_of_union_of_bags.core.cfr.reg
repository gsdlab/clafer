//# OPTIONS --explicit --core
0..* x ->> int 2..* {
  [(this.dref >= -2) && (this.dref <= 2)]
}
0..* y ->> int 2..* {
  [(this.dref >= -2) && (this.dref <= 2)]
}
0..* z -> int 1..1 {}
[(some z) => (z.dref = ((sum x.dref) + (sum y.dref)))] // =, sum_of_union_of_bags.cfr:7:1

assert [z.dref = ((sum x.dref) + (sum y.dref))]
assert [((all v : x | v.dref = 1) && (all w : y | w.dref = 1)) => (z.dref = ((#x) + (#y)))]
