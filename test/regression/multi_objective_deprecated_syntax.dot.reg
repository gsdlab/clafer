digraph "multi_objective_deprecated_syntax"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"c0_Feature" [label="abstract Feature" URL="#c0_Feature" tooltip="abstract Feature&#10;  performance : integer&#10;  energy : integer&#10;"];
"c0_SecurityFeature" [label="abstract SecurityFeature : Feature" URL="#c0_SecurityFeature" tooltip="abstract SecurityFeature : Feature&#10;  security : integer&#10;"];
"c0_SecurityFeature" -> "c0_Feature" [arrowhead=onormal constraint=true weight=100];
"c0_MobilePhone" [label="abstract MobilePhone" URL="#c0_MobilePhone" tooltip="abstract MobilePhone&#10;  or Connectivity : Feature&#10;    [ this.performance = 0 ]&#10;    [ this.energy = 0 ]&#10;    Bluetooth : Feature&#10;      [ this.performance = 9 ]&#10;      [ this.energy = 10 ]&#10;    USB : Feature&#10;      [ this.performance = 15 ]&#10;      [ this.energy = 7 ]&#10;    Wifi : Feature&#10;      [ this.performance = 22 ]&#10;      [ this.energy = 17 ]&#10;  PasswordProtection : SecurityFeature ?&#10;    [ this.security = 5 ]&#10;    [ this.performance = 1 ]&#10;    [ this.energy = 2 ]&#10;  FingerprintProtection : SecurityFeature ?&#10;    [ this.security = 5 ]&#10;    [ this.performance = 2 ]&#10;    [ this.energy = 4 ]&#10;  total_performance : integer&#10;  [ total_performance = sum Feature.performance ]&#10;  total_energy : integer&#10;  [ total_energy = sum Feature.energy ]&#10;  total_security : integer&#10;  [ total_security = sum SecurityFeature.security ]&#10;"];
"c0_MobilePhone" -> "c0_Feature" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_MobilePhone" -> "c0_Feature" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_MobilePhone" -> "c0_Feature" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_MobilePhone" -> "c0_Feature" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_MobilePhone" -> "c0_SecurityFeature" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_MobilePhone" -> "c0_SecurityFeature" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_MyPhone" [label="MyPhone : MobilePhone" URL="#c0_MyPhone" tooltip="MyPhone : MobilePhone&#10;  [ Connectivity.Bluetooth &amp;&amp;  ! USB ]&#10;"];
"c0_MyPhone" -> "c0_MobilePhone" [arrowhead=onormal constraint=true weight=100];
}