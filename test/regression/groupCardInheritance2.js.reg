defaultScope(1);
stringLength(16);

$A = Abstract("A");
$a = $A.addChild("a").withCard(1, 1);
$B = Abstract("B").withGroupCard(1);
$b = $B.addChild("b").withCard(0, 1);
$C = Abstract("C").withGroupCard(1);
$c = $C.addChild("c").withCard(0, 1);
$D = Abstract("D").withGroupCard(1, 1);
$d = $D.addChild("d").withCard(0, 1);
$E = Clafer("E").withCard(1, 1).withGroupCard(1, 1);
$e = $E.addChild("e").withCard(0, 1);
$B.extending($A);
$C.extending($B);
$D.extending($C);
$E.extending($D);
assert(and(and(and(and(one(join(global($E), $a)), none(join(global($E), $b))), none(join(global($E), $c))), none(join(global($E), $d))), none(join(global($E), $e))));
