//# OPTIONS --explicit --core --tl=10
[(!(previous ((#root) >= 1))) => ((#box.item) >= 1)]
[(!(previous ((#root) >= 1))) => (all i : box.item | X (((#(i ** box.item)) = 0) && (X ((#(i ** box.item)) >= 1))))]
0..* box 2..2 {
  0..* item 0..1 {}
}

assert [all b : box | all i : b.item | G (((#(i ** box.item)) >= 1) => ((#(i ** b.item)) >= 1))]
