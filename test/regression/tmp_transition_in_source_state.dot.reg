digraph "tmp_transition_in_source_state"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"go" [label="go ?" URL="#go" tooltip="go ?&#10;"];
"sm" [label="final xor sm" URL="#sm" tooltip="final xor sm&#10;  initial a&#10;    [ go --&gt; b ]&#10;  b&#10;  c&#10;"];
}