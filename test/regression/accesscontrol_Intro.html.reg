<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/accesscontrol_Intro.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Value">Value</span></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Attribute">Attribute</span>
  <div class="indent">
  <span class="claferDecl" id="value">value</span><span class="keyword"> -> </span><a href="#Value"><span class="reference">Value</span></a></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="ActionName">ActionName</span><span class="keyword"> : </span><a href="#Attribute"><span class="reference">Attribute</span></a></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Role">Role</span><span class="keyword"> : </span><a href="#Attribute"><span class="reference">Attribute</span></a></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="ResourceName">ResourceName</span><span class="keyword"> : </span><a href="#Attribute"><span class="reference">Attribute</span></a></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Element">Element</span>
  <div class="indent">
  <span class="keyword">abstract</span> <span class="claferDecl" id="attributes">attributes</span><span class="keyword"> : </span><a href="#Attribute"><span class="reference">Attribute</span></a> *</div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">enum</span> Effect = <span class="claferDecl" id="Permit">Permit</span> | <span class="claferDecl" id="Deny">Deny</span> | <span class="claferDecl" id="NotApplicable">NotApplicable</span> | <span class="claferDecl" id="Indeterminate">Indeterminate</span></div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">enum</span> CombiningAlgo = <span class="claferDecl" id="PermitOverrides">PermitOverrides</span> | <span class="claferDecl" id="DenyOverrides">DenyOverrides</span> | <span class="claferDecl" id="OnlyOneApplicable">OnlyOneApplicable</span></div>

</body>
</html>