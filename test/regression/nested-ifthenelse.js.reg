defaultScope(1);
stringLength(16);

$x = Clafer("x").withCard(0, 1);
$y = Clafer("y").withCard(0, 1);
$z = Clafer("z").withCard(0, 1);
$w = Clafer("w").withCard(0, 1);
$u = Clafer("u").withCard(0, 1);
$o = Clafer("o").withCard(0, 1);
$p = Clafer("p").withCard(0, 1);
$h = Clafer("h").withCard(0, 1);
Constraint(ifOnlyIf(some(global($h)), ifThenElse(ifThenElse(some(global($x)), some(global($z)), some(global($y))), implies(some(global($x)), some(global($y))), ifThenElse(none(global($w)), ifThenElse(some(global($z)), some(global($u)), some(global($o))), some(global($p))))));
