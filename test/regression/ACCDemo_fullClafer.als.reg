open util/integer
pred show {}


abstract sig car
{ r_transmission : one transmission
, r_car__fca : lone car__fca
, r_car__cc : one car__cc }
{ (some (this.@r_car__cc).@r_acc) => (some this.@r_car__fca) }

sig transmission
{ r_automatic : lone automatic
, r_manual : lone manual }
{ one @r_transmission.this
  let children = (r_automatic + r_manual) | one children }

sig automatic
{}
{ one @r_automatic.this }

sig manual
{}
{ one @r_manual.this }

sig car__fca extends root__fca
{}
{ one @r_car__fca.this }

sig car__cc extends root__cc
{}
{ one @r_car__cc.this }

abstract sig root__fca
{ r_sensor : one sensor }

sig sensor
{ r_radar : lone radar
, r_lidar : lone lidar }
{ one @r_sensor.this
  let children = (r_radar + r_lidar) | one children }

sig radar
{}
{ one @r_radar.this }

sig lidar
{}
{ one @r_lidar.this }

abstract sig root__cc
{ r_switches : set switches
, r_acc : lone acc }
{ 2 <= #r_switches and #r_switches <= 3 }

sig switches
{ r_backlight : lone backlight }
{ one @r_switches.this }

sig backlight
{}
{ one @r_backlight.this }

sig acc
{}
{ one @r_acc.this }

abstract sig camaro extends car
{ r_transformer : lone transformer }
{ all  s : (this.@r_car__cc).@r_switches | some s.@r_backlight }

sig transformer
{}
{ one @r_transformer.this
  (#(((this.~@r_transformer).@r_car__cc).@r_switches)) = 3 }

one sig bumbleBee extends camaro
{}
{ some this.@r_transformer
  some (this.@r_transmission).@r_manual }

