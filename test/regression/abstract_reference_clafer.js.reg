defaultScope(1);
stringLength(16);

$Person = Abstract("Person");
$age = $Person.addChild("age").withCard(1, 1);
$married = $Person.addChild("married").withCard(0, 1);
$NewBorn = Abstract("NewBorn");
$Alice = Clafer("Alice").withCard(1, 1);
$baby = Clafer("baby").withCard(1, 1);
$age.refToUnique(Int);
$NewBorn.refToUnique($Person);
$NewBorn.addConstraint(and(equal(joinRef(join(joinRef($this()), $age)), constant(0)), none(join(joinRef($this()), $married))));
$Alice.extending($Person);
$baby.extending($NewBorn);
assert(equal(joinRef(global($baby)), global($Alice)));
assert(equal(joinRef(join(global($Alice), $age)), constant(0)));
assert(none(join(global($Alice), $married)));
