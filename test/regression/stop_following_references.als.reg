open util/integer
pred show {}


abstract sig A
{ r_A__b : lone A__b }

sig A__b
{}
{ one @r_A__b.this }

one sig A1 extends A
{}
{ no this.@r_A__b }

one sig C
{ r_C__b : lone C__b
, r_a : one a }
{ some C.@r_C__b }

lone sig C__b
{}
{ one r_C__b }

one sig a
{ a_ref : one A
, r_d : one d }
{ some (this.@r_d).@r_d__b }

one sig d
{ r_d__b : lone d__b }

lone sig d__b
{}
{ one r_d__b }

