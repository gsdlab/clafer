scope({$M:5, $Meeting:4, $Meeting__chair:4, $Meeting__room:4, $Member:7, $Month:2, $Room:2, $Room__audioConferencing:2, $Room__whiteboard:2, $capacity:2, $computer:2, $electronic:2, $mt:4, $onlineParticipant:28, $participant:28, $projector:2, $traditional:2});
defaultScope(1);
stringLength(16);

$midYearReview = Clafer("midYearReview").withCard(1, 1);
$month = $midYearReview.addChild("month").withCard(1, 1);
$midYearReview__chair = $midYearReview.addChild("midYearReview__chair").withCard(1, 1);
$midYearReview__room = $midYearReview.addChild("midYearReview__room").withCard(1, 1);
$Steven = Clafer("Steven").withCard(1, 1);
$C = Clafer("C").withCard(1, 1);
$C__whiteboard = $C.addChild("C__whiteboard").withCard(1, 1);
$C__audioConferencing = $C.addChild("C__audioConferencing").withCard(1, 1);
$ondemandMeeting = Clafer("ondemandMeeting").withCard(1, 1);
$ondemandMeeting__chair = $ondemandMeeting.addChild("ondemandMeeting__chair").withCard(1, 1);
$ondemandMeeting__room = $ondemandMeeting.addChild("ondemandMeeting__room").withCard(1, 1);
$Joanna = Clafer("Joanna").withCard(1, 1);
$D = Clafer("D").withCard(1, 1);
$D__whiteboard = $D.addChild("D__whiteboard").withCard(1, 1);
$Meeting = Abstract("Meeting");
$Meeting__chair = $Meeting.addChild("Meeting__chair").withCard(1, 1);
$participant = $Meeting.addChild("participant").withCard(1);
$onlineParticipant = $Meeting.addChild("onlineParticipant");
$Meeting__room = $Meeting.addChild("Meeting__room").withCard(1, 1);
$Month = Abstract("Month");
$June = Clafer("June").withCard(1, 1);
$July = Clafer("July").withCard(1, 1);
$Member = Abstract("Member");
$Room = Abstract("Room");
$capacity = $Room.addChild("capacity").withCard(1, 1);
$Room__whiteboard = $Room.addChild("Room__whiteboard").withCard(1, 1).withGroupCard(1);
$traditional = $Room__whiteboard.addChild("traditional").withCard(0, 1);
$electronic = $Room__whiteboard.addChild("electronic").withCard(0, 1);
$projector = $Room.addChild("projector").withCard(0, 1);
$computer = $Room.addChild("computer").withCard(0, 1);
$Room__audioConferencing = $Room.addChild("Room__audioConferencing").withCard(0, 1);
$M = Clafer("M").withCard(5, 5);
$SueAgenda = Clafer("SueAgenda").withCard(1, 1);
$m1 = $SueAgenda.addChild("m1").withCard(0, 1);
$m2 = $SueAgenda.addChild("m2").withCard(0, 1);
$M1 = Clafer("M1").withCard(0, 1);
$M2 = Clafer("M2").withCard(0, 1);
$time = $M2.addChild("time").withCard(1, 1);
$Agenda = Abstract("Agenda");
$mt = $Agenda.addChild("mt");
$midYearReview.extending($Meeting);
$Steven.extending($Member);
$C.extending($Room);
$ondemandMeeting.extending($Meeting);
$Joanna.extending($Member);
$D.extending($Room);
$June.extending($Month);
$July.extending($Month);
$M.extending($Member);
$SueAgenda.extending($Agenda);
$M1.extending($Meeting);
$M2.extending($Meeting);
$month.refToUnique($Month);
$midYearReview__chair.refToUnique($Member);
$midYearReview__room.refToUnique($Room);
$ondemandMeeting__chair.refToUnique($Member);
$ondemandMeeting__room.refToUnique($Room);
$Meeting__chair.refToUnique($Member);
$participant.refToUnique($Member);
$onlineParticipant.refToUnique($Member);
$Meeting__room.refToUnique($Room);
$capacity.refToUnique(Int);
$m1.refToUnique($Meeting);
$m2.refToUnique($Meeting);
$time.refToUnique(Int);
$mt.refToUnique($Meeting);
$midYearReview.addConstraint(implies(some(join($this(), $month)), equal(joinRef(join($this(), $month)), global($June))));
$midYearReview.addConstraint(implies(some(join($this(), $midYearReview__chair)), equal(joinRef(join($this(), $midYearReview__chair)), global($Steven))));
$midYearReview.addConstraint(implies(some(join($this(), $midYearReview__room)), equal(joinRef(join($this(), $midYearReview__room)), global($C))));
$midYearReview.addConstraint(some(join($this(), $onlineParticipant)));
$ondemandMeeting.addConstraint(implies(some(join($this(), $ondemandMeeting__chair)), equal(joinRef(join($this(), $ondemandMeeting__chair)), global($Joanna))));
$ondemandMeeting.addConstraint(none(join($this(), $onlineParticipant)));
$ondemandMeeting.addConstraint(implies(some(join($this(), $ondemandMeeting__room)), equal(joinRef(join($this(), $ondemandMeeting__room)), global($D))));
$Meeting.addConstraint(notIn(joinRef(join($this(), $Meeting__chair)), joinRef(join($this(), $participant))));
$Meeting.addConstraint(notIn(joinRef(join($this(), $Meeting__chair)), joinRef(join($this(), $onlineParticipant))));
$Meeting__room.addConstraint(greaterThanEqual(joinRef(join(joinRef($this()), $capacity)), add(card(join(joinParent($this()), $participant)), constant(1))));
$Meeting.addConstraint(implies(some(join($this(), $onlineParticipant)), some(join(joinRef(join($this(), $Meeting__room)), $Room__audioConferencing))));
$SueAgenda.addConstraint(implies(some(join($this(), $m1)), equal(joinRef(join($this(), $m1)), global($M1))));
$SueAgenda.addConstraint(implies(some(join($this(), $m2)), equal(joinRef(join($this(), $m2)), global($M2))));
$M2.addConstraint(implies(some(join($this(), $time)), equal(joinRef(join($this(), $time)), constant(10))));
