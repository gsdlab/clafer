digraph "scope_from_cardinality_constraints_nested"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Animal" [label="abstract Animal" URL="#Animal" tooltip="abstract Animal&#10;  leg *&#10;"];
"Owner" [label="abstract Owner" URL="#Owner" tooltip="abstract Owner&#10;  Pet : Animal&#10;"];
"SnakeOwner" [label="SnakeOwner : Owner +" URL="#SnakeOwner" tooltip="SnakeOwner : Owner +&#10;  [ no Pet.leg ]&#10;"];
"DogOwner" [label="DogOwner : Owner +" URL="#DogOwner" tooltip="DogOwner : Owner +&#10;  [ # Pet.leg = 4 ]&#10;"];
}