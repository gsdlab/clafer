<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/implicit_dref_in_union.cfr</div>

<div>
<span class="claferDecl" id="c0_AlicePicks">AlicePicks</span><span class="keyword"> ->> </span><a href="#integer"><span class="reference">integer</span></a> *</div>


<div>
<span class="claferDecl" id="c0_BobPicks">BobPicks</span><span class="keyword"> ->> </span><a href="#integer"><span class="reference">integer</span></a> *</div>


<div>
<span class="keyword">[</span> <a href="#c0_AlicePicks"><span class="reference">AlicePicks</span></a> = <a href="#c0_BobPicks"><span class="reference">BobPicks</span></a>++3 <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> 3++<a href="#c0_BobPicks"><span class="reference">BobPicks</span></a> = <a href="#c0_AlicePicks"><span class="reference">AlicePicks</span></a>.<span class="keyword">dref</span> <span class="keyword">]</span></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Person">Person</span></div>


<div>
<span class="claferDecl" id="c0_p1">p1</span><span class="keyword"> : </span><a href="#c0_Person"><span class="reference">Person</span></a></div>


<div>
<span class="claferDecl" id="c0_p2">p2</span><span class="keyword"> : </span><a href="#c0_Person"><span class="reference">Person</span></a></div>


<div>
<span class="claferDecl" id="c0_p3">p3</span><span class="keyword"> : </span><a href="#c0_Person"><span class="reference">Person</span></a></div>


<div>
<span class="claferDecl" id="c0_friends">friends</span><span class="keyword"> -> </span><a href="#c0_Person"><span class="reference">Person</span></a> *</div>


<div>
<span class="claferDecl" id="c0_others">others</span><span class="keyword"> -> </span><a href="#c0_Person"><span class="reference">Person</span></a> *</div>


<div>
<span class="keyword">[</span> <a href="#c0_friends"><span class="reference">friends</span></a> = <a href="#c0_others"><span class="reference">others</span></a>++<a href="#c0_p1"><span class="reference">p1</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <a href="#c0_others"><span class="reference">others</span></a> = <a href="#c0_p2"><span class="reference">p2</span></a> <span class="keyword">]</span></div>

</body>
</html>