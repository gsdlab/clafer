open util/integer
pred show {}


fact { 1 <= #A and #A <= 2 }
sig A
{ A_ref : one Int }

fact { 2 <= #B and #B <= 3 }
sig B
{ B_ref : one Int }

fact {  all disj x, y : B | (x.@B_ref) != (y.@B_ref)  }
fact { (min[A.@A_ref]) = (max[B.@B_ref]) }
assert assertAt_8_10 { (max[A.@A_ref]) >= (min[B.@B_ref]) }
check assertAt_8_10 for 1 but 2 A, 3 B

