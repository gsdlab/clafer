//# OPTIONS --explicit
abstract 0..* A 0..* {
  0..* a 1..1 {}
}
abstract 1..* B : A 0..* {
  0..* b 0..1 {}
}
abstract 1..* C : B 0..* {
  0..* c 0..1 {}
}
abstract 1..1 D : C 0..* {
  0..* d 0..1 {}
}
1..1 E : D 1..1 {
  0..* e 0..1 {}
}

assert [(((((#E . a) = 1) && ((#E . b) = 0)) && ((#E . c) = 0)) && ((#E . d) = 0)) && ((#E . e) = 0)]
