//# OPTIONS --explicit
abstract 0..* c0_A 0..* {
  0..* c0_a 1..1 {}
}
abstract 1..* c0_B : c0_A 0..* {
  0..* c0_b 0..1 {}
}
abstract 1..* c0_C : c0_B 0..* {
  0..* c0_c 0..1 {}
}
abstract 1..1 c0_D : c0_C 0..* {
  0..* c0_d 0..1 {}
}
1..1 c0_E : c0_D 1..1 {
  0..* c0_e 0..1 {}
}

assert [(((((#c0_E . c0_a) = 1) && ((#c0_E . c0_b) = 0)) && ((#c0_E . c0_c) = 0)) && ((#c0_E . c0_d) = 0)) && ((#c0_E . c0_e) = 0)]
