scope({$Animal:2, $leg:2});
defaultScope(1);
stringLength(16);

$Animal = Abstract("Animal");
$leg = $Animal.addChild("leg");
$Dog = Clafer("Dog");
$Spider = Clafer("Spider");
$Dog.extending($Animal);
$Spider.extending($Animal);
$Dog.addConstraint(equal(card(join($this(), $leg)), constant(4)));
$Spider.addConstraint(equal(card(join($this(), $leg)), constant(8)));
