digraph "inherited_reference_not_shared"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;"];
"JohnDoe" [label="JohnDoe : Person" URL="#JohnDoe" tooltip="JohnDoe : Person&#10;"];
"MaryJane" [label="MaryJane : Person" URL="#MaryJane" tooltip="MaryJane : Person&#10;"];
"WaitingLine" [label="abstract WaitingLine" URL="#WaitingLine" tooltip="abstract WaitingLine&#10;  participants -&gt; Person *&#10;"];
"WaitingLine" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=participants];
"BusLine" [label="BusLine : WaitingLine" URL="#BusLine" tooltip="BusLine : WaitingLine&#10;  [ JohnDoe in participants ][ MaryJane in participants ]&#10;"];
"JohnAndMaryLine" [label="JohnAndMaryLine : WaitingLine" URL="#JohnAndMaryLine" tooltip="JohnAndMaryLine : WaitingLine&#10;  [ participants = JohnDoe, MaryJane ]&#10;"];
}