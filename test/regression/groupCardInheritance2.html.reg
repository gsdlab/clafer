<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/groupCardInheritance2.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="A">A</span>
  <div class="indent">
  <span class="claferDecl" id="a">a</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="keyword">or</span> <span class="claferDecl" id="B">B</span><span class="keyword"> : </span><a href="#A"><span class="reference">A</span></a>
  <div class="indent">
  <span class="claferDecl" id="b">b</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="C">C</span><span class="keyword"> : </span><a href="#B"><span class="reference">B</span></a>
  <div class="indent">
  <span class="claferDecl" id="c">c</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="keyword">xor</span> <span class="claferDecl" id="D">D</span><span class="keyword"> : </span><a href="#C"><span class="reference">C</span></a>
  <div class="indent">
  <span class="claferDecl" id="d">d</span></div>
</div>


<div>
<span class="claferDecl" id="E">E</span><span class="keyword"> : </span><a href="#D"><span class="reference">D</span></a>
  <div class="indent">
  <span class="claferDecl" id="e">e</span></div>
</div>


<div>
<span class="keyword">assert [</span> <span class="keyword">one</span> <a href="#E"><span class="reference">E</span></a>.<a href="#a"><span class="reference">a</span></a> &amp;&amp; <span class="keyword">no</span> <a href="#E"><span class="reference">E</span></a>.<a href="#b"><span class="reference">b</span></a> &amp;&amp; <span class="keyword">no</span> <a href="#E"><span class="reference">E</span></a>.<a href="#c"><span class="reference">c</span></a> &amp;&amp; <span class="keyword">no</span> <a href="#E"><span class="reference">E</span></a>.<a href="#d"><span class="reference">d</span></a> &amp;&amp; <span class="keyword">no</span> <a href="#E"><span class="reference">E</span></a>.<a href="#e"><span class="reference">e</span></a> <span class="keyword">]</span></div>

</body>
</html>