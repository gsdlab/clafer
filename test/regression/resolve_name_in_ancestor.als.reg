open util/integer
pred show {}


one sig person
{ r_haha : one haha
, r_ble : one ble }

one sig haha
{ r_lala : one lala }

one sig lala
{ r_age : one age }

one sig age
{ age_ref : one Int }

one sig ble
{ r_married : lone married }

lone sig married
{}
{ one r_married
  ((((((this.~@r_married).~@r_ble).@r_haha).@r_lala).@r_age).@age_ref) >= 18 }

