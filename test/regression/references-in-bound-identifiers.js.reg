defaultScope(1);
stringLength(16);

$A = Clafer("A").withCard(1, 1);
$B = $A.addChild("B");
$C = $B.addChild("C").withCard(0, 1);
$B.refToUnique(Int);
$A.addConstraint(all([decl([$_b = local("b")], join($this(), $B))], some(join($_b, $C))));
$A.addConstraint(all([decl([$_b = local("b")], join($this(), $B))], equal(add(joinRef($_b), constant(1)), constant(2))));
