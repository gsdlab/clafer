<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/if_then_else_with_references.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Hardware">Hardware</span></div>


<div>
<span class="claferDecl" id="c0_h1">h1</span><span class="keyword"> : </span><a href="#c0_Hardware"><span class="reference">Hardware</span></a></div>


<div>
<span class="claferDecl" id="c0_h2">h2</span><span class="keyword"> : </span><a href="#c0_Hardware"><span class="reference">Hardware</span></a></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Software">Software</span>
  <div class="indent">
  <span class="claferDecl" id="c0_target">target</span><span class="keyword"> -> </span><a href="#c0_Hardware"><span class="reference">Hardware</span></a></div>
</div>


<div>
<span class="claferDecl" id="c0_s1">s1</span><span class="keyword"> : </span><a href="#c0_Software"><span class="reference">Software</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#c0_target"><span class="reference">target</span></a> = <a href="#c0_h1"><span class="reference">h1</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="c0_s2">s2</span><span class="keyword"> : </span><a href="#c0_Software"><span class="reference">Software</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#c0_target"><span class="reference">target</span></a> = <a href="#c0_h2"><span class="reference">h2</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="c0_noHardware">noHardware</span><span class="keyword"> -> </span><a href="#c0_Hardware"><span class="reference">Hardware</span></a> 0</div>


<div>
<span class="claferDecl" id="c0_uses">uses</span><span class="keyword"> -> </span><a href="#c0_Hardware"><span class="reference">Hardware</span></a> *</div>


<div>
<span class="keyword">[</span> <a href="#c0_uses"><span class="reference">uses</span></a> = <span class="keyword">if </span># <a href="#c0_Software"><span class="reference">Software</span></a> &gt; 0<span class="keyword"> then </span><a href="#c0_s1"><span class="reference">s1</span></a>.<a href="#c0_target"><span class="reference">target</span></a>++<a href="#c0_s2"><span class="reference">s2</span></a>.<a href="#c0_target"><span class="reference">target</span></a><span class="keyword"> else </span><a href="#c0_noHardware"><span class="reference">noHardware</span></a> <span class="keyword">]</span></div>

</body>
</html>