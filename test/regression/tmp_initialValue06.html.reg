<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_initialValue06.cfr</div>

<div>
<span class="claferDecl" id="A">A</span>
  <div class="indent">
  <span class="claferDecl" id="A__y">y</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="x">x</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> ? := <a href="#A__y"><span class="reference">y</span></a> + 1
    <div class="indent">
    <span class="claferDecl" id="x__y">y</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="z">z</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> := <span class="keyword">this</span>.<a href="#A__y"><span class="reference">y</span></a></div>
  <div class="indent">
  <span class="keyword">[</span> F (<a href="#x"><span class="reference">x</span></a> = 5 &amp;&amp; <a href="#x"><span class="reference">x</span></a>.<a href="#x__y"><span class="reference">y</span></a> = 7) <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Val">Val</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> := 2</div>


<div>
<span class="claferDecl" id="v1">v1</span><span class="keyword"> : </span><a href="#Val"><span class="reference">Val</span></a></div>


<div>
<span class="claferDecl" id="B">B</span>
  <div class="indent">
  <span class="claferDecl" id="v2">v2</span><span class="keyword"> : </span><a href="#Val"><span class="reference">Val</span></a></div>
</div>


<div>
<span class="keyword">[</span> F <a href="#v1"><span class="reference">v1</span></a> = 4 <span class="keyword">]</span></div>

</body>
</html>