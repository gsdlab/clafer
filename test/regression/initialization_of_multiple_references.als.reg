open util/integer
pred show {}


sig x
{ x_ref : one Int }

fact {  all disj x, y : x | (x.@x_ref) != (y.@x_ref)  }
fact { (some x) => ((x.@x_ref) = ((1 + 2) + 3)) }
abstract sig Person
{}

one sig p1 extends Person
{}

one sig p2 extends Person
{}

one sig p3 extends Person
{}

sig people
{ people_ref : one Person }

fact {  all disj x, y : people | (x.@people_ref) != (y.@people_ref)  }
fact { (some people) => ((people.@people_ref) = ((p1 + p1) + p3)) }
