open util/integer
pred show {}


sig c0_x
{ c0_x_ref : one Int }

fact {  all disj x, y : c0_x | (x.@c0_x_ref) != (y.@c0_x_ref)  }
fact { (some c0_x) => ((c0_x.@c0_x_ref) = ((1 + 2) + 3)) }
abstract sig c0_Person
{}

one sig c0_p1 extends c0_Person
{}

one sig c0_p2 extends c0_Person
{}

one sig c0_p3 extends c0_Person
{}

sig c0_people
{ c0_people_ref : one c0_Person }

fact {  all disj x, y : c0_people | (x.@c0_people_ref) != (y.@c0_people_ref)  }
fact { (some c0_people) => ((c0_people.@c0_people_ref) = ((c0_p1 + c0_p1) + c0_p3)) }
