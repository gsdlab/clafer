digraph "telematics"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"root__options" [label="abstract options" URL="#root__options" tooltip="abstract options&#10;  xor size&#10;    small&#10;    large&#10;  cache ?&#10;    size -&gt; integer&#10;      fixed ?&#10;  [ small &amp;&amp; cache => fixed ]&#10;"];
"comp" [label="abstract comp" URL="#comp" tooltip="abstract comp&#10;  version -&gt; integer = 1 + 2&#10;"];
"ECU" [label="abstract ECU : comp" URL="#ECU" tooltip="abstract ECU : comp&#10;"];
"root__display" [label="abstract display : comp" URL="#root__display" tooltip="abstract display : comp&#10;  server -&gt; ECU&#10;  `options&#10;  [ this.version >= server.version ]&#10;"];
"root__display" -> "ECU" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=server];
"root__display" -> "root__options" [arrowhead=vee arrowtail=diamond dir=both style=solid constraint=true weight=5 minlen=2 arrowsize=0.6 penwidth=0.5 ];
"plaECU" [label="abstract plaECU : ECU" URL="#plaECU" tooltip="abstract plaECU : ECU&#10;  `display 1..2&#10;    [ server = parent ][  ! options.cache ]&#10;"];
"plaECU" -> "root__display" [arrowhead=vee arrowtail=diamond dir=both style=solid constraint=true weight=5 minlen=2 arrowsize=0.6 penwidth=0.5 ];
"ECU1" [label="ECU1 : plaECU" URL="#ECU1" tooltip="ECU1 : plaECU&#10;"];
"ECU2" [label="ECU2 : plaECU ?" URL="#ECU2" tooltip="ECU2 : plaECU ?&#10;  master -&gt; ECU1&#10;"];
"ECU2" -> "ECU1" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=master];
"telematicsSystem" [label="telematicsSystem" URL="#telematicsSystem" tooltip="telematicsSystem&#10;  xor channel&#10;    single&#10;    dual&#10;  extraDisplay ?&#10;  xor size&#10;    small&#10;    large&#10;  [ dual <=> ECU2 ][ extraDisplay <=> # ECU1.display = 2 ][ extraDisplay <=> ECU2 => # ECU2.display = 2 ][ large <=>  ! plaECU.display.options.size.small ][ small <=>  ! plaECU.display.options.size.large ]&#10;"];
}