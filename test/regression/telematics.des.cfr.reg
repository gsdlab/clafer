//# OPTIONS --explicit
abstract 0..* root__options 0..* {
  1..1 options__size 1..1 {
    0..* options__size__small 0..1 {}
    0..* options__size__large 0..1 {}
  }
  0..* cache 0..1 {
    0..* cache__size -> int 1..1 {
      0..* fixed 0..1 {}
    }
  }
  [((some this.options__size.options__size__small) && (some this.cache)) => (some this.cache.cache__size.fixed)]
}
abstract 0..* comp 0..* {
  0..* version -> int 1..1 = 1 + 2 {}
}
abstract 0..* ECU : comp 0..* {}
abstract 0..* root__display : comp 0..* {
  0..* server -> ECU 1..1 {}
  0..* display__options : root__options 1..1 {}
  [this.version.dref >= this.server.dref.version.dref]
}
abstract 0..* plaECU : ECU 0..* {
  0..* plaECU__display : root__display 1..2 {
    [(this.server.dref = this.parent) && (no this.display__options.cache)]
  }
}
0..* ECU1 : plaECU 1..1 {}
0..* ECU2 : plaECU 0..1 {
  0..* master -> ECU1 1..1 {}
}
0..* telematicsSystem 1..1 {
  1..1 channel 1..1 {
    0..* single 0..1 {}
    0..* dual 0..1 {}
  }
  0..* extraDisplay 0..1 {}
  1..1 telematicsSystem__size 1..1 {
    0..* telematicsSystem__size__small 0..1 {}
    0..* telematicsSystem__size__large 0..1 {}
  }
  [(((((some this.channel.dual) <=> (some ECU2)) && ((some this.extraDisplay) <=> ((#ECU1.plaECU__display) = 2))) && ((some this.extraDisplay) <=> ((some ECU2) => ((#ECU2.plaECU__display) = 2)))) && ((some this.telematicsSystem__size.telematicsSystem__size__large) <=> (no plaECU.plaECU__display.display__options.options__size.options__size__small))) && ((some this.telematicsSystem__size.telematicsSystem__size__small) <=> (no plaECU.plaECU__display.display__options.options__size.options__size__large))]
}
[((some telematicsSystem.channel.dual) && (some telematicsSystem.extraDisplay)) && (some telematicsSystem.telematicsSystem__size.telematicsSystem__size__large)]
