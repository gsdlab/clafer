<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/EAST-ADL-PowerWindow.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Feature">Feature</span></div>


<div>
<span class="claferDecl" id="express">express</span><span class="keyword"> : </span><a href="#Feature"><span class="reference">Feature</span></a> ?</div>


<div>
<span class="keyword">[</span> <a href="#express"><span class="reference">express</span></a> &lt;=&gt; <a href="#downX"><span class="reference">downX</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Component">Component</span>
  <div class="indent">
  <span class="keyword">abstract</span> <span class="keyword">xor</span> <span class="claferDecl" id="Port">Port</span>
    <div class="indent">
    <span class="claferDecl" id="input">input</span></div>
    <div class="indent">
    <span class="claferDecl" id="output">output</span></div>
  </div>
</div>


<div>
<span class="keyword">enum</span> Command = <span class="claferDecl" id="motorUp">motorUp</span> | <span class="claferDecl" id="motorDown">motorDown</span> | <span class="claferDecl" id="motorStop">motorStop</span></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Request">Request</span></div>


<div>
<span class="claferDecl" id="up">up</span><span class="keyword"> : </span><a href="#Request"><span class="reference">Request</span></a></div>


<div>
<span class="claferDecl" id="down">down</span><span class="keyword"> : </span><a href="#Request"><span class="reference">Request</span></a></div>


<div>
<span class="claferDecl" id="downX">downX</span><span class="keyword"> : </span><a href="#Request"><span class="reference">Request</span></a> ?</div>


<div>
<span class="claferDecl" id="stop">stop</span><span class="keyword"> : </span><a href="#Request"><span class="reference">Request</span></a></div>


<div>
<span class="claferDecl" id="WinCtrl">WinCtrl</span><span class="keyword"> : </span><a href="#Component"><span class="reference">Component</span></a>
  <div class="indent">
  <span class="claferDecl" id="cmd">cmd</span><span class="keyword"> : </span><a href="#Port"><span class="reference">Port</span></a><span class="keyword"> -> </span><a href="#Command"><span class="reference">Command</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#output"><span class="reference">output</span></a> <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="req">req</span><span class="keyword"> : </span><a href="#Port"><span class="reference">Port</span></a><span class="keyword"> -> </span><a href="#Request"><span class="reference">Request</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#input"><span class="reference">input</span></a> <span class="keyword">]</span></div>
  </div>
</div>

</body>
</html>