defaultScope(1);
stringLength(16);

$Person = Abstract("Person");
$married = $Person.addChild("married").withCard(0, 1);
$child = $Person.addChild("child");
$Alice = Clafer("Alice").withCard(1, 1);
$Alice.extending($Person);
$child.refToUnique($Person);
$Alice.addConstraint(none(join($this(), $married)));
$Alice.addConstraint(none(join($this(), $child)));
