scope({c0_Feat:4, c0_Top:2, c0_f3:2, c0_h:2, c0_i:2});
defaultScope(1);
stringLength(16);

c0_a = Clafer("c0_a").withCard(1, 1);
c0_x = c0_a.addChild("c0_x").withCard(1, 1);
c0_extra = Clafer("c0_extra").withCard(0, 1);
c0_b = Clafer("c0_b").withCard(1, 1);
c0_Top = Abstract("c0_Top");
c0_top1 = Clafer("c0_top1").withCard(1, 1);
c0_top2 = Clafer("c0_top2").withCard(1, 1);
c0_Feat = Abstract("c0_Feat");
c0_f1 = Clafer("c0_f1").withCard(1, 1);
c0_g = Clafer("c0_g").withCard(1, 1);
c0_f2 = c0_g.addChild("c0_f2").withCard(1, 1);
c0_h = Clafer("c0_h").withCard(2, 2);
c0_i = c0_h.addChild("c0_i").withCard(1, 1);
c0_f3 = c0_i.addChild("c0_f3").withCard(1, 1);
c0_x.refToUnique(Int);
c0_b.addConstraint(some(global(c0_a)));
c0_b.addConstraint(lessThan(constant(0), constant(1)));
c0_b.addConstraint(lessThan(constant(0), constant(1)));
c0_b.addConstraint(equal(joinRef(join(global(c0_a), c0_x)), constant(2)));
c0_b.addConstraint(all([decl([v = local("v")], global(c0_b))], some(global(c0_a))));
c0_b.addConstraint(some(global(c0_a)));
c0_b.addConstraint(ifOnlyIf(some(global(c0_extra)), some(global(c0_extra))));
c0_b.addConstraint(implies(equal(ifThenElse(some(global(c0_extra)), constant(1), constant(0)), constant(1)), some(global(c0_extra))));
c0_b.addConstraint(implies(some(ifThenElse(some(global(c0_extra)), global(c0_a), constant(c0_a))), some(global(c0_extra))));
Constraint(lessThan(constant(0), constant(1)));
Constraint(equal(joinRef(join(global(c0_a), c0_x)), constant(2)));
c0_Top.addConstraint(lessThan(constant(0), constant(1)));
c0_top1.extending(c0_Top);
c0_top2.extending(c0_Top);
c0_Feat.addConstraint(and(and(implies($in($this(), global(c0_f1)), lessThan(constant(0), constant(1))), implies($in($this(), join(global(c0_g), c0_f2)), some(joinParent(inter($this(), join(global(c0_g), c0_f2)))))), implies($in($this(), join(join(global(c0_h), c0_i), c0_f3)), some(joinParent(inter($this(), join(join(global(c0_h), c0_i), c0_f3)))))));
c0_Feat.addConstraint(and(and(implies($in($this(), global(c0_f1)), lessThan(constant(0), constant(1))), implies($in($this(), join(global(c0_g), c0_f2)), equal(card(joinParent(inter($this(), join(global(c0_g), c0_f2)))), constant(1)))), implies($in($this(), join(join(global(c0_h), c0_i), c0_f3)), equal(card(joinParent(inter($this(), join(join(global(c0_h), c0_i), c0_f3)))), constant(1)))));
c0_f1.extending(c0_Feat);
c0_f2.extending(c0_Feat);
c0_f3.extending(c0_Feat);
