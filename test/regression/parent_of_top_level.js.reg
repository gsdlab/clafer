scope({$Feat:4, $Top:2, $f3:2, $h:2, $i:2});
defaultScope(1);
stringLength(16);

$a = Clafer("a").withCard(1, 1);
$x = $a.addChild("x").withCard(1, 1);
$extra = Clafer("extra").withCard(0, 1);
$b = Clafer("b").withCard(1, 1);
$Top = Abstract("Top");
$top1 = Clafer("top1").withCard(1, 1);
$top2 = Clafer("top2").withCard(1, 1);
$Feat = Abstract("Feat");
$f1 = Clafer("f1").withCard(1, 1);
$g = Clafer("g").withCard(1, 1);
$f2 = $g.addChild("f2").withCard(1, 1);
$h = Clafer("h").withCard(2, 2);
$i = $h.addChild("i").withCard(1, 1);
$f3 = $i.addChild("f3").withCard(1, 1);
$top1.extending($Top);
$top2.extending($Top);
$f1.extending($Feat);
$f2.extending($Feat);
$f3.extending($Feat);
$x.refToUnique(Int);
$b.addConstraint(some(global($a)));
$b.addConstraint(lessThan(constant(0), constant(1)));
$b.addConstraint(lessThan(constant(0), constant(1)));
$b.addConstraint(equal(joinRef(join(global($a), $x)), constant(2)));
$b.addConstraint(all([decl([$_v = local("v")], global($b))], some(global($a))));
$b.addConstraint(some(global($a)));
$b.addConstraint(ifOnlyIf(some(global($extra)), some(global($extra))));
$b.addConstraint(implies(equal(ifThenElse(some(global($extra)), constant(1), constant(0)), constant(1)), some(global($extra))));
$b.addConstraint(implies(some(ifThenElse(some(global($extra)), global($a), constant($a))), some(global($extra))));
Constraint(lessThan(constant(0), constant(1)));
Constraint(equal(joinRef(join(global($a), $x)), constant(2)));
$Top.addConstraint(lessThan(constant(0), constant(1)));
$Feat.addConstraint(and(and(implies($in($this(), global($f1)), lessThan(constant(0), constant(1))), implies($in($this(), join(global($g), $f2)), some(joinParent(inter($this(), join(global($g), $f2)))))), implies($in($this(), join(join(global($h), $i), $f3)), some(joinParent(inter($this(), join(join(global($h), $i), $f3)))))));
$Feat.addConstraint(and(and(implies($in($this(), global($f1)), lessThan(constant(0), constant(1))), implies($in($this(), join(global($g), $f2)), equal(card(joinParent(inter($this(), join(global($g), $f2)))), constant(1)))), implies($in($this(), join(join(global($h), $i), $f3)), equal(card(joinParent(inter($this(), join(join(global($h), $i), $f3)))), constant(1)))));
