digraph "check_unique_ref_names_with_inheritance"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"date" [label="abstract date -&gt;&gt; string" URL="#date" tooltip="abstract date -&gt;&gt; string&#10;"];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  Name -&gt; string&#10;  DateOfBirth : date&#10;"];
"JohnDoe" [label="JohnDoe : Person" URL="#JohnDoe" tooltip="JohnDoe : Person&#10;  [ Name = &quot;John&quot; ][ DateOfBirth = &quot;01/02/1985&quot; ]&#10;"];
}