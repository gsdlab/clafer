      <span class="claferDecl" id="deceleration">deceleration</span></div>
      <div class="indent">
      <span class="claferDecl" id="breaking">breaking</span></div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="withAntiLockBrakeSystem">withAntiLockBrakeSystem</span></div>
    <div class="indent">
    <span class="claferDecl" id="withTractionControlSystem">withTractionControlSystem</span></div>
  </div>
  <div class="indent">
  <span class="keyword">or</span> <span class="claferDecl" id="isNotOperational">isNotOperational</span>
    <div class="indent">
    <span class="claferDecl" id="whenTurnedOffByTheDriver">whenTurnedOffByTheDriver</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="whenDrivenInReverse">whenDrivenInReverse</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="duringSystemInitialization">duringSystemInitialization</span> ?</div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="Mode">Mode</span>
    <div class="indent">
    <span class="claferDecl" id="driverSelected">driverSelected</span> ?</div>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="type">type</span>
      <div class="indent">
      <span class="claferDecl" id="standard">standard</span></div>
      <div class="indent">
      <span class="claferDecl" id="performance">performance</span></div>
      <div class="indent">
      <span class="claferDecl" id="snowOrSlipperyRoad">snowOrSlipperyRoad</span></div>
      <div class="indent">
      <span class="claferDecl" id="type__Off">Off</span></div>
    </div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="entersStandardModeAfterIgnition">entersStandardModeAfterIgnition</span></div>
  <div class="indent">
  <span class="claferDecl" id="satisfies">satisfies</span>
