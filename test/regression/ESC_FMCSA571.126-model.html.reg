    <div class="indent">
    <span class="claferDecl" id="malfunctionDetected">malfunctionDetected</span>
      <div class="indent">
      <span class="claferDecl" id="mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists">mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists</span></div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="ignitionLockInOnPosition">ignitionLockInOnPosition</span></div>
    <div class="indent">
    <span class="claferDecl" id="mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected">mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected</span></div>
    <div class="indent">
    <span class="claferDecl" id="flashingWhenInOperation">flashingWhenInOperation</span> ?</div>
    <div class="indent">
