  </div>
  <div class="indent">
  <span class="claferDecl" id="hasOversteer">hasOversteer</span> ?</div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#yawRate"><span class="reference">yawRate</span></a> &gt; <a href="#normalYawRate"><span class="reference">normalYawRate</span></a> &lt;=&gt; <a href="#hasOversteer"><span class="reference">hasOversteer</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="hasUndersteer">hasUndersteer</span> ?</div>
