  <div class="indent">
  <span class="claferDecl" id="vehicle">vehicle</span><span class="keyword"> -> </span><a href="#Vehicle"><span class="reference">Vehicle</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="augmentsVehiclesDirectionalStability">augmentsVehiclesDirectionalStability</span>
    <div class="indent">
    <span class="claferDecl" id="adjustsBrakeTorquesToInduceCorrectingYawMoment">adjustsBrakeTorquesToInduceCorrectingYawMoment</span>
      <div class="indent">
      <span class="claferDecl" id="toEachWheelIndividually">toEachWheelIndividually</span></div>
    </div>
  </div>
  <div class="indent">
