    <span class="claferDecl" id="oversteer">oversteer</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="estimates">estimates</span>
    <div class="indent">
    <span class="claferDecl" id="YawRate">YawRate</span></div>
    <div class="indent">
    <span class="claferDecl" id="sideSlip">sideSlip</span>
      <div class="indent">
      <span class="claferDecl" id="derivativeWithRespectToTime">derivativeWithRespectToTime</span></div>
    </div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="monitors">monitors</span>
    <div class="indent">
    <span class="claferDecl" id="driverSteeringInputs">driverSteeringInputs</span></div>
    <div class="indent">
    <span class="claferDecl" id="modifiesEngineTorque">modifiesEngineTorque</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="isOperational">isOperational</span> ?
    <div class="indent">
    <span class="keyword">[</span> <a href="#vehicle"><span class="reference">vehicle</span></a>.<a href="#speed"><span class="reference">speed</span></a> &gt; 20 <span class="keyword">]</span></div>
    <div class="indent">
    <span class="claferDecl" id="duringAllPhasesOfDriving">duringAllPhasesOfDriving</span>
      <div class="indent">
      <span class="claferDecl" id="acceleration">acceleration</span></div>
