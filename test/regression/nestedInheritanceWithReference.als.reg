open util/integer
pred show {}


abstract sig System
{ r_Connection : set Connection
, r_connections : set connections }
{ all disj x, y : this.@r_connections | (x.@connections_ref) != (y.@connections_ref) 
  ((this.@r_connections).@connections_ref) = (this.@r_Connection) }

abstract sig Connection
{}
{ one @r_Connection.this }

sig connections
{ connections_ref : one Connection }
{ one @r_connections.this }

one sig SystemX extends System
{ r_con1 : one con1
, r_con2 : one con2 }
{ r_con1 in r_Connection
  r_con2 in r_Connection }

one sig con1 extends Connection
{}

one sig con2 extends Connection
{}

assert assertAt_10_10 { ((SystemX.@r_connections).@connections_ref) = ((SystemX.@r_con1) + (SystemX.@r_con2)) }
check assertAt_10_10 for 1 but 5 Connection, 2 System, 10 connections

one sig SystemY extends System
{ r_con3 : one con3
, r_con4 : one con4
, r_con5 : one con5 }
{ r_con3 in r_Connection
  r_con4 in r_Connection
  r_con5 in r_Connection }

one sig con3 extends Connection
{}

one sig con4 extends Connection
{}

one sig con5 extends Connection
{}

assert assertAt_17_10 { ((SystemY.@r_connections).@connections_ref) = (((SystemY.@r_con3) + (SystemY.@r_con4)) + (SystemY.@r_con5)) }
check assertAt_17_10 for 1 but 5 Connection, 2 System, 10 connections

