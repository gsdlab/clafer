scope({$Address:2, $City:2, $Country:2, $DateOfBirth:2, $Divorced:2, $Female:2, $Gender:2, $Male:2, $MaritalStatus:2, $Married:2, $Name:2, $NeverMarried:2, $NorthAmericanCountry:2, $OneToTenPersonLine:0, $Person:2, $PostalCode:2, $Street:2, $Surname:2, $TwoPersonLine:0, $UnitNo:2, $WaitingLine:2, $date:2, $participants:4});
defaultScope(1);
stringLength(16);

$date = Abstract("date");
$NorthAmericanCountry = Abstract("NorthAmericanCountry");
$Canada = Clafer("Canada").withCard(1, 1);
$USA = Clafer("USA").withCard(1, 1);
$Person = Abstract("Person");
$Name = $Person.addChild("Name").withCard(1, 1);
$Surname = $Person.addChild("Surname").withCard(1, 1);
$DateOfBirth = $Person.addChild("DateOfBirth").withCard(1, 1);
$Gender = $Person.addChild("Gender").withCard(1, 1).withGroupCard(1);
$Male = $Gender.addChild("Male").withCard(0, 1);
$Female = $Gender.addChild("Female").withCard(0, 1);
$MaritalStatus = $Person.addChild("MaritalStatus").withCard(1, 1).withGroupCard(1, 1);
$NeverMarried = $MaritalStatus.addChild("NeverMarried").withCard(0, 1);
$Married = $MaritalStatus.addChild("Married").withCard(0, 1);
$Divorced = $MaritalStatus.addChild("Divorced").withCard(0, 1);
$Address = $Person.addChild("Address").withCard(1, 1);
$Street = $Address.addChild("Street").withCard(1, 1);
$UnitNo = $Street.addChild("UnitNo").withCard(0, 1);
$City = $Address.addChild("City").withCard(1, 1);
$Country = $Address.addChild("Country").withCard(1, 1);
$PostalCode = $Address.addChild("PostalCode").withCard(1, 1);
$JohnDoe = Clafer("JohnDoe").withCard(1, 1);
$Student = Abstract("Student");
$StudentId = $Student.addChild("StudentId").withCard(1, 1);
$WaitingLine = Abstract("WaitingLine");
$participants = $WaitingLine.addChild("participants");
$MaryJane = Clafer("MaryJane").withCard(1, 1);
$BusLine = Clafer("BusLine").withCard(1, 1);
$JohnAndMaryLine = Clafer("JohnAndMaryLine").withCard(1, 1);
$TwoPersonLine = Abstract("TwoPersonLine");
$OneToTenPersonLine = Abstract("OneToTenPersonLine");
$date.refTo(string);
$Canada.extending($NorthAmericanCountry);
$USA.extending($NorthAmericanCountry);
$Name.refToUnique(string);
$Surname.refToUnique(string);
$DateOfBirth.extending($date);
$Street.refToUnique(string);
$UnitNo.refToUnique(string);
$City.refToUnique(string);
$Country.refToUnique($NorthAmericanCountry);
$PostalCode.refToUnique(string);
$JohnDoe.extending($Person);
$JohnDoe.addConstraint(and(and(and(and(and(and(and(and(equal(joinRef(join($this(), $Name)), constant("\"John\"")), equal(joinRef(join($this(), $Surname)), constant("\"Doe\""))), equal(joinRef(join($this(), $DateOfBirth)), constant("\"01/02/1985\""))), some(join(join($this(), $Gender), $Male))), some(join(join($this(), $MaritalStatus), $Married))), equal(joinRef(join(join($this(), $Address), $Street)), constant("\"123 Main St.\""))), equal(joinRef(join(join($this(), $Address), $City)), constant("\"Great Town\""))), equal(joinRef(join(join($this(), $Address), $Country)), global($Canada))), equal(joinRef(join(join($this(), $Address), $PostalCode)), constant("\"A1B 2C3\""))));
$Student.extending($Person);
$StudentId.refToUnique(string);
$participants.refToUnique($Person);
$MaryJane.extending($Student);
$MaryJane.addConstraint(equal(joinRef(join($this(), $StudentId)), constant("\"MJ13421354\"")));
$BusLine.extending($WaitingLine);
$BusLine.addConstraint(and($in(global($JohnDoe), joinRef(join($this(), $participants))), $in(global($MaryJane), joinRef(join($this(), $participants)))));
$JohnAndMaryLine.extending($WaitingLine);
$JohnAndMaryLine.addConstraint(equal(joinRef(join($this(), $participants)), union(global($JohnDoe), global($MaryJane))));
$TwoPersonLine.extending($WaitingLine);
$TwoPersonLine.addConstraint(equal(card(join($this(), $participants)), constant(2)));
$OneToTenPersonLine.extending($WaitingLine);
$OneToTenPersonLine.addConstraint(and(greaterThanEqual(card(join($this(), $participants)), constant(1)), lessThanEqual(card(join($this(), $participants)), constant(10))));
