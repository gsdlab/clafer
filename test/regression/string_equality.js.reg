defaultScope(1);
stringLength(16);

$text = Clafer("text").withCard(1, 1);
$text1 = Clafer("text1").withCard(1, 1);
$text2 = Clafer("text2").withCard(1, 1);
$equal1 = Clafer("equal1").withCard(0, 1);
$equal2 = Clafer("equal2").withCard(0, 1);
$text.refToUnique(string);
Constraint(implies(some(global($text)), equal(joinRef(global($text)), constant("\"some text\""))));
$text1.refToUnique(string);
Constraint(implies(some(global($text1)), equal(joinRef(global($text1)), constant("\"some text\""))));
$text2.refToUnique(string);
Constraint(implies(some(global($text2)), equal(joinRef(global($text2)), constant("\"some text\""))));
Constraint(implies(equal(joinRef(global($text)), joinRef(global($text1))), some(global($equal1))));
Constraint(implies(equal(joinRef(global($text1)), joinRef(global($text2))), some(global($equal2))));
assert(some(global($equal1)));
assert(some(global($equal2)));
