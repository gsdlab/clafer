//# OPTIONS --explicit --tl=10
0..* a 1..1 {
  1..1 b 1..1 {
    [G ((((#this . d) >= 1) && ((#this . e) = 0)) => (((#this . c) >= 1) W ((#this . e) >= 1)))]
    0..* c 0..1 {}
    0..* d 0..1 {}
    0..* e 0..1 {}
  }
}

assert [G ((((#a . b . d) >= 1) && ((#a . b . e) = 0)) => (((#a . b . c) = 0) W ((#a . b . e) >= 1)))]
