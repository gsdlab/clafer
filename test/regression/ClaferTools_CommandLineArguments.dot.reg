digraph "ClaferTools_CommandLineArguments"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Argument" [label="abstract Argument" URL="#Argument" tooltip="abstract Argument&#10;"];
"IntegerArgument" [label="abstract IntegerArgument -&gt;&gt; integer" URL="#IntegerArgument" tooltip="abstract IntegerArgument -&gt;&gt; integer&#10;"];
"StringArgument" [label="abstract StringArgument -&gt;&gt; string" URL="#StringArgument" tooltip="abstract StringArgument -&gt;&gt; string&#10;"];
"Value" [label="abstract Value" URL="#Value" tooltip="abstract Value&#10;"];
"DefaultValue" [label="abstract DefaultValue" URL="#DefaultValue" tooltip="abstract DefaultValue&#10;"];
"ClaferArgs" [label="abstract xor ClaferArgs" URL="#ClaferArgs" tooltip="abstract xor ClaferArgs&#10;  functional&#10;    xor mode : Argument&#10;      alloy : DefaultValue&#10;        noalloyruncommand : Argument ?&#10;        alloy_mapping : Argument ?&#10;      desclafer : Value&#10;      html : Value&#10;        [ keep_unused ]&#10;        self_contained : Argument ?&#10;        add_graph : Argument ?&#10;        add_comments : Argument ?&#10;      graph : Value&#10;        [ keep_unused ]&#10;      cvlGraph : Value&#10;        [ flatten_inheritance ]&#10;        [ keep_unused ]&#10;    keep_unused : Argument ?&#10;    flatten_inheritance : Argument ?&#10;    console_output : Argument ?&#10;    timeout_analysis : IntegerArgument ?&#10;    mux layout ?&#10;      no_layout : Argument&#10;      new_layout : Argument&#10;    check_duplicates : Argument ?&#10;    skip_resolver : Argument ?&#10;    no_stats : Argument ?&#10;    validate : Argument ?&#10;      [ no html ]&#10;      [ no graph ]&#10;      [ no cvlGraph ]&#10;      tooldir : StringArgument&#10;  schema : Argument&#10;  help : Argument&#10;  version : Argument&#10;"];
"ca1" [label="ca1 : ClaferArgs" URL="#ca1" tooltip="ca1 : ClaferArgs&#10;  [ alloy ]&#10;"];
"ca2" [label="ca2 : ClaferArgs" URL="#ca2" tooltip="ca2 : ClaferArgs&#10;  [ alloy ]&#10;  [ validate ]&#10;  [ tooldir = &quot;&tilde;/clafer-tools-0.3.1/tools&quot; ]&#10;"];
"ca3" [label="ca3 : ClaferArgs" URL="#ca3" tooltip="ca3 : ClaferArgs&#10;  [ alloy ]&#10;  [ keep_unused ]&#10;  [ flatten_inheritance ]&#10;"];
"ca4" [label="ca4 : ClaferArgs" URL="#ca4" tooltip="ca4 : ClaferArgs&#10;  [ html ]&#10;"];
"ca5" [label="ca5 : ClaferArgs" URL="#ca5" tooltip="ca5 : ClaferArgs&#10;  [ html ]&#10;  [ self_contained ]&#10;  [ add_graph ]&#10;  [ add_comments ]&#10;"];
"ca6" [label="ca6 : ClaferArgs" URL="#ca6" tooltip="ca6 : ClaferArgs&#10;  [ cvlGraph ]&#10;"];
}