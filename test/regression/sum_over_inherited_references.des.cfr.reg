//# OPTIONS --explicit
abstract 0..* Component 0..* {
  0..* energy ->> int 1..1 {}
}
0..* c1 : Component 1..1 {
  [this.energy.dref = 1]
}
0..* c2 : Component 1..1 {
  [this.energy.dref = 1]
}
0..* c3 : Component 1..1 {
  [this.energy.dref = 1]
}
0..* total ->> int 1..1 = sum Component.energy.dref {}

assert [total.dref = 3]
