open util/integer
pred show {}


one sig root
{ var r_a : set a }
fact { all self_ : root | always (one self_.@r_a) }

assert assertAt_6_8 { all self_ : root | always (eventually (some alive_a.@r_b)) }
check assertAt_6_8 for 1 but 10 steps



sig a
{ p_a : lone root
, var r_b : set b }
fun alive_a : set a { root.@r_a }
fact { always ~@r_a in @p_a }

fact { all self_ : a | always (self_ in alive_a implies (lone self_.@r_b)) }
fact { all self_ : a | always (self_ in alive_a implies (eventually (after (some self_.@r_b)))) }


sig b
{ p_b : lone a }
fun alive_b : set b { a.@r_b }
fact { always ~@r_b in @p_b
  always @r_b.univ in alive_a }


