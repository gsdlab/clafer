open util/integer
pred show {}


one sig root
{ var r_c0_a : set c0_a }
fact { all self_ : root | always (one self_.@r_c0_a) }

assert assertOnLine_6 { always (eventually (some alive_c0_a.@r_c0_b)) }
check assertOnLine_6 for 1 but 10 steps



sig c0_a
{ p_c0_a : lone root
, var r_c0_b : set c0_b }
fun alive_c0_a : set c0_a { root.@r_c0_a }
fact { always ~@r_c0_a in @p_c0_a }

fact { all self_ : c0_a | always (self_ in alive_c0_a implies (lone self_.@r_c0_b)) }
fact { all self_ : c0_a | always (self_ in alive_c0_a implies (eventually (not some (self_ & alive_c0_a) or (after (not some (self_ & alive_c0_a) or (some self_.@r_c0_b)))))) }


sig c0_b
{ p_c0_b : lone c0_a }
fun alive_c0_b : set c0_b { c0_a.@r_c0_b }
fact { always ~@r_c0_b in @p_c0_b
  always @r_c0_b.univ in alive_c0_a }


