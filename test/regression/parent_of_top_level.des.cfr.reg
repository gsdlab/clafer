//# OPTIONS --explicit
[0 < 1]
[a . x . dref = 2]
0..* a 1..1 {
  0..* x -> int 1..1 {}
}
0..* extra 0..1 {}
0..* b 1..1 {
  [(#a) >= 1]
  [0 < 1]
  [0 < 1]
  [a . x . dref = 2]
  [all v : b | (#a) >= 1]
  [(#a) >= 1]
  [((#extra) >= 1) <=> ((#extra) >= 1)]
  [((if ((#extra) >= 1) then 1 else 0) = 1) => ((#extra) >= 1)]
  [((#(if ((#extra) >= 1) then a else noclafer)) >= 1) => ((#extra) >= 1)]
}
abstract 0..* Top 0..* {
  [0 < 1]
}
0..* top1 : Top 1..1 {}
0..* top2 : Top 1..1 {}
abstract 0..* Feat 0..* {
  [(((this in f1) => (0 < 1)) && ((this in g . f2) => ((#(this ** g . f2) . parent) >= 1))) && ((this in h . i . f3) => ((#(this ** h . i . f3) . parent) >= 1))]
  [(((this in f1) => (0 < 1)) && ((this in g . f2) => ((#(this ** g . f2) . parent) = 1))) && ((this in h . i . f3) => ((#(this ** h . i . f3) . parent) = 1))]
}
0..* f1 : Feat 1..1 {}
0..* g 1..1 {
  0..* f2 : Feat 1..1 {}
}
0..* h 2..2 {
  0..* i 1..1 {
    0..* f3 : Feat 1..1 {}
  }
}
