scope({$A:2, $x:2, $y:2, $zs:4});
defaultScope(1);
stringLength(16);

$A = Clafer("A").withCard(2, 2);
$x = $A.addChild("x").withCard(1, 1);
$y = $A.addChild("y").withCard(0, 1);
$zs = $A.addChild("zs").withCard(0, 2);
$Val = Abstract("Val");
$v1 = Clafer("v1").withCard(1, 1);
$x.refToUnique(Int);
$A.addConstraint(implies(some(join($this(), $x)), equal(joinRef(join($this(), $x)), constant(10))));
$y.refToUnique(Int);
$A.addConstraint(implies(some(join($this(), $y)), equal(joinRef(join($this(), $y)), add(joinRef(join($this(), $x)), constant(1)))));
$zs.refToUnique(Int);
$A.addConstraint(implies(some(join($this(), $zs)), equal(joinRef(join($this(), $zs)), union(constant(1), constant(2)))));
$Val.refToUnique(Int);
Constraint(implies(some(global($Val)), equal(joinRef(global($Val)), constant(2))));
$v1.extending($Val);
