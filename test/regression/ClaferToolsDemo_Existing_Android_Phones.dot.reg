"AndroidPhone1" [label="AndroidPhone1" URL="#AndroidPhone1" tooltip="AndroidPhone1&#10;  Connectivity&#10;    Bluetooth40&#10;    GSM&#10;    WiFi&#10;    USB&#10;  Battery&#10;    LiBattery1450&#10;"];
"AndroidPhone2" [label="AndroidPhone2" URL="#AndroidPhone2" tooltip="AndroidPhone2&#10;  Connectivity&#10;    Bluetooth21&#10;    GSM&#10;    USB&#10;  Battery&#10;    LiBattery1150&#10;"];
"root__Bluetooth" [label="abstract xor Bluetooth" URL="#root__Bluetooth" tooltip="abstract xor Bluetooth&#10;  Bluetooth20 ?&#10;  Bluetooth21 ?&#10;  Bluetooth40 ?&#10;"];
"MobilePhone" [label="abstract MobilePhone" URL="#MobilePhone" tooltip="abstract MobilePhone&#10;  Connectivity&#10;    `Bluetooth&#10;    GSM&#10;    LTE ?&#10;      [ LiBattery1400 ]&#10;    WiFi ?&#10;    USB ?&#10;  xor Battery&#10;    LiBattery1150 ?&#10;    LiBattery1400 ?&#10;"];
