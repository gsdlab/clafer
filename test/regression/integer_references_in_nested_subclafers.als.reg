open util/integer
pred show {}


abstract sig Person
{ r_Age : one Age }

sig Age
{ Age_ref : one Int }
{ one @r_Age.this }

one sig Team
{ r_Contractor : one Contractor
, r_Member : set Member }
{ 2 <= #r_Member
  all disj x, y : this.@r_Member | (x.@Member_ref) != (y.@Member_ref)  }

one sig Contractor extends Person
{ r_since_1 : one since_1 }

one sig since_1
{ since_1_ref : one Int }

sig Member
{ Member_ref : one Person }
{ one @r_Member.this }

one sig Alice extends Person
{}

one sig Bob extends Person
{}

