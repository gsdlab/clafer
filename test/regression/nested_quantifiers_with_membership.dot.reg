"Teacher" [label="abstract Teacher" URL="#Teacher" tooltip="abstract Teacher&#10;  teaches -&gt; Course *&#10;"];
"Teacher" -> "Course" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="teaches"];
"course" [label="course : Course 5" URL="#course" tooltip="course : Course 5&#10;"];
