//# OPTIONS --explicit --tl=10
0..* A 0..* {
  0..* b 0..1 {}
  0..* c 0..1 {}
  [X (X (initially (some this.c)))]
  [!(initially (some this.b))]
  [(initially (some this.b)) => (finally (some this.c))]
  [(initially (some this.b)) <=> (finally (some this.c))]
  [(initially (some this.b)) xor (some this.c)]
  [if (some this.b) then (initially (some this.c)) else (finally (some this.c))]
  [no x : this.b | initially (some this.c)]
  [lone x : this.b | !(initially (some this.c))]
  0..* n -> int 1..1 {}
  [this.n.dref = (if (initially (some this.c)) then 1 else 2)]
  [!(this.n.dref = (if (some this.b) then 1 else (if (finally (some this.c)) then 2 else 3)))]
}
0..* d 0..1 {}
[!(initially (some d))]
