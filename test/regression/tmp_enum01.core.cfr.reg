0..* down : UserRequest 1..1 { // enum, tmp_enum01.cfr:9:32
  [all down_1 : this | X (down_1 in down)] // final, tmp_enum01.cfr:9:32
  [all down_1 : this | (previous ((#root) >= 1)) => (previous (down_1 in down))] // final, tmp_enum01.cfr:9:32
