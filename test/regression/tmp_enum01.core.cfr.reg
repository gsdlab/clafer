//# OPTIONS --explicit --core --tl=10
abstract 0..* UserRequest 0..* {} // enum, tmp_enum01.cfr:9:1
0..* stop : UserRequest 1..1 { // enum, tmp_enum01.cfr:9:20
  [all stop_1 : this | X (stop_1 in stop)] // final, tmp_enum01.cfr:9:20
  [all stop_1 : this | (previous ((#root) >= 1)) => (previous (stop_1 in stop))] // final, tmp_enum01.cfr:9:20
}
0..* up : UserRequest 1..1 { // enum, tmp_enum01.cfr:9:27
  [all up_1 : this | X (up_1 in up)] // final, tmp_enum01.cfr:9:27
  [all up_1 : this | (previous ((#root) >= 1)) => (previous (up_1 in up))] // final, tmp_enum01.cfr:9:27
