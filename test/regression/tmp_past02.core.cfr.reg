//# OPTIONS --explicit --core --tl=10
[(!(previous ((#root) >= 1))) => ((#Shift.Worker.alarm) >= 1)]
[(!(previous ((#root) >= 1))) => (X ((#Shift) = 0))]
[(!(previous ((#root) >= 1))) => (X (X (((#Shift.Worker) >= 1) && ((#Shift.Worker.alarm) = 0))))]
0..* Shift 0..1 {
  0..* Worker 0..1 {
    [((#this.warned) >= 1) <=> (previous (once ((#this.alarm) >= 1)))]
    0..* alarm 0..1 {}
    0..* warned 0..1 {}
  }
}

assert [(!(previous ((#root) >= 1))) => (X (X ((#Shift.Worker.warned) = 0)))]
