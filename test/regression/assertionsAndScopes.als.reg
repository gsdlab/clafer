open util/integer
pred show {}


fact { 2 <= #c0_a and #c0_a <= 2 }
sig c0_a
{ r_c0_b : set c0_b }
{ 3 <= #r_c0_b and #r_c0_b <= 3 }

sig c0_b
{ r_c0_c : set c0_c }
{ one @r_c0_b.this
  #r_c0_c = 0 }

sig c0_c
{}
{ one @r_c0_c.this }

assert assertAt_5_10 { no (c0_a.@r_c0_b).@r_c0_c }
check assertAt_5_10 for 1 but 2 c0_a, 6 c0_b, 0 c0_c

assert assertAt_7_10 { some c0_a.@r_c0_b }
check assertAt_7_10 for 1 but 2 c0_a, 6 c0_b, 0 c0_c

assert assertAt_9_10 { no (c0_a.@r_c0_b).@r_c0_c }
check assertAt_9_10 for 1 but 2 c0_a, 6 c0_b, 0 c0_c

assert assertAt_11_10 { (#(c0_a.@r_c0_b)) = 6 }
check assertAt_11_10 for 1 but 2 c0_a, 6 c0_b, 0 c0_c

