open util/integer
pred show {}


fact { 2 <= #a and #a <= 2 }
sig a
{ r_b : set b }
{ 3 <= #r_b and #r_b <= 3 }

sig b
{ r_c : set c }
{ one @r_b.this
  #r_c = 0 }

sig c
{}
{ one @r_c.this }

assert assertAt_5_10 { no (a.@r_b).@r_c }
check assertAt_5_10 for 1 but 2 a, 6 b, 0 c

assert assertAt_7_10 { some a.@r_b }
check assertAt_7_10 for 1 but 2 a, 6 b, 0 c

assert assertAt_9_10 { no (a.@r_b).@r_c }
check assertAt_9_10 for 1 but 2 a, 6 b, 0 c

assert assertAt_11_10 { (#(a.@r_b)) = 6 }
check assertAt_11_10 for 1 but 2 a, 6 b, 0 c

