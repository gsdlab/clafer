digraph "ancestor_in_reference_constraint"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"c0_Service" [label="abstract Service" URL="#c0_Service" tooltip="abstract Service&#10;  machine -&gt; Machine&#10;"];
"c0_Service" -> "c0_Machine" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=machine];
"c0_Machine" [label="abstract Machine" URL="#c0_Machine" tooltip="abstract Machine&#10;  services -&gt; Service *&#10;    [ this.machine = Machine ]&#10;    [ machine = parent ]&#10;"];
"c0_Machine" -> "c0_Service" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=services];
"c0_m1" [label="m1 : Machine" URL="#c0_m1" tooltip="m1 : Machine&#10;"];
"c0_m1" -> "c0_Machine" [arrowhead=onormal constraint=true weight=100];
"c0_m2" [label="m2 : Machine" URL="#c0_m2" tooltip="m2 : Machine&#10;"];
"c0_m2" -> "c0_Machine" [arrowhead=onormal constraint=true weight=100];
"c0_s1" [label="s1 : Service" URL="#c0_s1" tooltip="s1 : Service&#10;"];
"c0_s1" -> "c0_Service" [arrowhead=onormal constraint=true weight=100];
"c0_s2" [label="s2 : Service" URL="#c0_s2" tooltip="s2 : Service&#10;"];
"c0_s2" -> "c0_Service" [arrowhead=onormal constraint=true weight=100];
}