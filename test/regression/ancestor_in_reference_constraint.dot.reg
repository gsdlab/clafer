digraph "ancestor_in_reference_constraint"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Service" [label="abstract Service" URL="#Service" tooltip="abstract Service&#10;  machine -&gt; Machine&#10;"];
"Service" -> "Machine" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=machine];
"Machine" [label="abstract Machine" URL="#Machine" tooltip="abstract Machine&#10;  services -&gt; Service *&#10;    [ this.machine = Machine ]&#10;    [ machine = parent ]&#10;"];
"Machine" -> "Service" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=services];
"m1" [label="m1 : Machine" URL="#m1" tooltip="m1 : Machine&#10;"];
"m2" [label="m2 : Machine" URL="#m2" tooltip="m2 : Machine&#10;"];
"s1" [label="s1 : Service" URL="#s1" tooltip="s1 : Service&#10;"];
"s2" [label="s2 : Service" URL="#s2" tooltip="s2 : Service&#10;"];
}