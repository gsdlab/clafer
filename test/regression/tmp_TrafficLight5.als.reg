open util/integer
pred show {}


one sig c0_TrafficLight_5
{ r_c0_on : lone c0_on
, r_c0_off : lone c0_off }
{ let children = (r_c0_on + r_c0_off) | one children }

lone sig c0_on
{ r_c0_normal : lone c0_normal
, r_c0_flashing : lone c0_flashing }
{ one r_c0_on
  let children = (r_c0_normal + r_c0_flashing) | one children }

lone sig c0_normal
{}
{ one r_c0_normal }

lone sig c0_flashing
{}
{ one r_c0_flashing }

lone sig c0_off
{}
{ one r_c0_off }

