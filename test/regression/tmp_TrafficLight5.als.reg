open util/integer
pred show {}


one sig TrafficLight_5
{ r_on : lone on
, r_off : lone off }
{ let children = (r_on + r_off) | one children }

lone sig on
{ r_normal : lone normal
, r_flashing : lone flashing }
{ one r_on
  let children = (r_normal + r_flashing) | one children }

lone sig normal
{}
{ one r_normal }

lone sig flashing
{}
{ one r_flashing }

lone sig off
{}
{ one r_off }

