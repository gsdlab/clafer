open util/integer
pred show {}


abstract sig Person
{ r_married : lone married
, r_child : set child }
{ all disj x, y : this.@r_child | (x.@child_ref) != (y.@child_ref)  }

sig married
{}
{ one @r_married.this }

sig child
{ child_ref : one Person }
{ one @r_child.this }

one sig Alice extends Person
{}
{ no this.@r_married
  no this.@r_child }

