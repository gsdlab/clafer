digraph "nested-ifthenelse"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"x" [label="x ?" URL="#x" tooltip="x ?&#10;"];
"y" [label="y ?" URL="#y" tooltip="y ?&#10;"];
"z" [label="z ?" URL="#z" tooltip="z ?&#10;"];
"w" [label="w ?" URL="#w" tooltip="w ?&#10;"];
"u" [label="u ?" URL="#u" tooltip="u ?&#10;"];
"o" [label="o ?" URL="#o" tooltip="o ?&#10;"];
"p" [label="p ?" URL="#p" tooltip="p ?&#10;"];
"h" [label="h ?" URL="#h" tooltip="h ?&#10;"];
}