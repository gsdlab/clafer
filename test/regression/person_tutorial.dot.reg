digraph "person_tutorial"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"date" [label="abstract date -&gt;&gt; string" URL="#date" tooltip="abstract date -&gt;&gt; string&#10;"];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  Name -&gt; string&#10;  Surname -&gt; string&#10;  DateOfBirth : date&#10;  or Gender&#10;    Male&#10;    Female&#10;  xor MaritalStatus&#10;    NeverMarried&#10;    Married&#10;    Divorced&#10;  Address&#10;    Street -&gt; string&#10;      UnitNo -&gt; string ?&#10;    City -&gt; string&#10;    Country -&gt; NorthAmericanCountry&#10;    PostalCode -&gt; string&#10;"];
"Person" -> "NorthAmericanCountry" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=Country];
"JohnDoe" [label="JohnDoe : Person" URL="#JohnDoe" tooltip="JohnDoe : Person&#10;  [ Name = &quot;John&quot; ][ Surname = &quot;Doe&quot; ][ DateOfBirth = &quot;01/02/1985&quot; ][ Male ][ Married ][ Street = &quot;123 Main St.&quot; ][ City = &quot;Great Town&quot; ][ Country = Canada ][ PostalCode = &quot;A1B 2C3&quot; ]&#10;"];
"Student" [label="abstract Student : Person" URL="#Student" tooltip="abstract Student : Person&#10;  StudentId -&gt; string&#10;"];
"WaitingLine" [label="abstract WaitingLine" URL="#WaitingLine" tooltip="abstract WaitingLine&#10;  participants -&gt; Person *&#10;"];
"WaitingLine" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=participants];
"MaryJane" [label="MaryJane : Student" URL="#MaryJane" tooltip="MaryJane : Student&#10;  [ StudentId = &quot;MJ13421354&quot; ]&#10;"];
"BusLine" [label="BusLine : WaitingLine" URL="#BusLine" tooltip="BusLine : WaitingLine&#10;  [ JohnDoe in participants ][ MaryJane in participants ]&#10;"];
"JohnAndMaryLine" [label="JohnAndMaryLine : WaitingLine" URL="#JohnAndMaryLine" tooltip="JohnAndMaryLine : WaitingLine&#10;  [ participants = JohnDoe, MaryJane ]&#10;"];
"TwoPersonLine" [label="abstract TwoPersonLine : WaitingLine" URL="#TwoPersonLine" tooltip="abstract TwoPersonLine : WaitingLine&#10;  [ # participants = 2 ]&#10;"];
"OneToTenPersonLine" [label="abstract OneToTenPersonLine : WaitingLine" URL="#OneToTenPersonLine" tooltip="abstract OneToTenPersonLine : WaitingLine&#10;  [ # participants >= 1 ][ # participants <= 10 ]&#10;"];
}