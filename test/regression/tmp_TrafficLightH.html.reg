<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_TrafficLightH.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="keyword">xor</span> <span class="claferDecl" id="TrafficLight_H">TrafficLight_H</span>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="on">on</span><span class="tKeyword"> --&gt;&gt; </span><a href="#off"><span class="reference">off</span></a>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="normal">normal</span>
      <div class="indent">
      <span class="tKeyword">initial</span> <span class="claferDecl" id="green">green</span><span class="tKeyword"> --&gt; </span><a href="#yellow"><span class="reference">yellow</span></a></div>
      <div class="indent">
      <span class="claferDecl" id="yellow">yellow</span><span class="tKeyword"> --&gt; </span><a href="#red"><span class="reference">red</span></a></div>
      <div class="indent">
      <span class="claferDecl" id="red">red</span><span class="tKeyword"> --&gt; </span><a href="#green"><span class="reference">green</span></a></div>
    </div>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="flashing">flashing</span><span class="tKeyword"> --&gt;&gt; </span><a href="#normal"><span class="reference">normal</span></a>
      <div class="indent">
      <span class="tKeyword">initial</span> <span class="claferDecl" id="yellow_on">yellow_on</span><span class="tKeyword"> --&gt; </span><a href="#yellow_off"><span class="reference">yellow_off</span></a></div>
      <div class="indent">
      <span class="claferDecl" id="yellow_off">yellow_off</span><span class="tKeyword"> --&gt; </span><a href="#yellow_on"><span class="reference">yellow_on</span></a></div>
    </div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="off">off</span><span class="tKeyword"> --&gt; </span><a href="#on"><span class="reference">on</span></a></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#on"><span class="reference">on</span></a>.<a href="#normal"><span class="reference">normal</span></a> &amp;&amp; X <span class="keyword">no</span> <a href="#on"><span class="reference">on</span></a> =&gt; X (<span class="keyword">no</span> <a href="#on"><span class="reference">on</span></a> W <a href="#on"><span class="reference">on</span></a>.<a href="#normal"><span class="reference">normal</span></a>) <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#on"><span class="reference">on</span></a>.<a href="#flashing"><span class="reference">flashing</span></a> &amp;&amp; X <span class="keyword">no</span> <a href="#on"><span class="reference">on</span></a> =&gt; X (<span class="keyword">no</span> <a href="#on"><span class="reference">on</span></a> W <a href="#on"><span class="reference">on</span></a>.<a href="#flashing"><span class="reference">flashing</span></a>) <span class="keyword">]</span></div>
</div>

</body>
</html>