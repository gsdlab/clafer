digraph "constraints"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Phone" [label="abstract Phone" URL="#Phone" tooltip="abstract Phone&#10;  networking&#10;    wifi ?&#10;      typeB ?&#10;      typeG ?&#10;      typeN ?&#10;    bluetooth ?&#10;    mobile ?&#10;    nfc ?&#10;  xor location ?&#10;    gps&#10;    agps&#10;  gpu *&#10;"];
"PhoneWithGps" [label="PhoneWithGps : Phone" URL="#PhoneWithGps" tooltip="PhoneWithGps : Phone&#10;  [ gps ]&#10;"];
"PhoneWithWifi" [label="PhoneWithWifi : Phone" URL="#PhoneWithWifi" tooltip="PhoneWithWifi : Phone&#10;  [ networking.wifi.typeN ]&#10;"];
"PhonewithWifiAndGpsNoBluetoothOrNfc" [label="PhonewithWifiAndGpsNoBluetoothOrNfc : Phone" URL="#PhonewithWifiAndGpsNoBluetoothOrNfc" tooltip="PhonewithWifiAndGpsNoBluetoothOrNfc : Phone&#10;  [ wifi &amp;&amp; gps &amp;&amp;  ! (bluetooth || nfc) ]&#10;"];
"PhoneWithGpu" [label="PhoneWithGpu : Phone" URL="#PhoneWithGpu" tooltip="PhoneWithGpu : Phone&#10;  [ some gpu ]&#10;"];
}