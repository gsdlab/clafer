open util/integer
pred show {}


one sig Office
{ r_Printer : lone Printer
, r_Scanner : lone Scanner }

lone sig Printer
{ r_resolution : one resolution
, r_Cartridge : set Cartridge
, r_Type : one Type }
{ one r_Printer
  1 <= #r_Cartridge and #r_Cartridge <= 4 }

lone sig resolution
{ resolution_ref : one Int }
{ one r_resolution }

sig Cartridge
{ r_inkVolume : one inkVolume
, r_Speed : one Speed
, r_Turbo : lone Turbo }
{ one @r_Cartridge.this }

sig inkVolume
{ inkVolume_ref : one Int }
{ one @r_inkVolume.this }

sig Speed
{ r_High : lone High
, r_Low : lone Low }
{ one @r_Speed.this
  let children = (r_High + r_Low) | some children }

sig High
{}
{ one @r_High.this }

sig Low
{}
{ one @r_Low.this }

sig Turbo
{}
{ one @r_Turbo.this }

lone sig Type
{ r_Color : lone Color
, r_BW : lone BW }
{ one r_Type
  let children = (r_Color + r_BW) | one children }

lone sig Color
{}
{ one r_Color }

lone sig BW
{}
{ one r_BW }

lone sig Scanner
{ r_GreenMode : lone GreenMode
, r_Head : set Head }
{ one r_Scanner
  1 <= #r_Head and #r_Head <= 2 }

lone sig GreenMode
{}
{ one r_GreenMode }

sig Head
{}
{ one @r_Head.this }

one sig PrinterPool
{ r_fax : lone fax
, r_printer : lone printer
, r_copier : lone copier
, r_scan : lone scan }
{ (some this.@r_fax) => (some this.@r_printer) }

lone sig fax
{}
{ one r_fax }

lone sig printer
{}
{ one r_printer }

lone sig copier
{}
{ one r_copier }

lone sig scan
{}
{ one r_scan }

fact { ((some PrinterPool.@r_fax) => (some PrinterPool.@r_printer)) && ((some PrinterPool.@r_copier) => ((some PrinterPool.@r_fax) && (some PrinterPool.@r_printer))) }
