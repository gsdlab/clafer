open util/integer
pred show {}


abstract sig Book
{ r_title : one title
, r_year : one year
, r_page : set page
, r_format : one format
, r_kind : one kind
, r_authors : some authors
, r_ISBN : lone ISBN }
{ 2 <= #r_page
  all disj x, y : this.@r_authors | (x.@authors_ref) != (y.@authors_ref) 
  (((this.@r_year).@year_ref) >= 5) => (some this.@r_ISBN) }

sig title
{ title_ref : one Int
, r_subtitle : lone subtitle }
{ one @r_title.this }

sig subtitle
{ subtitle_ref : one Int }
{ one @r_subtitle.this }

sig year
{ year_ref : one Int }
{ one @r_year.this }

sig page
{}
{ one @r_page.this }

sig format
{ r_paper : lone paper
, r_electronic : lone electronic }
{ one @r_format.this
  let children = (r_paper + r_electronic) | one children }

sig paper
{ r_hardcover : lone hardcover }
{ one @r_paper.this }

sig hardcover
{}
{ one @r_hardcover.this }

sig electronic
{}
{ one @r_electronic.this }

sig kind
{ r_textbook : lone textbook
, r_manual : lone manual
, r_reference : lone reference
, r_fiction : lone fiction
, r_nonfiction : lone nonfiction
, r_other : lone other }
{ one @r_kind.this
  let children = (r_textbook + r_manual + r_reference + r_fiction + r_nonfiction + r_other) | one children }

sig textbook
{}
{ one @r_textbook.this }

sig manual
{}
{ one @r_manual.this }

sig reference
{}
{ one @r_reference.this }

sig fiction
{}
{ one @r_fiction.this }

sig nonfiction
{}
{ one @r_nonfiction.this }

sig other
{ other_ref : one Int }
{ one @r_other.this }

sig authors
{ authors_ref : one Author }
{ one @r_authors.this }

sig ISBN
{ ISBN_ref : one Int
, r_GS1 : lone GS1 }
{ one @r_ISBN.this
  ((((this.~@r_ISBN).@r_year).@year_ref) >= 6) => (some this.@r_GS1) }

sig GS1
{ GS1_ref : one Int }
{ one @r_GS1.this }

abstract sig Person
{ r_name : one name
, r_dob : lone dob }

sig name
{ name_ref : one Int }
{ one @r_name.this }

sig dob
{ dob_ref : one Int }
{ one @r_dob.this }

abstract sig Author extends Person
{ r_books : some books }
{ all disj x, y : this.@r_books | (x.@books_ref) != (y.@books_ref)  }

sig books
{ books_ref : one Book }
{ one @r_books.this }

one sig GenerativeProgramming extends Book
{}
{ ((((((((((this.@r_title).@title_ref) = 0) && (no (this.@r_title).@r_subtitle)) && (((this.@r_year).@year_ref) = 5)) && ((#(this.@r_page)) = 4)) && (some (this.@r_format).@r_paper)) && (some (this.@r_kind).@r_nonfiction)) && (((this.@r_authors).@authors_ref) = (Czarnecki + Eisenecker))) && (((this.@r_ISBN).@ISBN_ref) = 0)) && (no (this.@r_ISBN).@r_GS1) }

one sig Czarnecki extends Author
{}
{ (((this.@r_name).@name_ref) = 0) && (GenerativeProgramming in ((this.@r_books).@books_ref)) }

one sig Eisenecker extends Author
{}
{ (((this.@r_name).@name_ref) = 0) && (GenerativeProgramming in ((this.@r_books).@books_ref)) }

