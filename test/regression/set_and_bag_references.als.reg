open util/integer
pred show {}


abstract sig A
{}

some sig a extends A
{}

fact { 3 <= #setRefToA and #setRefToA <= 3 }
sig setRefToA
{ setRefToA_ref : one A }

fact {  all disj x, y : setRefToA | (x.@setRefToA_ref) != (y.@setRefToA_ref)  }
fact { 3 <= #multisetRefToA and #multisetRefToA <= 3 }
sig multisetRefToA
{ multisetRefToA_ref : one A }

