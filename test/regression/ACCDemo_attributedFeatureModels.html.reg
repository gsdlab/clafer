<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/ACCDemo_attributedFeatureModels.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Feature">Feature</span>
  <div class="indent">
  <span class="claferDecl" id="cost">cost</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="ComfortFeature">ComfortFeature</span><span class="keyword"> : </span><a href="#Feature"><span class="reference">Feature</span></a>
  <div class="indent">
  <span class="claferDecl" id="comfort">comfort</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="FuelFeature">FuelFeature</span><span class="keyword"> : </span><a href="#ComfortFeature"><span class="reference">ComfortFeature</span></a>
  <div class="indent">
  <span class="claferDecl" id="fuel">fuel</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Car">Car</span>
  <div class="indent">
  <span class="claferDecl" id="ABS">ABS</span><span class="keyword"> : </span><a href="#Feature"><span class="reference">Feature</span></a> ?
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 2 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="CC">CC</span><span class="keyword"> : </span><a href="#FuelFeature"><span class="reference">FuelFeature</span></a> ?
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#fuel"><span class="reference">fuel</span></a> = 1 <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#comfort"><span class="reference">comfort</span></a> = 3 <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 4 <span class="keyword">]</span></div>
    <div class="indent">
    <span class="claferDecl" id="ACC">ACC</span><span class="keyword"> : </span><a href="#FuelFeature"><span class="reference">FuelFeature</span></a> ?
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#fuel"><span class="reference">fuel</span></a> = 2 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#comfort"><span class="reference">comfort</span></a> = 6 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 3 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <a href="#FCA"><span class="reference">FCA</span></a> <span class="keyword">]</span></div>
    </div>
  </div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="Transmission">Transmission</span>
    <div class="indent">
    <span class="claferDecl" id="Automatic">Automatic</span><span class="keyword"> : </span><a href="#FuelFeature"><span class="reference">FuelFeature</span></a>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#fuel"><span class="reference">fuel</span></a> = 2 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#comfort"><span class="reference">comfort</span></a> = 2 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 3 <span class="keyword">]</span></div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="Manual">Manual</span><span class="keyword"> : </span><a href="#FuelFeature"><span class="reference">FuelFeature</span></a>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#fuel"><span class="reference">fuel</span></a> = 0 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#comfort"><span class="reference">comfort</span></a> = 1 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 2 <span class="keyword">]</span></div>
    </div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="FCA">FCA</span><span class="keyword"> : </span><a href="#FuelFeature"><span class="reference">FuelFeature</span></a> ?
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#fuel"><span class="reference">fuel</span></a> = 2 <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#comfort"><span class="reference">comfort</span></a> = 4 <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 5 <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="Sensor">Sensor</span>
      <div class="indent">
      <span class="claferDecl" id="Radar">Radar</span><span class="keyword"> : </span><a href="#Feature"><span class="reference">Feature</span></a>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 2 <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="Lidar">Lidar</span><span class="keyword"> : </span><a href="#Feature"><span class="reference">Feature</span></a>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 4 <span class="keyword">]</span></div>
      </div>
    </div>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="Alert">Alert</span>
      <div class="indent">
      <span class="claferDecl" id="Haptic">Haptic</span><span class="keyword"> : </span><a href="#ComfortFeature"><span class="reference">ComfortFeature</span></a>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#comfort"><span class="reference">comfort</span></a> = 4 <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 2 <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="Audible">Audible</span><span class="keyword"> : </span><a href="#ComfortFeature"><span class="reference">ComfortFeature</span></a>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#comfort"><span class="reference">comfort</span></a> = 2 <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#cost"><span class="reference">cost</span></a> = 1 <span class="keyword">]</span></div>
      </div>
    </div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="total_cost">total_cost</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> = <span class="keyword">sum </span><a href="#Feature"><span class="reference">Feature</span></a>.<a href="#cost"><span class="reference">cost</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="total_comfort">total_comfort</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> = <span class="keyword">sum </span><a href="#ComfortFeature"><span class="reference">ComfortFeature</span></a>.<a href="#comfort"><span class="reference">comfort</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="total_fuel">total_fuel</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> = <span class="keyword">sum </span><a href="#FuelFeature"><span class="reference">FuelFeature</span></a>.<a href="#fuel"><span class="reference">fuel</span></a></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="claferDecl" id="aCar">aCar</span><span class="keyword"> : </span><a href="#Car"><span class="reference">Car</span></a></div>

<!-- # FRAGMENT /-->

<div>
&lt;&lt;<span class="keyword">minimize </span><a href="#aCar"><span class="reference">aCar</span></a>.<a href="#total_cost"><span class="reference">total_cost</span></a>&gt;&gt;</div>


<div>
&lt;&lt;<span class="keyword">minimize </span><a href="#aCar"><span class="reference">aCar</span></a>.<a href="#total_fuel"><span class="reference">total_fuel</span></a>&gt;&gt;</div>


<div>
&lt;&lt;<span class="keyword">maximize </span><a href="#aCar"><span class="reference">aCar</span></a>.<a href="#total_comfort"><span class="reference">total_comfort</span></a>&gt;&gt;</div>

</body>
</html>