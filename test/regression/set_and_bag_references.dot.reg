digraph "set_and_bag_references"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"A" [label="abstract A" URL="#A" tooltip="abstract A&#10;"];
"a" [label="a : A +" URL="#a" tooltip="a : A +&#10;"];
"setRefToA" [label="setRefToA -&gt; A 3" URL="#setRefToA" tooltip="setRefToA -&gt; A 3&#10;"];
"setRefToA" -> "A" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"multisetRefToA" [label="multisetRefToA -&gt;&gt; A 3" URL="#multisetRefToA" tooltip="multisetRefToA -&gt;&gt; A 3&#10;"];
"multisetRefToA" -> "A" [arrowhead=veevee arrowsize=0.6 minlen=1.5 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}