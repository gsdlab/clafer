"c0_door" [label="xor door" URL="#c0_door" tooltip="xor door&#10;  initial closed&#10;  opened&#10;  [ closed -[signal]-&gt; opened ]&#10;  [ opened -[no signal]-&gt;&gt; closed ]&#10;"];
}