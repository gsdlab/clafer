//# OPTIONS --explicit --core --tl=10
abstract 0..* event 0..* {
  [X (no this)]
}
0..1 events 1..1 {
  0..* e1 : event 0..1 {}
  0..* e2 : event 0..1 {}
}
abstract 0..* Port 0..* {
  [some this.parent]
}
0..* sys 0..1 {
  0..* p1 : Port 1..1 {}
}
0..* top : Port 1..1 {}

assert [all e : event | X (no (e ** event))]
assert [all p : sys.p1 | p.parent = sys]
