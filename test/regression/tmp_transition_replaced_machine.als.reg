open util/integer
pred show {}


one sig root
{ var r_c0_go : set c0_go
, var r_c0_sm : set c0_sm }
fact { all self_ : root | always (lone self_.@r_c0_go) }
fact { all self_ : root | always (one self_.@r_c0_sm) }

assert assertAt_12_10 { all self_ : root | always (all  m : alive_c0_sm | ((some m.@r_c0_a) && (some alive_c0_go)) => (after ((some m.@r_c0_b) || (no m & alive_c0_sm)))) }
check assertAt_12_10 for 1 but 10 steps

assert assertAt_13_10 { all self_ : root | always (((some alive_c0_sm.@r_c0_a) && (some alive_c0_go)) => (after (some alive_c0_sm.@r_c0_b))) }
check assertAt_13_10 for 1 but 10 steps



sig c0_go
{ p_c0_go : lone root }
fun alive_c0_go : set c0_go { root.@r_c0_go }
fact { always ~@r_c0_go in @p_c0_go }


sig c0_sm
{ p_c0_sm : lone root
, var r_c0_a : set c0_a
, var r_c0_b : set c0_b
, var r_c0_c : set c0_c }
{ always (this in alive_c0_sm implies (let children = (this.@r_c0_a + this.@r_c0_b + this.@r_c0_c) | one children))
  always (this in alive_c0_sm and not before this in alive_c0_sm implies (some this.@r_c0_a)) }
fun alive_c0_sm : set c0_sm { root.@r_c0_sm }
fact { always ~@r_c0_sm in @p_c0_sm }

fact { all self_ : c0_sm | always (self_ in alive_c0_sm implies (lone self_.@r_c0_a)) }
fact { all self_ : c0_sm | always (self_ in alive_c0_sm implies (lone self_.@r_c0_b)) }
fact { all self_ : c0_sm | always (self_ in alive_c0_sm implies (lone self_.@r_c0_c)) }


sig c0_a
{ p_c0_a : lone c0_sm }
fun alive_c0_a : set c0_a { c0_sm.@r_c0_a }
fact { always ~@r_c0_a in @p_c0_a
  always @r_c0_a.univ in alive_c0_sm }

fact { all self_ : c0_a | always (self_ in alive_c0_a implies ((some alive_c0_go) => (after (not some self_.(@p_c0_a :> alive_c0_sm) or (some (self_.(@p_c0_a :> alive_c0_sm)).@r_c0_b))))) }


sig c0_b
{ p_c0_b : lone c0_sm }
fun alive_c0_b : set c0_b { c0_sm.@r_c0_b }
fact { always ~@r_c0_b in @p_c0_b
  always @r_c0_b.univ in alive_c0_sm }


sig c0_c
{ p_c0_c : lone c0_sm }
fun alive_c0_c : set c0_c { c0_sm.@r_c0_c }
fact { always ~@r_c0_c in @p_c0_c
  always @r_c0_c.univ in alive_c0_sm }


