//# OPTIONS --explicit --tl=10
[initially ((#Shift.Worker.alarm) >= 1)]
[initially (X ((#Shift) = 0))]
[initially (X (X (((#Shift.Worker) >= 1) && ((#Shift.Worker.alarm) = 0))))]
0..* Shift 0..1 {
  0..* Worker 0..1 {
    [((#this.warned) >= 1) <=> (previous (once ((#this.alarm) >= 1)))]
    0..* alarm 0..1 {}
    0..* warned 0..1 {}
  }
}

assert [initially (X (X ((#Shift.Worker.warned) = 0)))]
