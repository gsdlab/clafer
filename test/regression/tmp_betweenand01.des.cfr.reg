//# OPTIONS --explicit --tl=10
final 0..* a 1..1 {
  final 1..1 b 1..1 {
    0..* c 0..1 {}
    0..* d 0..1 {}
    0..* e 0..1 {}
    [always (some this.c) between (some this.d) and (some this.e)]
    [initially (sometime (some this.d))]
    [initially (sometime (some this.c))]
    [initially (sometime (some this.e))]
  }
}

assert [always (some a.b.c) between (some a.b.d) and (some a.b.e)]
