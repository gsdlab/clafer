//# OPTIONS --explicit --tl=10
final 0..* a 1..1 {
  final 1..1 b 1..1 {
    [G (((((#this . d) >= 1) && ((#this . e) = 0)) && (F ((#this . e) >= 1))) => (((#this . c) >= 1) U ((#this . e) >= 1)))]
    [initially (F ((#this . d) >= 1))]
    [initially (F ((#this . c) >= 1))]
    [initially (F ((#this . e) >= 1))]
    0..* c 0..1 {}
    0..* d 0..1 {}
    0..* e 0..1 {}
  }
}

assert [G (((((#a . b . d) >= 1) && ((#a . b . e) = 0)) && (F ((#a . b . e) >= 1))) => (((#a . b . c) >= 1) U ((#a . b . e) >= 1)))]
