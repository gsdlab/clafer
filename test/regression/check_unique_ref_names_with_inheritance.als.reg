open util/integer
pred show {}


abstract sig date
{ date_ref : one Int }

abstract sig Person
{ r_Name : one Name
, r_DateOfBirth : one DateOfBirth }

sig Name
{ Name_ref : one Int }
{ one @r_Name.this }

sig DateOfBirth extends date
{}
{ one @r_DateOfBirth.this }

one sig JohnDoe extends Person
{}
{ (((this.@r_Name).@Name_ref) = 0) && (((this.@r_DateOfBirth).@date_ref) = 1) }

