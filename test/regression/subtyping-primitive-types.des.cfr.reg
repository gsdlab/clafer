//# OPTIONS --explicit
abstract 0..* percent ->> int 0..* {
  [(this.dref >= 0) && (this.dref <= 5)]
}
0..* twoPercent : percent 1..1 = 2 {}
0..* threePercent : percent 1..1 = twoPercent.dref + 1 {}
abstract 0..* date ->> string 0..* {}
0..* today : date 1..1 = "Mar 20, 2012" {}
abstract 0..* time ->> int 0..* = time.minute.dref + time.hour.dref {
  0..* minute -> int 1..1 {
    [(this.dref >= 0) && (this.dref <= 5)]
  }
  0..* hour -> int 1..1 {
    [(this.dref >= 0) && (this.dref <= 5)]
  }
}
0..* now : time 1..1 {
  [this.minute.dref = 3]
  [this.hour.dref = 1]
}
