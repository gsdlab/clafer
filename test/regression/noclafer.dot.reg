digraph "noclafer"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"c0_Thing" [label="abstract Thing" URL="#c0_Thing" tooltip="abstract Thing&#10;"];
"c0_a" [label="a : Thing 0..2" URL="#c0_a" tooltip="a : Thing 0..2&#10;"];
"c0_a" -> "c0_Thing" [arrowhead=onormal constraint=true weight=100];
"c0_b" [label="b : Thing ?" URL="#c0_b" tooltip="b : Thing ?&#10;"];
"c0_b" -> "c0_Thing" [arrowhead=onormal constraint=true weight=100];
"c0_c" [label="c ?" URL="#c0_c" tooltip="c ?&#10;"];
}