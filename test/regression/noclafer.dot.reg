digraph "noclafer"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Thing" [label="abstract Thing" URL="#Thing" tooltip="abstract Thing&#10;"];
"a" [label="a : Thing 0..2" URL="#a" tooltip="a : Thing 0..2&#10;"];
"b" [label="b : Thing ?" URL="#b" tooltip="b : Thing ?&#10;"];
"c" [label="c ?" URL="#c" tooltip="c ?&#10;  d ?&#10;"];
}