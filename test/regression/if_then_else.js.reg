defaultScope(1);
stringLength(16);

$emergencyVehicle = Clafer("emergencyVehicle").withCard(0, 1);
$allWayYellow = Clafer("allWayYellow").withCard(0, 1);
$allYellow = Clafer("allYellow").withCard(0, 1);
$allYellow__flashing = $allYellow.addChild("allYellow__flashing").withCard(0, 1);
$warning = Clafer("warning").withCard(0, 1);
$warning__flashing = $warning.addChild("warning__flashing").withCard(0, 1);
$AliceAge = Clafer("AliceAge").withCard(1, 1);
$BobAge = Clafer("BobAge").withCard(1, 1);
$BobsBirthday = Clafer("BobsBirthday").withCard(0, 1);
$AliceAge.refToUnique(Int);
$BobAge.refToUnique(Int);
Constraint(implies(some(global($emergencyVehicle)), ifThenElse(some(global($allWayYellow)), some(global($allYellow)), some(global($warning)))));
Constraint(implies(some(global($emergencyVehicle)), ifThenElse(some(global($allWayYellow)), some(global($allYellow)), some(global($warning)))));
Constraint(equal(ifThenElse(some(global($BobsBirthday)), joinRef(global($BobAge)), joinRef(global($AliceAge))), constant(5)));
