open util/integer
pred show {}


one sig claferCompiler extends claferLib
{}

one sig claferIG extends claferLib
{}

one sig claferMOO extends claferLib
{ r_moo : one moo }

one sig moo
{}

abstract sig claferLib
{ r_common : one common
, r_front : one front
, r_intermediate : one intermediate
, r_optimizer : one optimizer
, r_generator : one generator }

sig common
{}
{ one @r_common.this }

sig front extends Front
{}
{ one @r_front.this }

sig intermediate extends Intermediate
{}
{ one @r_intermediate.this }

sig optimizer
{}
{ one @r_optimizer.this }

sig generator extends Generator
{}
{ one @r_generator.this
  let children = (r_alloy + r_stats + r_xml + r_desClafer + r_xsdSchema + r_input + r_output) | one children }

abstract sig Representation
{}

one sig text extends Representation
{}

one sig tokens extends Representation
{}

one sig ast extends Representation
{}

one sig ir extends Representation
{}

abstract sig io
{ r_input : one input
, r_output : one output }

sig input
{ input_ref : one Representation }
{ one @r_input.this }

sig output
{ output_ref : one Representation }
{ one @r_output.this }

abstract sig text2tokens extends io
{}
{ (((this.@r_input).@input_ref) = text) && (((this.@r_output).@output_ref) = tokens) }

abstract sig tokens2tokens extends io
{}
{ (((this.@r_input).@input_ref) = tokens) && (((this.@r_output).@output_ref) = tokens) }

abstract sig tokens2ast extends io
{}
{ (((this.@r_input).@input_ref) = tokens) && (((this.@r_output).@output_ref) = ast) }

abstract sig ast2ast extends io
{}
{ (((this.@r_input).@input_ref) = ast) && (((this.@r_output).@output_ref) = ast) }

abstract sig ast2text extends io
{}
{ (((this.@r_input).@input_ref) = ast) && (((this.@r_output).@output_ref) = text) }

abstract sig ast2ir extends io
{}
{ (((this.@r_input).@input_ref) = ast) && (((this.@r_output).@output_ref) = ir) }

abstract sig ir2ir extends io
{}
{ (((this.@r_input).@input_ref) = ir) && (((this.@r_output).@output_ref) = ir) }

abstract sig ir2text extends io
{}
{ (((this.@r_input).@input_ref) = ir) && (((this.@r_output).@output_ref) = text) }

abstract sig Front
{ r_lexer : one lexer
, r_layoutResolver : lone layoutResolver
, r_parser : one parser
, r_mapper : one mapper
, r_prettyPrinter : lone prettyPrinter }

sig lexer extends text2tokens
{}
{ one @r_lexer.this }

sig layoutResolver extends tokens2tokens
{ r_stable : lone stable
, r_experimental : lone experimental }
{ one @r_layoutResolver.this
  let children = (r_stable + r_experimental + r_input + r_output) | one children }

sig stable
{}
{ one @r_stable.this }

sig experimental
{}
{ one @r_experimental.this }

sig parser extends tokens2ast
{}
{ one @r_parser.this }

sig mapper extends ast2ast
{}
{ one @r_mapper.this }

sig prettyPrinter extends ast2text
{}
{ one @r_prettyPrinter.this }

abstract sig Intermediate
{ r_desugarer : one desugarer
, r_findDuplicates : lone findDuplicates
, r_resolver : lone resolver
, r_transformer : one transformer
, r_stringAnalyzer : lone stringAnalyzer
, r_scopeAnalysis : lone scopeAnalysis }

sig desugarer extends ast2ir
{}
{ one @r_desugarer.this }

sig findDuplicates
{}
{ one @r_findDuplicates.this }

sig resolver extends ir2ir
{ r_setUid : one setUid
, r_inheritanceFlattener : lone inheritanceFlattener
, r_nameResolution : one nameResolution }
{ one @r_resolver.this }

sig setUid
{}
{ one @r_setUid.this }

sig inheritanceFlattener
{}
{ one @r_inheritanceFlattener.this }

sig nameResolution
{ r_nameResolver : lone nameResolver
, r_inheritanceResolver : one inheritanceResolver
, r_typeResolver : one typeResolver }
{ one @r_nameResolution.this }

sig nameResolver
{}
{ one @r_nameResolver.this
  some (((this.~@r_nameResolver).~@r_nameResolution).~@r_resolver).@r_findDuplicates }

sig inheritanceResolver
{}
{ one @r_inheritanceResolver.this }

sig typeResolver
{}
{ one @r_typeResolver.this }

sig transformer extends ir2ir
{}
{ one @r_transformer.this }

sig stringAnalyzer extends ir2ir
{}
{ one @r_stringAnalyzer.this }

sig scopeAnalysis extends ir2ir
{}
{ one @r_scopeAnalysis.this }

abstract sig Generator extends ir2text
{ r_alloy : lone alloy
, r_stats : lone stats
, r_xml : lone xml
, r_desClafer : lone desClafer
, r_xsdSchema : lone xsdSchema }

sig alloy
{}
{ one @r_alloy.this
  (some Intermediate.@r_stringAnalyzer) && (some Intermediate.@r_scopeAnalysis) }

sig stats
{}
{ one @r_stats.this }

sig xml
{}
{ one @r_xml.this }

sig desClafer
{}
{ one @r_desClafer.this
  some Front.@r_prettyPrinter }

sig xsdSchema
{}
{ one @r_xsdSchema.this }

