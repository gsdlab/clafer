<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/Linux_model.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="tristate">tristate</span>
  <div class="indent">
  <span class="claferDecl" id="module">module</span> ?</div>
</div>


<div>
<span class="claferDecl" id="MISC_FILESYSTEMS">MISC_FILESYSTEMS</span> ?
  <div class="indent">
  <span class="claferDecl" id="MISC_FILESYSTEMS__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Miscellaneous filesystems"</div>
  <div class="indent">
  <span class="claferDecl" id="JFFS2_FS">JFFS2_FS</span><span class="keyword"> : </span><a href="#tristate"><span class="reference">tristate</span></a> ?
    <div class="indent">
    <span class="claferDecl" id="JFFS2_FS__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Journalling Flash File System"</div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#MTD"><span class="reference">MTD</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#MTD"><span class="reference">MTD</span></a> =&gt; <a href="#CRC32"><span class="reference">CRC32</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="claferDecl" id="FFS2_FS_DEBUG">FFS2_FS_DEBUG</span><span class="keyword"> -> </span><a href="#int"><span class="reference">int</span></a>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span> = 0 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="FFS2_FS_DEBUG__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "JFFS2 Debug level (0=quiet, 2=noisy)"</div>
      <div class="indent">
      <span class="keyword">[</span> 0 &lt;= <span class="keyword">this</span> &amp;&amp; <span class="keyword">this</span> &lt;= 2 <span class="keyword">]</span></div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="JFFS2_FS_WRITEBUFFER">JFFS2_FS_WRITEBUFFER</span> ?</div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#JFFS2_FS_WRITEBUFFER"><span class="reference">JFFS2_FS_WRITEBUFFER</span></a> &lt;=&gt; <a href="#HAS_IOMEM"><span class="reference">HAS_IOMEM</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="claferDecl" id="JFFS2_COMPRESS">JFFS2_COMPRESS</span> ?
      <div class="indent">
      <span class="claferDecl" id="JFFS2_COMPRESS__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Advanced compression options for JFFS2"</div>
      <div class="indent">
      <span class="keyword">[</span> <a href="#JFFS2_ZLIB"><span class="reference">JFFS2_ZLIB</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="JFFS2_ZLIB">JFFS2_ZLIB</span> ?
        <div class="indent">
        <span class="claferDecl" id="JFFS2_ZLIB__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Compress w/zlib..."</div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#ZLIB_INFLATE"><span class="reference">ZLIB_INFLATE</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="CompressionChoice">CompressionChoice</span>
        <div class="indent">
        <span class="claferDecl" id="CompressionChoice__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Default compression"</div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#JFFS2_CMODE_PRIORITY"><span class="reference">JFFS2_CMODE_PRIORITY</span></a> <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">xor</span> <span class="claferDecl" id="choice">choice</span>
          <div class="indent">
          <span class="claferDecl" id="JFFS2_CMODE_NONE">JFFS2_CMODE_NONE</span>
            <div class="indent">
            <span class="claferDecl" id="JFFS2_CMODE_NONE__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "no compression"</div>
          </div>
          <div class="indent">
          <span class="claferDecl" id="JFFS2_CMODE_PRIORITY">JFFS2_CMODE_PRIORITY</span>
            <div class="indent">
            <span class="claferDecl" id="JFFS2_CMODE_PRIORITY__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "priority"</div>
          </div>
          <div class="indent">
          <span class="claferDecl" id="JFFS2_CMODE_SIZE">JFFS2_CMODE_SIZE</span>
            <div class="indent">
            <span class="claferDecl" id="JFFS2_CMODE_SIZE__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "size (EXPERIMENTAL)"</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="claferDecl" id="MTD">MTD</span></div>


<div>
<span class="claferDecl" id="CRC32">CRC32</span></div>


<div>
<span class="claferDecl" id="HAS_IOMEM">HAS_IOMEM</span></div>


<div>
<span class="claferDecl" id="ZLIB_INFLATE">ZLIB_INFLATE</span></div>

</body>
</html>