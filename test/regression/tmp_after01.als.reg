open util/integer
pred show {}


one sig root
{ var r_a : set a
, r_e : set e }
fact { always (lone root.@r_a) }
fact { always (one root.@r_e) }

assert assertAt_12_9 { always (all  b1 : alive_a.@r_b | always ((!(some b1.@r_c)) || (after (!(some b1.@r_d))))) }
check assertAt_12_9 for 1 but 10 steps

assert assertAt_22_9 { always (always ((some (alive_e.@r_f).@r_g) => (always (no (alive_e.@r_f).@r_h)))) }
check assertAt_22_9 for 1 but 10 steps



sig a
{ p_a : lone root
, var r_b : set b }
fun alive_a : set a { root.@r_a }
fact { always ~@r_a in @p_a }

fact { all self_ : a | always (self_ in alive_a implies (one self_.@r_b)) }


sig b
{ p_b : lone a
, var r_c : set c
, var r_d : set d }
{ always (this in alive_b implies (let children = (this.@r_c + this.@r_d) | one children)) }
fun alive_b : set b { a.@r_b }
fact { always ~@r_b in @p_b
  always @r_b.univ in alive_a }

fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_c)) }
fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_d)) }
fact { all self_ : b | always (self_ in alive_b implies ((not some self_.(@p_b :> alive_a)) releases (not some self_.(@p_b :> alive_a) or ((some self_.@r_c) => ((not some self_.(@p_b :> alive_a)) releases (not some self_.(@p_b :> alive_a) or (no self_.@r_d))))))) }


sig c
{ p_c : lone b }
fun alive_c : set c { b.@r_c }
fact { always ~@r_c in @p_c
  always @r_c.univ in alive_b }


sig d
{ p_d : lone b }
fun alive_d : set d { b.@r_d }
fact { always ~@r_d in @p_d
  always @r_d.univ in alive_b }


sig e
{ p_e : lone root
, r_f : set f }
fun alive_e : set e { root.@r_e }
fact { always ~@r_e in @p_e }

fact { all self_ : e | always (self_ in alive_e implies (one self_.@r_f)) }
fact { all self_ : e | always (self_ in alive_e implies (all  e_1 : (self_ & alive_e) | after (e_1 in (alive_e)))) }
fact { all self_ : e | always (self_ in alive_e implies (all  e_1 : (self_ & alive_e) | (not before not (!(some root))) || (before (e_1 in (alive_e))))) }


sig f
{ p_f : lone e
, var r_g : set g
, var r_h : set h }
{ always (this in alive_f implies (let children = (this.@r_g + this.@r_h) | one children)) }
fun alive_f : set f { e.@r_f }
fact { always ~@r_f in @p_f
  always @r_f.univ in alive_e }

fact { all self_ : f | always (self_ in alive_f implies (lone self_.@r_g)) }
fact { all self_ : f | always (self_ in alive_f implies (lone self_.@r_h)) }
fact { all self_ : f | always (self_ in alive_f implies ((not some self_.(@p_f :> alive_e)) releases (not some self_.(@p_f :> alive_e) or ((some self_.@r_g) => ((not some self_.(@p_f :> alive_e)) releases (not some self_.(@p_f :> alive_e) or (no self_.@r_h))))))) }
fact { all self_ : f | always (self_ in alive_f implies (all  f_1 : (self_ & alive_f) | after (not some self_.(@p_f :> alive_e) or (f_1 in ((self_.(@p_f :> alive_e)).@r_f))))) }
fact { all self_ : f | always (self_ in alive_f implies (all  f_1 : (self_ & alive_f) | (not before (some self_.(@p_f :> alive_e) and not (!(some self_.(@p_f :> alive_e))))) || (before (some self_.(@p_f :> alive_e) and (f_1 in ((self_.(@p_f :> alive_e)).@r_f)))))) }


sig g
{ p_g : lone f }
fun alive_g : set g { f.@r_g }
fact { always ~@r_g in @p_g
  always @r_g.univ in alive_f }


sig h
{ p_h : lone f }
fun alive_h : set h { f.@r_h }
fact { always ~@r_h in @p_h
  always @r_h.univ in alive_f }


