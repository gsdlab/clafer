<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_parent_across_lifetimes.cfr</div>

<div>
<span class="claferDecl" id="c0_box">box</span> 2
  <div class="indent">
  <span class="claferDecl" id="c0_item">item</span> ?</div>
</div>


<div>
<span class="keyword">[</span> <span class="tKeyword">initially </span><span class="keyword">some</span> <a href="#c0_box"><span class="reference">box</span></a>.<a href="#c0_item"><span class="reference">item</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <span class="tKeyword">initially </span>(all i<span class="keyword"> : </span><a href="#c0_box"><span class="reference">box</span></a>.<a href="#c0_item"><span class="reference">item</span></a> | X (<span class="keyword">no</span> <a href="#i"><span class="reference">i</span></a>**<a href="#c0_box"><span class="reference">box</span></a>.<a href="#c0_item"><span class="reference">item</span></a> &amp;&amp; X <span class="keyword">some</span> <a href="#i"><span class="reference">i</span></a>**<a href="#c0_box"><span class="reference">box</span></a>.<a href="#c0_item"><span class="reference">item</span></a>)) <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> all b<span class="keyword"> : </span><a href="#c0_box"><span class="reference">box</span></a> | all i<span class="keyword"> : </span><a href="#b"><span class="reference">b</span></a>.<a href="#c0_item"><span class="reference">item</span></a> | G (<span class="keyword">some</span> <a href="#i"><span class="reference">i</span></a>**<a href="#c0_box"><span class="reference">box</span></a>.<a href="#c0_item"><span class="reference">item</span></a> =&gt; <span class="keyword">some</span> <a href="#i"><span class="reference">i</span></a>**<a href="#b"><span class="reference">b</span></a>.<a href="#c0_item"><span class="reference">item</span></a>) <span class="keyword">]</span></div>

</body>
</html>