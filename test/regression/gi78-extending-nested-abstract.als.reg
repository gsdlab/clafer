open util/integer
pred show {}


abstract sig Object
{}

abstract sig Person extends Object
{ r_Hand : set Hand
, r_Hook : set Hook }
{ r_Hook in r_Hand }

abstract sig Hand extends Object
{}
{ one @r_Hand.this }

abstract sig Hook extends Hand
{}
{ one @r_Hook.this }

one sig CptHookHand extends Person
{ r_CptHookHand__left : one CptHookHand__left
, r_CptHookHand__right : one CptHookHand__right }
{ r_CptHookHand__left in r_Hook
  r_CptHookHand__right in r_Hand }

one sig CptHookHand__left extends Hook
{}

one sig CptHookHand__right extends Hand
{}

one sig CptHandHook extends Person
{ r_CptHandHook__left : one CptHandHook__left
, r_CptHandHook__right : one CptHandHook__right }
{ r_CptHandHook__left in r_Hand
  r_CptHandHook__right in r_Hook }

one sig CptHandHook__left extends Hand
{}

one sig CptHandHook__right extends Hook
{}

