digraph "comments_and_html_directives"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"A" [label="A" URL="#A" tooltip="A&#10;  B&#10;  C ?&#10;"];
"D" [label="D -&gt; A" URL="#D" tooltip="D -&gt; A&#10;"];
"D" -> "A" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"E" [label="E ?" URL="#E" tooltip="E ?&#10;"];
}
