<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/nested_quantifiers_with_membership.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Course">Course</span>
  <div class="indent">
  <span class="claferDecl" id="taughtBy">taughtBy</span><span class="keyword"> -> </span><a href="#Teacher"><span class="reference">Teacher</span></a> *
    <div class="indent">
    <span class="claferDecl" id="x">x</span> ?</div>
  </div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Teacher">Teacher</span>
  <div class="indent">
  <span class="claferDecl" id="teaches">teaches</span><span class="keyword"> -> </span><a href="#Course"><span class="reference">Course</span></a> *</div>
</div>


<div>
<span class="keyword">[</span> all c<span class="keyword"> : </span><a href="#Course"><span class="reference">Course</span></a> | all t<span class="keyword"> : </span><a href="#c"><span class="reference">c</span></a>.<a href="#taughtBy"><span class="reference">taughtBy</span></a> | <a href="#t"><span class="reference">t</span></a>.<a href="#x"><span class="reference">x</span></a> &amp;&amp; <a href="#c"><span class="reference">c</span></a> in <a href="#t"><span class="reference">t</span></a>.<a href="#teaches"><span class="reference">teaches</span></a> <span class="keyword">]</span></div>


<div>
<span class="claferDecl" id="course">course</span><span class="keyword"> : </span><a href="#Course"><span class="reference">Course</span></a> 5</div>


<div>
<span class="claferDecl" id="teacher">teacher</span><span class="keyword"> : </span><a href="#Teacher"><span class="reference">Teacher</span></a> 3</div>

</body>
</html>