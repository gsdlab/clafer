//# OPTIONS --explicit --core
0..* claferA 1..1 {
  0..* claferB 1..1 {
    [some this.parent]
    0..* claferC 1..1 {
      [some this.parent]
      [some this.parent.claferC]
    }
  }
}
0..* Person 1..1 {
  0..* maritalStatus 1..1 {
    0..* married 1..1 {
      [some this.parent.parent]
    }
  }
}
