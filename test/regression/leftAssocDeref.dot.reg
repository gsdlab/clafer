digraph "leftAssocDeref"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"x" [label="x -&gt; integer" URL="#x" tooltip="x -&gt; integer&#10;  [ this = 1 ]&#10;  [ this.dref = 1 ]&#10;"];
"y" [label="y -&gt; x" URL="#y" tooltip="y -&gt; x&#10;  [ this = 1 ]&#10;  [ this.dref = 1 ]&#10;  [ this.dref.dref = 1 ]&#10;"];
"y" -> "x" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"z" [label="z -&gt; y" URL="#z" tooltip="z -&gt; y&#10;  [ this = 1 ]&#10;  [ this.dref = 1 ]&#10;  [ this.dref.dref = 1 ]&#10;  [ this.dref.dref.dref = 1 ]&#10;"];
"z" -> "y" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}