open util/integer
pred show {}


fact { #degree = 0 }
abstract sig degree
{ degree_ref : one Int }
{ ((this.@degree_ref) > 0) && ((this.@degree_ref) <= 360) }

fact { #Vehicle = 0 }
abstract sig Vehicle
{ r_Vehicle__DriveConfiguration : one Vehicle__DriveConfiguration
, r_Vehicle__ElectronicStabilityControlSystem : one Vehicle__ElectronicStabilityControlSystem
, r_Vehicle__AntiLockBreakSystem : one Vehicle__AntiLockBreakSystem
, r_Vehicle__TractionControlSystem : one Vehicle__TractionControlSystem
, r_AckermanSteerAngle : one AckermanSteerAngle
, r_speed : one speed
, r_lateralAcceleration : one lateralAcceleration
, r_sideSlipAngle : one sideSlipAngle
, r_yawRate : one yawRate
, r_normalYawRate : one normalYawRate
, r_hasOversteer : lone hasOversteer
, r_hasUndersteer : lone hasUndersteer
, r_GVWR : one GVWR }
{ ((((this.@r_yawRate).@yawRate_ref).@degree_ref) > (((this.@r_normalYawRate).@normalYawRate_ref).@degree_ref)) <=> (some this.@r_hasOversteer)
  ((((this.@r_yawRate).@yawRate_ref).@degree_ref) < (((this.@r_normalYawRate).@normalYawRate_ref).@degree_ref)) <=> (some this.@r_hasUndersteer) }

sig Vehicle__DriveConfiguration extends root__DriveConfiguration
{}
{ one @r_Vehicle__DriveConfiguration.this
  let children = (r_twoWheelDrive + r_frontWheelDrive + r_rearWheelDrive + r_allWheelDrive + r_fourWheelDrive) | one children }

sig Vehicle__ElectronicStabilityControlSystem extends root__ElectronicStabilityControlSystem
{}
{ one @r_Vehicle__ElectronicStabilityControlSystem.this }

sig Vehicle__AntiLockBreakSystem extends root__AntiLockBreakSystem
{}
{ one @r_Vehicle__AntiLockBreakSystem.this }

sig Vehicle__TractionControlSystem extends root__TractionControlSystem
{}
{ one @r_Vehicle__TractionControlSystem.this }

sig AckermanSteerAngle
{ AckermanSteerAngle_ref : one degree }
{ one @r_AckermanSteerAngle.this }

sig speed
{ speed_ref : one Int }
{ one @r_speed.this }

sig lateralAcceleration
{ lateralAcceleration_ref : one Int }
{ one @r_lateralAcceleration.this }

sig sideSlipAngle
{ sideSlipAngle_ref : one degree }
{ one @r_sideSlipAngle.this }

sig yawRate
{ yawRate_ref : one degree }
{ one @r_yawRate.this }

sig normalYawRate
{ normalYawRate_ref : one degree
, r_givenAckermanSteerAngle : one givenAckermanSteerAngle }
{ one @r_normalYawRate.this }

sig givenAckermanSteerAngle
{}
{ one @r_givenAckermanSteerAngle.this }

sig hasOversteer
{}
{ one @r_hasOversteer.this }

sig hasUndersteer
{}
{ one @r_hasUndersteer.this }

sig GVWR
{ GVWR_ref : one Int }
{ one @r_GVWR.this }

fact { #root__DriveConfiguration = 0 }
abstract sig root__DriveConfiguration
{ r_twoWheelDrive : lone twoWheelDrive
, r_frontWheelDrive : lone frontWheelDrive
, r_rearWheelDrive : lone rearWheelDrive
, r_allWheelDrive : lone allWheelDrive
, r_fourWheelDrive : lone fourWheelDrive }

sig twoWheelDrive
{}
{ one @r_twoWheelDrive.this }

sig frontWheelDrive
{}
{ one @r_frontWheelDrive.this }

sig rearWheelDrive
{}
{ one @r_rearWheelDrive.this }

sig allWheelDrive
{}
{ one @r_allWheelDrive.this }

sig fourWheelDrive
{ r_highGearWithLockedDifferential : lone highGearWithLockedDifferential
, r_lowGear : lone lowGear }
{ one @r_fourWheelDrive.this
  let children = (r_highGearWithLockedDifferential + r_lowGear) | one children }

sig highGearWithLockedDifferential
{}
{ one @r_highGearWithLockedDifferential.this }

sig lowGear
{}
{ one @r_lowGear.this }

fact { #root__ElectronicStabilityControlSystem = 0 }
abstract sig root__ElectronicStabilityControlSystem
{ r_vehicle : one vehicle
, r_augmentsVehiclesDirectionalStability : one augmentsVehiclesDirectionalStability
, r_limits : one limits
, r_estimates : one estimates
, r_monitors : one monitors
, r_isOperational : lone isOperational
, r_isNotOperational : one isNotOperational
, r_Mode : one Mode
, r_entersStandardModeAfterIgnition : one entersStandardModeAfterIgnition
, r_satisfies : one satisfies
, r_MalfunctionTelltale : lone MalfunctionTelltale
, r_SystemControls : one SystemControls }

sig vehicle
{ vehicle_ref : one Vehicle }
{ one @r_vehicle.this }

sig augmentsVehiclesDirectionalStability
{ r_adjustsBrakeTorquesToInduceCorrectingYawMoment : one adjustsBrakeTorquesToInduceCorrectingYawMoment }
{ one @r_augmentsVehiclesDirectionalStability.this }

sig adjustsBrakeTorquesToInduceCorrectingYawMoment
{ r_toEachWheelIndividually : one toEachWheelIndividually }
{ one @r_adjustsBrakeTorquesToInduceCorrectingYawMoment.this }

sig toEachWheelIndividually
{}
{ one @r_toEachWheelIndividually.this }

sig limits
{ r_understeer : one understeer
, r_oversteer : one oversteer }
{ one @r_limits.this }

sig understeer
{}
{ one @r_understeer.this }

sig oversteer
{}
{ one @r_oversteer.this }

sig estimates
{ r_YawRate : one YawRate
, r_sideSlip : one sideSlip }
{ one @r_estimates.this }

sig YawRate
{}
{ one @r_YawRate.this }

sig sideSlip
{ r_derivativeWithRespectToTime : one derivativeWithRespectToTime }
{ one @r_sideSlip.this }

sig derivativeWithRespectToTime
{}
{ one @r_derivativeWithRespectToTime.this }

sig monitors
{ r_driverSteeringInputs : one driverSteeringInputs
, r_modifiesEngineTorque : one modifiesEngineTorque }
{ one @r_monitors.this }

sig driverSteeringInputs
{}
{ one @r_driverSteeringInputs.this }

sig modifiesEngineTorque
{}
{ one @r_modifiesEngineTorque.this }

sig isOperational
{ r_duringAllPhasesOfDriving : one duringAllPhasesOfDriving
, r_withAntiLockBrakeSystem : one withAntiLockBrakeSystem
, r_withTractionControlSystem : one withTractionControlSystem }
{ one @r_isOperational.this
  (((((this.~@r_isOperational).@r_vehicle).@vehicle_ref).@r_speed).@speed_ref) > 20 }

sig duringAllPhasesOfDriving
{ r_acceleration : one acceleration
, r_coasting : one coasting
, r_deceleration : one deceleration
, r_breaking : one breaking }
{ one @r_duringAllPhasesOfDriving.this }

sig acceleration
{}
{ one @r_acceleration.this }

sig coasting
{}
{ one @r_coasting.this }

sig deceleration
{}
{ one @r_deceleration.this }

sig breaking
{}
{ one @r_breaking.this }

sig withAntiLockBrakeSystem
{}
{ one @r_withAntiLockBrakeSystem.this }

sig withTractionControlSystem
{}
{ one @r_withTractionControlSystem.this }

sig isNotOperational
{ r_whenTurnedOffByTheDriver : lone whenTurnedOffByTheDriver
, r_whenDrivenInReverse : lone whenDrivenInReverse
, r_duringSystemInitialization : lone duringSystemInitialization }
{ one @r_isNotOperational.this
  let children = (r_whenTurnedOffByTheDriver + r_whenDrivenInReverse + r_duringSystemInitialization) | some children }

sig whenTurnedOffByTheDriver
{}
{ one @r_whenTurnedOffByTheDriver.this }

sig whenDrivenInReverse
{}
{ one @r_whenDrivenInReverse.this }

sig duringSystemInitialization
{}
{ one @r_duringSystemInitialization.this }

sig Mode
{ r_driverSelected : lone driverSelected
, r_type : one type }
{ one @r_Mode.this }

sig driverSelected
{}
{ one @r_driverSelected.this }

sig type
{ r_standard : lone standard
, r_performance : lone performance
, r_snowOrSlipperyRoad : lone snowOrSlipperyRoad
, r_type__Off : lone type__Off }
{ one @r_type.this
  let children = (r_standard + r_performance + r_snowOrSlipperyRoad + r_type__Off) | one children }

sig standard
{}
{ one @r_standard.this }

sig performance
{}
{ one @r_performance.this }

sig snowOrSlipperyRoad
{}
{ one @r_snowOrSlipperyRoad.this }

sig type__Off
{}
{ one @r_type__Off.this }

sig entersStandardModeAfterIgnition
{}
{ one @r_entersStandardModeAfterIgnition.this }

sig satisfies
{ r_stabilityCriteria : one stabilityCriteria
, r_responsivenessCriterion : one responsivenessCriterion }
{ one @r_satisfies.this }

sig stabilityCriteria
{}
{ one @r_stabilityCriteria.this }

sig responsivenessCriterion
{}
{ one @r_responsivenessCriterion.this }

sig MalfunctionTelltale
{ r_malfunctionDetected : lone malfunctionDetected
, r_ignitionLockInOnPosition : lone ignitionLockInOnPosition
, r_mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected : lone mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected
, r_flashingWhenInOperation : lone flashingWhenInOperation
, r_mustIlluminateWhenIgnitionControlInCheckPosition : lone mustIlluminateWhenIgnitionControlInCheckPosition }
{ one @r_MalfunctionTelltale.this
  let children = (r_malfunctionDetected + r_ignitionLockInOnPosition + r_mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected + r_flashingWhenInOperation + r_mustIlluminateWhenIgnitionControlInCheckPosition) | some children }

sig malfunctionDetected
{ r_mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists : one mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists }
{ one @r_malfunctionDetected.this }

sig mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists
{}
{ one @r_mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists.this }

sig ignitionLockInOnPosition
{}
{ one @r_ignitionLockInOnPosition.this }

sig mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected
{}
{ one @r_mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected.this }

sig flashingWhenInOperation
{}
{ one @r_flashingWhenInOperation.this }

sig mustIlluminateWhenIgnitionControlInCheckPosition
{}
{ one @r_mustIlluminateWhenIgnitionControlInCheckPosition.this }

sig SystemControls
{ r_SystemControls__Off : one SystemControls__Off
, r_ignitionControlPosition : one ignitionControlPosition }
{ one @r_SystemControls.this }

sig SystemControls__Off
{}
{ one @r_SystemControls__Off.this }

sig ignitionControlPosition
{ r_ignitionControlPosition__Off : lone ignitionControlPosition__Off
, r_Check : lone Check
, r_On : lone On
, r_Start : lone Start }
{ one @r_ignitionControlPosition.this
  let children = (r_ignitionControlPosition__Off + r_Check + r_On + r_Start) | one children }

sig ignitionControlPosition__Off
{}
{ one @r_ignitionControlPosition__Off.this }

sig Check
{}
{ one @r_Check.this }

sig On
{}
{ one @r_On.this }

sig Start
{}
{ one @r_Start.this }

fact { #root__AntiLockBreakSystem = 0 }
abstract sig root__AntiLockBreakSystem
{}

fact { #root__TractionControlSystem = 0 }
abstract sig root__TractionControlSystem
