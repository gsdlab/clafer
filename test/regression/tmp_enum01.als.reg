open util/integer
pred show {}


one sig root
{ r_stop : set stop
, r_up : set up
, r_down : set down
, var r_Elevator : set Elevator }
fact { all self_ : root | always (one self_.@r_stop) }
fact { all self_ : root | always (one self_.@r_up) }
fact { all self_ : root | always (one self_.@r_down) }
fact { all self_ : root | always (one self_.@r_Elevator) }


abstract sig UserRequest
{}
fun alive_UserRequest : set UserRequest { alive_stop + alive_up + alive_down }

sig stop extends UserRequest
{ p_stop : lone root }
fun alive_stop : set stop { root.@r_stop }
fact { always ~@r_stop in @p_stop }


sig up extends UserRequest
{ p_up : lone root }
fun alive_up : set up { root.@r_up }
fact { always ~@r_up in @p_up }


sig down extends UserRequest
{ p_down : lone root }
fun alive_down : set down { root.@r_down }
fact { always ~@r_down in @p_down }


sig Elevator
{ p_Elevator : lone root
, var r_request : set request }
fun alive_Elevator : set Elevator { root.@r_Elevator }
fact { always ~@r_Elevator in @p_Elevator }

fact { all self_ : Elevator | always (self_ in alive_Elevator implies (one self_.@r_request)) }
fact { all self_ : Elevator | always (self_ in alive_Elevator implies ((not before self_ in alive_Elevator) implies (((self_.@r_request).@request_ref) = alive_stop))) }
fact { all self_ : Elevator | always (self_ in alive_Elevator implies (always ((((self_.@r_request).@request_ref) = alive_up) => (after (((self_.@r_request).@request_ref) = alive_stop))))) }


sig request
{ p_request : lone Elevator
, var request_ref : set UserRequest }
{ always (this in alive_request implies (one this.@request_ref))
  always (this in alive_request implies (this.@request_ref in alive_UserRequest)) }
fun alive_request : set request { Elevator.@r_request }
fact { always ~@r_request in @p_request
  always @r_request.univ in alive_Elevator }


