open util/integer
pred show {}


one sig root
{ r_c0_stop : set c0_stop
, r_c0_up : set c0_up
, r_c0_down : set c0_down
, var r_c0_Elevator : set c0_Elevator }
fact { all self_ : root | always (one self_.@r_c0_stop) }
fact { all self_ : root | always (one self_.@r_c0_up) }
fact { all self_ : root | always (one self_.@r_c0_down) }
fact { all self_ : root | always (one self_.@r_c0_Elevator) }


abstract sig c0_UserRequest
{}
fun alive_c0_UserRequest : set c0_UserRequest { alive_c0_stop + alive_c0_up + alive_c0_down }

sig c0_stop extends c0_UserRequest
{ p_c0_stop : lone root }
fun alive_c0_stop : set c0_stop { root.@r_c0_stop }
fact { always ~@r_c0_stop in @p_c0_stop }


sig c0_up extends c0_UserRequest
{ p_c0_up : lone root }
fun alive_c0_up : set c0_up { root.@r_c0_up }
fact { always ~@r_c0_up in @p_c0_up }


sig c0_down extends c0_UserRequest
{ p_c0_down : lone root }
fun alive_c0_down : set c0_down { root.@r_c0_down }
fact { always ~@r_c0_down in @p_c0_down }


sig c0_Elevator
{ p_c0_Elevator : lone root
, var r_c0_request : set c0_request }
fun alive_c0_Elevator : set c0_Elevator { root.@r_c0_Elevator }
fact { always ~@r_c0_Elevator in @p_c0_Elevator }

fact { all self_ : c0_Elevator | always (self_ in alive_c0_Elevator implies (one self_.@r_c0_request)) }
fact { all self_ : c0_Elevator | always (self_ in alive_c0_Elevator implies ((not before self_ in alive_c0_Elevator) implies (((self_.@r_c0_request).@c0_request_ref) = alive_c0_stop))) }
fact { all self_ : c0_Elevator | always (self_ in alive_c0_Elevator implies ((not some (self_ & alive_c0_Elevator)) releases (not some (self_ & alive_c0_Elevator) or ((((self_.@r_c0_request).@c0_request_ref) = alive_c0_up) => (after (not some (self_ & alive_c0_Elevator) or (((self_.@r_c0_request).@c0_request_ref) = alive_c0_stop))))))) }


sig c0_request
{ p_c0_request : lone c0_Elevator
, var c0_request_ref : set c0_UserRequest }
{ always (this in alive_c0_request implies (one this.@c0_request_ref))
  always (this in alive_c0_request implies (this.@c0_request_ref in alive_c0_UserRequest)) }
fun alive_c0_request : set c0_request { c0_Elevator.@r_c0_request }
fact { always ~@r_c0_request in @p_c0_request
  always @r_c0_request.univ in alive_c0_Elevator }


