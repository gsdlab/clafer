<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/abstract_multiplicity.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Tools">Tools</span> 3..6 </div>


<div>
<span class="claferDecl" id="hammer">hammer</span><span class="keyword"> : </span><a href="#Tools"><span class="reference">Tools</span></a> 1..2 </div>


<div>
<span class="claferDecl" id="saw">saw</span><span class="keyword"> : </span><a href="#Tools"><span class="reference">Tools</span></a> 0..5 </div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Bench">Bench</span>
  <div class="indent">
  <span class="keyword">abstract</span> <span class="claferDecl" id="Rack">Rack</span> ?</div>
</div>


<div>
<span class="claferDecl" id="Workbench">Workbench</span><span class="keyword"> : </span><a href="#Bench"><span class="reference">Bench</span></a> 2
  <div class="indent">
  <span class="claferDecl" id="big">big</span><span class="keyword"> : </span><a href="#Bench"><span class="reference">Bench</span></a>.<a href="#Rack"><span class="reference">Rack</span></a> ?</div>
  <div class="indent">
  <span class="claferDecl" id="small">small</span><span class="keyword"> : </span><a href="#Bench"><span class="reference">Bench</span></a>.<a href="#Rack"><span class="reference">Rack</span></a> ?</div>
</div>


<div>
<span class="keyword">assert [</span> # <a href="#Tools"><span class="reference">Tools</span></a> &gt;= 3 &amp;&amp; # <a href="#Tools"><span class="reference">Tools</span></a> &lt;= 6 <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> # <a href="#saw"><span class="reference">saw</span></a> &lt;= 5 <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> all w<span class="keyword"> : </span><a href="#Workbench"><span class="reference">Workbench</span></a> | # <a href="#w"><span class="reference">w</span></a>.<a href="#big"><span class="reference">big</span></a> + # <a href="#w"><span class="reference">w</span></a>.<a href="#small"><span class="reference">small</span></a> &lt;= 1 <span class="keyword">]</span></div>

</body>
</html>