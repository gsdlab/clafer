scope({$Machine:2, $Service:2, $machine:2, $services:4});
defaultScope(1);
stringLength(16);

$Service = Abstract("Service");
$machine = $Service.addChild("machine").withCard(1, 1);
$Machine = Abstract("Machine");
$services = $Machine.addChild("services");
$m1 = Clafer("m1").withCard(1, 1);
$m2 = Clafer("m2").withCard(1, 1);
$s1 = Clafer("s1").withCard(1, 1);
$s2 = Clafer("s2").withCard(1, 1);
$machine.refToUnique($Machine);
$services.refToUnique($Service);
$services.addConstraint(equal(joinRef(join(joinRef($this()), $machine)), joinParent($this())));
$services.addConstraint(equal(joinRef(join(joinRef($this()), $machine)), joinParent($this())));
$m1.extending($Machine);
$m2.extending($Machine);
$s1.extending($Service);
$s2.extending($Service);
Constraint(and($in(global($s1), joinRef(join(global($m1), $services))), $in(global($s2), joinRef(join(global($m2), $services)))));
