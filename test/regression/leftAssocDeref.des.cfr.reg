//# OPTIONS --explicit
[c0_x . dref = 1]
[c0_x . dref = 1]
[c0_y . dref . dref = 1]
[c0_y . dref . dref = 1]
[c0_y . dref . dref = 1]
[c0_z . dref . dref . dref = 1]
