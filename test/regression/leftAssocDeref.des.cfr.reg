  [this . dref . dref = 1]
  [this . dref . dref = 1]
  [this . dref . dref = 1]
}
0..* c0_z -> c0_y 1..1 {
  [this . dref . dref . dref = 1]
  [this . dref . dref . dref = 1]
  [this . dref . dref . dref = 1]
  [this . dref . dref . dref = 1]
}
