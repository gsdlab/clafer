open util/integer
pred show {}


one sig x
{ x_ref : one Int }
{ (this.@x_ref) = 1
  (this.@x_ref) = 1 }

fact { (x.@x_ref) = 1 }
fact { (x.@x_ref) = 1 }
one sig y
{ y_ref : one x }
{ ((this.@y_ref).@x_ref) = 1
  ((this.@y_ref).@x_ref) = 1
  ((this.@y_ref).@x_ref) = 1 }

fact { ((y.@y_ref).@x_ref) = 1 }
fact { ((y.@y_ref).@x_ref) = 1 }
fact { ((y.@y_ref).@x_ref) = 1 }
one sig z
{ z_ref : one y }
{ (((this.@z_ref).@y_ref).@x_ref) = 1
  (((this.@z_ref).@y_ref).@x_ref) = 1
  (((this.@z_ref).@y_ref).@x_ref) = 1
  (((this.@z_ref).@y_ref).@x_ref) = 1 }

fact { (((z.@z_ref).@y_ref).@x_ref) = 1 }
fact { (((z.@z_ref).@y_ref).@x_ref) = 1 }
fact { (((z.@z_ref).@y_ref).@x_ref) = 1 }
fact { (((z.@z_ref).@y_ref).@x_ref) = 1 }
