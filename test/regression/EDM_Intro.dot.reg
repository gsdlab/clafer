digraph "EDM_Intro"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"midYearReview" [label="midYearReview : Meeting" URL="#midYearReview" tooltip="midYearReview : Meeting&#10;  month -&gt; Month = June&#10;  chair -&gt; Member = Steven&#10;  room -&gt; Room = C&#10;  [ some onlineParticipant ]&#10;"];
"midYearReview" -> "Month" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=month];
"midYearReview" -> "Member" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=chair];
"midYearReview" -> "Room" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=room];
"Steven" [label="Steven : Member" URL="#Steven" tooltip="Steven : Member&#10;"];
"C" [label="C : Room" URL="#C" tooltip="C : Room&#10;  whiteboard&#10;  audioConferencing&#10;"];
"ondemandMeeting" [label="ondemandMeeting : Meeting" URL="#ondemandMeeting" tooltip="ondemandMeeting : Meeting&#10;  chair -&gt; Member = Joanna&#10;  [ no onlineParticipant ]&#10;  room -&gt; Room = D&#10;"];
"ondemandMeeting" -> "Member" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=chair];
"ondemandMeeting" -> "Room" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=room];
"Joanna" [label="Joanna : Member" URL="#Joanna" tooltip="Joanna : Member&#10;"];
"D" [label="D : Room" URL="#D" tooltip="D : Room&#10;  whiteboard&#10;"];
"Meeting" [label="abstract Meeting" URL="#Meeting" tooltip="abstract Meeting&#10;  chair -&gt; Member&#10;  participant -&gt; Member +&#10;  [ chair not in participant ]&#10;  onlineParticipant -&gt; Member *&#10;  [ chair not in onlineParticipant ]&#10;  room -&gt; Room&#10;    [ this.capacity >= # participant + 1 ]&#10;  [ some onlineParticipant => room.audioConferencing ]&#10;"];
"Meeting" -> "Member" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=chair];
"Meeting" -> "Member" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=participant];
"Meeting" -> "Member" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=onlineParticipant];
"Meeting" -> "Room" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=room];
"Member" [label="abstract Member" URL="#Member" tooltip="abstract Member&#10;"];
"Room" [label="abstract Room" URL="#Room" tooltip="abstract Room&#10;  capacity -&gt; integer&#10;  or whiteboard&#10;    traditional&#10;    electronic&#10;  projector ?&#10;  computer ?&#10;  audioConferencing ?&#10;"];
"M" [label="M : Member 5" URL="#M" tooltip="M : Member 5&#10;"];
"SueAgenda" [label="SueAgenda : Agenda" URL="#SueAgenda" tooltip="SueAgenda : Agenda&#10;  m1 -&gt; Meeting ? = M1&#10;  m2 -&gt; Meeting ? = M2&#10;"];
"SueAgenda" -> "Meeting" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=m1];
"SueAgenda" -> "Meeting" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=m2];
"M1" [label="M1 : Meeting ?" URL="#M1" tooltip="M1 : Meeting ?&#10;"];
"M2" [label="M2 : Meeting ?" URL="#M2" tooltip="M2 : Meeting ?&#10;  time -&gt; integer = 10&#10;"];
"Agenda" [label="abstract Agenda" URL="#Agenda" tooltip="abstract Agenda&#10;  mt -&gt; Meeting *&#10;"];
"Agenda" -> "Meeting" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=mt];
}