digraph "parent_navigation"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"claferA" [label="claferA" URL="#claferA" tooltip="claferA&#10;  claferB&#10;    [ parent ]&#10;    claferC&#10;      [ parent.claferC.parent ]&#10;      [ parent.claferC ]&#10;"];
"Person" [label="Person" URL="#Person" tooltip="Person&#10;  maritalStatus&#10;    married&#10;      [ parent.parent ]&#10;"];
}