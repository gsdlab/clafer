open util/integer
pred show {}


abstract sig Phone
{ r_networking : one networking
, r_location : lone location
, r_gpu : set gpu }

sig networking
{ r_wifi : lone wifi
, r_bluetooth : lone bluetooth
, r_mobile : lone mobile
, r_nfc : lone nfc }
{ one @r_networking.this }

sig wifi
{ r_typeB : lone typeB
, r_typeG : lone typeG
, r_typeN : lone typeN }
{ one @r_wifi.this }

sig typeB
{}
{ one @r_typeB.this }

sig typeG
{}
{ one @r_typeG.this }

sig typeN
{}
{ one @r_typeN.this }

sig bluetooth
{}
{ one @r_bluetooth.this }

sig mobile
{}
{ one @r_mobile.this }

sig nfc
{}
{ one @r_nfc.this }

sig location
{ r_gps : lone gps
, r_agps : lone agps }
{ one @r_location.this
  let children = (r_gps + r_agps) | one children }

sig gps
{}
{ one @r_gps.this }

sig agps
{}
{ one @r_agps.this }

sig gpu
{}
{ one @r_gpu.this }

one sig PhoneWithGps extends Phone
{}
{ some (this.@r_location).@r_gps }

one sig PhoneWithWifi extends Phone
{}
{ some ((this.@r_networking).@r_wifi).@r_typeN }

one sig PhonewithWifiAndGpsNoBluetoothOrNfc extends Phone
{}
{ ((some (this.@r_networking).@r_wifi) && (some (this.@r_location).@r_gps)) && (!((some (this.@r_networking).@r_bluetooth) || (some (this.@r_networking).@r_nfc))) }

one sig PhoneWithGpu extends Phone
{}
{ some this.@r_gpu }

fact { all  p : Phone | some (p.@r_networking).@r_mobile }
