digraph "primitiveTypesAndCoersions"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"I" [label="I -&gt; integer = 5" URL="#I" tooltip="I -&gt; integer = 5&#10;"];
"S" [label="S -&gt; string = &quot;some string&quot;" URL="#S" tooltip="S -&gt; string = &quot;some string&quot;&#10;"];
"R" [label="R -&gt; real = 3.1415" URL="#R" tooltip="R -&gt; real = 3.1415&#10;"];
"D" [label="D -&gt; double = 1.2e2" URL="#D" tooltip="D -&gt; double = 1.2e2&#10;"];
"R2" [label="R2 -&gt; real = 3.1415 + 6" URL="#R2" tooltip="R2 -&gt; real = 3.1415 + 6&#10;"];
"D2" [label="D2 -&gt; double = 3.1415e2 + 7" URL="#D2" tooltip="D2 -&gt; double = 3.1415e2 + 7&#10;"];
"R3" [label="R3 -&gt; real = 3.1415 + 6.0e0" URL="#R3" tooltip="R3 -&gt; real = 3.1415 + 6.0e0&#10;"];
"R4" [label="R4 -&gt; real = 8" URL="#R4" tooltip="R4 -&gt; real = 8&#10;"];
"D3" [label="D3 -&gt; double = 9" URL="#D3" tooltip="D3 -&gt; double = 9&#10;"];
"R5" [label="R5 -&gt; real = 3.0e0" URL="#R5" tooltip="R5 -&gt; real = 3.0e0&#10;"];
}