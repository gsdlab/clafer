digraph "maxMinArithmetic"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"a" [label="a -&gt; integer" URL="#a" tooltip="a -&gt; integer&#10;"];
"b" [label="b -&gt; integer" URL="#b" tooltip="b -&gt; integer&#10;"];
"c" [label="c -&gt; integer" URL="#c" tooltip="c -&gt; integer&#10;"];
"spread" [label="spread -&gt; integer = max a.dref, b.dref, c.dref - min a.dref, b.dref, c.dref" URL="#spread" tooltip="spread -&gt; integer = max a.dref, b.dref, c.dref - min a.dref, b.dref, c.dref&#10;"];
"range" [label="range -&gt; integer = max a.dref++b.dref++c.dref - min a.dref++b.dref++c.dref" URL="#range" tooltip="range -&gt; integer = max a.dref++b.dref++c.dref - min a.dref++b.dref++c.dref&#10;"];
"above" [label="above -&gt; integer = max a.dref++3 + 1" URL="#above" tooltip="above -&gt; integer = max a.dref++3 + 1&#10;"];
}