scope({$Person:2, $friend:2, $likes:2});
defaultScope(1);
stringLength(16);

$numberOne = Clafer("numberOne").withCard(1, 1);
$alice = Clafer("alice").withCard(1, 1);
$likertScaleVal = Clafer("likertScaleVal").withCard(1, 1);
$nonZero = Clafer("nonZero").withCard(1, 1);
$Person = Abstract("Person");
$Person__Head = $Person.addAbstractChild("Person__Head");
$likes = $Person.addChild("likes").withCard(0, 1);
$Alice = Clafer("Alice").withCard(1, 1);
$Alice__Head = $Alice.addChild("Alice__Head").withCard(1, 1);
$Ella = Clafer("Ella").withCard(1, 1);
$h = $Ella.addChild("h").withCard(1, 1);
$heads = Clafer("heads");
$friend = Clafer("friend").withCard(2, 2);
$onlyAlice = Clafer("onlyAlice").withCard(1, 1);
$exceptElla = Clafer("exceptElla").withCard(1, 1);
$Alice.extending($Person);
$Alice__Head.extending($Person__Head);
$Ella.extending($Person);
$numberOne.refToUnique(Int);
$alice.refToUnique(string);
$likertScaleVal.refToUnique(Int);
$nonZero.refToUnique(Int);
$likes.refToUnique($Person);
$heads.refToUnique($Person__Head);
$friend.refToUnique($Person);
$onlyAlice.refToUnique($Person);
$exceptElla.refToUnique($Person);
Constraint(implies(some(global($numberOne)), equal(joinRef(global($numberOne)), constant(1))));
Constraint(implies(some(global($alice)), equal(joinRef(global($alice)), constant("\"Alice\""))));
$likertScaleVal.addConstraint(or(or(or(or(equal(joinRef($this()), constant(1)), equal(joinRef($this()), constant(2))), equal(joinRef($this()), constant(3))), equal(joinRef($this()), constant(4))), equal(joinRef($this()), constant(5))));
$nonZero.addConstraint(not(equal(joinRef($this()), constant(0))));
$Alice.addConstraint(equal(joinRef(join($this(), $likes)), global($Ella)));
$Ella.addConstraint(none(join($this(), $likes)));
$friend.addConstraint($in(joinRef($this()), union(global($Alice), global($Ella))));
$onlyAlice.addConstraint($in(joinRef($this()), inter(global($Alice), global($Person))));
assert($in(global($Alice), joinRef(global($onlyAlice))));
assert(notIn(global($Ella), joinRef(global($onlyAlice))));
$exceptElla.addConstraint($in(joinRef($this()), diff(global($Person), global($Ella))));
assert($in(global($Alice), joinRef(global($exceptElla))));
assert(notIn(global($Ella), joinRef(global($exceptElla))));
