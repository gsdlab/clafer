scope({$Bob__Head:2, $Person:2, $Person__Head:5, $ears:2, $hair:5, $redHair:2});
defaultScope(1);
stringLength(16);

$Person = Abstract("Person");
$Person__Head = $Person.addAbstractChild("Person__Head");
$hair = $Person__Head.addChild("hair").withCard(0, 1);
$Ella = Clafer("Ella").withCard(1, 1);
$h1 = $Ella.addChild("h1").withCard(1, 1);
$h2 = $Ella.addChild("h2").withCard(1, 1);
$Bob = Clafer("Bob").withCard(1, 1);
$Bob__Head = $Bob.addAbstractChild("Bob__Head");
$redHair = $Bob__Head.addChild("redHair").withCard(0, 1);
$h3 = $Bob.addChild("h3").withCard(1, 1);
$h4 = $Bob.addChild("h4").withCard(1, 1);
$h5 = $Bob.addChild("h5").withCard(1, 1);
$Dog = Abstract("Dog");
$Dog__Head = $Dog.addAbstractChild("Dog__Head");
$ears = $Dog__Head.addChild("ears").withCard(2, 2);
$Rex = Clafer("Rex").withCard(1, 1);
$h6 = $Rex.addChild("h6").withCard(1, 1);
$A = Abstract("A");
$B = $A.addAbstractChild("B");
$C = $B.addAbstractChild("C");
$x = $C.addChild("x").withCard(0, 1);
$D = Clafer("D").withCard(1, 1);
$b = $D.addChild("b").withCard(1, 1);
$c = $b.addChild("c").withCard(1, 1);
$Ella.extending($Person);
$h1.extending($Person__Head);
$h2.extending($Person__Head);
$Bob.extending($Person);
$Bob__Head.extending($Person__Head);
$h3.extending($Bob__Head);
$h4.extending($Person__Head);
$h5.extending($Bob__Head);
$Rex.extending($Dog);
$h6.extending($Dog__Head);
$D.extending($A);
$b.extending($B);
$c.extending($C);
$Ella.addConstraint(and(some(join(join($this(), $h1), $hair)), none(join(join($this(), $h2), $hair))));
$Bob.addConstraint(and(and(and(some(join(join($this(), $h3), $redHair)), some(join(join($this(), $h3), $hair))), none(join(join($this(), $h4), $hair))), none(join(join($this(), $h5), $redHair))));
$Rex.addConstraint(equal(card(join(join($this(), $h6), $ears)), constant(2)));
$b.addConstraint(some(join(join($this(), $c), $x)));
