open util/integer
pred show {}


one sig root
{ r_a : set a }
fact { always (one root.@r_a) }

assert assertAt_15_8 { always (always (((!((some (alive_a.@r_b).@r_d) && (no (alive_a.@r_b).@r_e))) || (always (!(some (alive_a.@r_b).@r_e)))) || ((some (alive_a.@r_b).@r_c) until (some (alive_a.@r_b).@r_e)))) }
check assertAt_15_8 for 1 but 10 steps



sig a
{ p_a : lone root
, r_b : set b }
fun alive_a : set a { root.@r_a }
fact { always ~@r_a in @p_a }

fact { all self_ : a | always (self_ in alive_a implies (one self_.@r_b)) }


sig b
{ p_b : lone a
, var r_c : set c
, var r_d : set d
, var r_e : set e }
{ always (this in alive_b implies (let children = (this.@r_c + this.@r_d + this.@r_e) | one children)) }
fun alive_b : set b { a.@r_b }
fact { always ~@r_b in @p_b
  always @r_b.univ in alive_a }

fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_c)) }
fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_d)) }
fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_e)) }
fact { all self_ : b | always (self_ in alive_b implies ((not some self_.(@p_b :> alive_a)) releases (not some self_.(@p_b :> alive_a) or (((!((some self_.@r_d) && (no self_.@r_e))) || ((not some self_.(@p_b :> alive_a)) releases (not some self_.(@p_b :> alive_a) or (!(some self_.@r_e))))) || ((some self_.(@p_b :> alive_a) and (some self_.@r_c)) until (not some self_.(@p_b :> alive_a) or (some self_.@r_e))))))) }
fact { all self_ : b | always (self_ in alive_b implies ((not before self_ in alive_b) implies (eventually (not some self_.(@p_b :> alive_a) or (some self_.@r_d))))) }
fact { all self_ : b | always (self_ in alive_b implies ((not before self_ in alive_b) implies (eventually (not some self_.(@p_b :> alive_a) or (some self_.@r_c))))) }
fact { all self_ : b | always (self_ in alive_b implies ((not before self_ in alive_b) implies (eventually (not some self_.(@p_b :> alive_a) or (some self_.@r_e))))) }


sig c
{ p_c : lone b }
fun alive_c : set c { b.@r_c }
fact { always ~@r_c in @p_c
  always @r_c.univ in alive_b }


sig d
{ p_d : lone b }
fun alive_d : set d { b.@r_d }
fact { always ~@r_d in @p_d
  always @r_d.univ in alive_b }


sig e
{ p_e : lone b }
fun alive_e : set e { b.@r_e }
fact { always ~@r_e in @p_e
  always @r_e.univ in alive_b }


