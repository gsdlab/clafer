<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/explicit_dref_navigation.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Port">Port</span>
  <div class="indent">
  <span class="claferDecl" id="Port__speed">speed</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="name">name</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
</div>


<div>
<span class="claferDecl" id="Hub">Hub</span>
  <div class="indent">
  <span class="claferDecl" id="p">p</span><span class="keyword"> : </span><a href="#Port"><span class="reference">Port</span></a> 2</div>
</div>


<div>
<span class="claferDecl" id="fast">fast</span><span class="keyword"> : </span><a href="#Port"><span class="reference">Port</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#Port__speed"><span class="reference">speed</span></a> = 10 <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Component">Component</span>
  <div class="indent">
  <span class="keyword">abstract</span> <span class="claferDecl" id="link">link</span><span class="keyword"> -> </span><a href="#Port"><span class="reference">Port</span></a> *
    <div class="indent">
    <span class="claferDecl" id="latency">latency</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
    <div class="indent">
    <span class="claferDecl" id="link__speed">speed</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">dref</span>.<a href="#Port__speed"><span class="reference">speed</span></a> &gt;= <span class="keyword">this</span>.<a href="#link__speed"><span class="reference">speed</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> all t<span class="keyword"> : </span><span class="keyword">this</span>.<span class="keyword">dref</span> | <a href="#t"><span class="reference">t</span></a>.<a href="#Port__speed"><span class="reference">speed</span></a> &gt;= <a href="#latency"><span class="reference">latency</span></a> <span class="keyword">]</span></div>
  </div>
</div>


<div>
<span class="claferDecl" id="cam">cam</span><span class="keyword"> : </span><a href="#Component"><span class="reference">Component</span></a>
  <div class="indent">
  <span class="claferDecl" id="l">l</span><span class="keyword"> : </span><a href="#link"><span class="reference">link</span></a><span class="keyword"> -> </span><a href="#Hub"><span class="reference">Hub</span></a>.<a href="#p"><span class="reference">p</span></a> 1
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">dref</span>.<a href="#Port__speed"><span class="reference">speed</span></a> = 3 <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">dref</span>.<a href="#name"><span class="reference">name</span></a> = 1 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#l"><span class="reference">l</span></a>.<span class="keyword">dref</span>.<a href="#Port__speed"><span class="reference">speed</span></a> = 3 <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="b">b</span><span class="keyword"> ->> </span><a href="#Port"><span class="reference">Port</span></a> 2
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">dref</span>.<a href="#Port__speed"><span class="reference">speed</span></a>.<span class="keyword">dref</span> = 3 <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Plug">Plug</span><span class="keyword"> -> </span><a href="#Port"><span class="reference">Port</span></a>
  <div class="indent">
  <span class="claferDecl" id="Plug__speed">speed</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
</div>


<div>
<span class="claferDecl" id="plug">plug</span><span class="keyword"> : </span><a href="#Plug"><span class="reference">Plug</span></a></div>


<div>
<span class="claferDecl" id="pl">pl</span><span class="keyword"> -> </span><a href="#Plug"><span class="reference">Plug</span></a>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">dref</span>.<a href="#Plug__speed"><span class="reference">speed</span></a> = 5 <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="u">u</span><span class="keyword"> -> </span><a href="#Hub"><span class="reference">Hub</span></a>.<a href="#p"><span class="reference">p</span></a>++<a href="#fast"><span class="reference">fast</span></a>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">dref</span>.<a href="#Port__speed"><span class="reference">speed</span></a> = 10 <span class="keyword">]</span></div>
</div>

</body>
</html>