open util/integer
pred show {}


abstract sig Component
{ r_link : lone link }

sig link
{ link_ref : one Component }
{ one @r_link.this }

one sig Comp1 extends Component
{}
{ ((this.@r_link).@link_ref) = Comp1
  ((this.@r_link).@link_ref) = Comp1 }

fact { some Comp1 & Component }
fact { some Comp1 & Component }
