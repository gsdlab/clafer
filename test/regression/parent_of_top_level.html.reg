<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/parent_of_top_level.cfr</div>

<div>
<span class="claferDecl" id="a">a</span>
  <div class="indent">
  <span class="claferDecl" id="x">x</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
</div>


<div>
<span class="claferDecl" id="extra">extra</span> ?</div>


<div>
<span class="claferDecl" id="b">b</span>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <span class="keyword">parent</span>.<a href="#a"><span class="reference">a</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <span class="keyword">this</span>.<span class="keyword">parent</span> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> # <span class="keyword">parent</span> = 1 <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">parent</span>.<a href="#a"><span class="reference">a</span></a>.<a href="#x"><span class="reference">x</span></a> = 2 <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> all v<span class="keyword"> : </span><a href="#b"><span class="reference">b</span></a> | <span class="keyword">some</span> v.<span class="keyword">parent</span>.<a href="#a"><span class="reference">a</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> a.<span class="keyword">parent</span>.<a href="#a"><span class="reference">a</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <a href="#extra"><span class="reference">extra</span></a>.<span class="keyword">parent</span> &lt;=&gt; <span class="keyword">some</span> <a href="#extra"><span class="reference">extra</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> # <a href="#extra"><span class="reference">extra</span></a>.<span class="keyword">parent</span> = 1 =&gt; <span class="keyword">some</span> <a href="#extra"><span class="reference">extra</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <a href="#extra"><span class="reference">extra</span></a>.<span class="keyword">parent</span>.<a href="#a"><span class="reference">a</span></a> =&gt; <span class="keyword">some</span> <a href="#extra"><span class="reference">extra</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">[</span> <span class="keyword">some</span> <span class="keyword">root</span> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <span class="keyword">root</span>.<a href="#a"><span class="reference">a</span></a>.<a href="#x"><span class="reference">x</span></a> = 2 <span class="keyword">]</span></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Top">Top</span>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <span class="keyword">parent</span> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="top1">top1</span><span class="keyword"> : </span><a href="#Top"><span class="reference">Top</span></a></div>


<div>
<span class="claferDecl" id="top2">top2</span><span class="keyword"> : </span><a href="#Top"><span class="reference">Top</span></a></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Feat">Feat</span>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <span class="keyword">parent</span> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> # <span class="keyword">parent</span> = 1 <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="f1">f1</span><span class="keyword"> : </span><a href="#Feat"><span class="reference">Feat</span></a></div>


<div>
<span class="claferDecl" id="g">g</span>
  <div class="indent">
  <span class="claferDecl" id="f2">f2</span><span class="keyword"> : </span><a href="#Feat"><span class="reference">Feat</span></a></div>
</div>


<div>
<span class="claferDecl" id="h">h</span> 2
  <div class="indent">
  <span class="claferDecl" id="i">i</span>
    <div class="indent">
    <span class="claferDecl" id="f3">f3</span><span class="keyword"> : </span><a href="#Feat"><span class="reference">Feat</span></a></div>
  </div>
</div>

</body>
</html>