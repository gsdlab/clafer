scope({$Measurable:2, $performance:2});
defaultScope(1);
stringLength(16);

$Measurable = Abstract("Measurable");
$performance = $Measurable.addChild("performance").withCard(1, 1);
$D = Clafer("D").withCard(1, 1);
$C = Clafer("C").withCard(1, 1);
$D.extending($Measurable);
$C.extending($Measurable);
$performance.refToUnique(Int);
Constraint(equal(joinRef(join(global($C), $performance)), minus(joinRef(join(global($D), $performance)))));
