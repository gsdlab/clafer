open util/integer
pred show {}


abstract sig Component
{ r_Port : set Port
, r_TemperaturePort : set TemperaturePort }
{ r_TemperaturePort in r_Port
  all disj x, y : this.@r_TemperaturePort | (x.@TemperaturePort_ref) != (y.@TemperaturePort_ref)  }

abstract sig Port
{ r_input : lone input
, r_output : lone output }
{ one @r_Port.this }

sig input
{}
{ one @r_input.this }

sig output
{}
{ one @r_output.this }

abstract sig TemperaturePort extends Port
{ TemperaturePort_ref : one Int }
{ one @r_TemperaturePort.this }

abstract sig TemperatureConnector
{ r_from : one from
, r_to : one to }
{ (((this.@r_to).@to_ref).@TemperaturePort_ref) = (((this.@r_from).@from_ref).@TemperaturePort_ref) }

sig from
{ from_ref : one TemperaturePort }
{ one @r_from.this
  some (this.@from_ref).@r_output }

sig to
{ to_ref : one TemperaturePort }
{ one @r_to.this
  some (this.@to_ref).@r_input }

one sig sensor extends Component
{ r_sensor__temperature : one sensor__temperature }
{ r_sensor__temperature in r_TemperaturePort }

one sig sensor__temperature extends TemperaturePort
{}
{ let children = (r_input + r_output) | some children
  some this.@r_output }

one sig controller extends Component
{ r_controller__temperature : one controller__temperature }
{ r_controller__temperature in r_TemperaturePort }

one sig controller__temperature extends TemperaturePort
{}
{ let children = (r_input + r_output) | some children
  some this.@r_input }

one sig con1 extends TemperatureConnector
{}
{ ((this.@r_from).@from_ref) = (sensor.@r_sensor__temperature)
  ((this.@r_to).@to_ref) = (controller.@r_controller__temperature) }

assert assertAt_27_10 { ((controller.@r_controller__temperature).@TemperaturePort_ref) = ((sensor.@r_sensor__temperature).@TemperaturePort_ref) }
check assertAt_27_10 for 1 but 2 Component, 2 Port, 2 TemperaturePort, 2 input, 2 output

