open util/integer
pred show {}


one sig root
{ var r_c0_events : set c0_events
, var r_c0_tl : set c0_tl }
fact { all self_ : root | always (one self_.@r_c0_events) }
fact { all self_ : root | always (one self_.@r_c0_tl) }

assert assertOnLine_43 { always (((some (alive_c0_tl.@r_c0_on).@r_c0_normal) && (some alive_c0_events.@r_c0_e_police)) => (eventually ((some (alive_c0_tl.@r_c0_on).@r_c0_flashing) || (some alive_c0_tl.@r_c0_off)))) }
check assertOnLine_43 for 1 but 5 c0_event, 10 steps

assert assertOnLine_44 { always (((some ((alive_c0_tl.@r_c0_on).@r_c0_flashing).@r_c0_yellow_on) && (some alive_c0_events.@r_c0_e_after_0_5)) => (eventually ((some ((alive_c0_tl.@r_c0_on).@r_c0_flashing).@r_c0_yellow_off) || (no (alive_c0_tl.@r_c0_on).@r_c0_flashing)))) }
check assertOnLine_44 for 1 but 5 c0_event, 10 steps



