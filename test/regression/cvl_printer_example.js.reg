scope({$Cartridge:4, $Head:2, $High:4, $Low:4, $Speed:4, $Turbo:4, $inkVolume:4});
defaultScope(1);
stringLength(16);

$Office = Clafer("Office").withCard(1, 1);
$Printer = $Office.addChild("Printer").withCard(0, 1);
$resolution = $Printer.addChild("resolution").withCard(1, 1);
$Cartridge = $Printer.addChild("Cartridge").withCard(1, 4);
$inkVolume = $Cartridge.addChild("inkVolume").withCard(1, 1);
$Speed = $Cartridge.addChild("Speed").withCard(1, 1).withGroupCard(1);
$High = $Speed.addChild("High").withCard(0, 1);
$Low = $Speed.addChild("Low").withCard(0, 1);
$Turbo = $Cartridge.addChild("Turbo").withCard(0, 1);
$Type = $Printer.addChild("Type").withCard(1, 1).withGroupCard(1, 1);
$Color = $Type.addChild("Color").withCard(0, 1);
$BW = $Type.addChild("BW").withCard(0, 1);
$Scanner = $Office.addChild("Scanner").withCard(0, 1);
$GreenMode = $Scanner.addChild("GreenMode").withCard(0, 1);
$Head = $Scanner.addChild("Head").withCard(1, 2);
$PrinterPool = Clafer("PrinterPool").withCard(1, 1);
$fax = $PrinterPool.addChild("fax").withCard(0, 1);
$printer = $PrinterPool.addChild("printer").withCard(0, 1);
$copier = $PrinterPool.addChild("copier").withCard(0, 1);
$scan = $PrinterPool.addChild("scan").withCard(0, 1);
$resolution.refToUnique(Int);
$inkVolume.refToUnique(Int);
$PrinterPool.addConstraint(implies(some(join($this(), $fax)), some(join($this(), $printer))));
Constraint(and(implies(some(join(global($PrinterPool), $fax)), some(join(global($PrinterPool), $printer))), implies(some(join(global($PrinterPool), $copier)), and(some(join(global($PrinterPool), $fax)), some(join(global($PrinterPool), $printer))))));
