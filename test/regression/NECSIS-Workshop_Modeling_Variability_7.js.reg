defaultScope(1);
stringLength(16);

$BumbleBee = Clafer("BumbleBee").withCard(1, 1);
$Camaro = Abstract("Camaro");
$transformer = $Camaro.addChild("transformer").withCard(0, 1);
$Car = Abstract("Car");
$ABS = $Car.addChild("ABS").withCard(0, 1);
$Transmission = $Car.addChild("Transmission").withCard(1, 1).withGroupCard(1, 1);
$Automatic = $Transmission.addChild("Automatic").withCard(0, 1);
$Manual = $Transmission.addChild("Manual").withCard(0, 1);
$Car__FCA = $Car.addChild("Car__FCA").withCard(0, 1);
$Car__CC = $Car.addChild("Car__CC").withCard(0, 1);
$root__FCA = Abstract("root__FCA");
$Sensor = $root__FCA.addChild("Sensor").withCard(1, 1).withGroupCard(1, 1);
$Radar = $Sensor.addChild("Radar").withCard(0, 1);
$Lidar = $Sensor.addChild("Lidar").withCard(0, 1);
$Alert = $root__FCA.addChild("Alert").withCard(1, 1).withGroupCard(1, 1);
$Haptic = $Alert.addChild("Haptic").withCard(0, 1);
$Audible = $Alert.addChild("Audible").withCard(0, 1);
$root__CC = Abstract("root__CC");
$switch = $root__CC.addChild("switch").withCard(1, 1);
$backlight = $switch.addChild("backlight").withCard(0, 1);
$ACC = $root__CC.addChild("ACC").withCard(0, 1);
$BumbleBee.extending($Camaro);
$Camaro.extending($Car);
$Car__FCA.extending($root__FCA);
$Car__CC.extending($root__CC);
$BumbleBee.addConstraint(some(join($this(), $transformer)));
$Camaro.addConstraint(some(join(join($this(), $Car__CC), $ACC)));
$Camaro.addConstraint(some(join(join(join($this(), $Car__CC), $switch), $backlight)));
$Car.addConstraint(implies(some(join(join($this(), $Car__CC), $ACC)), some(join($this(), $Car__FCA))));
