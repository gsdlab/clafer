//# OPTIONS --explicit
abstract 0..* c0_degree ->> int 0..* {
  [(this . dref > 0) && (this . dref <= 360)]
}
abstract 0..* c0_Vehicle 0..* {
  [(this . c0_yawRate . dref . dref > this . c0_normalYawRate . dref . dref) <=> ((#this . c0_hasOversteer) >= 1)]
  [(this . c0_yawRate . dref . dref < this . c0_normalYawRate . dref . dref) <=> ((#this . c0_hasUndersteer) >= 1)]
  1..1 c0_DriveConfiguration : c1_DriveConfiguration 1..1 {}
  0..* c0_ElectronicStabilityControlSystem : c1_ElectronicStabilityControlSystem 1..1 {}
  0..* c0_AntiLockBreakSystem : c1_AntiLockBreakSystem 1..1 {}
  0..* c0_TractionControlSystem : c1_TractionControlSystem 1..1 {}
  0..* c0_AckermanSteerAngle -> c0_degree 1..1 {}
  0..* c0_speed -> int 1..1 {}
  0..* c0_lateralAcceleration -> int 1..1 {}
  0..* c0_sideSlipAngle -> c0_degree 1..1 {}
  0..* c0_yawRate -> c0_degree 1..1 {}
  0..* c0_normalYawRate -> c0_degree 1..1 {
    0..* c0_givenAckermanSteerAngle 1..1 {}
  }
  0..* c0_hasOversteer 0..1 {}
  0..* c0_hasUndersteer 0..1 {}
  0..* c0_GVWR -> int 1..1 {}
}
abstract 1..1 c1_DriveConfiguration 0..* {
  0..* c0_twoWheelDrive 0..1 {}
  0..* c0_frontWheelDrive 0..1 {}
  0..* c0_rearWheelDrive 0..1 {}
  0..* c0_allWheelDrive 0..1 {}
  1..1 c0_fourWheelDrive 0..1 {
    0..* c0_highGearWithLockedDifferential 0..1 {}
    0..* c0_lowGear 0..1 {}
  }
}
abstract 0..* c1_ElectronicStabilityControlSystem 0..* {
  0..* c0_vehicle -> c0_Vehicle 1..1 {}
  0..* c0_augmentsVehiclesDirectionalStability 1..1 {
    0..* c0_adjustsBrakeTorquesToInduceCorrectingYawMoment 1..1 {
      0..* c0_toEachWheelIndividually 1..1 {}
    }
  }
  0..* c0_limits 1..1 {
    0..* c0_understeer 1..1 {}
    0..* c0_oversteer 1..1 {}
  }
  0..* c0_estimates 1..1 {
    0..* c0_YawRate 1..1 {}
    0..* c0_sideSlip 1..1 {
      0..* c0_derivativeWithRespectToTime 1..1 {}
    }
  }
  0..* c0_monitors 1..1 {
    0..* c0_driverSteeringInputs 1..1 {}
    0..* c0_modifiesEngineTorque 1..1 {}
  }
  0..* c0_isOperational 0..1 {
    [this . parent . c0_vehicle . dref . c0_speed . dref > 20]
    0..* c0_duringAllPhasesOfDriving 1..1 {
      0..* c0_acceleration 1..1 {}
      0..* c0_coasting 1..1 {}
      0..* c0_deceleration 1..1 {}
      0..* c0_breaking 1..1 {}
    }
    0..* c0_withAntiLockBrakeSystem 1..1 {}
    0..* c0_withTractionControlSystem 1..1 {}
  }
  1..* c0_isNotOperational 1..1 {
    0..* c0_whenTurnedOffByTheDriver 0..1 {}
    0..* c0_whenDrivenInReverse 0..1 {}
    0..* c0_duringSystemInitialization 0..1 {}
  }
  0..* c0_Mode 1..1 {
    0..* c0_driverSelected 0..1 {}
    1..1 c0_type 1..1 {
      0..* c0_standard 0..1 {}
      0..* c0_performance 0..1 {}
      0..* c0_snowOrSlipperyRoad 0..1 {}
      0..* c0_Off 0..1 {}
    }
  }
  0..* c0_entersStandardModeAfterIgnition 1..1 {}
  0..* c0_satisfies 1..1 {
    0..* c0_stabilityCriteria 1..1 {}
    0..* c0_responsivenessCriterion 1..1 {}
  }
  1..* c0_MalfunctionTelltale 0..1 {
    0..* c0_malfunctionDetected 0..1 {
      0..* c0_mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists 1..1 {}
    }
    0..* c0_ignitionLockInOnPosition 0..1 {}
    0..* c0_mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected 0..1 {}
    0..* c0_flashingWhenInOperation 0..1 {}
    0..* c0_mustIlluminateWhenIgnitionControlInCheckPosition 0..1 {}
  }
  0..* c0_SystemControls 1..1 {
    0..* c1_Off 1..1 {}
    1..1 c0_ignitionControlPosition 1..1 {
      0..* c2_Off 0..1 {}
      0..* c0_Check 0..1 {}
      0..* c0_On 0..1 {}
      0..* c0_Start 0..1 {}
    }
  }
}
abstract 0..* c1_AntiLockBreakSystem 0..* {}
abstract 0..* c1_TractionControlSystem 0..* {}
