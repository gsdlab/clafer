defaultScope(1);
stringLength(16);

$Clafer1 = Clafer("Clafer1").withCard(1, 1);
$Clafer1__type = $Clafer1.addChild("Clafer1__type").withCard(1, 1).withGroupCard(1, 1);
$Clafer1__type__Type1 = $Clafer1__type.addChild("Clafer1__type__Type1").withCard(0, 1);
$Clafer1__type__Type2 = $Clafer1__type.addChild("Clafer1__type__Type2").withCard(0, 1);
$Clafer2 = Clafer("Clafer2").withCard(1, 1);
$clafer1 = $Clafer2.addChild("clafer1").withCard(1, 1);
$Clafer2__type = $Clafer2.addChild("Clafer2__type").withCard(1, 1).withGroupCard(1, 1);
$Clafer2__type__Type1 = $Clafer2__type.addChild("Clafer2__type__Type1").withCard(0, 1);
$Clafer2__type__Type2 = $Clafer2__type.addChild("Clafer2__type__Type2").withCard(0, 1);
$clafer1.refToUnique($Clafer1);
$Clafer2.addConstraint(implies(some(join(join($this(), $Clafer2__type), $Clafer2__type__Type1)), some(join(join(joinRef(join($this(), $clafer1)), $Clafer1__type), $Clafer1__type__Type2))));
$Clafer2.addConstraint(implies(some(join(join($this(), $Clafer2__type), $Clafer2__type__Type1)), some(join(join(joinRef(join($this(), $clafer1)), $Clafer1__type), $Clafer1__type__Type2))));
