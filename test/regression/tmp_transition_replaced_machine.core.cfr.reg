//# OPTIONS --explicit --core --tl=10
0..* go 0..1 {}
1..1 sm 1..1 {
  0..* a 0..1 {
    [(some go) => (X (some this.parent.b))] // -->, tmp_transition_replaced_machine.cfr:8:7
  }
  0..* b 0..1 {}
  0..* c 0..1 {}
  [((some this) && (!(previous (some this)))) => (some this.a)] // initial, tmp_transition_replaced_machine.cfr:7:3
}

assert [all m : sm | ((some m.a) && (some go)) => (X ((some m.b) || (no (m ** sm))))]
assert [((some sm.a) && (some go)) => (X (some sm.b))]
