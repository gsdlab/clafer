open util/integer
pred show {}


one sig root
{ var r_b : set b }
fact { all self_ : root | always (one self_.@r_b) }


sig b
{ p_b : lone root
, var r_c : set c
, var r_d : set d
, var r_e : set e }
{ always (this in alive_b implies (let children = (this.@r_c + this.@r_d + this.@r_e) | one children)) }
fun alive_b : set b { root.@r_b }
fact { always ~@r_b in @p_b }

fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_c)) }
fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_d)) }
fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_e)) }
fact { all self_ : b | always (self_ in alive_b implies ((some self_.@r_c) => (after (some self_.@r_d)))) }


sig c
{ p_c : lone b }
fun alive_c : set c { b.@r_c }
fact { always ~@r_c in @p_c
  always @r_c.univ in alive_b }


sig d
{ p_d : lone b }
fun alive_d : set d { b.@r_d }
fact { always ~@r_d in @p_d
  always @r_d.univ in alive_b }


sig e
{ p_e : lone b }
fun alive_e : set e { b.@r_e }
fact { always ~@r_e in @p_e
  always @r_e.univ in alive_b }


