digraph "ACCDemo_fullClafer"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"car" [label="abstract car" URL="#car" tooltip="abstract car&#10;  xor transmission&#10;    automatic&#10;    manual&#10;  `fca ?&#10;  `cc&#10;  [ acc => fca ]&#10;"];
"car" -> "root__fca" [arrowhead=vee arrowtail=diamond dir=both style=solid constraint=true weight=5 minlen=2 arrowsize=0.6 penwidth=0.5 ];
"car" -> "root__cc" [arrowhead=vee arrowtail=diamond dir=both style=solid constraint=true weight=5 minlen=2 arrowsize=0.6 penwidth=0.5 ];
"root__fca" [label="abstract fca" URL="#root__fca" tooltip="abstract fca&#10;  xor sensor&#10;    radar&#10;    lidar&#10;"];
"root__cc" [label="abstract cc" URL="#root__cc" tooltip="abstract cc&#10;  switches 2..3&#10;    backlight ?&#10;  acc ?&#10;"];
"camaro" [label="abstract camaro : car" URL="#camaro" tooltip="abstract camaro : car&#10;  [ all s : switches | s.backlight ]&#10;  transformer ?&#10;    [ # switches = 3 ]&#10;"];
"bumbleBee" [label="bumbleBee : camaro" URL="#bumbleBee" tooltip="bumbleBee : camaro&#10;  [ transformer ]&#10;  [ manual ]&#10;"];
}