<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/scopes.cfr</div>

<div>
<span class="claferDecl" id="a">a</span> 0..0 </div>


<div>
<span class="claferDecl" id="b">b</span> ?</div>


<div>
<span class="claferDecl" id="c">c</span></div>


<div>
<span class="claferDecl" id="d">d</span> *</div>


<div>
<span class="claferDecl" id="e">e</span> +</div>


<div>
<span class="claferDecl" id="f">f</span> 2..4 </div>


<div>
<span class="claferDecl" id="g">g</span> 3..* </div>


<div>
<span class="claferDecl" id="gs">gs</span><span class="keyword"> -> </span><a href="#g"><span class="reference">g</span></a> 2</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="H">H</span>
  <div class="indent">
  <span class="claferDecl" id="i">i</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="j">j</span> *</div>
  <div class="indent">
  <span class="claferDecl" id="k">k</span> 2</div>
</div>


<div>
<span class="claferDecl" id="Hs">Hs</span><span class="keyword"> -> </span><a href="#H"><span class="reference">H</span></a> 3..* </div>


<div>
<span class="claferDecl" id="H1">H1</span><span class="keyword"> : </span><a href="#H"><span class="reference">H</span></a> 2
  <div class="indent">
  <span class="claferDecl" id="H12">H12</span><span class="keyword"> : </span><a href="#H"><span class="reference">H</span></a> 2</div>
</div>


<div>
<span class="claferDecl" id="H2">H2</span><span class="keyword"> : </span><a href="#H"><span class="reference">H</span></a> 4..4 </div>


<div>
<span class="claferDecl" id="H3">H3</span><span class="keyword"> : </span><a href="#H"><span class="reference">H</span></a> 1..2 </div>


<div>
<span class="claferDecl" id="H4">H4</span><span class="keyword"> : </span><a href="#H"><span class="reference">H</span></a> 5..* </div>


<div>
<span class="claferDecl" id="Hs2">Hs2</span><span class="keyword"> -> </span><a href="#H"><span class="reference">H</span></a> 0..* </div>


<div>
<span class="claferDecl" id="Hs3">Hs3</span><span class="keyword"> -> </span><a href="#H"><span class="reference">H</span></a> 5..8
  <div class="indent">
  <span class="claferDecl" id="l">l</span> ?</div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="FF">FF</span><span class="keyword"> : </span><a href="#H"><span class="reference">H</span></a></div>


<div>
<span class="claferDecl" id="f1">f1</span><span class="keyword"> : </span><a href="#FF"><span class="reference">FF</span></a> 2..5
  <div class="indent">
  <span class="claferDecl" id="m">m</span> 0</div>
</div>

</body>
</html>