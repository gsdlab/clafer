<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_obligation_outlives_instance.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="event">event</span>
  <div class="indent">
  <span class="keyword">[</span> X <span class="keyword">no</span> <span class="keyword">this</span> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">mux</span> <span class="claferDecl" id="events">events</span>
  <div class="indent">
  <span class="claferDecl" id="e1">e1</span><span class="keyword"> : </span><a href="#event"><span class="reference">event</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="e2">e2</span><span class="keyword"> : </span><a href="#event"><span class="reference">event</span></a></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Port">Port</span>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <span class="keyword">this</span>.<span class="keyword">parent</span> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="sys">sys</span> ?
  <div class="indent">
  <span class="claferDecl" id="p1">p1</span><span class="keyword"> : </span><a href="#Port"><span class="reference">Port</span></a></div>
</div>


<div>
<span class="claferDecl" id="top">top</span><span class="keyword"> : </span><a href="#Port"><span class="reference">Port</span></a></div>


<div>
<span class="keyword">assert [</span> all e<span class="keyword"> : </span><a href="#event"><span class="reference">event</span></a> | X <span class="keyword">no</span> <a href="#e"><span class="reference">e</span></a>**<a href="#event"><span class="reference">event</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> all p<span class="keyword"> : </span><a href="#sys"><span class="reference">sys</span></a>.<a href="#p1"><span class="reference">p1</span></a> | <a href="#p"><span class="reference">p</span></a>.<span class="keyword">parent</span> = <a href="#sys"><span class="reference">sys</span></a> <span class="keyword">]</span></div>

</body>
</html>