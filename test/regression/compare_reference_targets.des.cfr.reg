//# OPTIONS --explicit
[all x : sys . b1 . a | x = sys . b1 . a]
abstract 0..* Port 0..* {}
abstract 0..* B 0..* {
  0..* a -> Port 1..1 {}
}
0..* p1 : Port 1..1 {}
0..* p2 : Port 1..1 {}
0..* sys 1..1 {
  0..* b1 : B 1..1 {}
  0..* b2 : B 1..1 {
    [this . a . dref = this . parent . b1 . a . dref]
    [(this . a . dref != this . parent . b1 . a . dref) || (this . a . dref = this . parent . b1 . a . dref)]
  }
}
0..* choice -> B 1..1 {
  [this . dref . a . dref in sys . b1 . a . dref]
}
0..* sel -> a 1..1 {
  [this . dref in sys . b1 . a]
  [this . dref = sys . b1 . a]
}
