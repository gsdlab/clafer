//# OPTIONS --explicit --core --tl=10
abstract 0..* Tools 0..* {}
[((#Tools) >= 3) && ((#Tools) <= 6)] // abstract multiplicity, tmp_abstract_multiplicity.cfr:5:1
0..* hammer : Tools 0..* {}
0..* saw : Tools 0..4 {}
[(!(previous ((#root) >= 1))) => (((#hammer) = 3) && ((#saw) = 0))]
[(!(previous ((#root) >= 1))) => (X ((#saw) = 4))]

assert [G (((#Tools) >= 3) && ((#Tools) <= 6))]
assert [(!(previous ((#root) >= 1))) => (X ((#hammer) <= 2))]
