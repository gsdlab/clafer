scope({$E1TEntities:3, $Entity:3, $type:3});
defaultScope(1);
stringLength(16);

$Entity = Abstract("Entity");
$type = $Entity.addChild("type").withCard(1, 1);
$E1 = Clafer("E1").withCard(1, 1);
$E2 = Clafer("E2").withCard(1, 1);
$E3 = Clafer("E3").withCard(1, 1);
$E1TEntities = Clafer("E1TEntities");
$type.refToUnique(string);
$E1.extending($Entity);
$E1.addConstraint(equal(joinRef(join($this(), $type)), constant("\"E1T\"")));
$E2.extending($Entity);
$E2.addConstraint(equal(joinRef(join($this(), $type)), constant("\"E1T\"")));
$E3.extending($Entity);
$E3.addConstraint(equal(joinRef(join($this(), $type)), constant("\"E1T\"")));
$E1TEntities.refToUnique($Entity);
$E1TEntities.addConstraint(equal(joinRef(join(joinRef($this()), $type)), constant("\"E1T\"")));
Constraint(equal(card(global($E1TEntities)), constant(3)));
