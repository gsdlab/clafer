digraph "decimals"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Feature" [label="abstract Feature" URL="#Feature" tooltip="abstract Feature&#10;  cost -&gt; decimal&#10;  weight -&gt; decimal&#10;"];
"Feature" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=cost];
"Feature" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=weight];
"Bike" [label="abstract Bike" URL="#Bike" tooltip="abstract Bike&#10;  Light : Feature ?&#10;    [ cost = 19.99 ]&#10;    [ weight = 0.25 ]&#10;  Rack : Feature ?&#10;    [ cost = 34.5 ]&#10;    [ weight = 1.2 ]&#10;  Bell : Feature ?&#10;    [ cost = 4.75 ]&#10;    [ weight = 0.05 ]&#10;  Frame : Feature&#10;    [ cost = 250 ]&#10;    [ weight = 9.8 ]&#10;  subtotal -&gt; decimal = sum Feature.cost&#10;  tax -&gt; decimal = subtotal * 0.13&#10;  total -&gt; decimal = subtotal + tax&#10;  weightPerFeature -&gt; decimal = sum Feature.weight / # Feature&#10;  [ total <= 340 ]&#10;  [ weightPerFeature < 5 ]&#10;"];
"Bike" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=subtotal];
"Bike" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=tax];
"Bike" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=total];
"Bike" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=weightPerFeature];
"aBike" [label="aBike : Bike" URL="#aBike" tooltip="aBike : Bike&#10;"];
"size" [label="size -&gt; 1, 2.5" URL="#size" tooltip="size -&gt; 1, 2.5&#10;  [ this != 1 ]&#10;"];
"change" [label="change -&gt; decimal = -aBike.total + 400" URL="#change" tooltip="change -&gt; decimal = -aBike.total + 400&#10;"];
"change" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"share" [label="share -&gt; decimal = 2 / 3" URL="#share" tooltip="share -&gt; decimal = 2 / 3&#10;"];
"share" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"discount" [label="discount -&gt; decimal = if aBike.total > 300 then 0.1 else 0" URL="#discount" tooltip="discount -&gt; decimal = if aBike.total > 300 then 0.1 else 0&#10;"];
"discount" -> "decimal" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}