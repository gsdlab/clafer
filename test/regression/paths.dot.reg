digraph "paths"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  age -&gt; integer&#10;  xor maritalStatus&#10;    neverMarried&#10;    married&#10;      spouse -&gt; Person&#10;        [ this != Person ]&#10;        [ this.maritalStatus.married.spouse = Person ]&#10;    divorced&#10;    [ married || divorced => age >= 3 ]&#10;  childs -&gt; Person *&#10;    [ Person in this.parents ]&#10;    [ spouse in this.parents ]&#10;    [ this.age < age ]&#10;  parents -&gt; Person 0..2&#10;    [ Person in this.childs ]&#10;"];
"Person" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="spouse"];
"Person" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="childs"];
"Person" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="parents"];
"Alice" [label="Alice : Person" URL="#Alice" tooltip="Alice : Person&#10;  [ age = 4 ]&#10;  [ married ]&#10;"];
"Bob" [label="Bob : Person" URL="#Bob" tooltip="Bob : Person&#10;  [ age = 5 ]&#10;"];
"Carol" [label="Carol : Person" URL="#Carol" tooltip="Carol : Person&#10;  [ age = 1 ]&#10;"];
}