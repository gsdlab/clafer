defaultScope(1);
stringLength(16);

$a = Clafer("a").withCard(1, 1);
$b = $a.addChild("b").withCard(1, 1);
$c = $a.addChild("c").withCard(1, 1);
$d = $c.addChild("d").withCard(1, 1);
$e = Clafer("e").withCard(1, 1);
$f = $e.addChild("f").withCard(0, 1);
$g = Clafer("g").withCard(1, 1);
$h = Clafer("h").withCard(1, 1);
$b.refToUnique($e);
$f.refToUnique($g);
$g.refToUnique($h);
$b.addConstraint(equal(joinRef(joinRef(join(joinRef($this()), $f))), global($h)));
$b.addConstraint(equal(joinRef(joinRef(join(joinRef($this()), $f))), global($h)));
$b.addConstraint(equal(joinRef(joinRef(join(joinRef($this()), $f))), global($h)));
$b.addConstraint(equal(joinRef(joinRef(join(joinRef($this()), $f))), global($h)));
$a.addConstraint(equal(joinRef(joinRef(join(joinRef(join($this(), $b)), $f))), global($h)));
$a.addConstraint(equal(joinRef(joinRef(join(joinRef(join($this(), $b)), $f))), global($h)));
$a.addConstraint(equal(joinRef(joinRef(join(joinRef(join($this(), $b)), $f))), global($h)));
$a.addConstraint(equal(joinRef(joinRef(join(joinRef(join($this(), $b)), $f))), global($h)));
$d.addConstraint(equal(joinRef(join(joinParent(joinParent($this())), $b)), global($e)));
$d.addConstraint(equal(joinRef(join(joinParent(joinParent($this())), $b)), global($e)));
$d.addConstraint(equal(joinRef(join(joinParent(joinParent($this())), $b)), global($e)));
$c.addConstraint(equal(joinRef(join(joinRef(join(joinParent($this()), $b)), $f)), global($g)));
$c.addConstraint(equal(joinRef(join(joinRef(join(joinParent($this()), $b)), $f)), global($g)));
$c.addConstraint(equal(joinRef(join(joinRef(join(joinParent($this()), $b)), $f)), global($g)));
$c.addConstraint(equal(joinRef(joinRef(join(joinRef(join(joinParent($this()), $b)), $f))), global($h)));
