open util/integer
pred show {}


one sig BumbleBee extends Camaro
{}
{ some this.@r_transformer }

abstract sig Camaro extends Car
{ r_transformer : lone transformer }
{ some (this.@r_Car__CC).@r_ACC
  some ((this.@r_Car__CC).@r_switch).@r_backlight }

sig transformer
{}
{ one @r_transformer.this }

abstract sig Car
{ r_ABS : lone ABS
, r_Transmission : one Transmission
, r_Car__FCA : lone Car__FCA
, r_Car__CC : lone Car__CC }
{ (some (this.@r_Car__CC).@r_ACC) => (some this.@r_Car__FCA) }

sig ABS
{}
{ one @r_ABS.this }

sig Transmission
{ r_Automatic : lone Automatic
, r_Manual : lone Manual }
{ one @r_Transmission.this
  let children = (r_Automatic + r_Manual) | one children }

sig Automatic
{}
{ one @r_Automatic.this }

sig Manual
{}
{ one @r_Manual.this }

sig Car__FCA extends root__FCA
{}
{ one @r_Car__FCA.this }

sig Car__CC extends root__CC
{}
{ one @r_Car__CC.this }

abstract sig root__FCA
{ r_Sensor : one Sensor
, r_Alert : one Alert }

sig Sensor
{ r_Radar : lone Radar
, r_Lidar : lone Lidar }
{ one @r_Sensor.this
  let children = (r_Radar + r_Lidar) | one children }

sig Radar
{}
{ one @r_Radar.this }

sig Lidar
{}
{ one @r_Lidar.this }

sig Alert
{ r_Haptic : lone Haptic
, r_Audible : lone Audible }
{ one @r_Alert.this
  let children = (r_Haptic + r_Audible) | one children }

sig Haptic
{}
{ one @r_Haptic.this }

sig Audible
{}
{ one @r_Audible.this }

abstract sig root__CC
{ r_switch : one switch
, r_ACC : lone ACC }

sig switch
{ r_backlight : lone backlight }
{ one @r_switch.this }

sig backlight
{}
{ one @r_backlight.this }

sig ACC
{}
{ one @r_ACC.this }

