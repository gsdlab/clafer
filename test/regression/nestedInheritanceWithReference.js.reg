scope({$Connection:5, $System:2, $connections:10});
defaultScope(1);
stringLength(16);

$System = Abstract("System");
$Connection = $System.addAbstractChild("Connection");
$connections = $System.addChild("connections");
$SystemX = Clafer("SystemX").withCard(1, 1);
$con1 = $SystemX.addChild("con1").withCard(1, 1);
$con2 = $SystemX.addChild("con2").withCard(1, 1);
$SystemY = Clafer("SystemY").withCard(1, 1);
$con3 = $SystemY.addChild("con3").withCard(1, 1);
$con4 = $SystemY.addChild("con4").withCard(1, 1);
$con5 = $SystemY.addChild("con5").withCard(1, 1);
$SystemX.extending($System);
$con1.extending($Connection);
$con2.extending($Connection);
$SystemY.extending($System);
$con3.extending($Connection);
$con4.extending($Connection);
$con5.extending($Connection);
$connections.refToUnique($Connection);
$System.addConstraint(equal(joinRef(join($this(), $connections)), join($this(), $Connection)));
assert(equal(joinRef(join(global($SystemX), $connections)), union(join(global($SystemX), $con1), join(global($SystemX), $con2))));
assert(equal(joinRef(join(global($SystemY), $connections)), union(union(join(global($SystemY), $con3), join(global($SystemY), $con4)), join(global($SystemY), $con5))));
