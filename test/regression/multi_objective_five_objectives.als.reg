open util/integer
pred show {}


abstract sig Feature
{ r_performance : one performance
, r_energy : one energy
, r_mass : one mass
, r_cost : one cost }
{ ((this.@r_mass).@mass_ref) >= 0
  ((this.@r_cost).@cost_ref) >= 0 }

sig performance
{ performance_ref : one Int }
{ one @r_performance.this }

sig energy
{ energy_ref : one Int }
{ one @r_energy.this }

sig mass
{ mass_ref : one Int }
{ one @r_mass.this }

sig cost
{ cost_ref : one Int }
{ one @r_cost.this }

abstract sig SecurityFeature extends Feature
{ r_security : one security }

sig security
{ security_ref : one Int }
{ one @r_security.this }

abstract sig MobilePhone
{ r_Connectivity : one Connectivity
, r_PasswordProtection : lone PasswordProtection
, r_FingerprintProtection : lone FingerprintProtection
, r_total_performance : one total_performance
, r_total_energy : one total_energy
, r_total_security : one total_security
, r_total_mass : one total_mass
, r_total_cost : one total_cost }
{ (some this.@r_total_performance) => (((this.@r_total_performance).@total_performance_ref) = (sum temp : (Feature.@r_performance) | temp.@performance_ref))
  (some this.@r_total_energy) => (((this.@r_total_energy).@total_energy_ref) = (sum temp : (Feature.@r_energy) | temp.@energy_ref))
  (some this.@r_total_security) => (((this.@r_total_security).@total_security_ref) = (sum temp : (SecurityFeature.@r_security) | temp.@security_ref))
  (some this.@r_total_mass) => (((this.@r_total_mass).@total_mass_ref) = (sum temp : (Feature.@r_mass) | temp.@mass_ref))
  (some this.@r_total_cost) => (((this.@r_total_cost).@total_cost_ref) = (sum temp : (Feature.@r_cost) | temp.@cost_ref)) }

sig Connectivity extends Feature
{ r_Bluetooth : lone Bluetooth
, r_USB : lone USB
, r_Wifi : lone Wifi }
{ one @r_Connectivity.this
  let children = (r_Bluetooth + r_USB + r_Wifi + r_performance + r_energy + r_mass + r_cost) | some children
  ((this.@r_performance).@performance_ref) = 0
  ((this.@r_energy).@energy_ref) = 0
  ((this.@r_mass).@mass_ref) = 0
  ((this.@r_cost).@cost_ref) = 12 }

sig Bluetooth extends Feature
{}
{ one @r_Bluetooth.this
  ((this.@r_performance).@performance_ref) = 9
  ((this.@r_energy).@energy_ref) = 10
  ((this.@r_mass).@mass_ref) = 2
  ((this.@r_cost).@cost_ref) = 3 }

sig USB extends Feature
{}
{ one @r_USB.this
  ((this.@r_performance).@performance_ref) = 10
  ((this.@r_energy).@energy_ref) = 5
  ((this.@r_mass).@mass_ref) = 3
  ((this.@r_cost).@cost_ref) = 5 }

sig Wifi extends Feature
{}
{ one @r_Wifi.this
  ((this.@r_performance).@performance_ref) = 22
  ((this.@r_energy).@energy_ref) = 17
  ((this.@r_mass).@mass_ref) = 6
  ((this.@r_cost).@cost_ref) = 5 }

sig PasswordProtection extends SecurityFeature
{}
{ one @r_PasswordProtection.this
  ((this.@r_security).@security_ref) = 5
  ((this.@r_performance).@performance_ref) = 1
  ((this.@r_energy).@energy_ref) = 2
  ((this.@r_mass).@mass_ref) = 0
  ((this.@r_cost).@cost_ref) = 2 }

sig FingerprintProtection extends SecurityFeature
{}
{ one @r_FingerprintProtection.this
  ((this.@r_mass).@mass_ref) = 0
  ((this.@r_security).@security_ref) = 5
  ((this.@r_performance).@performance_ref) = 3
  ((this.@r_energy).@energy_ref) = 1
  ((this.@r_cost).@cost_ref) = 13 }

sig total_performance
{ total_performance_ref : one Int }
{ one @r_total_performance.this }

sig total_energy
{ total_energy_ref : one Int }
{ one @r_total_energy.this }

sig total_security
{ total_security_ref : one Int }
{ one @r_total_security.this }

sig total_mass
{ total_mass_ref : one Int }
{ one @r_total_mass.this }

sig total_cost
{ total_cost_ref : one Int }
{ one @r_total_cost.this }

one sig MyPhone extends MobilePhone
{}

