//# OPTIONS --explicit
2..3 c0_A 1..1 {
  0..* c0_b 0..1 {}
  0..* c0_c 1..1 {}
  0..* c0_d 0..1 {}
}
1..1 c0_E 1..1 {
  0..* c0_f 0..1 {}
  0..* c0_g 0..1 {}
}
0..* c0_D 1..1 {
  0..* c0_Z 1..1 {}
  0..* c0_K 0..1 {}
}
0..* c0_L 1..1 {
  0..* c0_M 1..1 {}
  0..* c0_N 1..1 {}
}

assert [((#c0_E . c0_f) >= 1) || ((#c0_E . c0_g) >= 1)]
assert [!(((#c0_E . c0_f) >= 1) && ((#c0_E . c0_g) >= 1))]
assert [(#c0_D) = 1]
assert [(#c0_D . c0_Z) = 1]
