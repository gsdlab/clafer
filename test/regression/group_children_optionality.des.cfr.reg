//# OPTIONS --explicit
2..3 A 1..1 {
  0..* b 0..1 {}
  0..* c 1..1 {}
  0..* d 0..1 {}
}
1..1 E 1..1 {
  0..* f 0..1 {}
  0..* g 0..1 {}
}
0..* D 1..1 {
  0..* Z 1..1 {}
  0..* K 0..1 {}
}
0..* L 1..1 {
  0..* M 1..1 {}
  0..* N 1..1 {}
}

assert [((#E . f) >= 1) || ((#E . g) >= 1)]
assert [!(((#E . f) >= 1) && ((#E . g) >= 1))]
assert [(#D) = 1]
assert [(#D . Z) = 1]
