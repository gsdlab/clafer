<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/eCos_model.cfr</div>

<div>
<span class="claferDecl" id="MISC_FILESYSTEMS">MISC_FILESYSTEMS</span> ?
  <div class="indent">
  <span class="claferDecl" id="MISC_FILESYSTEMS__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Miscellaneous filesystems"</div>
  <div class="indent">
  <span class="claferDecl" id="CYGPKG_FS_JFFS2">CYGPKG_FS_JFFS2</span> ?
    <div class="indent">
    <span class="claferDecl" id="CYGPKG_FS_JFFS2__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Journalling Flash File System"</div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#CYGPKG_CRC"><span class="reference">CYGPKG_CRC</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#MTD"><span class="reference">MTD</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="claferDecl" id="CYGOPT_FS_JFFS2_DEBUG">CYGOPT_FS_JFFS2_DEBUG</span><span class="keyword"> -> </span><a href="#int"><span class="reference">int</span></a>
      <div class="indent">
      <span class="keyword">[</span> <span class="keyword">this</span> = 0 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="CYGOPT_FS_JFFS2_DEBUG__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Debug level"</div>
      <div class="indent">
      <span class="keyword">[</span> 0 &lt;= <span class="keyword">this</span> &amp;&amp; <span class="keyword">this</span> &lt;= 2 <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="description">description</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Debug verbosity of...."</div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="CYGOPT_FS_JFFS2_NAND">CYGOPT_FS_JFFS2_NAND</span> ?</div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#CYGOPT_FS_JFFS2_NAND"><span class="reference">CYGOPT_FS_JFFS2_NAND</span></a> &lt;=&gt; <a href="#HAS_IOMEM"><span class="reference">HAS_IOMEM</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#CYGOPT_FS_JFFS2_COMPRESS"><span class="reference">CYGOPT_FS_JFFS2_COMPRESS</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="claferDecl" id="CYGOPT_FS_JFFS2_COMPRESS">CYGOPT_FS_JFFS2_COMPRESS</span> ?
      <div class="indent">
      <span class="claferDecl" id="CYGOPT_FS_JFFS2_COMPRESS__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Compress data"</div>
      <div class="indent">
      <span class="keyword">[</span> <a href="#CYGOPT_FS_JFFS2_COMPRESS_ZLIB"><span class="reference">CYGOPT_FS_JFFS2_COMPRESS_ZLIB</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="CYGOPT_FS_JFFS2_COMPRESS_ZLIB">CYGOPT_FS_JFFS2_COMPRESS_ZLIB</span> ?
        <div class="indent">
        <span class="claferDecl" id="CYGOPT_FS_JFFS2_COMPRESS_ZLIB__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Compress data using zlib"</div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#CYGPKG_COMPRESS_ZLIB"><span class="reference">CYGPKG_COMPRESS_ZLIB</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="CYGOPT_FS_JFFS2_COMPRESS_CMODE">CYGOPT_FS_JFFS2_COMPRESS_CMODE</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">this</span> = "PRIORITY" <span class="keyword">]</span></div>
        <div class="indent">
        <span class="claferDecl" id="CYGOPT_FS_JFFS2_COMPRESS_CMODE__display">display</span><span class="keyword"> -> </span><a href="#string"><span class="reference">string</span></a> = "Set the default compression mode"</div>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">this</span> = "NONE" &#124;&#124; <span class="keyword">this</span> = "PRIORITY" &#124;&#124; <span class="keyword">this</span> = "SIZE" <span class="keyword">]</span></div>
      </div>
    </div>
  </div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="claferDecl" id="CYGPKG_CRC">CYGPKG_CRC</span></div>


<div>
<span class="claferDecl" id="MTD">MTD</span></div>


<div>
<span class="claferDecl" id="CYGPKG_COMPRESS_ZLIB">CYGPKG_COMPRESS_ZLIB</span></div>


<div>
<span class="claferDecl" id="HAS_IOMEM">HAS_IOMEM</span></div>

</body>
</html>