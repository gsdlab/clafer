digraph "if_then_else_with_references"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Hardware" [label="abstract Hardware" URL="#Hardware" tooltip="abstract Hardware&#10;"];
"h1" [label="h1 : Hardware" URL="#h1" tooltip="h1 : Hardware&#10;"];
"h2" [label="h2 : Hardware" URL="#h2" tooltip="h2 : Hardware&#10;"];
"Software" [label="abstract Software" URL="#Software" tooltip="abstract Software&#10;  target -&gt; Hardware&#10;"];
"Software" -> "Hardware" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=target];
"s1" [label="s1 : Software" URL="#s1" tooltip="s1 : Software&#10;  [ target = h1 ]&#10;"];
"s2" [label="s2 : Software" URL="#s2" tooltip="s2 : Software&#10;  [ target = h2 ]&#10;"];
"noHardware" [label="noHardware -&gt; Hardware 0" URL="#noHardware" tooltip="noHardware -&gt; Hardware 0&#10;"];
"noHardware" -> "Hardware" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"uses" [label="uses -&gt; Hardware *" URL="#uses" tooltip="uses -&gt; Hardware *&#10;"];
"uses" -> "Hardware" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}