open util/integer
pred show {}


one sig root
{ var r_c0_b : set c0_b }
fact { all self_ : root | always (one self_.@r_c0_b) }


sig c0_b
{ p_c0_b : lone root
, var r_c0_c : set c0_c
, var r_c0_d : set c0_d
, var r_c0_e : set c0_e }
{ always (this in alive_c0_b implies (let children = (this.@r_c0_c + this.@r_c0_d + this.@r_c0_e) | one children)) }
fun alive_c0_b : set c0_b { root.@r_c0_b }
fact { always ~@r_c0_b in @p_c0_b }

fact { all self_ : c0_b | always (self_ in alive_c0_b implies (lone self_.@r_c0_c)) }
fact { all self_ : c0_b | always (self_ in alive_c0_b implies (lone self_.@r_c0_d)) }
fact { all self_ : c0_b | always (self_ in alive_c0_b implies (lone self_.@r_c0_e)) }
fact { all self_ : c0_b | always (self_ in alive_c0_b implies ((some self_.@r_c0_c) => (after (not some (self_ & alive_c0_b) or ((some self_.@r_c0_d) || (some self_.@r_c0_e)))))) }


sig c0_c
{ p_c0_c : lone c0_b }
fun alive_c0_c : set c0_c { c0_b.@r_c0_c }
fact { always ~@r_c0_c in @p_c0_c
  always @r_c0_c.univ in alive_c0_b }


sig c0_d
{ p_c0_d : lone c0_b }
fun alive_c0_d : set c0_d { c0_b.@r_c0_d }
fact { always ~@r_c0_d in @p_c0_d
  always @r_c0_d.univ in alive_c0_b }


sig c0_e
{ p_c0_e : lone c0_b }
fun alive_c0_e : set c0_e { c0_b.@r_c0_e }
fact { always ~@r_c0_e in @p_c0_e
  always @r_c0_e.univ in alive_c0_b }


