digraph "gi67-extending-nested-abstract"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  abstract Hand&#10;"];
"Hand" [label="abstract Hand" URL="#Hand" tooltip="abstract Hand&#10;"];
"Hook" [label="abstract Hook : Hand" URL="#Hook" tooltip="abstract Hook : Hand&#10;"];
"CptHookHand" [label="CptHookHand : Person" URL="#CptHookHand" tooltip="CptHookHand : Person&#10;  left : Hook&#10;  right : Hand&#10;"];
"CptHandHook" [label="CptHandHook : Person" URL="#CptHandHook" tooltip="CptHandHook : Person&#10;  left : Hand&#10;  right : Hook&#10;"];
}