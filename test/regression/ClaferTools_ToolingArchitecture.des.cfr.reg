//# OPTIONS --explicit
0..* c0_claferCompiler : c0_claferLib 1..1 {}
0..* c0_claferIG : c0_claferLib 1..1 {}
0..* c0_claferMOO : c0_claferLib 1..1 {
  0..* c0_moo 1..1 {}
}
abstract 0..* c0_claferLib 0..* {
  0..* c0_common 1..1 {}
  0..* c0_front : c0_Front 1..1 {}
  0..* c0_intermediate : c0_Intermediate 1..1 {}
  0..* c0_optimizer 1..1 {}
  1..1 c0_generator : c0_Generator 1..1 {}
}
abstract 0..* c0_Representation 0..* {}
0..* c0_text : c0_Representation 1..1 {}
0..* c0_tokens : c0_Representation 1..1 {}
0..* c0_ast : c0_Representation 1..1 {}
0..* c0_ir : c0_Representation 1..1 {}
abstract 0..* c0_io 0..* {
  0..* c0_input -> c0_Representation 1..1 {}
  0..* c0_output -> c0_Representation 1..1 {}
}
abstract 0..* c0_text2tokens : c0_io 0..* {
  [(this . c0_input . dref = c0_text) && (this . c0_output . dref = c0_tokens)]
}
abstract 0..* c0_tokens2tokens : c0_io 0..* {
  [(this . c0_input . dref = c0_tokens) && (this . c0_output . dref = c0_tokens)]
}
abstract 0..* c0_tokens2ast : c0_io 0..* {
  [(this . c0_input . dref = c0_tokens) && (this . c0_output . dref = c0_ast)]
}
abstract 0..* c0_ast2ast : c0_io 0..* {
  [(this . c0_input . dref = c0_ast) && (this . c0_output . dref = c0_ast)]
}
abstract 0..* c0_ast2text : c0_io 0..* {
  [(this . c0_input . dref = c0_ast) && (this . c0_output . dref = c0_text)]
}
abstract 0..* c0_ast2ir : c0_io 0..* {
  [(this . c0_input . dref = c0_ast) && (this . c0_output . dref = c0_ir)]
}
abstract 0..* c0_ir2ir : c0_io 0..* {
  [(this . c0_input . dref = c0_ir) && (this . c0_output . dref = c0_ir)]
}
abstract 0..* c0_ir2text : c0_io 0..* {
  [(this . c0_input . dref = c0_ir) && (this . c0_output . dref = c0_text)]
}
abstract 0..* c0_Front 0..* {
  0..* c0_lexer : c0_text2tokens 1..1 {}
  1..1 c0_layoutResolver : c0_tokens2tokens 0..1 {
    0..* c0_stable 0..1 {}
    0..* c0_experimental 0..1 {}
  }
  0..* c0_parser : c0_tokens2ast 1..1 {}
  0..* c0_mapper : c0_ast2ast 1..1 {}
  0..* c0_prettyPrinter : c0_ast2text 0..1 {}
}
abstract 0..* c0_Intermediate 0..* {
  0..* c0_desugarer : c0_ast2ir 1..1 {}
  0..* c0_findDuplicates 0..1 {}
  0..* c0_resolver : c0_ir2ir 0..1 {
    0..* c0_setUid 1..1 {}
    0..* c0_inheritanceFlattener 0..1 {}
    0..* c0_nameResolution 1..1 {
      0..* c0_nameResolver 0..1 {
        [(#this . parent . parent . parent . c0_findDuplicates) >= 1]
      }
      0..* c0_inheritanceResolver 1..1 {}
      0..* c0_typeResolver 1..1 {}
    }
  }
  0..* c0_transformer : c0_ir2ir 1..1 {}
  0..* c0_stringAnalyzer : c0_ir2ir 0..1 {}
  0..* c0_scopeAnalysis : c0_ir2ir 0..1 {}
}
abstract 1..1 c0_Generator : c0_ir2text 0..* {
  0..* c0_alloy 0..1 {
    [((#c0_Intermediate . c0_stringAnalyzer) >= 1) && ((#c0_Intermediate . c0_scopeAnalysis) >= 1)]
  }
  0..* c0_stats 0..1 {}
  0..* c0_xml 0..1 {}
  0..* c0_desClafer 0..1 {
    [(#c0_Front . c0_prettyPrinter) >= 1]
  }
  0..* c0_xsdSchema 0..1 {}
}
