scope({$Request:2, $Signal:3});
defaultScope(1);
stringLength(16);

$Component = Abstract("Component");
$InPort = $Component.addAbstractChild("InPort");
$OutPort = $Component.addAbstractChild("OutPort");
$Signal = Abstract("Signal");
$Command = Abstract("Command");
$MotorCommand = Abstract("MotorCommand");
$motorDown = Clafer("motorDown").withCard(1, 1);
$Request = Abstract("Request");
$stop = Clafer("stop").withCard(1, 1);
$Controller = Abstract("Controller");
$Controller__req = $Controller.addAbstractChild("Controller__req");
$down = $Controller.addChild("down").withCard(1, 1);
$WinController = Clafer("WinController").withCard(1, 1);
$WinController__req = $WinController.addChild("WinController__req").withCard(1, 1);
$cmd = $WinController.addChild("cmd").withCard(1, 1);
$InPort.refTo($Signal);
$OutPort.refTo($Signal);
$Command.extending($Signal);
$MotorCommand.extending($Command);
$motorDown.extending($MotorCommand);
$Request.extending($Signal);
$stop.extending($Request);
$Controller.extending($Component);
$Controller__req.extending($InPort).refToUnique($Request);
$down.extending($Request);
$WinController.extending($Controller);
$WinController__req.extending($Controller__req).refToUnique($stop);
$cmd.extending($OutPort).refToUnique($MotorCommand);
assert(equal(joinRef(join(global($WinController), $cmd)), global($motorDown)));
assert(equal(joinRef(join(global($Controller), $Controller__req)), global($stop)));
