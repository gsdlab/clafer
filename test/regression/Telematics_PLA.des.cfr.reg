//# OPTIONS --explicit
[(#telematicsSystem.channel.dual) >= 1]
[(#telematicsSystem.extraDisplay) >= 1]
[(#telematicsSystem.telematicsSystem__size.telematicsSystem__size__large) >= 1]
[comp.version.dref = 1]
0..* telematicsSystem 1..1 {
  [((#this.channel.dual) >= 1) <=> ((#ECU2) >= 1)]
  [((#this.extraDisplay) >= 1) <=> ((#ECU1.plaECU__display) = 2)]
  [((#this.extraDisplay) >= 1) <=> (((#ECU2) >= 1) => ((#ECU2.plaECU__display) = 2))]
  [((#this.telematicsSystem__size.telematicsSystem__size__large) >= 1) <=> ((#plaECU.plaECU__display.display__options.options__size.options__size__small) = 0)]
  [((#this.telematicsSystem__size.telematicsSystem__size__small) >= 1) <=> ((#plaECU.plaECU__display.display__options.options__size.options__size__large) = 0)]
  1..1 channel 1..1 {
    0..* single 0..1 {}
    0..* dual 0..1 {}
