  0..* server -> ECU 1..1 {}
  0..* display__options : root__options 1..1 {}
}
abstract 0..* root__options 0..* {
  [(((#this.options__size.options__size__small) >= 1) && ((#this.cache) >= 1)) => ((#this.cache.cache__size.fixed) >= 1)]
