scope({$Phone:4, $agps:4, $bluetooth:4, $gps:4, $gpu:4, $location:4, $mobile:4, $networking:4, $nfc:4, $typeB:4, $typeG:4, $typeN:4, $wifi:4});
defaultScope(1);
stringLength(16);

$Phone = Abstract("Phone");
$networking = $Phone.addChild("networking").withCard(1, 1);
$wifi = $networking.addChild("wifi").withCard(0, 1);
$typeB = $wifi.addChild("typeB").withCard(0, 1);
$typeG = $wifi.addChild("typeG").withCard(0, 1);
$typeN = $wifi.addChild("typeN").withCard(0, 1);
$bluetooth = $networking.addChild("bluetooth").withCard(0, 1);
$mobile = $networking.addChild("mobile").withCard(0, 1);
$nfc = $networking.addChild("nfc").withCard(0, 1);
$location = $Phone.addChild("location").withCard(0, 1).withGroupCard(1, 1);
$gps = $location.addChild("gps").withCard(0, 1);
$agps = $location.addChild("agps").withCard(0, 1);
$gpu = $Phone.addChild("gpu");
$PhoneWithGps = Clafer("PhoneWithGps").withCard(1, 1);
$PhoneWithWifi = Clafer("PhoneWithWifi").withCard(1, 1);
$PhonewithWifiAndGpsNoBluetoothOrNfc = Clafer("PhonewithWifiAndGpsNoBluetoothOrNfc").withCard(1, 1);
$PhoneWithGpu = Clafer("PhoneWithGpu").withCard(1, 1);
$PhoneWithGps.extending($Phone);
$PhoneWithWifi.extending($Phone);
$PhonewithWifiAndGpsNoBluetoothOrNfc.extending($Phone);
$PhoneWithGpu.extending($Phone);
$PhoneWithGps.addConstraint(some(join(join($this(), $location), $gps)));
$PhoneWithWifi.addConstraint(some(join(join(join($this(), $networking), $wifi), $typeN)));
$PhonewithWifiAndGpsNoBluetoothOrNfc.addConstraint(and(and(some(join(join($this(), $networking), $wifi)), some(join(join($this(), $location), $gps))), not(or(some(join(join($this(), $networking), $bluetooth)), some(join(join($this(), $networking), $nfc))))));
$PhoneWithGpu.addConstraint(some(join($this(), $gpu)));
Constraint(all([decl([$_p = local("p")], global($Phone))], some(join(join($_p, $networking), $mobile))));
