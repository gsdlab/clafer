open util/integer
pred show {}


one sig numberOne
{ numberOne_ref : one Int }

fact { (some numberOne) => ((numberOne.@numberOne_ref) = 1) }
one sig alice
{ alice_ref : one Int }

fact { (some alice) => ((alice.@alice_ref) = 0) }
one sig likertScaleVal
{ likertScaleVal_ref : one (((1 + 2) + 3) + 4) + 5 }

one sig nonZero
{ nonZero_ref : one Int - 0 }

abstract sig Person
{ r_Person__Head : set Person__Head
, r_likes : lone likes }

abstract sig Person__Head
{}
{ one @r_Person__Head.this }

sig likes
{ likes_ref : one Person }
{ one @r_likes.this }

one sig Alice extends Person
{ r_Alice__Head : one Alice__Head }
{ r_Alice__Head in r_Person__Head
  ((this.@r_likes).@likes_ref) = Ella }

one sig Alice__Head extends Person__Head
{}

one sig Ella extends Person
{ r_h : one h }
{ no this.@r_likes }

one sig h
{}

sig heads
{ heads_ref : one Person__Head }

fact {  all disj x, y : heads | (x.@heads_ref) != (y.@heads_ref)  }
fact { 2 <= #friend and #friend <= 2 }
sig friend
{ friend_ref : one Alice + Ella }

fact {  all disj x, y : friend | (x.@friend_ref) != (y.@friend_ref)  }
one sig onlyAlice
{ onlyAlice_ref : one Alice & Person }

assert assertAt_37_10 { Alice in (onlyAlice.@onlyAlice_ref) }
check assertAt_37_10 for 1 but 2 Person, 2 friend, 2 likes

assert assertAt_38_10 { Ella not in (onlyAlice.@onlyAlice_ref) }
check assertAt_38_10 for 1 but 2 Person, 2 friend, 2 likes

one sig exceptElla
{ exceptElla_ref : one Person - Ella }

assert assertAt_43_10 { Alice in (exceptElla.@exceptElla_ref) }
check assertAt_43_10 for 1 but 2 Person, 2 friend, 2 likes

assert assertAt_44_10 { Ella not in (exceptElla.@exceptElla_ref) }
check assertAt_44_10 for 1 but 2 Person, 2 friend, 2 likes

