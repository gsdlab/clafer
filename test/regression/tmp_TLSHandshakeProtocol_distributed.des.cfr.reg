//# OPTIONS --explicit --tl=10
abstract final 0..* Feature 0..* {}
abstract final 0..* FeatureModel 0..* {}
final 0..* TLSFeatures : FeatureModel 1..1 {
  final 0..* annonymousMode : Feature 0..1 {}
  final 0..* clientAuthentication : Feature 0..1 {}
  [(some this.clientAuthentication) => (no this.annonymousMode)]
}
abstract final 0..* Domain 0..* {}
enum ProtocolVersion = SSL2_0 | SSL3_0 | TLS1_0 | TLS1_1 | TLS1_2
enum HandshakeStatus = initiated | completed | failed
abstract 0..* Port 0..* {}
abstract final 0..* Message 0..* {}
final 0..* serverHelloRequestMessage : Message 1..1 {}
final 0..* serverHelloMessage : Message 1..1 {}
final 0..* serverCertificateMessage : Message 1..1 {}
final 0..* serverKeyExchangeMessage : Message 1..1 {}
final 0..* serverCertificateRequestMessage : Message 1..1 {}
final 0..* serverHelloDoneMessage : Message 1..1 {}
final 0..* serverChangeCipherSpecMessage : Message 1..1 {}
final 0..* serverFinishedMessage : Message 1..1 {}
final 0..* protocolMismatch : Message 1..1 {}
final 0..* clientHelloMessage : Message 1..1 {}
final 0..* clientCertificateMessage : Message 1..1 {}
final 0..* clientKeyExchangeMessage : Message 1..1 {}
final 0..* certificateVerifyMessage : Message 1..1 {}
final 0..* clientChangeCipherSpecMessage : Message 1..1 {}
final 0..* clientFinishedMessage : Message 1..1 {}
final 0..* applicationDataMessage : Message 1..1 {}
abstract final 0..* Node : Domain 0..* {
  0..* send : Port -> Message 1..1 {}
  0..* receive : Port -> Message 1..1 {}
  0..* protocolversion -> ProtocolVersion 1..* {}
  0..* certificate 0..1 {
    0..* signing 0..1 {}
  }
}
abstract final 0..* Server : Node 0..* {}
abstract final 0..* Client : Node 0..* {}
[Server.send.dref = Client.receive.dref]
[Server.receive.dref = Client.send.dref]
final 0..* OurServer : Server 1..1 {
  [this.protocolversion.dref = ((SSL2_0 ++ SSL3_0) ++ TLS1_2)]
}
final 0..* aClient : Client 1..1 {
  [some this.certificate]
  [this.protocolversion.dref = TLS1_2]
}
final 0..* Protocol : Domain 1..1 {
  final 0..* client -> aClient 1..1 {}
  final 0..* server -> OurServer 1..1 {}
  0..* handshakeStatus -> HandshakeStatus 1..1 {}
  1..1 channel 1..1 {
    initial 0..* clientHello 0..1 {
      [this.parent.parent.handshakeStatus.dref = initiated]
      [this.parent.parent.client.dref.send.dref = clientHelloMessage]
      [(some this) --> ((some this.parent.serverResponse) || (some this.parent.fatalError))]
    }
    1..1 serverResponse 0..1 {
      [this.parent.parent.handshakeStatus.dref = initiated]
      [initially ((some this.serverHello) || (some this.mismatch))]
      0..* mismatch 0..1 {
        [no (this.parent.parent.parent.client.dref.protocolversion.dref ** this.parent.parent.parent.server.dref.protocolversion.dref)]
        [this.parent.parent.parent.server.dref.send.dref = protocolMismatch]
      }
      0..* serverHello 0..1 {
        [some (this.parent.parent.parent.client.dref.protocolversion.dref ** this.parent.parent.parent.server.dref.protocolversion.dref)]
        [this.parent.parent.parent.server.dref.send.dref = serverHelloMessage]
      }
      [(some this.serverHello) -[(no TLSFeatures.annonymousMode)]-> (some this.serverCertificate)]
      [(some this.serverHello) -[(some TLSFeatures.annonymousMode)]-> (some this.serverKeyExchange)]
      0..* serverCertificate 0..1 {
        [no TLSFeatures.annonymousMode]
        [this.parent.parent.parent.server.dref.send.dref = serverCertificateMessage]
      }
      [(some this.serverCertificate) -[(some TLSFeatures.clientAuthentication)]-> ((some this.serverKeyExchange) || (some this.certificateRequest))]
      [(some this.serverCertificate) -[(no TLSFeatures.clientAuthentication)]-> ((some this.serverKeyExchange) || (some this.serverHelloDone))]
      0..* serverKeyExchange 0..1 {
        [this.parent.parent.parent.server.dref.send.dref = serverKeyExchangeMessage]
      }
      [(some this.serverKeyExchange) -[(some TLSFeatures.clientAuthentication)]-> (some this.certificateRequest)]
      [(some this.serverKeyExchange) -[(no TLSFeatures.clientAuthentication)]-> (some this.serverHelloDone)]
      0..* certificateRequest 0..1 {
        [some TLSFeatures.clientAuthentication]
        [this.parent.parent.parent.server.dref.send.dref = serverCertificateRequestMessage]
        [(some this) --> (some this.parent.serverHelloDone)]
      }
      0..* serverHelloDone 0..1 {
        [this.parent.parent.parent.server.dref.send.dref = serverHelloDoneMessage]
      }
    }
    [(some this.serverResponse) -[(!((some this.serverResponse.mismatch) || (some this.serverResponse.serverHelloDone)))]-> (some this.serverResponse)]
    [(some this.serverResponse.mismatch) --> (some this.fatalError)]
    [(some this.serverResponse.serverHelloDone) --> (some this.clientResponse)]
    1..1 clientResponse 0..1 {
      [this.parent.parent.handshakeStatus.dref = initiated]
      [initially ((some TLSFeatures.clientAuthentication) => (some this.clientCertificate))]
      [initially ((no TLSFeatures.clientAuthentication) => (some this.clientKeyExchange))]
      0..* clientCertificate 0..1 {
        [some TLSFeatures.clientAuthentication]
        [this.parent.parent.parent.client.dref.send.dref = clientCertificateMessage]
        [(some this) --> (some this.parent.clientKeyExchange)]
      }
      0..* clientKeyExchange 0..1 {
        [this.parent.parent.parent.client.dref.send.dref = clientKeyExchangeMessage]
      }
      [(some this.clientKeyExchange) -[((some TLSFeatures.clientAuthentication) && (some this.parent.parent.client.dref.certificate.signing))]-> (some this.certificateVerify)]
      [(some this.clientKeyExchange) -[(!((some TLSFeatures.clientAuthentication) && (some this.parent.parent.client.dref.certificate.signing)))]-> (some this.clientChangeCipherSpec)]
      0..* certificateVerify 0..1 {
        [some this.parent.parent.parent.client.dref.certificate.signing]
        [this.parent.parent.parent.client.dref.send.dref = certificateVerifyMessage]
        [(some this) --> (some this.parent.clientChangeCipherSpec)]
      }
      0..* clientChangeCipherSpec 0..1 {
        [this.parent.parent.parent.client.dref.send.dref = clientChangeCipherSpecMessage]
        [(some this) --> (some this.parent.clientFinished)]
      }
      0..* clientFinished 0..1 {
        [this.parent.parent.parent.client.dref.send.dref = clientFinishedMessage]
      }
    }
    [(some this.clientResponse) -[(no this.clientResponse.clientFinished)]-> (some this.clientResponse)]
    [(some this.clientResponse.clientFinished) --> (some this.serverFinish)]
    1..1 serverFinish 0..1 {
      initial 0..* serverChangeCipherSpec 0..1 {
        [this.parent.parent.parent.handshakeStatus.dref = initiated]
        [this.parent.parent.parent.server.dref.send.dref = serverChangeCipherSpecMessage]
        [(some this) --> (some this.parent.serverFinished)]
      }
      0..* serverFinished 0..1 {
        [this.parent.parent.parent.server.dref.send.dref = serverFinishedMessage]
        [this.parent.parent.parent.handshakeStatus.dref = completed]
      }
    }
    [(some this.serverFinish) -[(no this.serverFinish.serverFinished)]-> (some this.serverFinish)]
    [(some this.serverFinish.serverFinished) --> (some this.dataTransfer)]
    0..* dataTransfer 0..1 {
      [this.parent.parent.handshakeStatus.dref = completed]
      [this.parent.parent.client.dref.send.dref = applicationDataMessage]
      [(some this) -->> (some this.parent.clientHello)]
    }
    0..* fatalError 0..1 {
      [this.parent.parent.handshakeStatus.dref = failed]
      [(some this) --> (some this)]
    }
  }
}
