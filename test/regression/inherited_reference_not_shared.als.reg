open util/integer
pred show {}


abstract sig Person
{}

one sig JohnDoe extends Person
{}

one sig MaryJane extends Person
{}

abstract sig WaitingLine
{ r_participants : set participants }
{ all disj x, y : this.@r_participants | (x.@participants_ref) != (y.@participants_ref)  }

sig participants
{ participants_ref : one Person }
{ one @r_participants.this }

one sig BusLine extends WaitingLine
{}
{ (JohnDoe in ((this.@r_participants).@participants_ref)) && (MaryJane in ((this.@r_participants).@participants_ref)) }

one sig JohnAndMaryLine extends WaitingLine
{}
{ ((this.@r_participants).@participants_ref) = (JohnDoe + MaryJane) }

assert assertAt_17_10 { all  wl : WaitingLine | ((wl.@r_participants).@participants_ref) = (JohnDoe + MaryJane) }
check assertAt_17_10 for 1 but 2 Person, 2 WaitingLine, 4 participants

