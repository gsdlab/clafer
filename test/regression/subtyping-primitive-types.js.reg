scope({$percent:2});
defaultScope(1);
stringLength(16);

$percent = Abstract("percent");
$twoPercent = Clafer("twoPercent").withCard(1, 1);
$threePercent = Clafer("threePercent").withCard(1, 1);
$date = Abstract("date");
$today = Clafer("today").withCard(1, 1);
$time = Abstract("time");
$minute = $time.addChild("minute").withCard(1, 1);
$hour = $time.addChild("hour").withCard(1, 1);
$now = Clafer("now").withCard(1, 1);
$percent.refTo(Int);
$percent.addConstraint(and(greaterThanEqual(joinRef($this()), constant(0)), lessThanEqual(joinRef($this()), constant(5))));
$twoPercent.extending($percent);
Constraint(implies(some(global($twoPercent)), equal(joinRef(global($twoPercent)), constant(2))));
$threePercent.extending($percent);
Constraint(implies(some(global($threePercent)), equal(joinRef(global($threePercent)), add(joinRef(global($twoPercent)), constant(1)))));
$date.refTo(string);
$today.extending($date);
Constraint(implies(some(global($today)), equal(joinRef(global($today)), constant("\"Mar 20, 2012\""))));
$time.refTo(Int);
$minute.refToUnique(Int);
$minute.addConstraint(and(greaterThanEqual(joinRef($this()), constant(0)), lessThanEqual(joinRef($this()), constant(5))));
$hour.refToUnique(Int);
$hour.addConstraint(and(greaterThanEqual(joinRef($this()), constant(0)), lessThanEqual(joinRef($this()), constant(5))));
Constraint(implies(some(global($time)), equal(joinRef(global($time)), add(joinRef(join(global($time), $minute)), joinRef(join(global($time), $hour))))));
$now.extending($time);
$now.addConstraint(equal(joinRef(join($this(), $minute)), constant(3)));
$now.addConstraint(equal(joinRef(join($this(), $hour)), constant(1)));
