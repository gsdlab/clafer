scope({$Person:4, $spouse:4});
defaultScope(1);
stringLength(16);

$Person = Abstract("Person");
$spouse = $Person.addChild("spouse").withCard(0, 1);
$Alice = Clafer("Alice").withCard(1, 1);
$Bob = Clafer("Bob").withCard(1, 1);
$Carol = Clafer("Carol").withCard(1, 1);
$Dave = Clafer("Dave").withCard(1, 1);
$spouse.refToUnique($Person);
$Alice.extending($Person);
$Alice.addConstraint(equal(joinRef(join($this(), $spouse)), global($Bob)));
$Bob.extending($Person);
assert(equal(joinRef(join(global($Bob), $spouse)), global($Alice)));
$Carol.extending($Person);
$Carol.addConstraint(none(join($this(), $spouse)));
$Dave.extending($Person);
assert(none(join(global($Dave), $spouse)));

//symmetric[r_spouse . spouse_ref]
//irreflexive[r_spouse . spouse_ref]
