open util/integer
pred show {}


one sig aCar extends Car
{}

abstract sig Car
{ r_ABS : lone ABS
, r_Transmission : one Transmission
, r_FCA : lone FCA
, r_CC : lone CC
, r_total_cost : one total_cost
, r_total_comfort : one total_comfort
, r_total_fuel : one total_fuel
, r_total_mass : one total_mass }
{ (some (this.@r_CC).@r_ACC) => (some this.@r_FCA)
  (some this.@r_total_cost) => (((this.@r_total_cost).@total_cost_ref) = (sum temp : (Feature.@r_cost) | temp.@cost_ref))
  (some this.@r_total_comfort) => (((this.@r_total_comfort).@total_comfort_ref) = (sum temp : (ComfortFeature.@r_cost) | temp.@cost_ref))
  (some this.@r_total_fuel) => (((this.@r_total_fuel).@total_fuel_ref) = (sum temp : (FuelFeature.@r_cost) | temp.@cost_ref))
  (some this.@r_total_mass) => (((this.@r_total_mass).@total_mass_ref) = (sum temp : (FuelFeature.@r_mass) | temp.@mass_ref)) }

sig ABS extends ComfortFeature
{}
{ one @r_ABS.this
  ((this.@r_cost).@cost_ref) = 2
  ((this.@r_mass).@mass_ref) = 1
  ((this.@r_comfort).@comfort_ref) = 1 }

sig Transmission
{ r_Automatic : lone Automatic
, r_Manual : lone Manual }
{ one @r_Transmission.this
  let children = (r_Automatic + r_Manual) | one children }

sig Automatic extends FuelFeature
{}
{ one @r_Automatic.this
  ((this.@r_fuel).@fuel_ref) = 2
  ((this.@r_mass).@mass_ref) = 1
  ((this.@r_comfort).@comfort_ref) = 2
  ((this.@r_cost).@cost_ref) = 4 }

sig Manual extends FuelFeature
{}
{ one @r_Manual.this
  ((this.@r_fuel).@fuel_ref) = 0
  ((this.@r_mass).@mass_ref) = 1
  ((this.@r_comfort).@comfort_ref) = 1
  ((this.@r_cost).@cost_ref) = 3 }

sig FCA extends FuelFeature
{ r_Sensor : one Sensor
, r_Alert : lone Alert }
{ one @r_FCA.this
  ((this.@r_fuel).@fuel_ref) = 2
  ((this.@r_mass).@mass_ref) = 2
  ((this.@r_comfort).@comfort_ref) = 4
  ((this.@r_cost).@cost_ref) = 5 }

sig Sensor
{ r_Radar : lone Radar
, r_Lidar : lone Lidar }
{ one @r_Sensor.this
  let children = (r_Radar + r_Lidar) | one children }

sig Radar extends Feature
{}
{ one @r_Radar.this
  ((this.@r_cost).@cost_ref) = 3
  ((this.@r_mass).@mass_ref) = 1 }

sig Lidar extends Feature
{}
{ one @r_Lidar.this
  ((this.@r_cost).@cost_ref) = 5
  ((this.@r_mass).@mass_ref) = 1 }

sig Alert
{ r_Haptic : lone Haptic
, r_Audible : lone Audible }
{ one @r_Alert.this
  let children = (r_Haptic + r_Audible) | one children }

sig Haptic extends ComfortFeature
{}
{ one @r_Haptic.this
  ((this.@r_comfort).@comfort_ref) = 4
  ((this.@r_cost).@cost_ref) = 2
  ((this.@r_mass).@mass_ref) = 1 }

sig Audible extends ComfortFeature
{}
{ one @r_Audible.this
  ((this.@r_comfort).@comfort_ref) = 2
  ((this.@r_cost).@cost_ref) = 1
  ((this.@r_mass).@mass_ref) = 1 }

sig CC extends FuelFeature
{ r_ACC : lone ACC }
{ one @r_CC.this
  ((this.@r_fuel).@fuel_ref) = 1
  ((this.@r_mass).@mass_ref) = 1
  ((this.@r_comfort).@comfort_ref) = 3
  ((this.@r_cost).@cost_ref) = 4 }

sig ACC extends FuelFeature
{}
{ one @r_ACC.this
  ((this.@r_fuel).@fuel_ref) = 2
  ((this.@r_mass).@mass_ref) = 2
  ((this.@r_comfort).@comfort_ref) = 6
  ((this.@r_cost).@cost_ref) = 3 }

sig total_cost
{ total_cost_ref : one Int }
{ one @r_total_cost.this }

sig total_comfort
{ total_comfort_ref : one Int }
{ one @r_total_comfort.this }

sig total_fuel
{ total_fuel_ref : one Int }
{ one @r_total_fuel.this }

sig total_mass
{ total_mass_ref : one Int }
{ one @r_total_mass.this }

abstract sig Feature
{ r_cost : one cost
, r_mass : one mass }

sig cost
{ cost_ref : one Int }
{ one @r_cost.this }

sig mass
{ mass_ref : one Int }
{ one @r_mass.this }

abstract sig ComfortFeature extends Feature
{ r_comfort : one comfort }

sig comfort
{ comfort_ref : one Int }
{ one @r_comfort.this }

abstract sig FuelFeature extends ComfortFeature
{ r_fuel : one fuel }

sig fuel
{ fuel_ref : one Int }
{ one @r_fuel.this }

