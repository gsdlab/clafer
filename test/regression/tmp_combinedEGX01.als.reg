open util/integer
pred show {}


one sig root
{ var r_a : set a }
fact { always (one root.@r_a) }


sig a
{ p_a : lone root
, var r_b : set b
, var r_c : set c }
{ always (this in alive_a implies (let children = (this.@r_b + this.@r_c) | one children)) }
fun alive_a : set a { root.@r_a }
fact { always ~@r_a in @p_a }

fact { all self_ : a | always (self_ in alive_a implies (lone self_.@r_b)) }
fact { all self_ : a | always (self_ in alive_a implies (lone self_.@r_c)) }
fact { all self_ : a | always (self_ in alive_a implies (eventually (some self_.@r_c))) }
fact { all self_ : a | always (self_ in alive_a implies ((not before self_ in alive_a) implies (some self_.@r_b))) }


sig b
{ p_b : lone a }
fun alive_b : set b { a.@r_b }
fact { always ~@r_b in @p_b
  always @r_b.univ in alive_a }


sig c
{ p_c : lone a }
fun alive_c : set c { a.@r_c }
fact { always ~@r_c in @p_c
  always @r_c.univ in alive_a }


