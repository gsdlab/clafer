open util/integer
pred show {}


abstract sig Person
{ r_name : one name
, r_civstat : one civstat
, r_gender : one gender
, r_alive : lone alive
, r_husband : lone husband
, r_wife : lone wife }
{ (((((this.@r_civstat).@civstat_ref) = 0) || (((this.@r_civstat).@civstat_ref) = 1)) || (((this.@r_civstat).@civstat_ref) = 2)) || (((this.@r_civstat).@civstat_ref) = 3)
  (((this.@r_gender).@gender_ref) = 4) || (((this.@r_gender).@gender_ref) = 5)
  all  p : Person | (this != p) => (((this.@r_name).@name_ref) != ((p.@r_name).@name_ref))
  one  p : Person | ((p.@r_name).@name_ref) = ((this.@r_name).@name_ref) }

sig name
{ name_ref : one Int }
{ one @r_name.this }

sig civstat
{ civstat_ref : one Int }
{ one @r_civstat.this }

sig gender
{ gender_ref : one Int }
{ one @r_gender.this }

sig alive
{}
{ one @r_alive.this }

sig husband
{ husband_ref : one Person }
{ one @r_husband.this
  (this.~@r_husband) in (((this.@husband_ref).@r_wife).@wife_ref) }

sig wife
{ wife_ref : one Person }
{ one @r_wife.this
  (this.~@r_wife) in (((this.@wife_ref).@r_husband).@husband_ref) }

one sig ada extends Person
{}
{ (((((((this.@r_name).@name_ref) = 6) && (((this.@r_civstat).@civstat_ref) = 3)) && (((this.@r_gender).@gender_ref) = 4)) && (some this.@r_alive)) && (no this.@r_husband)) && (no this.@r_wife) }

one sig cyd extends Person
{}
{ (((((((this.@r_name).@name_ref) = 7) && (((this.@r_civstat).@civstat_ref) = 1)) && (((this.@r_gender).@gender_ref) = 5)) && (no this.@r_alive)) && (no this.@r_husband)) && (no this.@r_wife) }

one sig eve extends Person
{}
{ (((((((this.@r_name).@name_ref) = 8) && (((this.@r_civstat).@civstat_ref) = 1)) && (((this.@r_gender).@gender_ref) = 4)) && (some this.@r_alive)) && (((this.@r_husband).@husband_ref) = dan)) && (no this.@r_wife) }

one sig bob extends Person
{}
{ (((((((this.@r_name).@name_ref) = 9) && (((this.@r_civstat).@civstat_ref) = 2)) && (((this.@r_gender).@gender_ref) = 5)) && (some this.@r_alive)) && (no this.@r_husband)) && (no this.@r_wife) }

one sig dan extends Person
{}
{ (((((((this.@r_name).@name_ref) = 10) && (((this.@r_civstat).@civstat_ref) = 1)) && (((this.@r_gender).@gender_ref) = 5)) && (some this.@r_alive)) && (no this.@r_husband)) && (((this.@r_wife).@wife_ref) = eve) }

fact { (((adaBobCyd.@adaBobCyd_ref).@r_name).@name_ref) = (stringSet1.@stringSet1_ref) }
fact { (((personWithUndefinedHusband1.@personWithUndefinedHusband1_ref).@r_name).@name_ref) = (stringSet2.@stringSet2_ref) }
fact { (((personWithUndefinedHusband2.@personWithUndefinedHusband2_ref).@r_name).@name_ref) = (stringSet2.@stringSet2_ref) }
fact { ((((((possiblePairs.@possiblePairs_ref).@r_first).@first_ref).@r_name).@name_ref) = 6) && ((((((possiblePairs.@possiblePairs_ref).@r_second).@second_ref).@r_name).@name_ref) = 9) }
sig adaBobCyd
{ adaBobCyd_ref : one Person }
{ (((this.@adaBobCyd_ref).@r_name).@name_ref) in (stringSet1.@stringSet1_ref) }

fact {  all disj x, y : adaBobCyd | (x.@adaBobCyd_ref) != (y.@adaBobCyd_ref)  }
fact { all  p : Person | (((p.@r_name).@name_ref) in (stringSet1.@stringSet1_ref)) => (p in (adaBobCyd.@adaBobCyd_ref)) }
sig personWithUndefinedHusband1
{ personWithUndefinedHusband1_ref : one Person }
{ (((this.@personWithUndefinedHusband1_ref).@r_husband).@husband_ref) = (emptyPersonSet1.@emptyPersonSet1_ref) }

fact {  all disj x, y : personWithUndefinedHusband1 | (x.@personWithUndefinedHusband1_ref) != (y.@personWithUndefinedHusband1_ref)  }
fact { all  p : Person | (((p.@r_husband).@husband_ref) = (emptyPersonSet1.@emptyPersonSet1_ref)) => (p in (personWithUndefinedHusband1.@personWithUndefinedHusband1_ref)) }
sig personWithUndefinedHusband2
{ personWithUndefinedHusband2_ref : one Person }
{ (((this.@personWithUndefinedHusband2_ref).@r_husband).@husband_ref) = (emptyPersonSet2.@emptyPersonSet2_ref) }

fact {  all disj x, y : personWithUndefinedHusband2 | (x.@personWithUndefinedHusband2_ref) != (y.@personWithUndefinedHusband2_ref)  }
fact { all  p : Person | (((p.@r_husband).@husband_ref) = (emptyPersonSet2.@emptyPersonSet2_ref)) => (p in (personWithUndefinedHusband2.@personWithUndefinedHusband2_ref)) }
sig personWithNoWife
{ personWithNoWife_ref : one Person }
{ no (this.@personWithNoWife_ref).@r_wife }

fact {  all disj x, y : personWithNoWife | (x.@personWithNoWife_ref) != (y.@personWithNoWife_ref)  }
fact { all  p : Person | (no p.@r_wife) => (p in (personWithNoWife.@personWithNoWife_ref)) }
sig emptyPersonSet1
{ emptyPersonSet1_ref : one Person }

fact {  all disj x, y : emptyPersonSet1 | (x.@emptyPersonSet1_ref) != (y.@emptyPersonSet1_ref)  }
fact { (emptyPersonSet1.@emptyPersonSet1_ref) = (((personWithNoWife.@personWithNoWife_ref).@r_wife).@wife_ref) }
sig emptyPersonSet2
{ emptyPersonSet2_ref : one Person }
{ 1 > 2 }

fact {  all disj x, y : emptyPersonSet2 | (x.@emptyPersonSet2_ref) != (y.@emptyPersonSet2_ref)  }
sig personPair
{ r_first : one first
, r_second : one second }

sig first
{ first_ref : one Person }
{ one @r_first.this }

sig second
{ second_ref : one Person }
{ one @r_second.this }

sig possiblePairs
{ possiblePairs_ref : one personPair }
{ ((((((((this.@possiblePairs_ref).@r_first).@first_ref).@r_gender).@gender_ref) = 4) && (some (((this.@possiblePairs_ref).@r_first).@first_ref).@r_alive)) && ((((((this.@possiblePairs_ref).@r_first).@first_ref).@r_civstat).@civstat_ref) != 1)) && ((((((((this.@possiblePairs_ref).@r_second).@second_ref).@r_gender).@gender_ref) = 5) && (some (((this.@possiblePairs_ref).@r_second).@second_ref).@r_alive)) && ((((((this.@possiblePairs_ref).@r_second).@second_ref).@r_civstat).@civstat_ref) != 1)) }

fact {  all disj x, y : possiblePairs | (x.@possiblePairs_ref) != (y.@possiblePairs_ref)  }
fact { all  p, q : Person | ((((((((p.@r_gender).@gender_ref) = 4) && (some p.@r_alive)) && (((p.@r_civstat).@civstat_ref) != 1)) && (((q.@r_gender).@gender_ref) = 5)) && (some q.@r_alive)) && (((q.@r_civstat).@civstat_ref) != 1)) => (one  pair : personPair | ((((pair.@r_first).@first_ref) = p) && (((pair.@r_second).@second_ref) = q)) && (pair in (possiblePairs.@possiblePairs_ref))) }
fact { 3 <= #stringSet1 and #stringSet1 <= 3 }
sig stringSet1
{ stringSet1_ref : one Int }
{ (((this.@stringSet1_ref) = 6) || ((this.@stringSet1_ref) = 9)) || ((this.@stringSet1_ref) = 7) }

fact {  all disj x, y : stringSet1 | (x.@stringSet1_ref) != (y.@stringSet1_ref)  }
fact { 4 <= #stringSet2 and #stringSet2 <= 4 }
sig stringSet2
{ stringSet2_ref : one Int }
{ ((((this.@stringSet2_ref) = 6) || ((this.@stringSet2_ref) = 9)) || ((this.@stringSet2_ref) = 7)) || ((this.@stringSet2_ref) = 10) }

fact {  all disj x, y : stringSet2 | (x.@stringSet2_ref) != (y.@stringSet2_ref)  }
