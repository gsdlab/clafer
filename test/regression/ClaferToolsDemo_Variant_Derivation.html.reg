<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/ClaferToolsDemo_Variant_Derivation.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="keyword">xor</span> <span class="claferDecl" id="root__Bluetooth">Bluetooth</span>
  <div class="indent">
  <span class="claferDecl" id="Bluetooth20">Bluetooth20</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="Bluetooth21">Bluetooth21</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="Bluetooth40">Bluetooth40</span> ?</div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="MobilePhone">MobilePhone</span>
  <div class="indent">
  <span class="claferDecl" id="Connectivity">Connectivity</span>
    <div class="indent">
    `<a href="#root__Bluetooth"><span class="reference">Bluetooth</span></a></div>
    <div class="indent">
    <span class="claferDecl" id="GSM">GSM</span></div>
    <div class="indent">
    <span class="claferDecl" id="LTE">LTE</span> ?
      <div class="indent">
      <span class="keyword">[</span> <a href="#LiBattery1400"><span class="reference">LiBattery1400</span></a> <span class="keyword">]</span></div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="WiFi">WiFi</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="USB">USB</span> ?</div>
  </div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="Battery">Battery</span>
    <div class="indent">
    <span class="claferDecl" id="LiBattery1150">LiBattery1150</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="LiBattery1400">LiBattery1400</span> ?</div>
  </div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="LowEndPhone">LowEndPhone</span><span class="keyword"> : </span><a href="#MobilePhone"><span class="reference">MobilePhone</span></a>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">no</span> <a href="#WiFi"><span class="reference">WiFi</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="HighEndPhone">HighEndPhone</span><span class="keyword"> : </span><a href="#MobilePhone"><span class="reference">MobilePhone</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#USB"><span class="reference">USB</span></a> &amp;&amp; <a href="#WiFi"><span class="reference">WiFi</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="QuadCPU">QuadCPU</span> ?</div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="claferDecl" id="Phone1">Phone1</span><span class="keyword"> : </span><a href="#MobilePhone"><span class="reference">MobilePhone</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#WiFi"><span class="reference">WiFi</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#LTE"><span class="reference">LTE</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#Bluetooth21"><span class="reference">Bluetooth21</span></a> <span class="keyword">]</span></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="claferDecl" id="Phone2">Phone2</span><span class="keyword"> : </span><a href="#HighEndPhone"><span class="reference">HighEndPhone</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#LTE"><span class="reference">LTE</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#Bluetooth21"><span class="reference">Bluetooth21</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#QuadCPU"><span class="reference">QuadCPU</span></a> <span class="keyword">]</span></div>
</div>

</body>
</html>