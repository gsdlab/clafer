scope({$Feature:6, $SecurityFeature:2, $energy:6, $performance:6, $security:2});
defaultScope(1);
stringLength(16);

$Feature = Abstract("Feature");
$performance = $Feature.addChild("performance").withCard(1, 1);
$energy = $Feature.addChild("energy").withCard(1, 1);
$SecurityFeature = Abstract("SecurityFeature");
$security = $SecurityFeature.addChild("security").withCard(1, 1);
$MobilePhone = Abstract("MobilePhone");
$Connectivity = $MobilePhone.addChild("Connectivity").withCard(1, 1).withGroupCard(1);
$Bluetooth = $Connectivity.addChild("Bluetooth").withCard(0, 1);
$USB = $Connectivity.addChild("USB").withCard(0, 1);
$Wifi = $Connectivity.addChild("Wifi").withCard(0, 1);
$PasswordProtection = $MobilePhone.addChild("PasswordProtection").withCard(0, 1);
$FingerprintProtection = $MobilePhone.addChild("FingerprintProtection").withCard(0, 1);
$total_performance = $MobilePhone.addChild("total_performance").withCard(1, 1);
$total_energy = $MobilePhone.addChild("total_energy").withCard(1, 1);
$total_security = $MobilePhone.addChild("total_security").withCard(1, 1);
$MyPhone = Clafer("MyPhone").withCard(1, 1);
$SecurityFeature.extending($Feature);
$Connectivity.extending($Feature);
$Bluetooth.extending($Feature);
$USB.extending($Feature);
$Wifi.extending($Feature);
$PasswordProtection.extending($SecurityFeature);
$FingerprintProtection.extending($SecurityFeature);
$MyPhone.extending($MobilePhone);
$performance.refToUnique(Int);
$energy.refToUnique(Int);
$security.refToUnique(Int);
$total_performance.refToUnique(Int);
$total_energy.refToUnique(Int);
$total_security.refToUnique(Int);
$Connectivity.addConstraint(equal(joinRef(join($this(), $performance)), constant(0)));
$Connectivity.addConstraint(equal(joinRef(join($this(), $energy)), constant(0)));
$Bluetooth.addConstraint(equal(joinRef(join($this(), $performance)), constant(9)));
$Bluetooth.addConstraint(equal(joinRef(join($this(), $energy)), constant(10)));
$USB.addConstraint(equal(joinRef(join($this(), $performance)), constant(15)));
$USB.addConstraint(equal(joinRef(join($this(), $energy)), constant(7)));
$Wifi.addConstraint(equal(joinRef(join($this(), $performance)), constant(22)));
$Wifi.addConstraint(equal(joinRef(join($this(), $energy)), constant(17)));
$PasswordProtection.addConstraint(equal(joinRef(join($this(), $security)), constant(5)));
$PasswordProtection.addConstraint(equal(joinRef(join($this(), $performance)), constant(1)));
$PasswordProtection.addConstraint(equal(joinRef(join($this(), $energy)), constant(2)));
$FingerprintProtection.addConstraint(equal(joinRef(join($this(), $security)), constant(5)));
$FingerprintProtection.addConstraint(equal(joinRef(join($this(), $performance)), constant(2)));
$FingerprintProtection.addConstraint(equal(joinRef(join($this(), $energy)), constant(4)));
$MobilePhone.addConstraint(equal(joinRef(join($this(), $total_performance)), sum(join(global($Feature), $performance))));
$MobilePhone.addConstraint(equal(joinRef(join($this(), $total_energy)), sum(join(global($Feature), $energy))));
$MobilePhone.addConstraint(equal(joinRef(join($this(), $total_security)), sum(join(global($SecurityFeature), $security))));
$MyPhone.addConstraint(and(some(join(join($this(), $Connectivity), $Bluetooth)), none(join(join($this(), $Connectivity), $USB))));
min(joinRef(join(global($MyPhone), $total_energy)));
max(joinRef(join(global($MyPhone), $total_performance)));
max(joinRef(join(global($MyPhone), $total_security)));
