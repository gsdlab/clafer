scope({$AckermanSteerAngle:0, $Check:0, $GVWR:0, $MalfunctionTelltale:0, $Mode:0, $On:0, $Start:0, $SystemControls:0, $SystemControls__Off:0, $Vehicle:0, $Vehicle__AntiLockBreakSystem:0, $Vehicle__DriveConfiguration:0, $Vehicle__ElectronicStabilityControlSystem:0, $Vehicle__TractionControlSystem:0, $YawRate:0, $acceleration:0, $adjustsBrakeTorquesToInduceCorrectingYawMoment:0, $allWheelDrive:0, $augmentsVehiclesDirectionalStability:0, $breaking:0, $coasting:0, $deceleration:0, $degree:0, $derivativeWithRespectToTime:0, $driverSelected:0, $driverSteeringInputs:0, $duringAllPhasesOfDriving:0, $duringSystemInitialization:0, $entersStandardModeAfterIgnition:0, $estimates:0, $flashingWhenInOperation:0, $fourWheelDrive:0, $frontWheelDrive:0, $givenAckermanSteerAngle:0, $hasOversteer:0, $hasUndersteer:0, $highGearWithLockedDifferential:0, $ignitionControlPosition:0, $ignitionControlPosition__Off:0, $ignitionLockInOnPosition:0, $isNotOperational:0, $isOperational:0, $lateralAcceleration:0, $limits:0, $lowGear:0, $malfunctionDetected:0, $modifiesEngineTorque:0, $monitors:0, $mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected:0, $mustIlluminateWhenIgnitionControlInCheckPosition:0, $mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists:0, $normalYawRate:0, $oversteer:0, $performance:0, $rearWheelDrive:0, $responsivenessCriterion:0, $root__AntiLockBreakSystem:0, $root__DriveConfiguration:0, $root__ElectronicStabilityControlSystem:0, $root__TractionControlSystem:0, $satisfies:0, $sideSlip:0, $sideSlipAngle:0, $snowOrSlipperyRoad:0, $speed:0, $stabilityCriteria:0, $standard:0, $toEachWheelIndividually:0, $twoWheelDrive:0, $type:0, $type__Off:0, $understeer:0, $vehicle:0, $whenDrivenInReverse:0, $whenTurnedOffByTheDriver:0, $withAntiLockBrakeSystem:0, $withTractionControlSystem:0, $yawRate:0});
defaultScope(1);
stringLength(16);

$degree = Abstract("degree");
$Vehicle = Abstract("Vehicle");
$Vehicle__DriveConfiguration = $Vehicle.addChild("Vehicle__DriveConfiguration").withCard(1, 1).withGroupCard(1, 1);
$Vehicle__ElectronicStabilityControlSystem = $Vehicle.addChild("Vehicle__ElectronicStabilityControlSystem").withCard(1, 1);
$Vehicle__AntiLockBreakSystem = $Vehicle.addChild("Vehicle__AntiLockBreakSystem").withCard(1, 1);
$Vehicle__TractionControlSystem = $Vehicle.addChild("Vehicle__TractionControlSystem").withCard(1, 1);
$AckermanSteerAngle = $Vehicle.addChild("AckermanSteerAngle").withCard(1, 1);
$speed = $Vehicle.addChild("speed").withCard(1, 1);
$lateralAcceleration = $Vehicle.addChild("lateralAcceleration").withCard(1, 1);
$sideSlipAngle = $Vehicle.addChild("sideSlipAngle").withCard(1, 1);
$yawRate = $Vehicle.addChild("yawRate").withCard(1, 1);
$normalYawRate = $Vehicle.addChild("normalYawRate").withCard(1, 1);
$givenAckermanSteerAngle = $normalYawRate.addChild("givenAckermanSteerAngle").withCard(1, 1);
$hasOversteer = $Vehicle.addChild("hasOversteer").withCard(0, 1);
$hasUndersteer = $Vehicle.addChild("hasUndersteer").withCard(0, 1);
$GVWR = $Vehicle.addChild("GVWR").withCard(1, 1);
$root__DriveConfiguration = Abstract("root__DriveConfiguration").withGroupCard(1, 1);
$twoWheelDrive = $root__DriveConfiguration.addChild("twoWheelDrive").withCard(0, 1);
$frontWheelDrive = $root__DriveConfiguration.addChild("frontWheelDrive").withCard(0, 1);
$rearWheelDrive = $root__DriveConfiguration.addChild("rearWheelDrive").withCard(0, 1);
$allWheelDrive = $root__DriveConfiguration.addChild("allWheelDrive").withCard(0, 1);
$fourWheelDrive = $root__DriveConfiguration.addChild("fourWheelDrive").withCard(0, 1).withGroupCard(1, 1);
$highGearWithLockedDifferential = $fourWheelDrive.addChild("highGearWithLockedDifferential").withCard(0, 1);
$lowGear = $fourWheelDrive.addChild("lowGear").withCard(0, 1);
$root__ElectronicStabilityControlSystem = Abstract("root__ElectronicStabilityControlSystem");
$vehicle = $root__ElectronicStabilityControlSystem.addChild("vehicle").withCard(1, 1);
$augmentsVehiclesDirectionalStability = $root__ElectronicStabilityControlSystem.addChild("augmentsVehiclesDirectionalStability").withCard(1, 1);
$adjustsBrakeTorquesToInduceCorrectingYawMoment = $augmentsVehiclesDirectionalStability.addChild("adjustsBrakeTorquesToInduceCorrectingYawMoment").withCard(1, 1);
$toEachWheelIndividually = $adjustsBrakeTorquesToInduceCorrectingYawMoment.addChild("toEachWheelIndividually").withCard(1, 1);
$limits = $root__ElectronicStabilityControlSystem.addChild("limits").withCard(1, 1);
$understeer = $limits.addChild("understeer").withCard(1, 1);
$oversteer = $limits.addChild("oversteer").withCard(1, 1);
$estimates = $root__ElectronicStabilityControlSystem.addChild("estimates").withCard(1, 1);
$YawRate = $estimates.addChild("YawRate").withCard(1, 1);
$sideSlip = $estimates.addChild("sideSlip").withCard(1, 1);
$derivativeWithRespectToTime = $sideSlip.addChild("derivativeWithRespectToTime").withCard(1, 1);
$monitors = $root__ElectronicStabilityControlSystem.addChild("monitors").withCard(1, 1);
$driverSteeringInputs = $monitors.addChild("driverSteeringInputs").withCard(1, 1);
$modifiesEngineTorque = $monitors.addChild("modifiesEngineTorque").withCard(1, 1);
$isOperational = $root__ElectronicStabilityControlSystem.addChild("isOperational").withCard(0, 1);
$duringAllPhasesOfDriving = $isOperational.addChild("duringAllPhasesOfDriving").withCard(1, 1);
$acceleration = $duringAllPhasesOfDriving.addChild("acceleration").withCard(1, 1);
$coasting = $duringAllPhasesOfDriving.addChild("coasting").withCard(1, 1);
$deceleration = $duringAllPhasesOfDriving.addChild("deceleration").withCard(1, 1);
$breaking = $duringAllPhasesOfDriving.addChild("breaking").withCard(1, 1);
$withAntiLockBrakeSystem = $isOperational.addChild("withAntiLockBrakeSystem").withCard(1, 1);
$withTractionControlSystem = $isOperational.addChild("withTractionControlSystem").withCard(1, 1);
$isNotOperational = $root__ElectronicStabilityControlSystem.addChild("isNotOperational").withCard(1, 1).withGroupCard(1);
$whenTurnedOffByTheDriver = $isNotOperational.addChild("whenTurnedOffByTheDriver").withCard(0, 1);
$whenDrivenInReverse = $isNotOperational.addChild("whenDrivenInReverse").withCard(0, 1);
$duringSystemInitialization = $isNotOperational.addChild("duringSystemInitialization").withCard(0, 1);
$Mode = $root__ElectronicStabilityControlSystem.addChild("Mode").withCard(1, 1);
$driverSelected = $Mode.addChild("driverSelected").withCard(0, 1);
$type = $Mode.addChild("type").withCard(1, 1).withGroupCard(1, 1);
$standard = $type.addChild("standard").withCard(0, 1);
$performance = $type.addChild("performance").withCard(0, 1);
$snowOrSlipperyRoad = $type.addChild("snowOrSlipperyRoad").withCard(0, 1);
$type__Off = $type.addChild("type__Off").withCard(0, 1);
$entersStandardModeAfterIgnition = $root__ElectronicStabilityControlSystem.addChild("entersStandardModeAfterIgnition").withCard(1, 1);
$satisfies = $root__ElectronicStabilityControlSystem.addChild("satisfies").withCard(1, 1);
$stabilityCriteria = $satisfies.addChild("stabilityCriteria").withCard(1, 1);
$responsivenessCriterion = $satisfies.addChild("responsivenessCriterion").withCard(1, 1);
$MalfunctionTelltale = $root__ElectronicStabilityControlSystem.addChild("MalfunctionTelltale").withCard(0, 1).withGroupCard(1);
$malfunctionDetected = $MalfunctionTelltale.addChild("malfunctionDetected").withCard(0, 1);
$mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists = $malfunctionDetected.addChild("mustRemainContinuouslyIlluminatedForAsLongAsMalfunctionExists").withCard(1, 1);
$ignitionLockInOnPosition = $MalfunctionTelltale.addChild("ignitionLockInOnPosition").withCard(0, 1);
$mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected = $MalfunctionTelltale.addChild("mustExtinguishAtTheNextIgnitionCycleAfterTheMalfunctionHasBeenCorrected").withCard(0, 1);
$flashingWhenInOperation = $MalfunctionTelltale.addChild("flashingWhenInOperation").withCard(0, 1);
$mustIlluminateWhenIgnitionControlInCheckPosition = $MalfunctionTelltale.addChild("mustIlluminateWhenIgnitionControlInCheckPosition").withCard(0, 1);
$SystemControls = $root__ElectronicStabilityControlSystem.addChild("SystemControls").withCard(1, 1);
$SystemControls__Off = $SystemControls.addChild("SystemControls__Off").withCard(1, 1);
$ignitionControlPosition = $SystemControls.addChild("ignitionControlPosition").withCard(1, 1).withGroupCard(1, 1);
$ignitionControlPosition__Off = $ignitionControlPosition.addChild("ignitionControlPosition__Off").withCard(0, 1);
$Check = $ignitionControlPosition.addChild("Check").withCard(0, 1);
$On = $ignitionControlPosition.addChild("On").withCard(0, 1);
$Start = $ignitionControlPosition.addChild("Start").withCard(0, 1);
$root__AntiLockBreakSystem = Abstract("root__AntiLockBreakSystem");
$root__TractionControlSystem = Abstract("root__TractionControlSystem");
$degree.refTo(Int);
$degree.addConstraint(and(greaterThan(joinRef($this()), constant(0)), lessThanEqual(joinRef($this()), constant(360))));
$Vehicle__DriveConfiguration.extending($root__DriveConfiguration);
$Vehicle__ElectronicStabilityControlSystem.extending($root__ElectronicStabilityControlSystem);
$Vehicle__AntiLockBreakSystem.extending($root__AntiLockBreakSystem);
$Vehicle__TractionControlSystem.extending($root__TractionControlSystem);
$AckermanSteerAngle.refToUnique($degree);
$speed.refToUnique(Int);
$lateralAcceleration.refToUnique(Int);
$sideSlipAngle.refToUnique($degree);
$yawRate.refToUnique($degree);
$normalYawRate.refToUnique($degree);
$Vehicle.addConstraint(ifOnlyIf(greaterThan(joinRef(joinRef(join($this(), $yawRate))), joinRef(joinRef(join($this(), $normalYawRate)))), some(join($this(), $hasOversteer))));
$Vehicle.addConstraint(ifOnlyIf(lessThan(joinRef(joinRef(join($this(), $yawRate))), joinRef(joinRef(join($this(), $normalYawRate)))), some(join($this(), $hasUndersteer))));
$GVWR.refToUnique(Int);
$vehicle.refToUnique($Vehicle);
$isOperational.addConstraint(greaterThan(joinRef(join(joinRef(join(joinParent($this()), $vehicle)), $speed)), constant(20)));
