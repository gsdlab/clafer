fact { #Association = 0 }
abstract sig Association extends Classifier
{ r_Association__relatedElement : some Association__relatedElement
, r_Association__isDerived : lone Association__isDerived
, r_ownedEnd : set ownedEnd
, r_endType : some endType
, r_memberEnd : set memberEnd }
{ all disj x, y : this.@r_Association__relatedElement | (x.@Association__relatedElement_ref) != (y.@Association__relatedElement_ref) 
  all disj x, y : this.@r_endType | (x.@endType_ref) != (y.@endType_ref) 
  2 <= #r_memberEnd
  all disj x, y : this.@r_memberEnd | (x.@memberEnd_ref) != (y.@memberEnd_ref) 
  all  x : this.@r_memberEnd | this in (((x.@memberEnd_ref).@r_association).@association_ref)
  ((#(this.@r_memberEnd)) > 2) => (((this.@r_memberEnd).@memberEnd_ref) in (this.@r_ownedEnd)) }

