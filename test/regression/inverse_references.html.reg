<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/inverse_references.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Service">Service</span>
  <div class="indent">
  <span class="claferDecl" id="c0_requirements">requirements</span><span class="keyword"> : </span><a href="#c0_Requirements"><span class="reference">Requirements</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="c0_machine">machine</span><span class="keyword"> -> </span><a href="#c0_Machine"><span class="reference">Machine</span></a></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span> in <a href="#c0_machine"><span class="reference">machine</span></a>.<a href="#c0_services"><span class="reference">services</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Requirements">Requirements</span>
  <div class="indent">
  <span class="claferDecl" id="c0_cpu">cpu</span><span class="keyword"> ->> </span><a href="#integer"><span class="reference">integer</span></a></div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Resources">Resources</span><span class="keyword"> : </span><a href="#c0_Requirements"><span class="reference">Requirements</span></a></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Machine">Machine</span>
  <div class="indent">
  <span class="claferDecl" id="c0_services">services</span><span class="keyword"> -> </span><a href="#c0_Service"><span class="reference">Service</span></a> *</div>
  <div class="indent">
  <span class="keyword">[</span> all s<span class="keyword"> : </span><a href="#c0_services"><span class="reference">services</span></a> | <a href="#s"><span class="reference">s</span></a>.<a href="#c0_machine"><span class="reference">machine</span></a> = <span class="keyword">this</span> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="c0_isFree">isFree</span> ?</div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#c0_isFree"><span class="reference">isFree</span></a> &lt;=&gt; <span class="keyword">no</span> <a href="#c0_services"><span class="reference">services</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="c0_limits">limits</span><span class="keyword"> : </span><a href="#c0_Resources"><span class="reference">Resources</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="c0_utilization">utilization</span><span class="keyword"> : </span><a href="#c0_Resources"><span class="reference">Resources</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_cpu"><span class="reference">cpu</span></a> = <span class="keyword">sum </span><a href="#c0_services"><span class="reference">services</span></a>.<a href="#c0_requirements"><span class="reference">requirements</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_cpu"><span class="reference">cpu</span></a> &lt; <a href="#c0_limits"><span class="reference">limits</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> <span class="keyword">]</span></div>
  </div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Task">Task</span>
  <div class="indent">
  <span class="claferDecl" id="c0_total_free">total_free</span><span class="keyword"> : </span><a href="#integer"><span class="reference">integer</span></a> = # <a href="#c0_Machine"><span class="reference">Machine</span></a>.<a href="#c0_isFree"><span class="reference">isFree</span></a></div>
</div>


<div>
<span class="claferDecl" id="c0_MyTask">MyTask</span><span class="keyword"> : </span><a href="#c0_Task"><span class="reference">Task</span></a>
  <div class="indent">
  <span class="claferDecl" id="c0_GoogleCA">GoogleCA</span><span class="keyword"> : </span><a href="#c0_Machine"><span class="reference">Machine</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_limits"><span class="reference">limits</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> = 10 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="c0_GoogleNY">GoogleNY</span><span class="keyword"> : </span><a href="#c0_Machine"><span class="reference">Machine</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_limits"><span class="reference">limits</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> = 16 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="c0_GoogleTX">GoogleTX</span><span class="keyword"> : </span><a href="#c0_Machine"><span class="reference">Machine</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_limits"><span class="reference">limits</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> = 14 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="c0_MailService">MailService</span><span class="keyword"> : </span><a href="#c0_Service"><span class="reference">Service</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_requirements"><span class="reference">requirements</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> = 4 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="c0_SearchService">SearchService</span><span class="keyword"> : </span><a href="#c0_Service"><span class="reference">Service</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_requirements"><span class="reference">requirements</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> = 3 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="c0_CalendarService">CalendarService</span><span class="keyword"> : </span><a href="#c0_Service"><span class="reference">Service</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_requirements"><span class="reference">requirements</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> = 1 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="c0_DriveService">DriveService</span><span class="keyword"> : </span><a href="#c0_Service"><span class="reference">Service</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#c0_requirements"><span class="reference">requirements</span></a>.<a href="#c0_cpu"><span class="reference">cpu</span></a> = 2 <span class="keyword">]</span></div>
  </div>
</div>


<div>
&lt;&lt;<span class="deprecated" title="Deprecated. Use `maximize` instead.">max </span><a href="#c0_MyTask"><span class="reference">MyTask</span></a>.<a href="#c0_total_free"><span class="reference">total_free</span></a>&gt;&gt;</div>

</body>
</html>