scope({$TimeLevel:3, $Week1AggregatesTo:3, $aggregatesTo:3});
defaultScope(1);
stringLength(16);

$TimeLevel = Abstract("TimeLevel");
$aggregatesTo = $TimeLevel.addChild("aggregatesTo").withCard(0, 1);
$YearLevel = Abstract("YearLevel");
$MonthLevel = Abstract("MonthLevel");
$WeekLevel = Abstract("WeekLevel");
$Year2012 = Clafer("Year2012").withCard(1, 1);
$Jan2012 = Clafer("Jan2012").withCard(1, 1);
$Week1 = Clafer("Week1").withCard(1, 1);
$Week1AggregatesTo = Clafer("Week1AggregatesTo");
$aggregatesTo.refToUnique($TimeLevel);
$YearLevel.extending($TimeLevel);
$YearLevel.addConstraint(none(join($this(), $aggregatesTo)));
$MonthLevel.extending($TimeLevel);
$MonthLevel.addConstraint($in(joinRef(join($this(), $aggregatesTo)), global($YearLevel)));
$WeekLevel.extending($TimeLevel);
$WeekLevel.addConstraint($in(joinRef(join($this(), $aggregatesTo)), global($MonthLevel)));
$Year2012.extending($YearLevel);
$Jan2012.extending($MonthLevel);
$Jan2012.addConstraint(equal(joinRef(join($this(), $aggregatesTo)), global($Year2012)));
$Week1.extending($WeekLevel);
$Week1.addConstraint(equal(joinRef(join($this(), $aggregatesTo)), global($Jan2012)));
$Week1AggregatesTo.refToUnique($TimeLevel);
Constraint($in(joinRef(join(global($Week1), $aggregatesTo)), joinRef(global($Week1AggregatesTo))));
Constraint($in(joinRef(join(joinRef(join(global($Week1), $aggregatesTo)), $aggregatesTo)), joinRef(global($Week1AggregatesTo))));
Constraint(equal(joinRef(global($Week1AggregatesTo)), union(global($Jan2012), global($Year2012))));
