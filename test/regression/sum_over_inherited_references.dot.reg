digraph "sum_over_inherited_references"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Component" [label="abstract Component" URL="#Component" tooltip="abstract Component&#10;  energy -&gt;&gt; integer&#10;"];
"c1" [label="c1 : Component" URL="#c1" tooltip="c1 : Component&#10;  [ energy = 1 ]&#10;"];
"c2" [label="c2 : Component" URL="#c2" tooltip="c2 : Component&#10;  [ energy = 1 ]&#10;"];
"c3" [label="c3 : Component" URL="#c3" tooltip="c3 : Component&#10;  [ energy = 1 ]&#10;"];
"total" [label="total -&gt;&gt; integer = sum Component.energy" URL="#total" tooltip="total -&gt;&gt; integer = sum Component.energy&#10;"];
}