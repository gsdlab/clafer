digraph "oclBench_b1"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  name -&gt; string&#10;  civstat -&gt; string&#10;  gender -&gt; string&#10;  alive ?&#10;  husband -&gt; Person ?&#10;    [ parent in this.wife ]&#10;  wife -&gt; Person ?&#10;    [ parent in this.husband ]&#10;  [ civstat = &quot;single&quot; || civstat = &quot;married&quot; || civstat = &quot;divorced&quot; || civstat = &quot;widowed&quot; ]&#10;  [ gender = &quot;female&quot; || gender = &quot;male&quot; ]&#10;  [ all p : Person | this != p => this.name.dref != p.name.dref ]&#10;  [ one p : Person | p.name.dref = this.name.dref ]&#10;"];
"Person" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="husband"];
"Person" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="wife"];
"ada" [label="ada : Person" URL="#ada" tooltip="ada : Person&#10;  [ name = &quot;Ada&quot; ][ civstat = &quot;widowed&quot; ][ gender = &quot;female&quot; ][ alive ][ no husband ][ no wife ]&#10;"];
"cyd" [label="cyd : Person" URL="#cyd" tooltip="cyd : Person&#10;  [ name = &quot;Cyd&quot; ][ civstat = &quot;married&quot; ][ gender = &quot;male&quot; ][ no alive ][ no husband ][ no wife ]&#10;"];
"eve" [label="eve : Person" URL="#eve" tooltip="eve : Person&#10;  [ name = &quot;Eve&quot; ][ civstat = &quot;married&quot; ][ gender = &quot;female&quot; ][ alive ][ husband = dan ][ no wife ]&#10;"];
"bob" [label="bob : Person" URL="#bob" tooltip="bob : Person&#10;  [ name = &quot;Bob&quot; ][ civstat = &quot;divorced&quot; ][ gender = &quot;male&quot; ][ alive ][ no husband ][ no wife ]&#10;"];
"dan" [label="dan : Person" URL="#dan" tooltip="dan : Person&#10;  [ name = &quot;Dan&quot; ][ civstat = &quot;married&quot; ][ gender = &quot;male&quot; ][ alive ][ no husband ][ wife = eve ]&#10;"];
"adaBobCyd" [label="adaBobCyd -&gt; Person *" URL="#adaBobCyd" tooltip="adaBobCyd -&gt; Person *&#10;  [ this.name in stringSet1 ]&#10;"];
"adaBobCyd" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"personWithUndefinedHusband1" [label="personWithUndefinedHusband1 -&gt; Person *" URL="#personWithUndefinedHusband1" tooltip="personWithUndefinedHusband1 -&gt; Person *&#10;  [ this.husband = emptyPersonSet1 ]&#10;"];
"personWithUndefinedHusband1" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"personWithUndefinedHusband2" [label="personWithUndefinedHusband2 -&gt; Person *" URL="#personWithUndefinedHusband2" tooltip="personWithUndefinedHusband2 -&gt; Person *&#10;  [ this.husband = emptyPersonSet2 ]&#10;"];
"personWithUndefinedHusband2" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"personWithNoWife" [label="personWithNoWife -&gt; Person *" URL="#personWithNoWife" tooltip="personWithNoWife -&gt; Person *&#10;  [ no this.wife ]&#10;"];
"personWithNoWife" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"emptyPersonSet1" [label="emptyPersonSet1 -&gt; Person *" URL="#emptyPersonSet1" tooltip="emptyPersonSet1 -&gt; Person *&#10;"];
"emptyPersonSet1" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"emptyPersonSet2" [label="emptyPersonSet2 -&gt; Person *" URL="#emptyPersonSet2" tooltip="emptyPersonSet2 -&gt; Person *&#10;  [ 1 > 2 ]&#10;"];
"emptyPersonSet2" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"personPair" [label="personPair *" URL="#personPair" tooltip="personPair *&#10;  first -&gt; Person&#10;  second -&gt; Person&#10;"];
"personPair" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="first"];
"personPair" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="second"];
"possiblePairs" [label="possiblePairs -&gt; personPair *" URL="#possiblePairs" tooltip="possiblePairs -&gt; personPair *&#10;  [ this.first.gender = &quot;female&quot; &amp;&amp; this.first.alive &amp;&amp; this.first.civstat != &quot;married&quot; ][ this.second.gender = &quot;male&quot; &amp;&amp; this.second.alive &amp;&amp; this.second.civstat != &quot;married&quot; ]&#10;"];
"possiblePairs" -> "personPair" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"stringSet1" [label="stringSet1 -&gt; string 3" URL="#stringSet1" tooltip="stringSet1 -&gt; string 3&#10;  [ this = &quot;Ada&quot; || this = &quot;Bob&quot; || this = &quot;Cyd&quot; ]&#10;"];
"stringSet2" [label="stringSet2 -&gt; string 4" URL="#stringSet2" tooltip="stringSet2 -&gt; string 4&#10;  [ this = &quot;Ada&quot; || this = &quot;Bob&quot; || this = &quot;Cyd&quot; || this = &quot;Dan&quot; ]&#10;"];
}