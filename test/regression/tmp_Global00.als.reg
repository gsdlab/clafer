open util/integer
pred show {}


one sig root
{ var r_c0_a : set c0_a }
fact { all self_ : root | always (lone self_.@r_c0_a) }

assert assertOnLine_6 { always (always (all  b1 : alive_c0_a.@r_c0_b | some  a1 : alive_c0_a | (b1.(@p_c0_b :> alive_c0_a)) = a1)) }
check assertOnLine_6 for 1 but 10 steps



sig c0_a
{ p_c0_a : lone root
, var r_c0_b : set c0_b }
fun alive_c0_a : set c0_a { root.@r_c0_a }
fact { always ~@r_c0_a in @p_c0_a }

fact { all self_ : c0_a | always (self_ in alive_c0_a implies (lone self_.@r_c0_b)) }


sig c0_b
{ p_c0_b : lone c0_a }
fun alive_c0_b : set c0_b { c0_a.@r_c0_b }
fact { always ~@r_c0_b in @p_c0_b
  always @r_c0_b.univ in alive_c0_a }


