open util/integer
pred show {}


one sig root
{ var r_a : set a }
fact { all self_ : root | always (lone self_.@r_a) }

assert assertAt_6_10 { all self_ : root | always (always (all  b1 : alive_a.@r_b | some  a1 : alive_a | (b1.(@p_b :> alive_a)) = a1)) }
check assertAt_6_10 for 1 but 10 steps



sig a
{ p_a : lone root
, var r_b : set b }
fun alive_a : set a { root.@r_a }
fact { always ~@r_a in @p_a }

fact { all self_ : a | always (self_ in alive_a implies (lone self_.@r_b)) }


sig b
{ p_b : lone a }
fun alive_b : set b { a.@r_b }
fact { always ~@r_b in @p_b
  always @r_b.univ in alive_a }


