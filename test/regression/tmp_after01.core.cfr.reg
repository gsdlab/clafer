0..* a 0..1 {
  1..1 b 1..1 {
    0..* c 0..1 {}
    0..* d 0..1 {}
    [G ((some this.c) => (G (no this.d)))] // never after, tmp_after01.cfr:6:4
  }
}
0..* e 1..1 {
  1..1 f 1..1 {
    0..* g 0..1 {}
    0..* h 0..1 {}
    [G ((some this.g) => (G (no this.h)))] // never after, tmp_after01.cfr:20:4
    [all f_1 : this | X (f_1 in this.parent.f)] // final, tmp_after01.cfr:17:2
    [all f_1 : this | (previous (some this.parent)) => (previous (f_1 in this.parent.f))] // final, tmp_after01.cfr:17:2
  }
  [all e_1 : this | X (e_1 in e)] // final, tmp_after01.cfr:16:1
  [all e_1 : this | (previous (some root)) => (previous (e_1 in e))] // final, tmp_after01.cfr:16:1
}

assert [all b1 : a.b | G (!((some b1.c) && (X (some b1.d))))] // never, tmp_after01.cfr:12:24
