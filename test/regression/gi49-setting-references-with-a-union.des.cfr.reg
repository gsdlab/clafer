//# OPTIONS --explicit
[((#A) >= 1) => (A . dref = 1)]
[((#B) >= 1) => (B . dref = 2)]
[((#C) >= 1) => (C . dref = 3)]
[xs . dref = ((A ++ B) ++ C)]
[xs . dref = ((A ++ B) ++ C)]
[xs . dref . dref = ((A . dref ++ B . dref) ++ C . dref)]
abstract 0..* x -> int 0..* {}
0..* A : x 1..1 {}
0..* B : x 1..1 {}
0..* C : x 1..1 {}
0..* xs ->> x 0..* {}
