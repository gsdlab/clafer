//# OPTIONS --explicit
[((#c0_A) >= 1) => (c0_A . dref = 1)]
[((#c0_B) >= 1) => (c0_B . dref = 2)]
[((#c0_C) >= 1) => (c0_C . dref = 3)]
[c0_xs . dref = ((c0_A ++ c0_B) ++ c0_C)]
[c0_xs . dref = ((c0_A ++ c0_B) ++ c0_C)]
[c0_xs . dref . dref = ((c0_A . dref ++ c0_B . dref) ++ c0_C . dref)]
abstract 0..* c0_x -> int 0..* {}
0..* c0_A : c0_x 1..1 {}
0..* c0_B : c0_x 1..1 {}
0..* c0_C : c0_x 1..1 {}
0..* c0_xs ->> c0_x 0..* {}
