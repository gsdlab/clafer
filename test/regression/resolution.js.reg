defaultScope(1);
stringLength(16);

$XX = Clafer("XX").withCard(1, 1);
$x = $XX.addChild("x").withCard(1, 1);
$x__y = $x.addChild("x__y").withCard(1, 1);
$ZZ = Clafer("ZZ").withCard(1, 1);
$z = $ZZ.addChild("z").withCard(1, 1);
$z__y = $z.addChild("z__y").withCard(1, 1);
$z.refToUnique(Int);
$XX.addConstraint(some(join($this(), $x)));
$ZZ.addConstraint(greaterThan(joinRef(join($this(), $z)), constant(0)));
