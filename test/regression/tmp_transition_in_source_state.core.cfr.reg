//# OPTIONS --explicit --core --tl=10
0..* go 0..1 {}
1..1 sm 1..1 {
  [all sm_1 : this | X (sm_1 in sm)] // final, tmp_transition_in_source_state.cfr:7:1
  [all sm_1 : this | (previous ((#root) >= 1)) => (previous (sm_1 in sm))] // final, tmp_transition_in_source_state.cfr:7:1
  [initially ((#this.a) >= 1)] // initial, tmp_transition_in_source_state.cfr:8:3
  0..* a 0..1 {
    [((#go) >= 1) => (X ((#this.parent.b) >= 1))] // transition, tmp_transition_in_source_state.cfr:9:7
  }
  0..* b 0..1 {}
  0..* c 0..1 {}
}

assert [(((#sm.a) >= 1) && ((#go) >= 1)) => (X ((#sm.b) >= 1))]
