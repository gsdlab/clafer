digraph "explicit_dref_navigation"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"c0_Port" [label="abstract Port" URL="#c0_Port" tooltip="abstract Port&#10;  speed -&gt; integer&#10;  name -&gt; integer&#10;"];
"c0_Hub" [label="Hub" URL="#c0_Hub" tooltip="Hub&#10;  p : Port 2&#10;"];
"c0_Hub" -> "c0_Port" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_fast" [label="fast : Port" URL="#c0_fast" tooltip="fast : Port&#10;  [ speed = 10 ]&#10;"];
"c0_fast" -> "c0_Port" [arrowhead=onormal constraint=true weight=100];
"c0_Component" [label="abstract Component" URL="#c0_Component" tooltip="abstract Component&#10;  abstract link -&gt; Port *&#10;    latency -&gt; integer&#10;    speed -&gt; integer&#10;    [ this.dref.speed >= this.speed ]&#10;    [ all t : this.dref | t.speed >= latency ]&#10;"];
"c0_link" [label="abstract link -> Port *" URL="#c0_link" tooltip="abstract link -&gt; Port *&#10;  latency -&gt; integer&#10;  speed -&gt; integer&#10;  [ this.dref.speed >= this.speed ]&#10;  [ all t : this.dref | t.speed >= latency ]&#10;"];
"c0_link" -> "c0_Port" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=c0_link];
"c0_cam" [label="cam : Component" URL="#c0_cam" tooltip="cam : Component&#10;  l : link -&gt; Hub.p 1&#10;    [ this.dref.speed = 3 ]&#10;    [ dref.name = 1 ]&#10;  [ l.dref.speed = 3 ]&#10;"];
"c0_cam" -> "c0_Component" [arrowhead=onormal constraint=true weight=100];
"c0_cam" -> "c0_link" [arrowhead=vee arrowtail=diamond dir=both style=solid weight=10 color=gray arrowsize=0.6 minlen=2 penwidth=0.5 constraint=true];
"c0_b" [label="b -&gt;&gt; Port 2" URL="#c0_b" tooltip="b -&gt;&gt; Port 2&#10;  [ this.dref.speed.dref = 3 ]&#10;"];
"c0_b" -> "c0_Port" [arrowhead=veevee arrowsize=0.6 minlen=1.5 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"c0_Plug" [label="abstract Plug -&gt; Port" URL="#c0_Plug" tooltip="abstract Plug -&gt; Port&#10;  speed -&gt; integer&#10;"];
"c0_Plug" -> "c0_Port" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"c0_plug" [label="plug : Plug" URL="#c0_plug" tooltip="plug : Plug&#10;"];
"c0_plug" -> "c0_Plug" [arrowhead=onormal constraint=true weight=100];
"c0_pl" [label="pl -&gt; Plug" URL="#c0_pl" tooltip="pl -&gt; Plug&#10;  [ this.dref.speed = 5 ]&#10;"];
"c0_pl" -> "c0_Plug" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"c0_u" [label="u -&gt; Hub.p++fast" URL="#c0_u" tooltip="u -&gt; Hub.p++fast&#10;  [ this.dref.speed = 10 ]&#10;"];
}