digraph "ClaferToolsDemo_Variant_Derivation"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"root__Bluetooth" [label="abstract xor Bluetooth" URL="#root__Bluetooth" tooltip="abstract xor Bluetooth&#10;  Bluetooth20 ?&#10;  Bluetooth21 ?&#10;  Bluetooth40 ?&#10;"];
"MobilePhone" [label="abstract MobilePhone" URL="#MobilePhone" tooltip="abstract MobilePhone&#10;  Connectivity&#10;    `Bluetooth&#10;    GSM&#10;    LTE ?&#10;      [ LiBattery1400 ]&#10;    WiFi ?&#10;    USB ?&#10;  xor Battery&#10;    LiBattery1150 ?&#10;    LiBattery1400 ?&#10;"];
"MobilePhone" -> "root__Bluetooth" [arrowhead=vee arrowtail=diamond dir=both style=solid constraint=true weight=5 minlen=2 arrowsize=0.6 penwidth=0.5 ];
"LowEndPhone" [label="abstract LowEndPhone : MobilePhone" URL="#LowEndPhone" tooltip="abstract LowEndPhone : MobilePhone&#10;  [ no WiFi ]&#10;"];
"HighEndPhone" [label="abstract HighEndPhone : MobilePhone" URL="#HighEndPhone" tooltip="abstract HighEndPhone : MobilePhone&#10;  [ USB &amp;&amp; WiFi ]&#10;  QuadCPU ?&#10;"];
"Phone1" [label="Phone1 : MobilePhone" URL="#Phone1" tooltip="Phone1 : MobilePhone&#10;  [ WiFi ]&#10;  [ LTE ]&#10;  [ Bluetooth21 ]&#10;"];
"Phone2" [label="Phone2 : HighEndPhone" URL="#Phone2" tooltip="Phone2 : HighEndPhone&#10;  [ LTE ]&#10;  [ Bluetooth21 ]&#10;  [ QuadCPU ]&#10;"];
}