//# OPTIONS --explicit --tl=10
0..* go 0..1 {}
1..1 sm 1..1 {
  initial 0..* a 0..1 {
    [(some go) --> (some this.parent.b)]
  }
  0..* b 0..1 {}
  0..* c 0..1 {}
}

assert [all m : sm | ((some m.a) && (some go)) => (X ((some m.b) || (no (m ** sm))))]
assert [((some sm.a) && (some go)) => (X (some sm.b))]
