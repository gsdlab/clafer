digraph "ClaferTools_ToolingArchitecture"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"claferCompiler" [label="claferCompiler : claferLib" URL="#claferCompiler" tooltip="claferCompiler : claferLib&#10;"];
"claferIG" [label="claferIG : claferLib" URL="#claferIG" tooltip="claferIG : claferLib&#10;"];
"claferMOO" [label="claferMOO : claferLib" URL="#claferMOO" tooltip="claferMOO : claferLib&#10;  moo&#10;"];
"claferLib" [label="abstract claferLib" URL="#claferLib" tooltip="abstract claferLib&#10;  common&#10;  front : Front&#10;  intermediate : Intermediate&#10;  optimizer&#10;  generator : Generator&#10;"];
"io" [label="abstract io" URL="#io" tooltip="abstract io&#10;  input -&gt; Representation&#10;  output -&gt; Representation&#10;"];
"io" -> "Representation" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=input];
"io" -> "Representation" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=output];
"text2tokens" [label="abstract text2tokens : io" URL="#text2tokens" tooltip="abstract text2tokens : io&#10;  [ input = text &amp;&amp; output = tokens ]&#10;"];
"tokens2tokens" [label="abstract tokens2tokens : io" URL="#tokens2tokens" tooltip="abstract tokens2tokens : io&#10;  [ input = tokens &amp;&amp; output = tokens ]&#10;"];
"tokens2ast" [label="abstract tokens2ast : io" URL="#tokens2ast" tooltip="abstract tokens2ast : io&#10;  [ input = tokens &amp;&amp; output = ast ]&#10;"];
"ast2ast" [label="abstract ast2ast : io" URL="#ast2ast" tooltip="abstract ast2ast : io&#10;  [ input = ast &amp;&amp; output = ast ]&#10;"];
"ast2text" [label="abstract ast2text : io" URL="#ast2text" tooltip="abstract ast2text : io&#10;  [ input = ast &amp;&amp; output = text ]&#10;"];
"ast2ir" [label="abstract ast2ir : io" URL="#ast2ir" tooltip="abstract ast2ir : io&#10;  [ input = ast &amp;&amp; output = ir ]&#10;"];
"ir2ir" [label="abstract ir2ir : io" URL="#ir2ir" tooltip="abstract ir2ir : io&#10;  [ input = ir &amp;&amp; output = ir ]&#10;"];
"ir2text" [label="abstract ir2text : io" URL="#ir2text" tooltip="abstract ir2text : io&#10;  [ input = ir &amp;&amp; output = text ]&#10;"];
"Front" [label="abstract Front" URL="#Front" tooltip="abstract Front&#10;  lexer : text2tokens&#10;  xor layoutResolver : tokens2tokens ?&#10;    stable&#10;    experimental&#10;  parser : tokens2ast&#10;  mapper : ast2ast&#10;  prettyPrinter : ast2text ?&#10;"];
"Intermediate" [label="abstract Intermediate" URL="#Intermediate" tooltip="abstract Intermediate&#10;  desugarer : ast2ir&#10;  findDuplicates ?&#10;  resolver : ir2ir ?&#10;    setUid&#10;    inheritanceFlattener ?&#10;    nameResolution&#10;      nameResolver ?&#10;        [ findDuplicates ]&#10;      inheritanceResolver&#10;      typeResolver&#10;  transformer : ir2ir&#10;  stringAnalyzer : ir2ir ?&#10;  scopeAnalysis : ir2ir ?&#10;"];
"Generator" [label="abstract xor Generator : ir2text" URL="#Generator" tooltip="abstract xor Generator : ir2text&#10;  alloy&#10;    [ Intermediate.stringAnalyzer &amp;&amp; Intermediate.scopeAnalysis ]&#10;  stats&#10;  xml&#10;  desClafer&#10;    [ Front.prettyPrinter ]&#10;  xsdSchema&#10;"];
}