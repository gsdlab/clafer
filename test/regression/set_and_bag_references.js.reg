scope({$multisetRefToA:3, $setRefToA:3});
defaultScope(1);
stringLength(16);

$A = Abstract("A");
$a = Clafer("a").withCard(1);
$setRefToA = Clafer("setRefToA").withCard(3, 3);
$multisetRefToA = Clafer("multisetRefToA").withCard(3, 3);
$a.extending($A);
$setRefToA.refToUnique($A);
$multisetRefToA.refTo($A);
