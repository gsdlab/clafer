digraph "gi84-parent-top-level-abstract"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"FeatureModel" [label="abstract FeatureModel" URL="#FeatureModel" tooltip="abstract FeatureModel&#10;"];
"Feature" [label="abstract Feature" URL="#Feature" tooltip="abstract Feature&#10;  [ parent in Feature, FeatureModel ]&#10;"];
"FM" [label="FM : FeatureModel" URL="#FM" tooltip="FM : FeatureModel&#10;  F1 : Feature&#10;    F2 : Feature&#10;"];
}