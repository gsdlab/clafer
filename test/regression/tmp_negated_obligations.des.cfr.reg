//# OPTIONS --explicit --tl=10
0..* machine 0..1 {
  0..* ctx 1..1 {
    0..* error 0..1 {}
    [!(F (some this.error))]
  }
}
[initially (some machine)]
[initially (X (no machine))]

assert [all this_ : machine.ctx | (G (no this_.error)) <=> (!(F (some this_.error)))]
assert [all this_ : machine.ctx | (!(X (some this_.error))) <=> (X (no this_.error))]
assert [all this_ : machine.ctx | (!((some this_.error) U (no this_.error))) <=> ((some this_.error) W ((no this_.error) && (some this_.error)))]
