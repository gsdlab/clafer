digraph "navAndDeref"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"a" [label="a" URL="#a" tooltip="a&#10;  b -&gt; e&#10;    [ f = h ]&#10;    [ this.f = h ]&#10;    [ this.f.dref = h ]&#10;    [ this.f.dref.dref = h ]&#10;  [ b.f = h ]&#10;  [ this.b.f = h ]&#10;  [ this.b.f.dref = h ]&#10;  [ this.b.f.dref.dref = h ]&#10;  c&#10;    d&#10;      [ b = e ]&#10;      [ parent.parent.b = e ]&#10;      [ this.parent.parent.b.dref = e ]&#10;    [ b.f = g ]&#10;    [ parent.b.f = g ]&#10;    [ this.parent.b.f.dref = g ]&#10;    [ this.parent.b.f.dref.dref = h ]&#10;"];
"a" -> "e" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="b"];
"e" [label="e" URL="#e" tooltip="e&#10;  f -&gt; g ?&#10;"];
"e" -> "g" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="f"];
"g" [label="g -&gt; h" URL="#g" tooltip="g -&gt; h&#10;"];
"g" -> "h" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"h" [label="h" URL="#h" tooltip="h&#10;"];
}