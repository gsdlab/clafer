digraph "references_to_same_object"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Dimension" [label="abstract Dimension" URL="#Dimension" tooltip="abstract Dimension&#10;  levels -&gt; DimensionLevel *&#10;  [ all dl : this.levels | dl.belongsTo = this ]&#10;"];
"Dimension" -> "DimensionLevel" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="levels"];
"DimensionLevel" [label="abstract DimensionLevel" URL="#DimensionLevel" tooltip="abstract DimensionLevel&#10;  belongsTo -&gt; Dimension&#10;"];
"DimensionLevel" -> "Dimension" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="belongsTo"];
"dim1" [label="dim1 : Dimension" URL="#dim1" tooltip="dim1 : Dimension&#10;"];
"dim2" [label="dim2 : Dimension" URL="#dim2" tooltip="dim2 : Dimension&#10;"];
"dimLevel1" [label="dimLevel1 : DimensionLevel" URL="#dimLevel1" tooltip="dimLevel1 : DimensionLevel&#10;"];
"dimLevel2" [label="dimLevel2 : DimensionLevel" URL="#dimLevel2" tooltip="dimLevel2 : DimensionLevel&#10;"];
}