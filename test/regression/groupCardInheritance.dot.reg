digraph "groupCardInheritance"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Port" [label="abstract or Port" URL="#Port" tooltip="abstract or Port&#10;  input&#10;  output&#10;"];
"RelayPort" [label="abstract xor RelayPort : Port" URL="#RelayPort" tooltip="abstract xor RelayPort : Port&#10;  relay&#10;"];
"req" [label="req : RelayPort" URL="#req" tooltip="req : RelayPort&#10;  flow&#10;  [ flow ]&#10;"];
}