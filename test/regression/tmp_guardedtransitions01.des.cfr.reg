//# OPTIONS --explicit --tl=10
0..* signal 0..1 {}
1..1 light 1..1 {
  initial 0..* red 0..1 {
    [(some this) -[(some signal)]-> (some this.parent.green)]
  }
  0..* green 0..1 {
    [(some this) -[(no signal)]->> (some this.parent.red)]
  }
}
1..1 door 1..1 {
  initial 0..* closed 0..1 {}
  0..* opened 0..1 {}
  [(some this.closed) -[(some signal)]-> (some this.opened)]
  [(some this.opened) -[(no signal)]->> (some this.closed)]
}

assert [((some light.red) && (some signal)) => (X (some light.green))]
assert [((some light.green) && (no signal)) => (F (some light.red))]
assert [((some door.closed) && (some signal)) => (X (some door.opened))]
assert [((some door.opened) && (no signal)) => (F (some door.closed))]
