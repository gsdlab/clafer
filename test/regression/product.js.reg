scope({$N:5});
defaultScope(1);
stringLength(16);

$N = Abstract("N");
$n1 = Clafer("n1").withCard(1, 1);
$n2 = Clafer("n2").withCard(1, 1);
$n3 = Clafer("n3").withCard(1, 1);
$n4 = Clafer("n4").withCard(1, 1);
$n5 = Clafer("n5").withCard(1, 1);
$p = Clafer("p").withCard(1, 1);
$N.refTo(Int);
$n1.extending($N);
Constraint(implies(some(global($n1)), equal(joinRef(global($n1)), constant(1))));
$n2.extending($N);
Constraint(implies(some(global($n2)), equal(joinRef(global($n2)), constant(2))));
$n3.extending($N);
Constraint(implies(some(global($n3)), equal(joinRef(global($n3)), constant(3))));
$n4.extending($N);
Constraint(implies(some(global($n4)), equal(joinRef(global($n4)), constant(2))));
$n5.extending($N);
Constraint(implies(some(global($n5)), equal(joinRef(global($n5)), constant(3))));
$p.refToUnique(Int);
Constraint(implies(some(global($p)), equal(joinRef(global($p)), product(global($N)))));
assert(equal(joinRef(global($p)), constant(36)));
