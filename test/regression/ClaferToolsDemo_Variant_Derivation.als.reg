open util/integer
pred show {}


abstract sig root__Bluetooth
{ r_Bluetooth20 : lone Bluetooth20
, r_Bluetooth21 : lone Bluetooth21
, r_Bluetooth40 : lone Bluetooth40 }

sig Bluetooth20
{}
{ one @r_Bluetooth20.this }

sig Bluetooth21
{}
{ one @r_Bluetooth21.this }

sig Bluetooth40
{}
{ one @r_Bluetooth40.this }

abstract sig MobilePhone
{ r_Connectivity : one Connectivity
, r_Battery : one Battery }

sig Connectivity
{ r_Connectivity__Bluetooth : one Connectivity__Bluetooth
, r_GSM : one GSM
, r_LTE : lone LTE
, r_WiFi : lone WiFi
, r_USB : lone USB }
{ one @r_Connectivity.this }

sig Connectivity__Bluetooth extends root__Bluetooth
{}
{ one @r_Connectivity__Bluetooth.this
  let children = (r_Bluetooth20 + r_Bluetooth21 + r_Bluetooth40) | one children }

sig GSM
{}
{ one @r_GSM.this }

sig LTE
{}
{ one @r_LTE.this
  some (((this.~@r_LTE).~@r_Connectivity).@r_Battery).@r_LiBattery1400 }

sig WiFi
{}
{ one @r_WiFi.this }

sig USB
{}
{ one @r_USB.this }

sig Battery
{ r_LiBattery1150 : lone LiBattery1150
, r_LiBattery1400 : lone LiBattery1400 }
{ one @r_Battery.this
  let children = (r_LiBattery1150 + r_LiBattery1400) | one children }

sig LiBattery1150
{}
{ one @r_LiBattery1150.this }

sig LiBattery1400
{}
{ one @r_LiBattery1400.this }

fact { #LowEndPhone = 0 }
abstract sig LowEndPhone extends MobilePhone
{}
{ no (this.@r_Connectivity).@r_WiFi }

abstract sig HighEndPhone extends MobilePhone
{ r_QuadCPU : lone QuadCPU }
{ (some (this.@r_Connectivity).@r_USB) && (some (this.@r_Connectivity).@r_WiFi) }

sig QuadCPU
{}
{ one @r_QuadCPU.this }

one sig Phone1 extends MobilePhone
{}
{ some (this.@r_Connectivity).@r_WiFi
  some (this.@r_Connectivity).@r_LTE
  some ((this.@r_Connectivity).@r_Connectivity__Bluetooth).@r_Bluetooth21 }

one sig Phone2 extends HighEndPhone
{}
{ some (this.@r_Connectivity).@r_LTE
  some ((this.@r_Connectivity).@r_Connectivity__Bluetooth).@r_Bluetooth21
  some this.@r_QuadCPU }

