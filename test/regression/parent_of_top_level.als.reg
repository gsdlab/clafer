abstract sig Feat
{}
{ (((this in f1) => (0 < 1)) && ((this in (g.@r_f2)) => (some (this & (g.@r_f2)).~(@r_f2 + @r_f3)))) && ((this in ((h.@r_i).@r_f3)) => (some (this & ((h.@r_i).@r_f3)).~(@r_f2 + @r_f3)))
  (((this in f1) => (0 < 1)) && ((this in (g.@r_f2)) => ((#((this & (g.@r_f2)).~(@r_f2 + @r_f3))) = 1))) && ((this in ((h.@r_i).@r_f3)) => ((#((this & ((h.@r_i).@r_f3)).~(@r_f2 + @r_f3))) = 1)) }

