open util/integer
pred show {}


abstract sig Component
{ r_InPort : set InPort
, r_OutPort : set OutPort }

abstract sig InPort
{ InPort_ref : one Signal }
{ one @r_InPort.this }

abstract sig OutPort
{ OutPort_ref : one Signal }
{ one @r_OutPort.this }

abstract sig Signal
{}

abstract sig Command extends Signal
{}

abstract sig MotorCommand extends Command
{}

one sig motorDown extends MotorCommand
{}

abstract sig Request extends Signal
{}

one sig stop extends Request
{}

abstract sig Controller extends Component
{ r_Controller__req : lone Controller__req
, r_down : one down }
{ r_Controller__req in r_InPort }

abstract sig Controller__req extends InPort
{ Controller__req_ref : one Request }
{ one @r_Controller__req.this
  Controller__req_ref in InPort_ref }

sig down extends Request
{}
{ one @r_down.this }

one sig WinController extends Controller
{ r_WinController__req : one WinController__req
, r_cmd : one cmd }
{ r_WinController__req in r_Controller__req
  r_cmd in r_OutPort }

one sig WinController__req extends Controller__req
{ WinController__req_ref : one stop }
{ WinController__req_ref in Controller__req_ref }

one sig cmd extends OutPort
{ cmd_ref : one MotorCommand }
{ cmd_ref in OutPort_ref }

assert assertAt_17_10 { ((WinController.@r_cmd).@cmd_ref) = motorDown }
check assertAt_17_10 for 1 but 2 Request, 3 Signal

assert assertAt_31_10 { ((Controller.@r_Controller__req).@Controller__req_ref) = stop }
check assertAt_31_10 for 1 but 2 Request, 3 Signal

