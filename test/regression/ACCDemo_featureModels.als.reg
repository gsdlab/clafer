open util/integer
pred show {}


abstract sig Car
{ r_ABS : lone ABS
, r_CC : lone CC
, r_Transmission : one Transmission
, r_FCA : lone FCA }

sig ABS
{}
{ one @r_ABS.this }

sig CC
{ r_ACC : lone ACC }
{ one @r_CC.this }

sig ACC
{}
{ one @r_ACC.this
  some ((this.~@r_ACC).~@r_CC).@r_FCA }

sig Transmission
{ r_Automatic : lone Automatic
, r_Manual : lone Manual }
{ one @r_Transmission.this
  let children = (r_Automatic + r_Manual) | one children }

sig Automatic
{}
{ one @r_Automatic.this }

sig Manual
{}
{ one @r_Manual.this }

sig FCA
{ r_Sensor : one Sensor
, r_Alert : lone Alert }
{ one @r_FCA.this }

sig Sensor
{ r_Radar : lone Radar
, r_Lidar : lone Lidar }
{ one @r_Sensor.this
  let children = (r_Radar + r_Lidar) | one children }

sig Radar
{}
{ one @r_Radar.this }

sig Lidar
{}
{ one @r_Lidar.this }

sig Alert
{ r_Haptic : lone Haptic
, r_Audible : lone Audible }
{ one @r_Alert.this
  let children = (r_Haptic + r_Audible) | one children }

sig Haptic
{}
{ one @r_Haptic.this }

sig Audible
{}
{ one @r_Audible.this }

one sig aCar extends Car
{}

