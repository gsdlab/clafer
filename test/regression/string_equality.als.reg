open util/integer
pred show {}


one sig text
{ text_ref : one Int }

fact { (some text) => ((text.@text_ref) = 0) }
one sig text1
{ text1_ref : one Int }

fact { (some text1) => ((text1.@text1_ref) = 0) }
one sig text2
{ text2_ref : one Int }

fact { (some text2) => ((text2.@text2_ref) = 0) }
lone sig equal1
{}

fact { ((text.@text_ref) = (text1.@text1_ref)) => (some equal1) }
lone sig equal2
{}

fact { ((text1.@text1_ref) = (text2.@text2_ref)) => (some equal2) }
assert assertAt_15_10 { some equal1 }
check assertAt_15_10 for 1

assert assertAt_16_10 { some equal2 }
check assertAt_16_10 for 1

