scope({$ECU:2, $cache:4, $cache__size:4, $comp:6, $display__options:4, $fixed:4, $options__size:4, $options__size__large:4, $options__size__small:4, $plaECU:2, $plaECU__display:4, $root__display:4, $root__options:4, $server:4, $version:6});
defaultScope(1);
stringLength(16);

$root__options = Abstract("root__options");
$options__size = $root__options.addChild("options__size").withCard(1, 1).withGroupCard(1, 1);
$options__size__small = $options__size.addChild("options__size__small").withCard(0, 1);
$options__size__large = $options__size.addChild("options__size__large").withCard(0, 1);
$cache = $root__options.addChild("cache").withCard(0, 1);
$cache__size = $cache.addChild("cache__size").withCard(1, 1);
$fixed = $cache__size.addChild("fixed").withCard(0, 1);
$comp = Abstract("comp");
$version = $comp.addChild("version").withCard(1, 1);
$ECU = Abstract("ECU");
$root__display = Abstract("root__display");
$server = $root__display.addChild("server").withCard(1, 1);
$display__options = $root__display.addChild("display__options").withCard(1, 1);
$plaECU = Abstract("plaECU");
$plaECU__display = $plaECU.addChild("plaECU__display").withCard(1, 2);
$ECU1 = Clafer("ECU1").withCard(1, 1);
$ECU2 = Clafer("ECU2").withCard(0, 1);
$master = $ECU2.addChild("master").withCard(1, 1);
$telematicsSystem = Clafer("telematicsSystem").withCard(1, 1);
$channel = $telematicsSystem.addChild("channel").withCard(1, 1).withGroupCard(1, 1);
$single = $channel.addChild("single").withCard(0, 1);
$dual = $channel.addChild("dual").withCard(0, 1);
$extraDisplay = $telematicsSystem.addChild("extraDisplay").withCard(0, 1);
$telematicsSystem__size = $telematicsSystem.addChild("telematicsSystem__size").withCard(1, 1).withGroupCard(1, 1);
$telematicsSystem__size__small = $telematicsSystem__size.addChild("telematicsSystem__size__small").withCard(0, 1);
$telematicsSystem__size__large = $telematicsSystem__size.addChild("telematicsSystem__size__large").withCard(0, 1);
$ECU.extending($comp);
$root__display.extending($comp);
$display__options.extending($root__options);
$plaECU.extending($ECU);
$plaECU__display.extending($root__display);
$ECU1.extending($plaECU);
$ECU2.extending($plaECU);
$cache__size.refToUnique(Int);
$version.refToUnique(Int);
$server.refToUnique($ECU);
$master.refToUnique($ECU1);
$root__options.addConstraint(implies(and(some(join(join($this(), $options__size), $options__size__small)), some(join($this(), $cache))), some(join(join(join($this(), $cache), $cache__size), $fixed))));
$comp.addConstraint(implies(some(join($this(), $version)), equal(joinRef(join($this(), $version)), add(constant(1), constant(2)))));
$root__display.addConstraint(greaterThanEqual(joinRef(join($this(), $version)), joinRef(join(joinRef(join($this(), $server)), $version))));
$plaECU__display.addConstraint(and(equal(joinRef(join($this(), $server)), joinParent($this())), none(join(join($this(), $display__options), $cache))));
$telematicsSystem.addConstraint(and(and(and(and(ifOnlyIf(some(join(join($this(), $channel), $dual)), some(global($ECU2))), ifOnlyIf(some(join($this(), $extraDisplay)), equal(card(join(global($ECU1), $plaECU__display)), constant(2)))), ifOnlyIf(some(join($this(), $extraDisplay)), implies(some(global($ECU2)), equal(card(join(global($ECU2), $plaECU__display)), constant(2))))), ifOnlyIf(some(join(join($this(), $telematicsSystem__size), $telematicsSystem__size__large)), none(join(join(join(join(global($plaECU), $plaECU__display), $display__options), $options__size), $options__size__small)))), ifOnlyIf(some(join(join($this(), $telematicsSystem__size), $telematicsSystem__size__small)), none(join(join(join(join(global($plaECU), $plaECU__display), $display__options), $options__size), $options__size__large)))));
Constraint(and(and(some(join(join(global($telematicsSystem), $channel), $dual)), some(join(global($telematicsSystem), $extraDisplay))), some(join(join(global($telematicsSystem), $telematicsSystem__size), $telematicsSystem__size__large))));
