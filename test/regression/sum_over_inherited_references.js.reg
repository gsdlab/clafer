scope({$Component:3, $energy:3});
defaultScope(1);
stringLength(16);

$Component = Abstract("Component");
$energy = $Component.addChild("energy").withCard(1, 1);
$c1 = Clafer("c1").withCard(1, 1);
$c2 = Clafer("c2").withCard(1, 1);
$c3 = Clafer("c3").withCard(1, 1);
$total = Clafer("total").withCard(1, 1);
$c1.extending($Component);
$c2.extending($Component);
$c3.extending($Component);
$energy.refTo(Int);
$total.refTo(Int);
$c1.addConstraint(equal(joinRef(join($this(), $energy)), constant(1)));
$c2.addConstraint(equal(joinRef(join($this(), $energy)), constant(1)));
$c3.addConstraint(equal(joinRef(join($this(), $energy)), constant(1)));
Constraint(implies(some(global($total)), equal(joinRef(global($total)), sum(join(global($Component), $energy)))));
assert(equal(joinRef(global($total)), constant(3)));
