<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/top_level_constraints_with_relational_joins.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Course">Course</span>
  <div class="indent">
  <span class="claferDecl" id="assistants">assistants</span><span class="keyword"> -> </span><a href="#TA"><span class="reference">TA</span></a> *</div>
</div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="TA">TA</span>
  <div class="indent">
  <span class="claferDecl" id="first">first</span><span class="keyword"> -> </span><a href="#Course"><span class="reference">Course</span></a> ?
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">parent</span> in <span class="keyword">this</span>.<a href="#assistants"><span class="reference">assistants</span></a> <span class="keyword">]</span></div>
  </div>
</div>


<div>
<span class="claferDecl" id="CompilerGradStudent">CompilerGradStudent</span><span class="keyword"> : </span><a href="#TA"><span class="reference">TA</span></a></div>


<div>
<span class="claferDecl" id="AIGradStudent">AIGradStudent</span><span class="keyword"> : </span><a href="#TA"><span class="reference">TA</span></a></div>


<div>
<span class="claferDecl" id="CompilerCourse">CompilerCourse</span><span class="keyword"> : </span><a href="#Course"><span class="reference">Course</span></a></div>


<div>
<span class="claferDecl" id="MachineLearningCourse">MachineLearningCourse</span><span class="keyword"> : </span><a href="#Course"><span class="reference">Course</span></a></div>


<div>
<span class="keyword">[</span> <a href="#CompilerGradStudent"><span class="reference">CompilerGradStudent</span></a>.<a href="#first"><span class="reference">first</span></a> = <a href="#CompilerCourse"><span class="reference">CompilerCourse</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <a href="#AIGradStudent"><span class="reference">AIGradStudent</span></a>.<a href="#first"><span class="reference">first</span></a> = <a href="#MachineLearningCourse"><span class="reference">MachineLearningCourse</span></a> <span class="keyword">]</span></div>


<div>
<span class="claferDecl" id="numerOfAssistants">numerOfAssistants</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> = # <a href="#Course"><span class="reference">Course</span></a>.<a href="#assistants"><span class="reference">assistants</span></a></div>

</body>
</html>