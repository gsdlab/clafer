open util/integer
pred show {}


abstract sig Argument
{}

abstract sig IntegerArgument
{ IntegerArgument_ref : one Int }

abstract sig StringArgument
{ StringArgument_ref : one Int }

abstract sig Value
{}

abstract sig DefaultValue
{}

abstract sig ClaferArgs
{ r_functional : lone functional
, r_schema : lone schema
, r_help : lone help
, r_version : lone version }

sig functional
{ r_mode : one mode
, r_keep_unused : lone keep_unused
, r_flatten_inheritance : lone flatten_inheritance
, r_console_output : lone console_output
, r_timeout_analysis : lone timeout_analysis
, r_layout : lone layout
, r_check_duplicates : lone check_duplicates
, r_skip_resolver : lone skip_resolver
, r_no_stats : lone no_stats
, r_validate : lone validate }
{ one @r_functional.this }

sig mode extends Argument
{ r_alloy : lone alloy
, r_desclafer : lone desclafer
, r_html : lone html
, r_graph : lone graph
, r_cvlGraph : lone cvlGraph }
{ one @r_mode.this
  let children = (r_alloy + r_desclafer + r_html + r_graph + r_cvlGraph) | one children }

sig alloy extends DefaultValue
{ r_noalloyruncommand : lone noalloyruncommand
, r_alloy_mapping : lone alloy_mapping }
{ one @r_alloy.this }

sig noalloyruncommand extends Argument
{}
{ one @r_noalloyruncommand.this }

sig alloy_mapping extends Argument
{}
{ one @r_alloy_mapping.this }

sig desclafer extends Value
{}
{ one @r_desclafer.this }

sig html extends Value
{ r_self_contained : lone self_contained
, r_add_graph : lone add_graph
, r_add_comments : lone add_comments }
{ one @r_html.this
  some ((this.~@r_html).~@r_mode).@r_keep_unused }

sig self_contained extends Argument
{}
{ one @r_self_contained.this }

sig add_graph extends Argument
{}
{ one @r_add_graph.this }

sig add_comments extends Argument
{}
{ one @r_add_comments.this }

sig graph extends Value
{}
{ one @r_graph.this
  some ((this.~@r_graph).~@r_mode).@r_keep_unused }

sig cvlGraph extends Value
{}
{ one @r_cvlGraph.this
  some ((this.~@r_cvlGraph).~@r_mode).@r_flatten_inheritance
  some ((this.~@r_cvlGraph).~@r_mode).@r_keep_unused }

sig keep_unused extends Argument
{}
{ one @r_keep_unused.this }

sig flatten_inheritance extends Argument
{}
{ one @r_flatten_inheritance.this }

sig console_output extends Argument
{}
{ one @r_console_output.this }

sig timeout_analysis extends IntegerArgument
{}
{ one @r_timeout_analysis.this }

sig layout
{ r_no_layout : lone no_layout
, r_new_layout : lone new_layout }
{ one @r_layout.this
  let children = (r_no_layout + r_new_layout) | lone children }

sig no_layout extends Argument
{}
{ one @r_no_layout.this }

sig new_layout extends Argument
{}
{ one @r_new_layout.this }

sig check_duplicates extends Argument
{}
{ one @r_check_duplicates.this }

sig skip_resolver extends Argument
{}
{ one @r_skip_resolver.this }

sig no_stats extends Argument
{}
{ one @r_no_stats.this }

sig validate extends Argument
{ r_tooldir : one tooldir }
{ one @r_validate.this
  no ((this.~@r_validate).@r_mode).@r_html
  no ((this.~@r_validate).@r_mode).@r_graph
  no ((this.~@r_validate).@r_mode).@r_cvlGraph }

sig tooldir extends StringArgument
{}
{ one @r_tooldir.this }

sig schema extends Argument
{}
{ one @r_schema.this }

sig help extends Argument
{}
{ one @r_help.this }

sig version extends Argument
{}
{ one @r_version.this }

one sig ca1 extends ClaferArgs
{}
{ let children = (r_functional + r_schema + r_help + r_version) | one children
  some ((this.@r_functional).@r_mode).@r_alloy }

one sig ca2 extends ClaferArgs
{}
{ let children = (r_functional + r_schema + r_help + r_version) | one children
  some ((this.@r_functional).@r_mode).@r_alloy
  some (this.@r_functional).@r_validate
  ((((this.@r_functional).@r_validate).@r_tooldir).@StringArgument_ref) = 0 }

one sig ca3 extends ClaferArgs
{}
{ let children = (r_functional + r_schema + r_help + r_version) | one children
  some ((this.@r_functional).@r_mode).@r_alloy
  some (this.@r_functional).@r_keep_unused
  some (this.@r_functional).@r_flatten_inheritance }

one sig ca4 extends ClaferArgs
{}
{ let children = (r_functional + r_schema + r_help + r_version) | one children
  some ((this.@r_functional).@r_mode).@r_html }

one sig ca5 extends ClaferArgs
{}
{ let children = (r_functional + r_schema + r_help + r_version) | one children
  some ((this.@r_functional).@r_mode).@r_html
  some (((this.@r_functional).@r_mode).@r_html).@r_self_contained
  some (((this.@r_functional).@r_mode).@r_html).@r_add_graph
  some (((this.@r_functional).@r_mode).@r_html).@r_add_comments }

one sig ca6 extends ClaferArgs
{}
{ let children = (r_functional + r_schema + r_help + r_version) | one children
  some ((this.@r_functional).@r_mode).@r_cvlGraph }

