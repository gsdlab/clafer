<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_past02.cfr</div>

<div>
<span class="claferDecl" id="Shift">Shift</span> ?
  <div class="indent">
  <span class="claferDecl" id="Worker">Worker</span> ?
    <div class="indent">
    <span class="claferDecl" id="alarm">alarm</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="warned">warned</span> ?</div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#warned"><span class="reference">warned</span></a> &lt;=&gt; <span class="tKeyword">previous </span><span class="tKeyword">once </span><a href="#alarm"><span class="reference">alarm</span></a> <span class="keyword">]</span></div>
  </div>
</div>


<div>
<span class="keyword">[</span> <span class="tKeyword">initially </span><span class="keyword">some</span> <a href="#Shift"><span class="reference">Shift</span></a>.<a href="#Worker"><span class="reference">Worker</span></a>.<a href="#alarm"><span class="reference">alarm</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <span class="tKeyword">initially </span>X <span class="keyword">no</span> <a href="#Shift"><span class="reference">Shift</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <span class="tKeyword">initially </span>X X (<span class="keyword">some</span> <a href="#Shift"><span class="reference">Shift</span></a>.<a href="#Worker"><span class="reference">Worker</span></a> &amp;&amp; <span class="keyword">no</span> <a href="#Shift"><span class="reference">Shift</span></a>.<a href="#Worker"><span class="reference">Worker</span></a>.<a href="#alarm"><span class="reference">alarm</span></a>) <span class="keyword">]</span></div>


<div>
<span class="keyword">assert [</span> <span class="tKeyword">initially </span>X X <span class="keyword">no</span> <a href="#Shift"><span class="reference">Shift</span></a>.<a href="#Worker"><span class="reference">Worker</span></a>.<a href="#warned"><span class="reference">warned</span></a> <span class="keyword">]</span></div>

</body>
</html>