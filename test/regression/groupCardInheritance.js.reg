defaultScope(1);
stringLength(16);

$Port = Abstract("Port").withGroupCard(1);
$input = $Port.addChild("input").withCard(0, 1);
$output = $Port.addChild("output").withCard(0, 1);
$RelayPort = Abstract("RelayPort").withGroupCard(1, 1);
$relay = $RelayPort.addChild("relay").withCard(0, 1);
$req = Clafer("req").withCard(1, 1).withGroupCard(1, 1);
$flow = $req.addChild("flow").withCard(0, 1);
$RelayPort.extending($Port);
$req.extending($RelayPort);
$req.addConstraint(some(join($this(), $flow)));
assert(none(join(global($req), $input)));
assert(none(join(global($req), $output)));
assert(none(join(global($req), $relay)));
assert(one(join(global($req), $flow)));
