scope({$Command:3, $Port:2, $Request:4, $input:2, $output:2});
defaultScope(1);
stringLength(16);

$Feature = Abstract("Feature");
$express = Clafer("express").withCard(0, 1);
$Component = Abstract("Component");
$Port = $Component.addAbstractChild("Port").withGroupCard(1, 1);
$input = $Port.addChild("input").withCard(0, 1);
$output = $Port.addChild("output").withCard(0, 1);
$Command = Abstract("Command");
$motorUp = Clafer("motorUp").withCard(1, 1);
$motorDown = Clafer("motorDown").withCard(1, 1);
$motorStop = Clafer("motorStop").withCard(1, 1);
$Request = Abstract("Request");
$up = Clafer("up").withCard(1, 1);
$down = Clafer("down").withCard(1, 1);
$downX = Clafer("downX").withCard(0, 1);
$stop = Clafer("stop").withCard(1, 1);
$WinCtrl = Clafer("WinCtrl").withCard(1, 1);
$cmd = $WinCtrl.addChild("cmd").withCard(1, 1).withGroupCard(1, 1);
$req = $WinCtrl.addChild("req").withCard(1, 1).withGroupCard(1, 1);
$express.extending($Feature);
$motorUp.extending($Command);
$motorDown.extending($Command);
$motorStop.extending($Command);
$up.extending($Request);
$down.extending($Request);
$downX.extending($Request);
$stop.extending($Request);
$WinCtrl.extending($Component);
$cmd.extending($Port);
$req.extending($Port);
$cmd.refToUnique($Command);
$req.refToUnique($Request);
Constraint(ifOnlyIf(some(global($express)), some(global($downX))));
$cmd.addConstraint(some(join($this(), $output)));
$req.addConstraint(some(join($this(), $input)));
