open util/integer
pred show {}


fact { #Currency = 0 }
abstract sig Currency
{ Currency_ref : one Int }

fact { #Percentage = 0 }
abstract sig Percentage
{ Percentage_ref : one Int }
{ ((this.@Percentage_ref) >= 0) && ((this.@Percentage_ref) <= 100) }

fact { #Mortgage = 0 }
abstract sig Mortgage
{ r_valueProposition : one valueProposition
, r_term : one term
, r_kind : one kind
, r_principalMortgageAmount : one principalMortgageAmount
, r_balance : one balance
, r_propertyValue : one propertyValue
, r_loanToValue : one loanToValue
, r_amortization : one amortization
, r_interestRate : one interestRate
, r_currentInterestRate : one currentInterestRate
, r_currentPayment : one currentPayment
, r_paymentFrequency : one paymentFrequency
, r_financingAvailable : one financingAvailable }
{ (5000 <= (((this.@r_principalMortgageAmount).@principalMortgageAmount_ref).@Currency_ref)) && ((((this.@r_principalMortgageAmount).@principalMortgageAmount_ref).@Currency_ref) <= 9999999)
  (((this.@r_balance).@balance_ref).@Currency_ref) <= (((this.@r_principalMortgageAmount).@principalMortgageAmount_ref).@Currency_ref)
  (1 <= ((this.@r_amortization).@amortization_ref)) && (((this.@r_amortization).@amortization_ref) <= 30) }

sig valueProposition
{ valueProposition_ref : one Int }
{ one @r_valueProposition.this }

sig term
{ term_ref : one MortgageTerm }
{ one @r_term.this }

sig kind
{ r_open_1 : lone open_1
, r_closed : lone closed }
{ one @r_kind.this
  let children = (r_open_1 + r_closed) | one children }

sig open_1
{}
{ one @r_open_1.this }

sig closed
{}
{ one @r_closed.this }

sig principalMortgageAmount
{ principalMortgageAmount_ref : one Currency }
{ one @r_principalMortgageAmount.this }

sig balance
{ balance_ref : one Currency }
{ one @r_balance.this }

sig propertyValue
{ propertyValue_ref : one Currency }
{ one @r_propertyValue.this }

sig loanToValue
{ loanToValue_ref : one Percentage }
{ one @r_loanToValue.this }

sig amortization
{ amortization_ref : one Int }
{ one @r_amortization.this }

sig interestRate
{ r_fixedForTheFullTerm : lone fixedForTheFullTerm
, r_resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges : lone resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges }
{ one @r_interestRate.this
  let children = (r_fixedForTheFullTerm + r_resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges) | one children }

sig fixedForTheFullTerm
{}
{ one @r_fixedForTheFullTerm.this }

sig resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges
{}
{ one @r_resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges.this }

sig currentInterestRate
{ currentInterestRate_ref : one Percentage }
{ one @r_currentInterestRate.this }

sig currentPayment
{ currentPayment_ref : one Currency }
{ one @r_currentPayment.this }

sig paymentFrequency
{ r_weekly : lone weekly
, r_biweekly : lone biweekly
, r_semiMonthly : lone semiMonthly
, r_monthly : lone monthly }
{ one @r_paymentFrequency.this
  let children = (r_weekly + r_biweekly + r_semiMonthly + r_monthly) | one children }

sig weekly
{}
{ one @r_weekly.this }

sig biweekly
{}
{ one @r_biweekly.this }

sig semiMonthly
{}
{ one @r_semiMonthly.this }

sig monthly
{}
{ one @r_monthly.this }

sig financingAvailable
{ r_conventional : lone conventional
, r_insured : lone insured }
{ one @r_financingAvailable.this
  let children = (r_conventional + r_insured) | one children }

sig conventional
{}
{ one @r_conventional.this }

sig insured
{}
{ one @r_insured.this }

abstract sig MortgageTerm
{}

one sig sixMonths extends MortgageTerm
{}

one sig oneYear extends MortgageTerm
{}

