open util/integer
pred show {}


abstract sig Course
{ r_assistants : set assistants }
{ all disj x, y : this.@r_assistants | (x.@assistants_ref) != (y.@assistants_ref)  }

sig assistants
{ assistants_ref : one TA }
{ one @r_assistants.this }

abstract sig TA
{ r_first : lone first }

sig first
{ first_ref : one Course }
{ one @r_first.this
  (this.~@r_first) in (((this.@first_ref).@r_assistants).@assistants_ref) }

one sig CompilerGradStudent extends TA
{}

one sig AIGradStudent extends TA
{}

one sig CompilerCourse extends Course
{}

one sig MachineLearningCourse extends Course
{}

fact { ((CompilerGradStudent.@r_first).@first_ref) = CompilerCourse }
fact { ((AIGradStudent.@r_first).@first_ref) = MachineLearningCourse }
one sig numerOfAssistants
{ numerOfAssistants_ref : one Int }

fact { (some numerOfAssistants) => ((numerOfAssistants.@numerOfAssistants_ref) = (#(Course.@r_assistants))) }
