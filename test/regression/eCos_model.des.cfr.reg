//# OPTIONS --explicit
0..* c0_MISC_FILESYSTEMS 0..1 {
  [((#this . c0_display) >= 1) => (this . c0_display . dref = "Miscellaneous filesystems")]
  0..* c0_display -> string 1..1 {}
  0..* c0_CYGPKG_FS_JFFS2 0..1 {
    [((#this . c1_display) >= 1) => (this . c1_display . dref = "Journalling Flash File System")]
    [(#c0_CYGPKG_CRC) >= 1]
    [(#c0_MTD) >= 1]
    [((#this . c0_CYGOPT_FS_JFFS2_NAND) >= 1) <=> ((#c0_HAS_IOMEM) >= 1)]
    [(#this . c0_CYGOPT_FS_JFFS2_COMPRESS) >= 1]
    0..* c1_display -> string 1..1 {}
    0..* c0_CYGOPT_FS_JFFS2_DEBUG -> int 1..1 {
      [this . dref = 0]
      [((#this . c2_display) >= 1) => (this . c2_display . dref = "Debug level")]
      [(0 <= this . dref) && (this . dref <= 2)]
      [((#this . c0_description) >= 1) => (this . c0_description . dref = "Debug verbosity of....")]
      0..* c2_display -> string 1..1 {}
      0..* c0_description -> string 1..1 {}
    }
    0..* c0_CYGOPT_FS_JFFS2_NAND 0..1 {}
    0..* c0_CYGOPT_FS_JFFS2_COMPRESS 0..1 {
      [((#this . c3_display) >= 1) => (this . c3_display . dref = "Compress data")]
      [(#this . c0_CYGOPT_FS_JFFS2_COMPRESS_ZLIB) >= 1]
      0..* c3_display -> string 1..1 {}
      0..* c0_CYGOPT_FS_JFFS2_COMPRESS_ZLIB 0..1 {
        [((#this . c4_display) >= 1) => (this . c4_display . dref = "Compress data using zlib")]
        [(#c0_CYGPKG_COMPRESS_ZLIB) >= 1]
        0..* c4_display -> string 1..1 {}
      }
      0..* c0_CYGOPT_FS_JFFS2_COMPRESS_CMODE -> string 1..1 {
        [this . dref = "PRIORITY"]
        [((#this . c5_display) >= 1) => (this . c5_display . dref = "Set the default compression mode")]
        [((this . dref = "NONE") || (this . dref = "PRIORITY")) || (this . dref = "SIZE")]
        0..* c5_display -> string 1..1 {}
      }
    }
  }
}
0..* c0_CYGPKG_CRC 1..1 {}
0..* c0_MTD 1..1 {}
0..* c0_CYGPKG_COMPRESS_ZLIB 1..1 {}
0..* c0_HAS_IOMEM 1..1 {}
