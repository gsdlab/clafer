//# OPTIONS --explicit
0..* MISC_FILESYSTEMS 0..1 {
  0..* MISC_FILESYSTEMS__display -> string 1..1 = "Miscellaneous filesystems" {}
  0..* CYGPKG_FS_JFFS2 0..1 {
    [(#CYGPKG_CRC) >= 1]
    [(#MTD) >= 1]
    [((#this.CYGOPT_FS_JFFS2_NAND) >= 1) <=> ((#HAS_IOMEM) >= 1)]
    [(#this.CYGOPT_FS_JFFS2_COMPRESS) >= 1]
    0..* CYGPKG_FS_JFFS2__display -> string 1..1 = "Journalling Flash File System" {}
    0..* CYGOPT_FS_JFFS2_DEBUG -> int 1..1 {
      [this.dref = 0]
      [(0 <= this.dref) && (this.dref <= 2)]
      0..* CYGOPT_FS_JFFS2_DEBUG__display -> string 1..1 = "Debug level" {}
      0..* description -> string 1..1 = "Debug verbosity of...." {}
    }
    0..* CYGOPT_FS_JFFS2_NAND 0..1 {}
    0..* CYGOPT_FS_JFFS2_COMPRESS 0..1 {
      [(#this.CYGOPT_FS_JFFS2_COMPRESS_ZLIB) >= 1]
      0..* CYGOPT_FS_JFFS2_COMPRESS__display -> string 1..1 = "Compress data" {}
      0..* CYGOPT_FS_JFFS2_COMPRESS_ZLIB 0..1 {
        [(#CYGPKG_COMPRESS_ZLIB) >= 1]
        0..* CYGOPT_FS_JFFS2_COMPRESS_ZLIB__display -> string 1..1 = "Compress data using zlib" {}
      }
      0..* CYGOPT_FS_JFFS2_COMPRESS_CMODE -> string 1..1 {
        [this.dref = "PRIORITY"]
        [((this.dref = "NONE") || (this.dref = "PRIORITY")) || (this.dref = "SIZE")]
        0..* CYGOPT_FS_JFFS2_COMPRESS_CMODE__display -> string 1..1 = "Set the default compression mode" {}
      }
    }
  }
}
0..* CYGPKG_CRC 1..1 {}
0..* MTD 1..1 {}
0..* CYGPKG_COMPRESS_ZLIB 1..1 {}
0..* HAS_IOMEM 1..1 {}
