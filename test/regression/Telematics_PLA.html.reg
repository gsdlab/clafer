<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/Telematics_PLA.cfr</div>

<div>
<span class="claferDecl" id="telematicsSystem">telematicsSystem</span>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="channel">channel</span>
    <div class="indent">
    <span class="claferDecl" id="single">single</span></div>
    <div class="indent">
    <span class="claferDecl" id="dual">dual</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="extraDisplay">extraDisplay</span> ?</div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="telematicsSystem__size">size</span>
    <div class="indent">
    <span class="claferDecl" id="telematicsSystem__size__small">small</span></div>
    <div class="indent">
    <span class="claferDecl" id="telematicsSystem__size__large">large</span></div>
  </div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#dual"><span class="reference">dual</span></a> &lt;=&gt; <a href="#ECU2"><span class="reference">ECU2</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#extraDisplay"><span class="reference">extraDisplay</span></a> &lt;=&gt; # <a href="#ECU1"><span class="reference">ECU1</span></a>.<a href="#plaECU__display"><span class="reference">display</span></a> = 2 <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#extraDisplay"><span class="reference">extraDisplay</span></a> &lt;=&gt; <a href="#ECU2"><span class="reference">ECU2</span></a> =&gt; # <a href="#ECU2"><span class="reference">ECU2</span></a>.<a href="#plaECU__display"><span class="reference">display</span></a> = 2 <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#telematicsSystem__size__large"><span class="reference">large</span></a> &lt;=&gt;  ! <a href="#plaECU"><span class="reference">plaECU</span></a>.<a href="#plaECU__display"><span class="reference">display</span></a>.<a href="#display__options"><span class="reference">options</span></a>.<a href="#options__size"><span class="reference">size</span></a>.<a href="#options__size__small"><span class="reference">small</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#telematicsSystem__size__small"><span class="reference">small</span></a> &lt;=&gt;  ! <a href="#plaECU"><span class="reference">plaECU</span></a>.<a href="#plaECU__display"><span class="reference">display</span></a>.<a href="#display__options"><span class="reference">options</span></a>.<a href="#options__size"><span class="reference">size</span></a>.<a href="#options__size__large"><span class="reference">large</span></a> <span class="keyword">]</span></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="comp">comp</span>
  <div class="indent">
  <span class="claferDecl" id="version">version</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="ECU">ECU</span><span class="keyword"> : </span><a href="#comp"><span class="reference">comp</span></a></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="root__display">display</span><span class="keyword"> : </span><a href="#comp"><span class="reference">comp</span></a>
  <div class="indent">
  <span class="claferDecl" id="server">server</span><span class="keyword"> -> </span><a href="#ECU"><span class="reference">ECU</span></a></div>
  <div class="indent">
  `<a href="#root__options"><span class="reference">options</span></a></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#version"><span class="reference">version</span></a> &gt;= <a href="#server"><span class="reference">server</span></a>.<a href="#version"><span class="reference">version</span></a> <span class="keyword">]</span></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="root__options">options</span>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="options__size">size</span>
    <div class="indent">
    <span class="claferDecl" id="options__size__small">small</span></div>
    <div class="indent">
    <span class="claferDecl" id="options__size__large">large</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="cache">cache</span> ?
    <div class="indent">
    <span class="claferDecl" id="cache__size">size</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a>
      <div class="indent">
      <span class="claferDecl" id="fixed">fixed</span> ?</div>
    </div>
  </div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#options__size__small"><span class="reference">small</span></a> &amp;&amp; <a href="#cache"><span class="reference">cache</span></a> =&gt; <a href="#fixed"><span class="reference">fixed</span></a> <span class="keyword">]</span></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="plaECU">plaECU</span><span class="keyword"> : </span><a href="#ECU"><span class="reference">ECU</span></a>
  <div class="indent">
  `<a href="#root__display"><span class="reference">display</span></a> 1..2 </div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#server"><span class="reference">server</span></a> = <span class="keyword">parent</span> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span>  ! <a href="#display__options"><span class="reference">options</span></a>.<a href="#cache"><span class="reference">cache</span></a> <span class="keyword">]</span></div>
 
</div>


<div>
<span class="claferDecl" id="ECU1">ECU1</span><span class="keyword"> : </span><a href="#plaECU"><span class="reference">plaECU</span></a></div>


<div>
<span class="claferDecl" id="ECU2">ECU2</span><span class="keyword"> : </span><a href="#plaECU"><span class="reference">plaECU</span></a> ?
  <div class="indent">
  <span class="claferDecl" id="master">master</span><span class="keyword"> -> </span><a href="#ECU1"><span class="reference">ECU1</span></a></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">[</span> <a href="#dual"><span class="reference">dual</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <a href="#extraDisplay"><span class="reference">extraDisplay</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <a href="#telematicsSystem"><span class="reference">telematicsSystem</span></a>.<a href="#telematicsSystem__size"><span class="reference">size</span></a>.<a href="#telematicsSystem__size__large"><span class="reference">large</span></a> <span class="keyword">]</span></div>


<div>
<span class="keyword">[</span> <a href="#comp"><span class="reference">comp</span></a>.<a href="#version"><span class="reference">version</span></a> = 1 <span class="keyword">]</span></div>

</body>
</html>