digraph "enforcingInverseReferences"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Book" [label="abstract Book" URL="#Book" tooltip="abstract Book&#10;  author -&gt; Author +&#10;    [ Book in this.book ]&#10;"];
"Book" -> "Author" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="author"];
"Author" [label="abstract Author" URL="#Author" tooltip="abstract Author&#10;  book -&gt; Book +&#10;    [ Author in this.author ]&#10;"];
"Author" -> "Book" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="book"];
"B" [label="B : Book 5" URL="#B" tooltip="B : Book 5&#10;"];
"A" [label="A : Author 6" URL="#A" tooltip="A : Author 6&#10;"];
}