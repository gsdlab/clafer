digraph "product"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"N" [label="abstract N -&gt;&gt; integer" URL="#N" tooltip="abstract N -&gt;&gt; integer&#10;"];
"n1" [label="n1 : N = 1" URL="#n1" tooltip="n1 : N = 1&#10;"];
"n2" [label="n2 : N = 2" URL="#n2" tooltip="n2 : N = 2&#10;"];
"n3" [label="n3 : N = 3" URL="#n3" tooltip="n3 : N = 3&#10;"];
"n4" [label="n4 : N = 2" URL="#n4" tooltip="n4 : N = 2&#10;"];
"n5" [label="n5 : N = 3" URL="#n5" tooltip="n5 : N = 3&#10;"];
"p" [label="p -&gt; integer = product N" URL="#p" tooltip="p -&gt; integer = product N&#10;"];
}