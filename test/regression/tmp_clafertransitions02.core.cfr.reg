//# OPTIONS --explicit --core --tl=10
0..* a 1..1 {
  1..1 b 0..1 {
    0..* c 0..1 {
      [(some this) => ((some this) U (some this.parent.d))] // -->>, tmp_clafertransitions02.cfr:5:5
    }
    0..* d 0..1 {}
    0..* e 0..1 {}
  }
}

assert [all b1 : a.b | (some b1.c) => (F ((some b1.d) || (no (b1 ** a.b))))]
