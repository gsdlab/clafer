digraph "books_tutorial"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Book" [label="abstract Book" URL="#Book" tooltip="abstract Book&#10;  title -&gt; string&#10;    subtitle -&gt; string ?&#10;  year -&gt; integer&#10;  page 2..*&#10;  xor format&#10;    paper&#10;      hardcover ?&#10;    electronic&#10;  xor kind&#10;    textbook&#10;    manual&#10;    reference&#10;    fiction&#10;    nonfiction&#10;    other -&gt; string&#10;  authors -&gt; Author +&#10;  [ year >= 5 => ISBN ]&#10;  ISBN -&gt; string ?&#10;    GS1 -&gt; string ?&#10;    [ year >= 6 => GS1 ]&#10;"];
"Book" -> "Author" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="authors"];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  name -&gt; string&#10;  dob -&gt; string ?&#10;"];
"Author" [label="abstract Author : Person" URL="#Author" tooltip="abstract Author : Person&#10;  books -&gt; Book +&#10;"];
"Author" -> "Book" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="books"];
"GenerativeProgramming" [label="GenerativeProgramming : Book" URL="#GenerativeProgramming" tooltip="GenerativeProgramming : Book&#10;  [ title = &quot;name&quot; ][ no subtitle ][ year = 5 ][ # page = 4 ][ paper ][ nonfiction ][ authors = Czarnecki, Eisenecker ][ ISBN = &quot;name&quot; ][ no GS1 ]&#10;"];
"Czarnecki" [label="Czarnecki : Author" URL="#Czarnecki" tooltip="Czarnecki : Author&#10;  [ name = &quot;name&quot; ][ GenerativeProgramming in books ]&#10;"];
"Eisenecker" [label="Eisenecker : Author" URL="#Eisenecker" tooltip="Eisenecker : Author&#10;  [ name = &quot;name&quot; ][ GenerativeProgramming in books ]&#10;"];
}