scope({$Battery:2, $Bluetooth20:2, $Bluetooth21:2, $Bluetooth40:2, $Connectivity:2, $Connectivity__Bluetooth:2, $GSM:2, $LTE:2, $LiBattery1150:2, $LiBattery1400:2, $LowEndPhone:0, $MobilePhone:2, $USB:2, $WiFi:2, $root__Bluetooth:2});
defaultScope(1);
stringLength(16);

$root__Bluetooth = Abstract("root__Bluetooth").withGroupCard(1, 1);
$Bluetooth20 = $root__Bluetooth.addChild("Bluetooth20").withCard(0, 1);
$Bluetooth21 = $root__Bluetooth.addChild("Bluetooth21").withCard(0, 1);
$Bluetooth40 = $root__Bluetooth.addChild("Bluetooth40").withCard(0, 1);
$MobilePhone = Abstract("MobilePhone");
$Connectivity = $MobilePhone.addChild("Connectivity").withCard(1, 1);
$Connectivity__Bluetooth = $Connectivity.addChild("Connectivity__Bluetooth").withCard(1, 1).withGroupCard(1, 1);
$GSM = $Connectivity.addChild("GSM").withCard(1, 1);
$LTE = $Connectivity.addChild("LTE").withCard(0, 1);
$WiFi = $Connectivity.addChild("WiFi").withCard(0, 1);
$USB = $Connectivity.addChild("USB").withCard(0, 1);
$Battery = $MobilePhone.addChild("Battery").withCard(1, 1).withGroupCard(1, 1);
$LiBattery1150 = $Battery.addChild("LiBattery1150").withCard(0, 1);
$LiBattery1400 = $Battery.addChild("LiBattery1400").withCard(0, 1);
$LowEndPhone = Abstract("LowEndPhone");
$HighEndPhone = Abstract("HighEndPhone");
$QuadCPU = $HighEndPhone.addChild("QuadCPU").withCard(0, 1);
$Phone1 = Clafer("Phone1").withCard(1, 1);
$Phone2 = Clafer("Phone2").withCard(1, 1);
$Connectivity__Bluetooth.extending($root__Bluetooth);
$LowEndPhone.extending($MobilePhone);
$HighEndPhone.extending($MobilePhone);
$Phone1.extending($MobilePhone);
$Phone2.extending($HighEndPhone);
$LTE.addConstraint(some(join(join(joinParent(joinParent($this())), $Battery), $LiBattery1400)));
$LowEndPhone.addConstraint(none(join(join($this(), $Connectivity), $WiFi)));
$HighEndPhone.addConstraint(and(some(join(join($this(), $Connectivity), $USB)), some(join(join($this(), $Connectivity), $WiFi))));
$Phone1.addConstraint(some(join(join($this(), $Connectivity), $WiFi)));
$Phone1.addConstraint(some(join(join($this(), $Connectivity), $LTE)));
$Phone1.addConstraint(some(join(join(join($this(), $Connectivity), $Connectivity__Bluetooth), $Bluetooth21)));
$Phone2.addConstraint(some(join(join($this(), $Connectivity), $LTE)));
$Phone2.addConstraint(some(join(join(join($this(), $Connectivity), $Connectivity__Bluetooth), $Bluetooth21)));
$Phone2.addConstraint(some(join($this(), $QuadCPU)));
