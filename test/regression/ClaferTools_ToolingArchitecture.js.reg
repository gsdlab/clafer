scope({$Front:3, $Generator:3, $Intermediate:3, $Representation:4, $alloy:3, $ast2ast:3, $ast2ir:3, $ast2text:3, $claferLib:3, $common:3, $desClafer:3, $desugarer:3, $experimental:3, $findDuplicates:3, $front:3, $generator:3, $inheritanceFlattener:3, $inheritanceResolver:3, $input:33, $intermediate:3, $io:33, $ir2ir:12, $ir2text:3, $layoutResolver:3, $lexer:3, $mapper:3, $nameResolution:3, $nameResolver:3, $optimizer:3, $output:33, $parser:3, $prettyPrinter:3, $resolver:3, $scopeAnalysis:3, $setUid:3, $stable:3, $stats:3, $stringAnalyzer:3, $text2tokens:3, $tokens2ast:3, $tokens2tokens:3, $transformer:3, $typeResolver:3, $xml:3, $xsdSchema:3});
defaultScope(1);
stringLength(16);

$claferCompiler = Clafer("claferCompiler").withCard(1, 1);
$claferIG = Clafer("claferIG").withCard(1, 1);
$claferMOO = Clafer("claferMOO").withCard(1, 1);
$moo = $claferMOO.addChild("moo").withCard(1, 1);
$claferLib = Abstract("claferLib");
$common = $claferLib.addChild("common").withCard(1, 1);
$front = $claferLib.addChild("front").withCard(1, 1);
$intermediate = $claferLib.addChild("intermediate").withCard(1, 1);
$optimizer = $claferLib.addChild("optimizer").withCard(1, 1);
$generator = $claferLib.addChild("generator").withCard(1, 1).withGroupCard(1, 1);
$Representation = Abstract("Representation");
$text = Clafer("text").withCard(1, 1);
$tokens = Clafer("tokens").withCard(1, 1);
$ast = Clafer("ast").withCard(1, 1);
$ir = Clafer("ir").withCard(1, 1);
$io = Abstract("io");
$input = $io.addChild("input").withCard(1, 1);
$output = $io.addChild("output").withCard(1, 1);
$text2tokens = Abstract("text2tokens");
$tokens2tokens = Abstract("tokens2tokens");
$tokens2ast = Abstract("tokens2ast");
$ast2ast = Abstract("ast2ast");
$ast2text = Abstract("ast2text");
$ast2ir = Abstract("ast2ir");
$ir2ir = Abstract("ir2ir");
$ir2text = Abstract("ir2text");
$Front = Abstract("Front");
$lexer = $Front.addChild("lexer").withCard(1, 1);
$layoutResolver = $Front.addChild("layoutResolver").withCard(0, 1).withGroupCard(1, 1);
$stable = $layoutResolver.addChild("stable").withCard(0, 1);
$experimental = $layoutResolver.addChild("experimental").withCard(0, 1);
$parser = $Front.addChild("parser").withCard(1, 1);
$mapper = $Front.addChild("mapper").withCard(1, 1);
$prettyPrinter = $Front.addChild("prettyPrinter").withCard(0, 1);
$Intermediate = Abstract("Intermediate");
$desugarer = $Intermediate.addChild("desugarer").withCard(1, 1);
$findDuplicates = $Intermediate.addChild("findDuplicates").withCard(0, 1);
$resolver = $Intermediate.addChild("resolver").withCard(0, 1);
$setUid = $resolver.addChild("setUid").withCard(1, 1);
$inheritanceFlattener = $resolver.addChild("inheritanceFlattener").withCard(0, 1);
$nameResolution = $resolver.addChild("nameResolution").withCard(1, 1);
$nameResolver = $nameResolution.addChild("nameResolver").withCard(0, 1);
$inheritanceResolver = $nameResolution.addChild("inheritanceResolver").withCard(1, 1);
$typeResolver = $nameResolution.addChild("typeResolver").withCard(1, 1);
$transformer = $Intermediate.addChild("transformer").withCard(1, 1);
$stringAnalyzer = $Intermediate.addChild("stringAnalyzer").withCard(0, 1);
$scopeAnalysis = $Intermediate.addChild("scopeAnalysis").withCard(0, 1);
$Generator = Abstract("Generator").withGroupCard(1, 1);
$alloy = $Generator.addChild("alloy").withCard(0, 1);
$stats = $Generator.addChild("stats").withCard(0, 1);
$xml = $Generator.addChild("xml").withCard(0, 1);
$desClafer = $Generator.addChild("desClafer").withCard(0, 1);
$xsdSchema = $Generator.addChild("xsdSchema").withCard(0, 1);
$claferCompiler.extending($claferLib);
$claferIG.extending($claferLib);
$claferMOO.extending($claferLib);
$front.extending($Front);
$intermediate.extending($Intermediate);
$generator.extending($Generator);
$text.extending($Representation);
$tokens.extending($Representation);
$ast.extending($Representation);
$ir.extending($Representation);
$text2tokens.extending($io);
$tokens2tokens.extending($io);
$tokens2ast.extending($io);
$ast2ast.extending($io);
$ast2text.extending($io);
$ast2ir.extending($io);
$ir2ir.extending($io);
$ir2text.extending($io);
$lexer.extending($text2tokens);
$layoutResolver.extending($tokens2tokens);
$parser.extending($tokens2ast);
$mapper.extending($ast2ast);
$prettyPrinter.extending($ast2text);
$desugarer.extending($ast2ir);
$resolver.extending($ir2ir);
$transformer.extending($ir2ir);
$stringAnalyzer.extending($ir2ir);
$scopeAnalysis.extending($ir2ir);
$Generator.extending($ir2text);
$input.refToUnique($Representation);
$output.refToUnique($Representation);
$text2tokens.addConstraint(and(equal(joinRef(join($this(), $input)), global($text)), equal(joinRef(join($this(), $output)), global($tokens))));
$tokens2tokens.addConstraint(and(equal(joinRef(join($this(), $input)), global($tokens)), equal(joinRef(join($this(), $output)), global($tokens))));
$tokens2ast.addConstraint(and(equal(joinRef(join($this(), $input)), global($tokens)), equal(joinRef(join($this(), $output)), global($ast))));
$ast2ast.addConstraint(and(equal(joinRef(join($this(), $input)), global($ast)), equal(joinRef(join($this(), $output)), global($ast))));
$ast2text.addConstraint(and(equal(joinRef(join($this(), $input)), global($ast)), equal(joinRef(join($this(), $output)), global($text))));
$ast2ir.addConstraint(and(equal(joinRef(join($this(), $input)), global($ast)), equal(joinRef(join($this(), $output)), global($ir))));
$ir2ir.addConstraint(and(equal(joinRef(join($this(), $input)), global($ir)), equal(joinRef(join($this(), $output)), global($ir))));
$ir2text.addConstraint(and(equal(joinRef(join($this(), $input)), global($ir)), equal(joinRef(join($this(), $output)), global($text))));
$nameResolver.addConstraint(some(join(joinParent(joinParent(joinParent($this()))), $findDuplicates)));
$alloy.addConstraint(and(some(join(global($Intermediate), $stringAnalyzer)), some(join(global($Intermediate), $scopeAnalysis))));
$desClafer.addConstraint(some(join(global($Front), $prettyPrinter)));
