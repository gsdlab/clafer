open util/integer
pred show {}


one sig root
{ r_c0_a : set c0_a }
fact { all self_ : root | always (one self_.@r_c0_a) }

assert assertOnLine_7 { always ((always (no alive_c0_a.@r_c0_b)) || (eventually ((some alive_c0_a.@r_c0_b) && (eventually (some alive_c0_a.@r_c0_c))))) }
check assertOnLine_7 for 1 but 10 steps



sig c0_a
{ p_c0_a : lone root
, var r_c0_b : set c0_b
, var r_c0_c : set c0_c }
{ always (this in alive_c0_a implies (let children = (this.@r_c0_b + this.@r_c0_c) | one children))
  always (this in alive_c0_a and not before this in alive_c0_a implies (some this.@r_c0_b)) }
fun alive_c0_a : set c0_a { root.@r_c0_a }
fact { always ~@r_c0_a in @p_c0_a }

fact { all self_ : c0_a | always (self_ in alive_c0_a implies (lone self_.@r_c0_b)) }
fact { all self_ : c0_a | always (self_ in alive_c0_a implies (lone self_.@r_c0_c)) }
fact { all self_ : c0_a | always (self_ in alive_c0_a implies (eventually (not some (self_ & alive_c0_a) or (some self_.@r_c0_c)))) }


sig c0_b
{ p_c0_b : lone c0_a }
fun alive_c0_b : set c0_b { c0_a.@r_c0_b }
fact { always ~@r_c0_b in @p_c0_b
  always @r_c0_b.univ in alive_c0_a }


sig c0_c
{ p_c0_c : lone c0_a }
fun alive_c0_c : set c0_c { c0_a.@r_c0_c }
fact { always ~@r_c0_c in @p_c0_c
  always @r_c0_c.univ in alive_c0_a }


