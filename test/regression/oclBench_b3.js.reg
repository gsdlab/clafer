scope({$Exam:3, $Person:5, $date:3, $examinee:3, $examineeAda:3, $examineeOfAdaAsExaminer:5, $examineeOfAdaAsRecorder:5, $examiner:3, $examinerAda:3, $examinerOfAdaAsExaminee:5, $examinerOfAdaAsRecorder:5, $recorder:3, $recorderAda:3, $recorderOfAdaAsExaminee:5, $recorderOfAdaAsExaminer:5});
