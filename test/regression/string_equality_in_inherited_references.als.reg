open util/integer
pred show {}


abstract sig Entity
{ r_type : one type }

sig type
{ type_ref : one Int }
{ one @r_type.this }

one sig E1 extends Entity
{}
{ ((this.@r_type).@type_ref) = 0 }

one sig E2 extends Entity
{}
{ ((this.@r_type).@type_ref) = 0 }

one sig E3 extends Entity
{}
{ ((this.@r_type).@type_ref) = 0 }

sig E1TEntities
{ E1TEntities_ref : one Entity }
{ (((this.@E1TEntities_ref).@r_type).@type_ref) = 0 }

fact {  all disj x, y : E1TEntities | (x.@E1TEntities_ref) != (y.@E1TEntities_ref)  }
fact { (#E1TEntities) = 3 }
