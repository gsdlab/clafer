//# OPTIONS --explicit --tl=10
final 0..* feature_model 1..1 {
  final 0..* EU 0..1 {}
}
abstract 1..1 TrafficLight_2 0..* {
  initial 1..1 on 0..1 {
    initial 1..1 normal 0..1 {
      initial 0..* green 0..1 {
        [(some this) --> (some this.parent.yellow)]
      }
      0..* yellow 0..1 {
        [(some this) --> ((some this.parent.red) || ((some feature_model.EU) && (some this.parent.green)))]
      }
      0..* red 0..1 {
        [(some this) --> ((some this.parent.green) || ((some feature_model.EU) && (some this.parent.yellow)))]
      }
    }
    1..1 flashing 0..1 {
      initial 0..* yellow_on 0..1 {
        [(some this) --> (some this.parent.yellow_off)]
      }
      0..* yellow_off 0..1 {
        [(some this) --> (some this.parent.yellow_on)]
      }
      [(some this) -->> (some this.parent.normal)]
    }
    [(some this) -->> (some this.parent.off)]
  }
  0..* off 0..1 {
    [(some this) --> (some this.parent.on)]
  }
}
[no feature_model.EU]
1..1 tl : TrafficLight_2 1..1 {
  [initially ((some this.on.normal.green) --> (some this.on.normal.yellow) --> (some this.on.normal.red) --> (some this.on.normal.green))]
}
