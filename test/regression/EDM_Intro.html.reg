  <div class="indent">
  <span class="keyword">or</span> <span class="claferDecl" id="Room__whiteboard">whiteboard</span>
    <div class="indent">
    <span class="claferDecl" id="traditional">traditional</span></div>
    <div class="indent">
    <span class="claferDecl" id="electronic">electronic</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="projector">projector</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="computer">computer</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="Room__audioConferencing">audioConferencing</span> ?</div>
</div>

