<div>
<span class="claferDecl" id="M2">M2</span><span class="keyword"> : </span><a href="#Meeting"><span class="reference">Meeting</span></a> ?
  <div class="indent">
  <span class="claferDecl" id="time">time</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a> = 10</div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Agenda">Agenda</span>
  <div class="indent">
  <span class="claferDecl" id="mt">mt</span><span class="keyword"> -> </span><a href="#Meeting"><span class="reference">Meeting</span></a> *</div>
