  <div class="indent">
  <span class="claferDecl" id="D__whiteboard">whiteboard</span></div>
</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Meeting">Meeting</span>
  <div class="indent">
  <span class="claferDecl" id="Meeting__chair">chair</span><span class="keyword"> -> </span><a href="#Member"><span class="reference">Member</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="participant">participant</span><span class="keyword"> -> </span><a href="#Member"><span class="reference">Member</span></a> +</div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#Meeting__chair"><span class="reference">chair</span></a> not in <a href="#participant"><span class="reference">participant</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="onlineParticipant">onlineParticipant</span><span class="keyword"> -> </span><a href="#Member"><span class="reference">Member</span></a> *</div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#Meeting__chair"><span class="reference">chair</span></a> not in <a href="#onlineParticipant"><span class="reference">onlineParticipant</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="Meeting__room">room</span><span class="keyword"> -> </span><a href="#Room"><span class="reference">Room</span></a>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#capacity"><span class="reference">capacity</span></a> &gt;= # <a href="#participant"><span class="reference">participant</span></a> + 1 <span class="keyword">]</span></div>
  </div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <a href="#onlineParticipant"><span class="reference">onlineParticipant</span></a> =&gt; <a href="#Meeting__room"><span class="reference">room</span></a>.<a href="#Room__audioConferencing"><span class="reference">audioConferencing</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">enum</span> Month = <span class="claferDecl" id="June">June</span> | <span class="claferDecl" id="July">July</span></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Member">Member</span></div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Room">Room</span>
  <div class="indent">
