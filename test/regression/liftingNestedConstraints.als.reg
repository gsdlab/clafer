open util/integer
pred show {}


sig a
{ r_b : set b }
{ all  x : (this.@r_b).@r_c | one x.@r_d }

sig b
{ r_c : set c }
{ one @r_b.this
  one (this.@r_c).@r_d }

sig c
{ r_d : lone d }
{ one @r_c.this }

sig d
{}
{ one @r_d.this }

fact { all  x : (a.@r_b).@r_c | one x.@r_d }
assert assertAt_9_10 { all  x : (a.@r_b).@r_c | some x.@r_d }
check assertAt_9_10 for 1

