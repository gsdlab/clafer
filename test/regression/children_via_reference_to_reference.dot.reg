digraph "children_via_reference_to_reference"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"A" [label="abstract A" URL="#A" tooltip="abstract A&#10;  x ?&#10;"];
"a" [label="a : A 2" URL="#a" tooltip="a : A 2&#10;"];
"ref1" [label="ref1 -&gt; A" URL="#ref1" tooltip="ref1 -&gt; A&#10;"];
"ref1" -> "A" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"ref2" [label="ref2 -&gt; ref1" URL="#ref2" tooltip="ref2 -&gt; ref1&#10;  [ this.x ]&#10;"];
"ref2" -> "ref1" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}