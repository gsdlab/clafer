//# OPTIONS --explicit
[c0_AlicePicks . dref = (c0_BobPicks . dref ++ 3)]
[(3 ++ c0_BobPicks . dref) = c0_AlicePicks . dref]
[c0_friends . dref = (c0_others . dref ++ c0_p1)]
[c0_others . dref = c0_p2]
0..* c0_AlicePicks ->> int 0..* {}
0..* c0_BobPicks ->> int 0..* {}
abstract 0..* c0_Person 0..* {}
0..* c0_p1 : c0_Person 1..1 {}
0..* c0_p2 : c0_Person 1..1 {}
0..* c0_p3 : c0_Person 1..1 {}
0..* c0_friends -> c0_Person 0..* {}
0..* c0_others -> c0_Person 0..* {}
