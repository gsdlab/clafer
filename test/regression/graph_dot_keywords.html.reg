<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/graph_dot_keywords.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Node">Node</span>
  <div class="indent">
  <span class="keyword">abstract</span> <span class="claferDecl" id="Edge">Edge</span><span class="keyword"> -> </span><a href="#Node"><span class="reference">Node</span></a> ?</div>
</div>


<div>
<span class="claferDecl" id="N1">N1</span><span class="keyword"> : </span><a href="#Node"><span class="reference">Node</span></a>
  <div class="indent">
  <span class="claferDecl" id="E1">E1</span><span class="keyword"> : </span><a href="#Edge"><span class="reference">Edge</span></a><span class="keyword"> -> </span><a href="#N2"><span class="reference">N2</span></a></div>
</div>


<div>
<span class="claferDecl" id="N2">N2</span><span class="keyword"> : </span><a href="#Node"><span class="reference">Node</span></a></div>


<div>
<span class="claferDecl" id="graph">graph</span>
  <div class="indent">
  <span class="claferDecl" id="node">node</span><span class="keyword"> -> </span><a href="#N1"><span class="reference">N1</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="edge">edge</span><span class="keyword"> -> </span><a href="#N2"><span class="reference">N2</span></a> ?</div>
</div>


<div>
<span class="keyword">xor</span> <span class="claferDecl" id="digraph">digraph</span>
  <div class="indent">
  <span class="claferDecl" id="subgraph">subgraph</span><span class="keyword"> -> </span><a href="#Node"><span class="reference">Node</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="strict">strict</span></div>
</div>

</body>
</html>