defaultScope(1);
stringLength(16);

$A = Clafer("A").withCard(1, 1).withGroupCard(2, 3);
$b = $A.addChild("b").withCard(0, 1);
$c = $A.addChild("c").withCard(1, 1);
$d = $A.addChild("d").withCard(0, 1);
$E = Clafer("E").withCard(1, 1).withGroupCard(1, 1);
$f = $E.addChild("f").withCard(0, 1);
$g = $E.addChild("g").withCard(0, 1);
$D = Clafer("D").withCard(1, 1);
$Z = $D.addChild("Z").withCard(1, 1);
$K = $D.addChild("K").withCard(0, 1);
$L = Clafer("L").withCard(1, 1);
$M = $L.addChild("M").withCard(1, 1);
$N = $L.addChild("N").withCard(1, 1);
assert(or(some(join(global($E), $f)), some(join(global($E), $g))));
assert(not(and(some(join(global($E), $f)), some(join(global($E), $g)))));
assert(one(global($D)));
assert(one(join(global($D), $Z)));
