open util/integer
pred show {}


abstract sig c0_Thing
{}

fact { #c0_a <= 2 }
sig c0_a extends c0_Thing
{}

lone sig c0_b extends c0_Thing
{}

lone sig c0_c
{}

assert assertAt_10_10 { no none }
check assertAt_10_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_11_10 { (#none) = 0 }
check assertAt_11_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_14_10 { (c0_a + none) = c0_a }
check assertAt_14_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_15_10 { (none + c0_a) = c0_a }
check assertAt_15_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_16_10 { (#(c0_a + none)) = (#c0_a) }
check assertAt_16_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_19_10 { (c0_a & none) = none }
check assertAt_19_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_20_10 { (none & c0_a) = none }
check assertAt_20_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_21_10 { no c0_Thing & none }
check assertAt_21_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_24_10 { (c0_a - none) = c0_a }
check assertAt_24_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_25_10 { (none - c0_a) = none }
check assertAt_25_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_28_10 { none in c0_a }
check assertAt_28_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_29_10 { none in c0_Thing }
check assertAt_29_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_30_10 { (no c0_a) || (!(c0_a in none)) }
check assertAt_30_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_33_10 { (some c0_c) => (((some c0_c) => c0_a else none) = c0_a) }
check assertAt_33_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_34_10 { (no c0_c) => (no ((some c0_c) => c0_a else none)) }
check assertAt_34_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_35_10 { (no c0_c) => (((no c0_c) => none else c0_b) = none) }
check assertAt_35_10 for 1 but 3 c0_Thing, 2 c0_a

assert assertAt_36_10 { (#((some c0_c) => c0_a else none)) <= (#c0_a) }
check assertAt_36_10 for 1 but 3 c0_Thing, 2 c0_a

