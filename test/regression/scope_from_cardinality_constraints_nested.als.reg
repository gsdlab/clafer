open util/integer
pred show {}


abstract sig Animal
{ r_leg : set leg }

sig leg
{}
{ one @r_leg.this }

abstract sig Owner
{ r_Pet : one Pet }

sig Pet extends Animal
{}
{ one @r_Pet.this }

some sig SnakeOwner extends Owner
{}
{ no (this.@r_Pet).@r_leg }

some sig DogOwner extends Owner
{}
{ (#((this.@r_Pet).@r_leg)) = 4 }

