digraph "scopes"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"a" [label="a 0..0" URL="#a" tooltip="a 0..0&#10;"];
"b" [label="b ?" URL="#b" tooltip="b ?&#10;"];
"c" [label="c" URL="#c" tooltip="c&#10;"];
"d" [label="d *" URL="#d" tooltip="d *&#10;"];
"e" [label="e +" URL="#e" tooltip="e +&#10;"];
"f" [label="f 2..4" URL="#f" tooltip="f 2..4&#10;"];
"g" [label="g 3..*" URL="#g" tooltip="g 3..*&#10;"];
"gs" [label="gs -&gt; g 2" URL="#gs" tooltip="gs -&gt; g 2&#10;"];
"gs" -> "g" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"H" [label="abstract H" URL="#H" tooltip="abstract H&#10;  i ?&#10;  j *&#10;  k 2&#10;"];
"Hs" [label="Hs -&gt; H 3..*" URL="#Hs" tooltip="Hs -&gt; H 3..*&#10;"];
"Hs" -> "H" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"H1" [label="H1 : H 2" URL="#H1" tooltip="H1 : H 2&#10;  H12 : H 2&#10;"];
"H2" [label="H2 : H 4..4" URL="#H2" tooltip="H2 : H 4..4&#10;"];
"H3" [label="H3 : H 1..2" URL="#H3" tooltip="H3 : H 1..2&#10;"];
"H4" [label="H4 : H 5..*" URL="#H4" tooltip="H4 : H 5..*&#10;"];
"Hs2" [label="Hs2 -&gt; H 0..*" URL="#Hs2" tooltip="Hs2 -&gt; H 0..*&#10;"];
"Hs2" -> "H" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"Hs3" [label="Hs3 -&gt; H 5..8" URL="#Hs3" tooltip="Hs3 -&gt; H 5..8&#10;  l ?&#10;"];
"Hs3" -> "H" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"FF" [label="abstract FF : H" URL="#FF" tooltip="abstract FF : H&#10;"];
"f1" [label="f1 : FF 2..5" URL="#f1" tooltip="f1 : FF 2..5&#10;  m 0&#10;"];
}