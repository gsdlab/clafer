open util/integer
pred show {}


one sig root
{ var r_a : set a }
fact { all self_ : root | always (one self_.@r_a) }

assert assertAt_10_8 { all self_ : root | always (all  b1 : alive_a.@r_b | (some b1.@r_c) => (after ((some b1.@r_d) || (no b1 & (alive_a.@r_b))))) }
check assertAt_10_8 for 1 but 10 steps



sig a
{ p_a : lone root
, var r_b : set b }
fun alive_a : set a { root.@r_a }
fact { always ~@r_a in @p_a }

fact { all self_ : a | always (self_ in alive_a implies (one self_.@r_b)) }


sig b
{ p_b : lone a
, var r_c : set c
, var r_d : set d }
{ always (this in alive_b implies (let children = (this.@r_c + this.@r_d) | one children)) }
fun alive_b : set b { a.@r_b }
fact { always ~@r_b in @p_b
  always @r_b.univ in alive_a }

fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_c)) }
fact { all self_ : b | always (self_ in alive_b implies (lone self_.@r_d)) }


sig c
{ p_c : lone b }
fun alive_c : set c { b.@r_c }
fact { always ~@r_c in @p_c
  always @r_c.univ in alive_b }

fact { all self_ : c | always (self_ in alive_c implies ((some (self_ & alive_c)) => (after (not some self_.(@p_c :> alive_b) or (some (self_.(@p_c :> alive_b)).@r_d))))) }


sig d
{ p_d : lone b }
fun alive_d : set d { b.@r_d }
fact { always ~@r_d in @p_d
  always @r_d.univ in alive_b }


