//# OPTIONS --explicit
[((#c0_x) >= 1) => (c0_x . dref = ((1 ++ 2) ++ 3))]
[((#c0_people) >= 1) => (c0_people . dref = ((c0_p1 ++ c0_p1) ++ c0_p3))]
0..* c0_x -> int 0..* {}
abstract 0..* c0_Person 0..* {}
0..* c0_p1 : c0_Person 1..1 {}
0..* c0_p2 : c0_Person 1..1 {}
0..* c0_p3 : c0_Person 1..1 {}
0..* c0_people -> c0_Person 0..* {}
