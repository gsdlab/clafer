open util/integer
pred show {}


abstract sig Feature
{ r_productivity : one productivity
, r_cost : one cost
, r_batterylife : one batterylife
, r_security : one security }

sig productivity
{ productivity_ref : one Int }
{ one @r_productivity.this }

sig cost
{ cost_ref : one Int }
{ one @r_cost.this }

sig batterylife
{ batterylife_ref : one Int }
{ one @r_batterylife.this }

sig security
{ security_ref : one Int }
{ one @r_security.this }

abstract sig MobilePhone
{ r_Connectivity : one Connectivity
, r_Battery : one Battery
, r_total_productivity : one total_productivity
, r_total_batterylife : one total_batterylife
, r_total_security : one total_security
, r_total_cost : one total_cost }
{ (some this.@r_total_productivity) => (((this.@r_total_productivity).@total_productivity_ref) = (sum temp : (Feature.@r_productivity) | temp.@productivity_ref))
  (some this.@r_total_batterylife) => (((this.@r_total_batterylife).@total_batterylife_ref) = (sum temp : (Feature.@r_batterylife) | temp.@batterylife_ref))
  (some this.@r_total_security) => (((this.@r_total_security).@total_security_ref) = (sum temp : (Feature.@r_security) | temp.@security_ref))
  (some this.@r_total_cost) => (((this.@r_total_cost).@total_cost_ref) = (sum temp : (Feature.@r_cost) | temp.@cost_ref)) }

sig Connectivity extends Feature
{ r_Bluetooth : one Bluetooth
, r_GSM : one GSM
, r_LTE : lone LTE
, r_WiFi : lone WiFi
, r_USB : lone USB }
{ one @r_Connectivity.this
  ((this.@r_batterylife).@batterylife_ref) = (-1.mul[12])
  ((this.@r_productivity).@productivity_ref) = 14
  ((this.@r_security).@security_ref) = 43
  ((this.@r_cost).@cost_ref) = 101 }

sig Bluetooth
{ r_Bluetooth20EDR : lone Bluetooth20EDR
, r_Bluetooth21EDR : lone Bluetooth21EDR
, r_Bluetooth40 : lone Bluetooth40 }
{ one @r_Bluetooth.this
  let children = (r_Bluetooth20EDR + r_Bluetooth21EDR + r_Bluetooth40) | one children }

sig Bluetooth20EDR extends Feature
{}
{ one @r_Bluetooth20EDR.this
  ((this.@r_batterylife).@batterylife_ref) = (-1.mul[4])
  ((this.@r_productivity).@productivity_ref) = 1
  ((this.@r_security).@security_ref) = (-1.mul[15])
  ((this.@r_cost).@cost_ref) = 1 }

sig Bluetooth21EDR extends Feature
{}
{ one @r_Bluetooth21EDR.this
  ((this.@r_batterylife).@batterylife_ref) = (-1.mul[2])
  ((this.@r_productivity).@productivity_ref) = 4
  ((this.@r_security).@security_ref) = (-1.mul[10])
  ((this.@r_cost).@cost_ref) = 1 }

sig Bluetooth40 extends Feature
{}
{ one @r_Bluetooth40.this
  ((this.@r_batterylife).@batterylife_ref) = (-1.mul[1])
  ((this.@r_productivity).@productivity_ref) = 16
  ((this.@r_security).@security_ref) = (-1.mul[2])
  ((this.@r_cost).@cost_ref) = 2 }

sig GSM extends Feature
{}
{ one @r_GSM.this
  ((this.@r_batterylife).@batterylife_ref) = (-1.mul[2])
  ((this.@r_productivity).@productivity_ref) = 2
  ((this.@r_security).@security_ref) = (-1.mul[10])
  ((this.@r_cost).@cost_ref) = 1 }

sig LTE extends Feature
{}
{ one @r_LTE.this
  ((this.@r_batterylife).@batterylife_ref) = (-1.mul[1])
  ((this.@r_productivity).@productivity_ref) = 16
  ((this.@r_security).@security_ref) = (-1.mul[3])
  ((this.@r_cost).@cost_ref) = 3 }

sig WiFi extends Feature
{}
{ one @r_WiFi.this
  ((this.@r_batterylife).@batterylife_ref) = (-1.mul[10])
  ((this.@r_productivity).@productivity_ref) = 20
  ((this.@r_security).@security_ref) = (-1.mul[15])
  ((this.@r_cost).@cost_ref) = 20 }

sig USB extends Feature
{}
{ one @r_USB.this
  ((this.@r_batterylife).@batterylife_ref) = 10
  ((this.@r_productivity).@productivity_ref) = 20
  ((this.@r_security).@security_ref) = 0
  ((this.@r_cost).@cost_ref) = 3 }

sig Battery
{ r_LiBattery1150 : lone LiBattery1150
, r_LiBattery1400 : lone LiBattery1400 }
{ one @r_Battery.this
  let children = (r_LiBattery1150 + r_LiBattery1400) | one children }

sig LiBattery1150 extends Feature
{}
{ one @r_LiBattery1150.this
  ((this.@r_batterylife).@batterylife_ref) = 60
  ((this.@r_productivity).@productivity_ref) = 0
  ((this.@r_security).@security_ref) = 0
  ((this.@r_cost).@cost_ref) = 10 }

sig LiBattery1400 extends Feature
{}
{ one @r_LiBattery1400.this
  ((this.@r_batterylife).@batterylife_ref) = 70
  ((this.@r_productivity).@productivity_ref) = 0
  ((this.@r_security).@security_ref) = 0
  ((this.@r_cost).@cost_ref) = 15 }

sig total_productivity
{ total_productivity_ref : one Int }
{ one @r_total_productivity.this }

sig total_batterylife
{ total_batterylife_ref : one Int }
{ one @r_total_batterylife.this }

sig total_security
{ total_security_ref : one Int }
{ one @r_total_security.this }

sig total_cost
{ total_cost_ref : one Int }
{ one @r_total_cost.this }

one sig OptimalPhone extends MobilePhone
{}

