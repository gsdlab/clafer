//# OPTIONS --explicit
abstract 0..* c0_Thing 0..* {}
0..* c0_a : c0_Thing 0..2 {}
0..* c0_b : c0_Thing 0..1 {}
0..* c0_c 0..1 {
  0..* c0_d 0..1 {}
}

assert [(((c0_Thing ++ c0_c) ++ c0_c . c0_d) -- noclafer) = ((c0_Thing ++ c0_c) ++ c0_c . c0_d)]
assert [(((c0_Thing ++ c0_c) ++ c0_c . c0_d) ++ noclafer) = ((c0_Thing ++ c0_c) ++ c0_c . c0_d)]
assert [(((c0_Thing ++ c0_c) ++ c0_c . c0_d) ** noclafer) = noclafer]
assert [c0_a in ((c0_Thing ++ c0_c) ++ c0_c . c0_d)]
assert [c0_c . c0_d in ((c0_Thing ++ c0_c) ++ c0_c . c0_d)]
assert [(#((c0_Thing ++ c0_c) ++ c0_c . c0_d)) = (((#c0_Thing) + (#c0_c)) + (#c0_c . c0_d))]
assert [(#noclafer) = 0]
assert [(#noclafer) = 0]
assert [(c0_a ++ noclafer) = c0_a]
assert [(noclafer ++ c0_a) = c0_a]
assert [(#(c0_a ++ noclafer)) = (#c0_a)]
assert [(c0_a ** noclafer) = noclafer]
assert [(noclafer ** c0_a) = noclafer]
assert [(#(c0_Thing ** noclafer)) = 0]
assert [(c0_a -- noclafer) = c0_a]
assert [(noclafer -- c0_a) = noclafer]
assert [noclafer in c0_a]
assert [noclafer in c0_Thing]
assert [((#c0_a) = 0) || (!(c0_a in noclafer))]
assert [((#c0_c) >= 1) => ((if ((#c0_c) >= 1) then c0_a else noclafer) = c0_a)]
assert [((#c0_c) = 0) => ((#(if ((#c0_c) >= 1) then c0_a else noclafer)) = 0)]
assert [((#c0_c) = 0) => ((if ((#c0_c) = 0) then noclafer else c0_b) = noclafer)]
assert [(#(if ((#c0_c) >= 1) then c0_a else noclafer)) <= (#c0_a)]
assert [noclafer = noclafer]
assert [!(noclafer != noclafer)]
assert [(#noclafer) = 0]
assert [(#noclafer) = 0]
assert [noclafer = noclafer]
assert [(#noclafer) = 0]
