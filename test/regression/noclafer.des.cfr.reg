//# OPTIONS --explicit
abstract 0..* Thing 0..* {}
0..* a : Thing 0..2 {}
0..* b : Thing 0..1 {}
0..* c 0..1 {
  0..* d 0..1 {}
}

assert [(((Thing ++ c) ++ c.d) -- noclafer) = ((Thing ++ c) ++ c.d)]
assert [(((Thing ++ c) ++ c.d) ++ noclafer) = ((Thing ++ c) ++ c.d)]
assert [(((Thing ++ c) ++ c.d) ** noclafer) = noclafer]
assert [a in ((Thing ++ c) ++ c.d)]
assert [c.d in ((Thing ++ c) ++ c.d)]
assert [(#((Thing ++ c) ++ c.d)) = (((#Thing) + (#c)) + (#c.d))]
assert [(#noclafer) = 0]
assert [(#noclafer) = 0]
assert [(a ++ noclafer) = a]
assert [(noclafer ++ a) = a]
assert [(#(a ++ noclafer)) = (#a)]
assert [(a ** noclafer) = noclafer]
assert [(noclafer ** a) = noclafer]
assert [(#(Thing ** noclafer)) = 0]
assert [(a -- noclafer) = a]
assert [(noclafer -- a) = noclafer]
assert [noclafer in a]
assert [noclafer in Thing]
assert [((#a) = 0) || (!(a in noclafer))]
assert [((#c) >= 1) => ((if ((#c) >= 1) then a else noclafer) = a)]
assert [((#c) = 0) => ((#(if ((#c) >= 1) then a else noclafer)) = 0)]
assert [((#c) = 0) => ((if ((#c) = 0) then noclafer else b) = noclafer)]
assert [(#(if ((#c) >= 1) then a else noclafer)) <= (#a)]
assert [noclafer = noclafer]
assert [!(noclafer != noclafer)]
assert [(#noclafer) = 0]
assert [(#noclafer) = 0]
assert [noclafer = noclafer]
assert [(#noclafer) = 0]
