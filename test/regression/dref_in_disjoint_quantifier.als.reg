open util/integer
pred show {}


fact { all disj c1, c2 : Car | ((c1.@r_owner).@owner_ref) != ((c2.@r_owner).@owner_ref) }
fact { 4 <= #Car and #Car <= 4 }
sig Car
{ r_owner : one owner }

sig owner
{ owner_ref : one Person }
{ one @r_owner.this }

fact { 4 <= #Person and #Person <= 4 }
sig Person
{}

