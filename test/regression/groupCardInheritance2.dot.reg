digraph "groupCardInheritance2"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"A" [label="abstract A" URL="#A" tooltip="abstract A&#10;  a&#10;"];
"B" [label="abstract or B : A" URL="#B" tooltip="abstract or B : A&#10;  b&#10;"];
"C" [label="abstract C : B" URL="#C" tooltip="abstract C : B&#10;  c&#10;"];
"D" [label="abstract xor D : C" URL="#D" tooltip="abstract xor D : C&#10;  d&#10;"];
"E" [label="E : D" URL="#E" tooltip="E : D&#10;  e&#10;"];
}