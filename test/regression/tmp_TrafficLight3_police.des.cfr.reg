//# OPTIONS --explicit --tl=10
abstract 0..* event 0..* {}
0..1 events 1..1 {
  0..* e_on_off : event 0..1 {}
  0..* e_police : event 0..1 {}
  0..* e_after_5 : event 0..1 {}
  0..* e_after_7 : event 0..1 {}
  0..* e_after_0_5 : event 0..1 {}
}
abstract 1..1 TrafficLight_3 0..* {
  initial 1..1 on 0..1 {
    initial 1..1 normal 0..1 {
      initial 0..* green 0..1 {
        [(some this) --> (some this.parent.yellow)]
      }
      0..* yellow 0..1 {
        [(some this) --> (some this.parent.red)]
      }
      0..* red 0..1 {
        [(some this) --> (some this.parent.green)]
      }
      [(some this) -[(some events.e_police)]->> (some this.parent.flashing)]
    }
    1..1 flashing 0..1 {
      initial 0..* yellow_on 0..1 {
        [(some this) -[(some events.e_after_0_5)]->> (some this.parent.yellow_off)]
      }
      0..* yellow_off 0..1 {
        [(some this) -[(some events.e_after_0_5)]->> (some this.parent.yellow_on)]
      }
      [(some this) -[(some events.e_police)]->> (some this.parent.normal)]
    }
    [(some this) -[(some events.e_on_off)]->> (some this.parent.off)]
  }
  0..* off 0..1 {
    [(some this) --> (some this.parent.on)]
  }
}
1..1 tl : TrafficLight_3 1..1 {
  [initially ((some this.on.normal.green) && (some events.e_police))]
}

assert [((some tl.on.normal) && (some events.e_police)) => (F ((some tl.on.flashing) || (some tl.off)))]
assert [((some tl.on.flashing.yellow_on) && (some events.e_after_0_5)) => (F ((some tl.on.flashing.yellow_off) || (no tl.on.flashing)))]
