scope({$Author:2, $Person:2, $authors:2, $books:2, $dob:2, $name:2, $page:2});
defaultScope(1);
stringLength(16);

$Book = Abstract("Book");
$title = $Book.addChild("title").withCard(1, 1);
$subtitle = $title.addChild("subtitle").withCard(0, 1);
$year = $Book.addChild("year").withCard(1, 1);
$page = $Book.addChild("page").withCard(2);
$format = $Book.addChild("format").withCard(1, 1).withGroupCard(1, 1);
$paper = $format.addChild("paper").withCard(0, 1);
$hardcover = $paper.addChild("hardcover").withCard(0, 1);
$electronic = $format.addChild("electronic").withCard(0, 1);
$kind = $Book.addChild("kind").withCard(1, 1).withGroupCard(1, 1);
$textbook = $kind.addChild("textbook").withCard(0, 1);
$manual = $kind.addChild("manual").withCard(0, 1);
$reference = $kind.addChild("reference").withCard(0, 1);
$fiction = $kind.addChild("fiction").withCard(0, 1);
$nonfiction = $kind.addChild("nonfiction").withCard(0, 1);
$other = $kind.addChild("other").withCard(0, 1);
$authors = $Book.addChild("authors").withCard(1);
$ISBN = $Book.addChild("ISBN").withCard(0, 1);
$GS1 = $ISBN.addChild("GS1").withCard(0, 1);
$Person = Abstract("Person");
$name = $Person.addChild("name").withCard(1, 1);
$dob = $Person.addChild("dob").withCard(0, 1);
$Author = Abstract("Author");
$books = $Author.addChild("books").withCard(1);
$GenerativeProgramming = Clafer("GenerativeProgramming").withCard(1, 1);
$Czarnecki = Clafer("Czarnecki").withCard(1, 1);
$Eisenecker = Clafer("Eisenecker").withCard(1, 1);
$Author.extending($Person);
$GenerativeProgramming.extending($Book);
$Czarnecki.extending($Author);
$Eisenecker.extending($Author);
$title.refToUnique(string);
$subtitle.refToUnique(string);
$year.refToUnique(Int);
$other.refToUnique(string);
$authors.refToUnique($Author);
$ISBN.refToUnique(string);
$GS1.refToUnique(string);
$name.refToUnique(string);
$dob.refToUnique(string);
$books.refToUnique($Book);
$Book.addConstraint(implies(greaterThanEqual(joinRef(join($this(), $year)), constant(5)), some(join($this(), $ISBN))));
$ISBN.addConstraint(implies(greaterThanEqual(joinRef(join(joinParent($this()), $year)), constant(6)), some(join($this(), $GS1))));
$GenerativeProgramming.addConstraint(and(and(and(and(and(and(and(and(equal(joinRef(join($this(), $title)), constant("\"name\"")), none(join(join($this(), $title), $subtitle))), equal(joinRef(join($this(), $year)), constant(5))), equal(card(join($this(), $page)), constant(4))), some(join(join($this(), $format), $paper))), some(join(join($this(), $kind), $nonfiction))), equal(joinRef(join($this(), $authors)), union(global($Czarnecki), global($Eisenecker)))), equal(joinRef(join($this(), $ISBN)), constant("\"name\""))), none(join(join($this(), $ISBN), $GS1))));
$Czarnecki.addConstraint(and(equal(joinRef(join($this(), $name)), constant("\"name\"")), $in(global($GenerativeProgramming), joinRef(join($this(), $books)))));
$Eisenecker.addConstraint(and(equal(joinRef(join($this(), $name)), constant("\"name\"")), $in(global($GenerativeProgramming), joinRef(join($this(), $books)))));
