//# OPTIONS --explicit
[c0_CompilerGradStudent . c0_first . dref = c0_CompilerCourse]
[c0_AIGradStudent . c0_first . dref = c0_MachineLearningCourse]
[((#c0_numerOfAssistants) >= 1) => (c0_numerOfAssistants . dref = (#c0_Course . c0_assistants))]
abstract 0..* c0_Course 0..* {
  0..* c0_assistants -> c0_TA 0..* {}
}
abstract 0..* c0_TA 0..* {
  0..* c0_first -> c0_Course 0..1 {
    [this . parent in this . dref . c0_assistants . dref]
  }
}
0..* c0_CompilerGradStudent : c0_TA 1..1 {}
0..* c0_AIGradStudent : c0_TA 1..1 {}
0..* c0_CompilerCourse : c0_Course 1..1 {}
0..* c0_MachineLearningCourse : c0_Course 1..1 {}
0..* c0_numerOfAssistants -> int 1..1 {}
