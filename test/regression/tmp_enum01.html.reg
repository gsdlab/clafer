<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_enum01.cfr</div>

<div>
<span class="keyword">enum</span> UserRequest = <span class="claferDecl" id="c0_stop">stop</span> | <span class="claferDecl" id="c0_up">up</span> | <span class="claferDecl" id="c0_down">down</span></div>


<div>
<span class="claferDecl" id="c0_Elevator">Elevator</span>
  <div class="indent">
  <span class="claferDecl" id="c0_request">request</span><span class="keyword"> -> </span><a href="#c0_UserRequest"><span class="reference">UserRequest</span></a></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="tKeyword">initially </span><a href="#c0_request"><span class="reference">request</span></a> = <a href="#c0_stop"><span class="reference">stop</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="tKeyword">always </span><a href="#c0_request"><span class="reference">request</span></a> = <a href="#c0_up"><span class="reference">up</span></a> =&gt; X <a href="#c0_request"><span class="reference">request</span></a> = <a href="#c0_stop"><span class="reference">stop</span></a> <span class="keyword">]</span></div>
</div>

</body>
</html>