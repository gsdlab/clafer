digraph "escapes"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  spouse -&gt; Person ?&#10;"];
"Person" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="spouse"];
"Alice" [label="Alice : Person" URL="#Alice" tooltip="Alice : Person&#10;  [ spouse = Bob ]&#10;"];
"Bob" [label="Bob : Person" URL="#Bob" tooltip="Bob : Person&#10;"];
"Carol" [label="Carol : Person" URL="#Carol" tooltip="Carol : Person&#10;  [ no spouse ]&#10;"];
"Dave" [label="Dave : Person" URL="#Dave" tooltip="Dave : Person&#10;"];
}