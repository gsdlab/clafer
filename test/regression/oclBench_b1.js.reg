scope({$Person:5, $adaBobCyd:5, $alive:5, $civstat:5, $emptyPersonSet1:5, $emptyPersonSet2:5, $gender:5, $husband:5, $name:5, $personWithNoWife:5, $personWithUndefinedHusband1:5, $personWithUndefinedHusband2:5, $stringSet1:3, $stringSet2:4, $wife:5});
defaultScope(1);
stringLength(16);

$Person = Abstract("Person");
$name = $Person.addChild("name").withCard(1, 1);
$civstat = $Person.addChild("civstat").withCard(1, 1);
$gender = $Person.addChild("gender").withCard(1, 1);
$alive = $Person.addChild("alive").withCard(0, 1);
$husband = $Person.addChild("husband").withCard(0, 1);
$wife = $Person.addChild("wife").withCard(0, 1);
$ada = Clafer("ada").withCard(1, 1);
$cyd = Clafer("cyd").withCard(1, 1);
$eve = Clafer("eve").withCard(1, 1);
$bob = Clafer("bob").withCard(1, 1);
$dan = Clafer("dan").withCard(1, 1);
$adaBobCyd = Clafer("adaBobCyd");
$personWithUndefinedHusband1 = Clafer("personWithUndefinedHusband1");
$personWithUndefinedHusband2 = Clafer("personWithUndefinedHusband2");
$personWithNoWife = Clafer("personWithNoWife");
$emptyPersonSet1 = Clafer("emptyPersonSet1");
$emptyPersonSet2 = Clafer("emptyPersonSet2");
$personPair = Clafer("personPair");
$first = $personPair.addChild("first").withCard(1, 1);
$second = $personPair.addChild("second").withCard(1, 1);
$possiblePairs = Clafer("possiblePairs");
$stringSet1 = Clafer("stringSet1").withCard(3, 3);
$stringSet2 = Clafer("stringSet2").withCard(4, 4);
$ada.extending($Person);
$cyd.extending($Person);
$eve.extending($Person);
$bob.extending($Person);
$dan.extending($Person);
$name.refToUnique(string);
$civstat.refToUnique(string);
$gender.refToUnique(string);
$husband.refToUnique($Person);
$wife.refToUnique($Person);
$adaBobCyd.refToUnique($Person);
$personWithUndefinedHusband1.refToUnique($Person);
$personWithUndefinedHusband2.refToUnique($Person);
$personWithNoWife.refToUnique($Person);
$emptyPersonSet1.refToUnique($Person);
$emptyPersonSet2.refToUnique($Person);
$first.refToUnique($Person);
$second.refToUnique($Person);
$possiblePairs.refToUnique($personPair);
$stringSet1.refToUnique(string);
$stringSet2.refToUnique(string);
$husband.addConstraint($in(joinParent($this()), joinRef(join(joinRef($this()), $wife))));
$wife.addConstraint($in(joinParent($this()), joinRef(join(joinRef($this()), $husband))));
$Person.addConstraint(or(or(or(equal(joinRef(join($this(), $civstat)), constant("\"single\"")), equal(joinRef(join($this(), $civstat)), constant("\"married\""))), equal(joinRef(join($this(), $civstat)), constant("\"divorced\""))), equal(joinRef(join($this(), $civstat)), constant("\"widowed\""))));
$Person.addConstraint(or(equal(joinRef(join($this(), $gender)), constant("\"female\"")), equal(joinRef(join($this(), $gender)), constant("\"male\""))));
$Person.addConstraint(all([decl([$_p = local("p")], global($Person))], implies(notEqual($this(), $_p), notEqual(joinRef(join($this(), $name)), joinRef(join($_p, $name))))));
$Person.addConstraint(one([decl([$_p = local("p")], global($Person))], equal(joinRef(join($_p, $name)), joinRef(join($this(), $name)))));
$ada.addConstraint(and(and(and(and(and(equal(joinRef(join($this(), $name)), constant("\"Ada\"")), equal(joinRef(join($this(), $civstat)), constant("\"widowed\""))), equal(joinRef(join($this(), $gender)), constant("\"female\""))), some(join($this(), $alive))), none(join($this(), $husband))), none(join($this(), $wife))));
$cyd.addConstraint(and(and(and(and(and(equal(joinRef(join($this(), $name)), constant("\"Cyd\"")), equal(joinRef(join($this(), $civstat)), constant("\"married\""))), equal(joinRef(join($this(), $gender)), constant("\"male\""))), none(join($this(), $alive))), none(join($this(), $husband))), none(join($this(), $wife))));
$eve.addConstraint(and(and(and(and(and(equal(joinRef(join($this(), $name)), constant("\"Eve\"")), equal(joinRef(join($this(), $civstat)), constant("\"married\""))), equal(joinRef(join($this(), $gender)), constant("\"female\""))), some(join($this(), $alive))), equal(joinRef(join($this(), $husband)), global($dan))), none(join($this(), $wife))));
$bob.addConstraint(and(and(and(and(and(equal(joinRef(join($this(), $name)), constant("\"Bob\"")), equal(joinRef(join($this(), $civstat)), constant("\"divorced\""))), equal(joinRef(join($this(), $gender)), constant("\"male\""))), some(join($this(), $alive))), none(join($this(), $husband))), none(join($this(), $wife))));
$dan.addConstraint(and(and(and(and(and(equal(joinRef(join($this(), $name)), constant("\"Dan\"")), equal(joinRef(join($this(), $civstat)), constant("\"married\""))), equal(joinRef(join($this(), $gender)), constant("\"male\""))), some(join($this(), $alive))), none(join($this(), $husband))), equal(joinRef(join($this(), $wife)), global($eve))));
Constraint(equal(joinRef(join(joinRef(global($adaBobCyd)), $name)), joinRef(global($stringSet1))));
Constraint(equal(joinRef(join(joinRef(global($personWithUndefinedHusband1)), $name)), joinRef(global($stringSet2))));
Constraint(equal(joinRef(join(joinRef(global($personWithUndefinedHusband2)), $name)), joinRef(global($stringSet2))));
Constraint(and(equal(joinRef(join(joinRef(join(joinRef(global($possiblePairs)), $first)), $name)), constant("\"Ada\"")), equal(joinRef(join(joinRef(join(joinRef(global($possiblePairs)), $second)), $name)), constant("\"Bob\""))));
$adaBobCyd.addConstraint($in(joinRef(join(joinRef($this()), $name)), joinRef(global($stringSet1))));
Constraint(all([decl([$_p = local("p")], global($Person))], implies($in(joinRef(join($_p, $name)), joinRef(global($stringSet1))), $in($_p, joinRef(global($adaBobCyd))))));
$personWithUndefinedHusband1.addConstraint(equal(joinRef(join(joinRef($this()), $husband)), joinRef(global($emptyPersonSet1))));
Constraint(all([decl([$_p = local("p")], global($Person))], implies(equal(joinRef(join($_p, $husband)), joinRef(global($emptyPersonSet1))), $in($_p, joinRef(global($personWithUndefinedHusband1))))));
$personWithUndefinedHusband2.addConstraint(equal(joinRef(join(joinRef($this()), $husband)), joinRef(global($emptyPersonSet2))));
Constraint(all([decl([$_p = local("p")], global($Person))], implies(equal(joinRef(join($_p, $husband)), joinRef(global($emptyPersonSet2))), $in($_p, joinRef(global($personWithUndefinedHusband2))))));
$personWithNoWife.addConstraint(none(join(joinRef($this()), $wife)));
Constraint(all([decl([$_p = local("p")], global($Person))], implies(none(join($_p, $wife)), $in($_p, joinRef(global($personWithNoWife))))));
Constraint(equal(joinRef(global($emptyPersonSet1)), joinRef(join(joinRef(global($personWithNoWife)), $wife))));
$emptyPersonSet2.addConstraint(greaterThan(constant(1), constant(2)));
$possiblePairs.addConstraint(and(and(and(equal(joinRef(join(joinRef(join(joinRef($this()), $first)), $gender)), constant("\"female\"")), some(join(joinRef(join(joinRef($this()), $first)), $alive))), notEqual(joinRef(join(joinRef(join(joinRef($this()), $first)), $civstat)), constant("\"married\""))), and(and(equal(joinRef(join(joinRef(join(joinRef($this()), $second)), $gender)), constant("\"male\"")), some(join(joinRef(join(joinRef($this()), $second)), $alive))), notEqual(joinRef(join(joinRef(join(joinRef($this()), $second)), $civstat)), constant("\"married\"")))));
Constraint(all([decl([$_p = local("p"), $_q = local("q")], global($Person))], implies(and(and(and(and(and(equal(joinRef(join($_p, $gender)), constant("\"female\"")), some(join($_p, $alive))), notEqual(joinRef(join($_p, $civstat)), constant("\"married\""))), equal(joinRef(join($_q, $gender)), constant("\"male\""))), some(join($_q, $alive))), notEqual(joinRef(join($_q, $civstat)), constant("\"married\""))), one([decl([$_pair = local("pair")], global($personPair))], and(and(equal(joinRef(join($_pair, $first)), $_p), equal(joinRef(join($_pair, $second)), $_q)), $in($_pair, joinRef(global($possiblePairs))))))));
$stringSet1.addConstraint(or(or(equal(joinRef($this()), constant("\"Ada\"")), equal(joinRef($this()), constant("\"Bob\""))), equal(joinRef($this()), constant("\"Cyd\""))));
$stringSet2.addConstraint(or(or(or(equal(joinRef($this()), constant("\"Ada\"")), equal(joinRef($this()), constant("\"Bob\""))), equal(joinRef($this()), constant("\"Cyd\""))), equal(joinRef($this()), constant("\"Dan\""))));
