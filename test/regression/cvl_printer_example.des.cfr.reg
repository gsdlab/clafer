//# OPTIONS --explicit
0..* Office 1..1 {
  0..* Printer 0..1 {
    0..* resolution -> int 1..1 {}
    0..* Cartridge 1..4 {
      0..* inkVolume -> int 1..1 {}
      1..* Speed 1..1 {
        0..* High 0..1 {}
        0..* Low 0..1 {}
      }
      0..* Turbo 0..1 {}
    }
    1..1 Type 1..1 {
      0..* Color 0..1 {}
      0..* BW 0..1 {}
    }
  }
  0..* Scanner 0..1 {
    0..* GreenMode 0..1 {}
    0..* Head 1..2 {}
  }
}
0..* PrinterPool 1..1 {
  0..* fax 0..1 {}
  0..* printer 0..1 {}
  0..* copier 0..1 {}
  0..* scan 0..1 {}
  [(some this.fax) => (some this.printer)]
}
[((some PrinterPool.fax) => (some PrinterPool.printer)) && ((some PrinterPool.copier) => ((some PrinterPool.fax) && (some PrinterPool.printer)))]
