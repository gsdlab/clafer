open util/integer
pred show {}


abstract sig Service
{ r_machine : one machine }

sig machine
{ machine_ref : one Machine }
{ one @r_machine.this }

abstract sig Machine
{ r_services : set services }
{ all disj x, y : this.@r_services | (x.@services_ref) != (y.@services_ref)  }

sig services
{ services_ref : one Service }
{ one @r_services.this
  (((this.@services_ref).@r_machine).@machine_ref) = (this.~@r_services)
  (((this.@services_ref).@r_machine).@machine_ref) = (this.~@r_services) }

one sig m1 extends Machine
{}

one sig m2 extends Machine
{}

one sig s1 extends Service
{}

one sig s2 extends Service
{}

fact { (s1 in ((m1.@r_services).@services_ref)) && (s2 in ((m2.@r_services).@services_ref)) }
