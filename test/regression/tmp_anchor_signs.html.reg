<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/tmp_anchor_signs.cfr</div>

<div>
<span class="claferDecl" id="A">A</span> *
  <div class="indent">
  <span class="claferDecl" id="b">b</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="c">c</span> ?</div>
  <div class="indent">
  <span class="keyword">[</span> X X (<span class="tKeyword">initially </span><a href="#c"><span class="reference">c</span></a>) <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span>  ! (<span class="tKeyword">initially </span><a href="#b"><span class="reference">b</span></a>) <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> (<span class="tKeyword">initially </span><a href="#b"><span class="reference">b</span></a>) =&gt; (<span class="tKeyword">finally </span><a href="#c"><span class="reference">c</span></a>) <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> (<span class="tKeyword">initially </span><a href="#b"><span class="reference">b</span></a>) &lt;=&gt; (<span class="tKeyword">finally </span><a href="#c"><span class="reference">c</span></a>) <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> (<span class="tKeyword">initially </span><a href="#b"><span class="reference">b</span></a>) xor <a href="#c"><span class="reference">c</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">if </span><a href="#b"><span class="reference">b</span></a><span class="keyword"> then </span><span class="tKeyword">initially </span><a href="#c"><span class="reference">c</span></a><span class="keyword"> else </span><span class="tKeyword">finally </span><a href="#c"><span class="reference">c</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">no</span> x<span class="keyword"> : </span><a href="#b"><span class="reference">b</span></a> | <span class="tKeyword">initially </span><a href="#c"><span class="reference">c</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">lone</span> x<span class="keyword"> : </span><a href="#b"><span class="reference">b</span></a> |  ! (<span class="tKeyword">initially </span><a href="#c"><span class="reference">c</span></a>) <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="n">n</span><span class="keyword"> -> </span><a href="#int"><span class="reference">int</span></a></div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#n"><span class="reference">n</span></a> = (<span class="keyword">if </span><span class="tKeyword">initially </span><a href="#c"><span class="reference">c</span></a><span class="keyword"> then </span>1<span class="keyword"> else </span>2) <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span>  ! <a href="#n"><span class="reference">n</span></a> = (<span class="keyword">if </span><a href="#b"><span class="reference">b</span></a><span class="keyword"> then </span>1<span class="keyword"> else </span><span class="keyword">if </span><span class="tKeyword">finally </span><a href="#c"><span class="reference">c</span></a><span class="keyword"> then </span>2<span class="keyword"> else </span>3) <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="d">d</span> ?</div>


<div>
<span class="keyword">[</span>  ! (<span class="tKeyword">initially </span><a href="#d"><span class="reference">d</span></a>) <span class="keyword">]</span></div>

</body>
</html>