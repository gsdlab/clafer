digraph "tmp_TLSHandshakeProtocol_distributed"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Feature" [label="abstract final Feature" URL="#Feature" tooltip="abstract final Feature&#10;"];
"FeatureModel" [label="abstract final FeatureModel" URL="#FeatureModel" tooltip="abstract final FeatureModel&#10;"];
"TLSFeatures" [label="TLSFeatures : FeatureModel" URL="#TLSFeatures" tooltip="TLSFeatures : FeatureModel&#10;  annonymousMode : Feature ?&#10;  clientAuthentication : Feature ?&#10;  [ clientAuthentication => no annonymousMode ]&#10;"];
"Domain" [label="abstract final Domain" URL="#Domain" tooltip="abstract final Domain&#10;"];
"Port" [label="abstract Port" URL="#Port" tooltip="abstract Port&#10;"];
"Message" [label="abstract final Message" URL="#Message" tooltip="abstract final Message&#10;"];
"serverHelloRequestMessage" [label="serverHelloRequestMessage : Message" URL="#serverHelloRequestMessage" tooltip="serverHelloRequestMessage : Message&#10;"];
"serverHelloMessage" [label="serverHelloMessage : Message" URL="#serverHelloMessage" tooltip="serverHelloMessage : Message&#10;"];
"serverCertificateMessage" [label="serverCertificateMessage : Message" URL="#serverCertificateMessage" tooltip="serverCertificateMessage : Message&#10;"];
"serverKeyExchangeMessage" [label="serverKeyExchangeMessage : Message" URL="#serverKeyExchangeMessage" tooltip="serverKeyExchangeMessage : Message&#10;"];
"serverCertificateRequestMessage" [label="serverCertificateRequestMessage : Message" URL="#serverCertificateRequestMessage" tooltip="serverCertificateRequestMessage : Message&#10;"];
"serverHelloDoneMessage" [label="serverHelloDoneMessage : Message" URL="#serverHelloDoneMessage" tooltip="serverHelloDoneMessage : Message&#10;"];
"serverChangeCipherSpecMessage" [label="serverChangeCipherSpecMessage : Message" URL="#serverChangeCipherSpecMessage" tooltip="serverChangeCipherSpecMessage : Message&#10;"];
"serverFinishedMessage" [label="serverFinishedMessage : Message" URL="#serverFinishedMessage" tooltip="serverFinishedMessage : Message&#10;"];
"protocolMismatch" [label="protocolMismatch : Message" URL="#protocolMismatch" tooltip="protocolMismatch : Message&#10;"];
"clientHelloMessage" [label="clientHelloMessage : Message" URL="#clientHelloMessage" tooltip="clientHelloMessage : Message&#10;"];
"clientCertificateMessage" [label="clientCertificateMessage : Message" URL="#clientCertificateMessage" tooltip="clientCertificateMessage : Message&#10;"];
"clientKeyExchangeMessage" [label="clientKeyExchangeMessage : Message" URL="#clientKeyExchangeMessage" tooltip="clientKeyExchangeMessage : Message&#10;"];
"certificateVerifyMessage" [label="certificateVerifyMessage : Message" URL="#certificateVerifyMessage" tooltip="certificateVerifyMessage : Message&#10;"];
"clientChangeCipherSpecMessage" [label="clientChangeCipherSpecMessage : Message" URL="#clientChangeCipherSpecMessage" tooltip="clientChangeCipherSpecMessage : Message&#10;"];
"clientFinishedMessage" [label="clientFinishedMessage : Message" URL="#clientFinishedMessage" tooltip="clientFinishedMessage : Message&#10;"];
"applicationDataMessage" [label="applicationDataMessage : Message" URL="#applicationDataMessage" tooltip="applicationDataMessage : Message&#10;"];
"Node" [label="abstract final Node : Domain" URL="#Node" tooltip="abstract final Node : Domain&#10;  send : Port -&gt; Message&#10;  receive : Port -&gt; Message&#10;  protocolversion -&gt; ProtocolVersion +&#10;  certificate ?&#10;    signing ?&#10;"];
"Node" -> "Message" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="send"];
"Node" -> "Message" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="receive"];
"Node" -> "ProtocolVersion" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="protocolversion"];
"Server" [label="abstract final Server : Node" URL="#Server" tooltip="abstract final Server : Node&#10;"];
"Client" [label="abstract final Client : Node" URL="#Client" tooltip="abstract final Client : Node&#10;"];
"OurServer" [label="OurServer : Server" URL="#OurServer" tooltip="OurServer : Server&#10;  [ protocolversion = SSL2_0, SSL3_0, TLS1_2 ]&#10;"];
"aClient" [label="aClient : Client" URL="#aClient" tooltip="aClient : Client&#10;  [ certificate ]&#10;  [ protocolversion = TLS1_2 ]&#10;"];
"Protocol" [label="Protocol : Domain" URL="#Protocol" tooltip="Protocol : Domain&#10;  final client -&gt; aClient&#10;  final server -&gt; OurServer&#10;  handshakeStatus -&gt; HandshakeStatus&#10;  xor channel&#10;    initial clientHello --&gt; serverResponse || fatalError&#10;      [ handshakeStatus = initiated ]&#10;      [ client.send = clientHelloMessage ]&#10;    xor serverResponse&#10;      [ handshakeStatus = initiated ]&#10;      [ initially serverHello || mismatch ]&#10;      mismatch&#10;        [ no client.protocolversion**server.protocolversion ]&#10;        [ server.send = protocolMismatch ]&#10;      serverHello&#10;        [ some client.protocolversion**server.protocolversion ]&#10;        [ server.send = serverHelloMessage ]&#10;      [ serverHello -[no annonymousMode]-&gt; serverCertificate ]&#10;      [ serverHello -[annonymousMode]-&gt; serverKeyExchange ]&#10;      serverCertificate&#10;        [ no annonymousMode ]&#10;        [ server.send = serverCertificateMessage ]&#10;      [ serverCertificate -[clientAuthentication]-&gt; serverKeyExchange || certificateRequest ]&#10;      [ serverCertificate -[no clientAuthentication]-&gt; serverKeyExchange || serverHelloDone ]&#10;      serverKeyExchange&#10;        [ server.send = serverKeyExchangeMessage ]&#10;      [ serverKeyExchange -[clientAuthentication]-&gt; certificateRequest ]&#10;      [ serverKeyExchange -[no clientAuthentication]-&gt; serverHelloDone ]&#10;      certificateRequest --&gt; serverHelloDone&#10;        [ clientAuthentication ]&#10;        [ server.send = serverCertificateRequestMessage ]&#10;      serverHelloDone&#10;        [ server.send = serverHelloDoneMessage ]&#10;    [ serverResponse -[ ! (serverResponse.mismatch || serverResponse.serverHelloDone)]-&gt; serverResponse ]&#10;    [ serverResponse.mismatch --&gt; fatalError ]&#10;    [ serverResponse.serverHelloDone --&gt; clientResponse ]&#10;    xor clientResponse&#10;      [ handshakeStatus = initiated ]&#10;      [ initially clientAuthentication => clientCertificate ]&#10;      [ initially no clientAuthentication => clientKeyExchange ]&#10;      clientCertificate --&gt; clientKeyExchange&#10;        [ clientAuthentication ]&#10;        [ client.send = clientCertificateMessage ]&#10;      clientKeyExchange&#10;        [ client.send = clientKeyExchangeMessage ]&#10;      [ clientKeyExchange -[clientAuthentication &amp;&amp; some client.certificate.signing]-&gt; certificateVerify ]&#10;      [ clientKeyExchange -[ ! (clientAuthentication &amp;&amp; some client.certificate.signing)]-&gt; clientChangeCipherSpec ]&#10;      certificateVerify --&gt; clientChangeCipherSpec&#10;        [ client.certificate.signing ]&#10;        [ client.send = certificateVerifyMessage ]&#10;      clientChangeCipherSpec --&gt; clientFinished&#10;        [ client.send = clientChangeCipherSpecMessage ]&#10;      clientFinished&#10;        [ client.send = clientFinishedMessage ]&#10;    [ clientResponse -[no clientResponse.clientFinished]-&gt; clientResponse ]&#10;    [ clientResponse.clientFinished --&gt; serverFinish ]&#10;    xor serverFinish&#10;      initial serverChangeCipherSpec --&gt; serverFinished&#10;        [ handshakeStatus = initiated ]&#10;        [ server.send = serverChangeCipherSpecMessage ]&#10;      serverFinished&#10;        [ server.send = serverFinishedMessage ]&#10;        [ handshakeStatus = completed ]&#10;    [ serverFinish -[no serverFinish.serverFinished]-&gt; serverFinish ]&#10;    [ serverFinish.serverFinished --&gt; dataTransfer ]&#10;    dataTransfer --&gt;&gt; clientHello&#10;      [ handshakeStatus = completed ]&#10;      [ client.send = applicationDataMessage ]&#10;    fatalError --&gt; fatalError&#10;      [ handshakeStatus = failed ]&#10;"];
"Protocol" -> "aClient" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="client"];
"Protocol" -> "OurServer" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="server"];
"Protocol" -> "HandshakeStatus" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="handshakeStatus"];
}