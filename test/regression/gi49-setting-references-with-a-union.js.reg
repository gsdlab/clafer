scope({$x:3, $xs:3});
defaultScope(1);
stringLength(16);

$x = Abstract("x");
$A = Clafer("A").withCard(1, 1);
$B = Clafer("B").withCard(1, 1);
$C = Clafer("C").withCard(1, 1);
$xs = Clafer("xs");
$A.extending($x);
$B.extending($x);
$C.extending($x);
$x.refToUnique(Int);
$xs.refTo($x);
Constraint(implies(some(global($A)), equal(joinRef(global($A)), constant(1))));
Constraint(implies(some(global($B)), equal(joinRef(global($B)), constant(2))));
Constraint(implies(some(global($C)), equal(joinRef(global($C)), constant(3))));
Constraint(equal(joinRef(global($xs)), union(union(global($A), global($B)), global($C))));
Constraint(equal(joinRef(global($xs)), union(union(global($A), global($B)), global($C))));
Constraint(equal(joinRef(joinRef(global($xs))), union(union(joinRef(global($A)), joinRef(global($B))), joinRef(global($C)))));
