<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/cvl_printer_example.cfr</div>

<div>
<span class="claferDecl" id="Office">Office</span>
  <div class="indent">
  <span class="claferDecl" id="Printer">Printer</span> ?
    <div class="indent">
    <span class="claferDecl" id="resolution">resolution</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
    <div class="indent">
    <span class="claferDecl" id="Cartridge">Cartridge</span> 1..4
      <div class="indent">
      <span class="claferDecl" id="inkVolume">inkVolume</span><span class="keyword"> -> </span><a href="#integer"><span class="reference">integer</span></a></div>
      <div class="indent">
      <span class="keyword">or</span> <span class="claferDecl" id="Speed">Speed</span>
        <div class="indent">
        <span class="claferDecl" id="High">High</span></div>
        <div class="indent">
        <span class="claferDecl" id="Low">Low</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="Turbo">Turbo</span> ?</div>
    </div>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="Type">Type</span>
      <div class="indent">
      <span class="claferDecl" id="Color">Color</span></div>
      <div class="indent">
      <span class="claferDecl" id="BW">BW</span></div>
    </div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="Scanner">Scanner</span> ?
    <div class="indent">
    <span class="claferDecl" id="GreenMode">GreenMode</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="Head">Head</span> 1..2 </div>
  </div>
</div>


<div>
<span class="claferDecl" id="PrinterPool">PrinterPool</span>
  <div class="indent">
  <span class="claferDecl" id="fax">fax</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="printer">printer</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="copier">copier</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="scan">scan</span> ?</div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#fax"><span class="reference">fax</span></a> =&gt; <a href="#printer"><span class="reference">printer</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">[</span> (<a href="#fax"><span class="reference">fax</span></a> =&gt; <a href="#printer"><span class="reference">printer</span></a>) &amp;&amp; (<a href="#copier"><span class="reference">copier</span></a> =&gt; <a href="#fax"><span class="reference">fax</span></a> &amp;&amp; <a href="#printer"><span class="reference">printer</span></a>) <span class="keyword">]</span></div>

</body>
</html>