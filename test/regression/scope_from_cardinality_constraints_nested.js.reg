scope({$Animal:2, $Owner:2, $Pet:2, $leg:2});
defaultScope(1);
stringLength(16);

$Animal = Abstract("Animal");
$leg = $Animal.addChild("leg");
$Owner = Abstract("Owner");
$Pet = $Owner.addChild("Pet").withCard(1, 1);
$SnakeOwner = Clafer("SnakeOwner").withCard(1);
$DogOwner = Clafer("DogOwner").withCard(1);
$Pet.extending($Animal);
$SnakeOwner.extending($Owner);
$DogOwner.extending($Owner);
$SnakeOwner.addConstraint(none(join(join($this(), $Pet), $leg)));
$DogOwner.addConstraint(equal(card(join(join($this(), $Pet), $leg)), constant(4)));
