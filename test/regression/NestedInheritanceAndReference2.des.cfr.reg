//# OPTIONS --explicit
abstract 0..* c0_Component 0..* {
  abstract 1..* c0_Port 0..* {
    0..* c0_input 0..1 {}
    0..* c0_output 0..1 {}
  }
  abstract 1..* c0_TemperaturePort : c0_Port -> int 0..* {}
}
abstract 0..* c0_TemperatureConnector 0..* {
  [this . c0_to . dref . dref = this . c0_from . dref . dref]
  0..* c0_from -> c0_TemperaturePort 1..1 {
    [(#this . dref . c0_output) >= 1]
  }
  0..* c0_to -> c0_TemperaturePort 1..1 {
    [(#this . dref . c0_input) >= 1]
  }
}
0..* c0_sensor : c0_Component 1..1 {
  1..* c0_temperature : c0_TemperaturePort 1..1 {
    [(#this . c0_output) >= 1]
  }
}
0..* c0_controller : c0_Component 1..1 {
  1..* c1_temperature : c0_TemperaturePort 1..1 {
    [(#this . c0_input) >= 1]
  }
}
0..* c0_con1 : c0_TemperatureConnector 1..1 {
  [this . c0_from . dref = c0_sensor . c0_temperature]
  [this . c0_to . dref = c0_controller . c1_temperature]
}

assert [c0_controller . c1_temperature . dref = c0_sensor . c0_temperature . dref]
