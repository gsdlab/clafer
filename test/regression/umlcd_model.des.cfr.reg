//# OPTIONS --explicit
abstract 0..* Boolean 0..* {}
abstract 0..* Integer 0..* {}
abstract 0..* String 0..* {}
abstract 0..* UnlimitedNatural 0..* {}
abstract 0..* Sequence 0..* {}
abstract 0..* Set 0..* {}
abstract 0..* Element 0..* {
  [all x : this . ownedElement | this in x . dref . owner . dref]
  [all x : this . owner | this in x . dref . ownedElement . dref]
  0..* ownedElement -> Element 0..* {}
  0..* owner -> Element 0..1 {}
}
abstract 0..* NamedElement : Element 0..* {
  0..* name : String 0..1 {}
  0..* qualifiedName : String 0..1 {}
  0..* visibility -> VisibilityKind 0..1 {}
}
abstract 0..* ValueSpecification : NamedElement 0..* {}
abstract 0..* DirectedRelationship 0..* {
  0..* DirectedRelationship__relatedElement -> Element 1..* {}
  0..* source -> Element 1..* {}
  0..* target -> Element 1..* {}
}
abstract 0..* Class : Classifier 0..* {
  0..* isActive 0..1 {}
  0..* superClass -> Class 0..* {}
  0..* nestedClassifier : Classifier 0..* {}
}
abstract 0..* Property : StructuralFeature 0..* {
  [all x : this . owningAssociation | this in x . dref . ownedEnd]
  [all x : this . datatype | this in x . dref . ownedAttribute]
  [all x : this . association | this in x . dref . memberEnd . dref]
  [all x : this . associationEnd | this in x . dref . qualifier]
  0..* default : String 0..1 {}
  0..* isComposite 0..1 {}
  0..* Property__isDerived 0..1 {}
  0..* isDerivedUnion 0..1 {}
  0..* aggregation -> AggregationKind 0..1 {}
  0..* class -> Class 0..1 {}
  0..* opposite -> Property 0..1 {}
  0..* owningAssociation -> Association 0..1 {}
  0..* redefinedProperty -> Property 0..* {}
  0..* subsettedProperty -> Property 0..* {}
  0..* datatype -> DataType 0..1 {}
  0..* association -> Association 0..1 {}
  0..* defaultValue : ValueSpecification 0..1 {}
  0..* qualifier : Property 0..* {
    [this . parent in this . associationEnd . dref]
  }
  0..* associationEnd -> Property 0..1 {}
}
abstract 0..* Enumeration : DataType 0..* {
  0..* ownedLiteral : EnumerationLiteral 0..* {
    [this . parent in this . enumeration . dref]
  }
}
abstract 0..* DataType : Classifier 0..* {
  0..* ownedAttribute : Property 0..* {
    [this . parent in this . datatype . dref]
  }
}
abstract 0..* EnumerationLiteral : InstanceSpecification 0..* {
  [all x : this . enumeration | this in x . dref . ownedLiteral]
  0..* enumeration -> Enumeration 0..1 {}
}
abstract 0..* PrimitiveType : DataType 0..* {}
abstract 0..* Classifier : NamedElement 0..* {
  [all x : this . feature | this in x . dref . featuringClassifier . dref]
  [all x : this . powertypeExtent | this in x . dref . powertype . dref]
  0..* isAbstract 0..1 {}
  0..* feature -> Feature 0..* {}
  0..* inheritedMember -> NamedElement 0..* {}
  0..* Classifier__general -> Classifier 0..* {}
  0..* Classifier__generalization : Generalization 0..* {
    [this . parent in this . specific . dref]
  }
  0..* attribute -> Property 0..* {}
  0..* redefinedClassifier -> Classifier 0..* {}
  0..* powertypeExtent -> GeneralizationSet 0..* {}
}
abstract 0..* Feature : NamedElement 0..* {
  [all x : this . featuringClassifier | this in x . dref . feature . dref]
  0..* isStatic 0..1 {}
  0..* featuringClassifier -> Classifier 0..* {}
}
abstract 0..* VisibilityKind 0..* {}
0..* package : VisibilityKind 1..1 {}
0..* private : VisibilityKind 1..1 {}
0..* protected : VisibilityKind 1..1 {}
0..* public : VisibilityKind 1..1 {}
abstract 0..* LiteralBoolean : LiteralSpecification 0..* {
  0..* LiteralBoolean__value 0..1 {}
}
abstract 0..* LiteralSpecification : ValueSpecification 0..* {}
abstract 0..* LiteralString : LiteralSpecification 0..* {
  0..* LiteralString__value : String 0..1 {}
}
abstract 0..* LiteralNull : LiteralSpecification 0..* {}
abstract 0..* LiteralInteger : LiteralSpecification 0..* {
  0..* LiteralInteger__value -> Integer 0..1 {}
}
abstract 0..* LiteralUnlimitedNatural : LiteralSpecification 0..* {
  0..* LiteralUnlimitedNatural__value : UnlimitedNatural 0..1 {}
}
abstract 0..* StructuralFeature : Feature 0..* {
  0..* isReadOnly 0..1 {}
  0..* isOrdered 0..1 {}
  0..* isUnique 0..1 {}
  0..* lower -> Integer 0..1 {}
  0..* upper : UnlimitedNatural 0..1 {}
  0..* upperValue : ValueSpecification 0..1 {}
  0..* lowerValue : ValueSpecification 0..1 {}
}
abstract 0..* InstanceSpecification : NamedElement 0..* {
  0..* slot : Slot 0..* {
    [this . parent in this . owningInstance . dref]
  }
  0..* classifier -> Classifier 0..* {}
  0..* specification : ValueSpecification 0..1 {}
}
abstract 0..* Slot : Element 0..* {
  [all x : this . owningInstance | this in x . dref . slot]
  0..* owningInstance -> InstanceSpecification 1..1 {}
  0..* Slot__value : ValueSpecification 0..* {}
  0..* definingFeature -> StructuralFeature 1..1 {}
}
abstract 0..* InstanceValue : ValueSpecification 0..* {
  0..* instance -> InstanceSpecification 1..1 {}
}
abstract 0..* Generalization : DirectedRelationship 0..* {
  [all x : this . specific | this in x . dref . Classifier__generalization]
  [all x : this . generalizationSet | this in x . dref . GeneralizationSet__generalization . dref]
  0..* isSubstitutable 0..1 {}
  0..* specific -> Classifier 1..1 {}
  0..* Generalization__general -> Classifier 1..1 {}
  0..* generalizationSet -> GeneralizationSet 0..* {}
}
abstract 0..* Association : Classifier 0..* {
  [all x : this . memberEnd | this in x . dref . association . dref]
  [((#this . memberEnd) > 2) => (this . memberEnd . dref in this . ownedEnd)]
  0..* Association__relatedElement -> Element 1..* {}
  0..* Association__isDerived 0..1 {}
  0..* ownedEnd : Property 0..* {
    [this . parent in this . owningAssociation . dref]
  }
  0..* endType -> NamedElement 1..* {}
  0..* memberEnd -> Property 2..* {}
}
abstract 0..* ExtensionEnd : Property 0..* {}
abstract 0..* AggregationKind 0..* {}
0..* composite : AggregationKind 1..1 {}
0..* none : AggregationKind 1..1 {}
0..* shared : AggregationKind 1..1 {}
abstract 0..* GeneralizationSet : NamedElement 0..* {
  [all x : this . powertype | this in x . dref . powertypeExtent . dref]
  [all x : this . GeneralizationSet__generalization | this in x . dref . generalizationSet . dref]
  0..* isCovering 0..1 {}
  0..* isDisjoint 0..1 {}
  0..* powertype -> Classifier 0..1 {}
  0..* GeneralizationSet__generalization -> Generalization 0..* {}
}
