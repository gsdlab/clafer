defaultScope(1);
stringLength(16);

$person = Clafer("person").withCard(1, 1);
$haha = $person.addChild("haha").withCard(1, 1);
$lala = $haha.addChild("lala").withCard(1, 1);
$age = $lala.addChild("age").withCard(1, 1);
$ble = $person.addChild("ble").withCard(1, 1);
$married = $ble.addChild("married").withCard(0, 1);
$age.refToUnique(Int);
$married.addConstraint(greaterThanEqual(joinRef(join(join(join(joinParent(joinParent($this())), $haha), $lala), $age)), constant(18)));
