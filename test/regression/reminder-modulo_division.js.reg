defaultScope(1);
stringLength(16);

$a = Clafer("a").withCard(1, 1);
$b = Clafer("b").withCard(1, 1);
$c = Clafer("c").withCard(1, 1);
$a.refToUnique(Int);
Constraint(implies(some(global($a)), equal(joinRef(global($a)), mod(constant(6), constant(4)))));
assert(equal(joinRef(global($a)), constant(2)));
$b.refToUnique(Int);
Constraint(implies(some(global($b)), equal(joinRef(global($b)), mod(constant(0), constant(4)))));
assert(equal(joinRef(global($b)), constant(0)));
$c.refToUnique(Int);
Constraint(implies(some(global($c)), equal(joinRef(global($c)), mod(constant(4), constant(2)))));
assert(equal(joinRef(global($c)), constant(0)));
