scope({$Age:3, $Member:3, $Person:3});
defaultScope(1);
stringLength(16);

$Person = Abstract("Person");
$Age = $Person.addChild("Age").withCard(1, 1);
$Team = Clafer("Team").withCard(1, 1);
$Contractor = $Team.addChild("Contractor").withCard(1, 1);
$since = $Contractor.addChild("since").withCard(1, 1);
$Member = $Team.addChild("Member").withCard(2);
$Alice = Clafer("Alice").withCard(1, 1);
$Bob = Clafer("Bob").withCard(1, 1);
$Contractor.extending($Person);
$Alice.extending($Person);
$Bob.extending($Person);
$Age.refToUnique(Int);
$since.refToUnique(Int);
$Member.refToUnique($Person);
