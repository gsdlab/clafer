open util/integer
pred show {}


one sig AndroidPhone1
{ r_AndroidPhone1__Connectivity : one AndroidPhone1__Connectivity
, r_AndroidPhone1__Battery : one AndroidPhone1__Battery }

one sig AndroidPhone1__Connectivity
{ r_Connectivity__Bluetooth40 : one Connectivity__Bluetooth40
, r_AndroidPhone1__Connectivity__GSM : one AndroidPhone1__Connectivity__GSM
, r_AndroidPhone1__Connectivity__WiFi : one AndroidPhone1__Connectivity__WiFi
, r_AndroidPhone1__Connectivity__USB : one AndroidPhone1__Connectivity__USB }

one sig Connectivity__Bluetooth40
{}

one sig AndroidPhone1__Connectivity__GSM
{}

one sig AndroidPhone1__Connectivity__WiFi
{}

one sig AndroidPhone1__Connectivity__USB
{}

one sig AndroidPhone1__Battery
{ r_LiBattery1450 : one LiBattery1450 }

one sig LiBattery1450
{}

one sig AndroidPhone2
{ r_AndroidPhone2__Connectivity : one AndroidPhone2__Connectivity
, r_AndroidPhone2__Battery : one AndroidPhone2__Battery }

one sig AndroidPhone2__Connectivity
{ r_Connectivity__Bluetooth21 : one Connectivity__Bluetooth21
, r_AndroidPhone2__Connectivity__GSM : one AndroidPhone2__Connectivity__GSM
, r_AndroidPhone2__Connectivity__USB : one AndroidPhone2__Connectivity__USB }

one sig Connectivity__Bluetooth21
{}

one sig AndroidPhone2__Connectivity__GSM
{}

one sig AndroidPhone2__Connectivity__USB
{}

one sig AndroidPhone2__Battery
{ r_AndroidPhone2__Battery__LiBattery1150 : one AndroidPhone2__Battery__LiBattery1150 }

one sig AndroidPhone2__Battery__LiBattery1150
{}

abstract sig root__Bluetooth
{ r_Bluetooth20 : lone Bluetooth20
, r_Bluetooth__Bluetooth21 : lone Bluetooth__Bluetooth21
, r_Bluetooth__Bluetooth40 : lone Bluetooth__Bluetooth40 }

sig Bluetooth20
{}
{ one @r_Bluetooth20.this }

sig Bluetooth__Bluetooth21
{}
{ one @r_Bluetooth__Bluetooth21.this }

sig Bluetooth__Bluetooth40
{}
{ one @r_Bluetooth__Bluetooth40.this }

abstract sig MobilePhone
{ r_MobilePhone__Connectivity : one MobilePhone__Connectivity
, r_MobilePhone__Battery : one MobilePhone__Battery }

sig MobilePhone__Connectivity
{ r_Connectivity__Bluetooth : one Connectivity__Bluetooth
, r_MobilePhone__Connectivity__GSM : one MobilePhone__Connectivity__GSM
, r_LTE : lone LTE
, r_MobilePhone__Connectivity__WiFi : lone MobilePhone__Connectivity__WiFi
, r_MobilePhone__Connectivity__USB : lone MobilePhone__Connectivity__USB }
{ one @r_MobilePhone__Connectivity.this }

sig Connectivity__Bluetooth extends root__Bluetooth
{}
{ one @r_Connectivity__Bluetooth.this
  let children = (r_Bluetooth20 + r_Bluetooth__Bluetooth21 + r_Bluetooth__Bluetooth40) | one children }

sig MobilePhone__Connectivity__GSM
{}
{ one @r_MobilePhone__Connectivity__GSM.this }

sig LTE
{}
{ one @r_LTE.this
  some (((this.~@r_LTE).~@r_MobilePhone__Connectivity).@r_MobilePhone__Battery).@r_LiBattery1400 }

sig MobilePhone__Connectivity__WiFi
{}
{ one @r_MobilePhone__Connectivity__WiFi.this }

sig MobilePhone__Connectivity__USB
{}
{ one @r_MobilePhone__Connectivity__USB.this }

sig MobilePhone__Battery
{ r_MobilePhone__Battery__LiBattery1150 : lone MobilePhone__Battery__LiBattery1150
, r_LiBattery1400 : lone LiBattery1400 }
{ one @r_MobilePhone__Battery.this
  let children = (r_MobilePhone__Battery__LiBattery1150 + r_LiBattery1400) | one children }

sig MobilePhone__Battery__LiBattery1150
{}
{ one @r_MobilePhone__Battery__LiBattery1150.this }

sig LiBattery1400
{}
{ one @r_LiBattery1400.this }

one sig LowEndPhones extends MobilePhone
{}
{ no (this.@r_MobilePhone__Connectivity).@r_MobilePhone__Connectivity__WiFi }

one sig HighEndPhones extends MobilePhone
{ r_QuadCPU : lone QuadCPU }
{ (some (this.@r_MobilePhone__Connectivity).@r_MobilePhone__Connectivity__USB) && (some (this.@r_MobilePhone__Connectivity).@r_MobilePhone__Connectivity__WiFi) }

lone sig QuadCPU
{}
{ one r_QuadCPU }

