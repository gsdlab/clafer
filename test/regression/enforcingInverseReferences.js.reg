scope({$A:6, $Author:6, $B:5, $Book:5, $author:30, $book:30});
defaultScope(1);
stringLength(16);

$Book = Abstract("Book");
$author = $Book.addChild("author").withCard(1);
$Author = Abstract("Author");
$book = $Author.addChild("book").withCard(1);
$B = Clafer("B").withCard(5, 5);
$A = Clafer("A").withCard(6, 6);
$author.refToUnique($Author);
$author.addConstraint($in(joinParent($this()), joinRef(join(joinRef($this()), $book))));
$book.refToUnique($Book);
$book.addConstraint($in(joinParent($this()), joinRef(join(joinRef($this()), $author))));
$B.extending($Book);
$A.extending($Author);
