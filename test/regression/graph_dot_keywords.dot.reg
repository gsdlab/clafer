digraph "graph_dot_keywords"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Node" [label="abstract Node" URL="#Node" tooltip="abstract Node&#10;  abstract Edge -&gt; Node ?&#10;"];
"Edge" [label="abstract Edge -> Node ?" URL="#Edge" tooltip="abstract Edge -&gt; Node ?&#10;"];
"Edge" -> "Node" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="Edge"];
"N1" [label="N1 : Node" URL="#N1" tooltip="N1 : Node&#10;  E1 : Edge -&gt; N2&#10;"];
"N1" -> "N2" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="E1"];
"N2" [label="N2 : Node" URL="#N2" tooltip="N2 : Node&#10;"];
"graph" [label="graph" URL="#graph" tooltip="graph&#10;  node -&gt; N1&#10;  edge -&gt; N2 ?&#10;"];
"graph" -> "N1" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="node"];
"graph" -> "N2" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="edge"];
"digraph" [label="xor digraph" URL="#digraph" tooltip="xor digraph&#10;  subgraph -&gt; Node&#10;  strict&#10;"];
"digraph" -> "Node" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="subgraph"];
}