scope({$Feature:4, $cost:4, $weight:4});
defaultScope(1);
stringLength(16);
decimalScale(2);

$Feature = Abstract("Feature");
$cost = $Feature.addChild("cost").withCard(1, 1);
$weight = $Feature.addChild("weight").withCard(1, 1);
$Bike = Abstract("Bike");
$Light = $Bike.addChild("Light").withCard(0, 1);
$Rack = $Bike.addChild("Rack").withCard(0, 1);
$Bell = $Bike.addChild("Bell").withCard(0, 1);
$Frame = $Bike.addChild("Frame").withCard(1, 1);
$subtotal = $Bike.addChild("subtotal").withCard(1, 1);
$tax = $Bike.addChild("tax").withCard(1, 1);
$total = $Bike.addChild("total").withCard(1, 1);
$weightPerFeature = $Bike.addChild("weightPerFeature").withCard(1, 1);
$aBike = Clafer("aBike").withCard(1, 1);
$size = Clafer("size").withCard(1, 1);
$change = Clafer("change").withCard(1, 1);
$share = Clafer("share").withCard(1, 1);
$discount = Clafer("discount").withCard(1, 1);
$cost.refToUnique(Decimal);
$weight.refToUnique(Decimal);
$Light.extending($Feature);
$Light.addConstraint(equal(joinRef(join($this(), $cost)), decimal("19.99")));
$Light.addConstraint(equal(joinRef(join($this(), $weight)), decimal("0.25")));
$Rack.extending($Feature);
$Rack.addConstraint(equal(joinRef(join($this(), $cost)), decimal("34.50")));
$Rack.addConstraint(equal(joinRef(join($this(), $weight)), decimal("1.20")));
$Bell.extending($Feature);
$Bell.addConstraint(equal(joinRef(join($this(), $cost)), decimal("4.75")));
$Bell.addConstraint(equal(joinRef(join($this(), $weight)), decimal("0.05")));
$Frame.extending($Feature);
$Frame.addConstraint(equal(joinRef(join($this(), $cost)), constant(250)));
$Frame.addConstraint(equal(joinRef(join($this(), $weight)), decimal("9.80")));
$subtotal.refToUnique(Decimal);
$Bike.addConstraint(implies(some(join($this(), $subtotal)), equal(joinRef(join($this(), $subtotal)), sum(join(global($Feature), $cost)))));
$tax.refToUnique(Decimal);
$Bike.addConstraint(implies(some(join($this(), $tax)), equal(joinRef(join($this(), $tax)), mul(joinRef(join($this(), $subtotal)), decimal("0.13")))));
$total.refToUnique(Decimal);
$Bike.addConstraint(implies(some(join($this(), $total)), equal(joinRef(join($this(), $total)), add(joinRef(join($this(), $subtotal)), joinRef(join($this(), $tax))))));
$weightPerFeature.refToUnique(Decimal);
$Bike.addConstraint(implies(some(join($this(), $weightPerFeature)), equal(joinRef(join($this(), $weightPerFeature)), div(sum(join(global($Feature), $weight)), card(global($Feature))))));
$Bike.addConstraint(lessThanEqual(joinRef(join($this(), $total)), constant(340)));
$Bike.addConstraint(lessThan(joinRef(join($this(), $weightPerFeature)), constant(5)));
$aBike.extending($Bike);
$size.refToUnique(Decimal);
$size.addConstraint(or(equal(joinRef($this()), constant(1)), equal(joinRef($this()), decimal("2.50"))));
$size.addConstraint(notEqual(joinRef($this()), constant(1)));
$change.refToUnique(Decimal);
Constraint(implies(some(global($change)), equal(joinRef(global($change)), add(minus(joinRef(join(global($aBike), $total))), constant(400)))));
$share.refToUnique(Decimal);
Constraint(implies(some(global($share)), equal(joinRef(global($share)), div(constant(2), constant(3)))));
$discount.refToUnique(Decimal);
Constraint(implies(some(global($discount)), equal(joinRef(global($discount)), ifThenElse(greaterThan(joinRef(join(global($aBike), $total)), constant(300)), decimal("0.10"), constant(0)))));
max(joinRef(join(global($aBike), $total)));
