scope({c0_Feature:4, c0_cost:4, c0_weight:4});
defaultScope(1);
stringLength(16);
decimalScale(2);

c0_Feature = Abstract("c0_Feature");
c0_cost = c0_Feature.addChild("c0_cost").withCard(1, 1);
c0_weight = c0_Feature.addChild("c0_weight").withCard(1, 1);
c0_Bike = Abstract("c0_Bike");
c0_Light = c0_Bike.addChild("c0_Light").withCard(0, 1);
c0_Rack = c0_Bike.addChild("c0_Rack").withCard(0, 1);
c0_Bell = c0_Bike.addChild("c0_Bell").withCard(0, 1);
c0_Frame = c0_Bike.addChild("c0_Frame").withCard(1, 1);
c0_subtotal = c0_Bike.addChild("c0_subtotal").withCard(1, 1);
c0_tax = c0_Bike.addChild("c0_tax").withCard(1, 1);
c0_total = c0_Bike.addChild("c0_total").withCard(1, 1);
c0_weightPerFeature = c0_Bike.addChild("c0_weightPerFeature").withCard(1, 1);
c0_aBike = Clafer("c0_aBike").withCard(1, 1);
c0_size = Clafer("c0_size").withCard(1, 1);
c0_change = Clafer("c0_change").withCard(1, 1);
c0_share = Clafer("c0_share").withCard(1, 1);
c0_discount = Clafer("c0_discount").withCard(1, 1);
c0_cost.refToUnique(Decimal);
c0_weight.refToUnique(Decimal);
c0_Light.extending(c0_Feature);
c0_Light.addConstraint(equal(joinRef(join($this(), c0_cost)), decimal("19.99")));
c0_Light.addConstraint(equal(joinRef(join($this(), c0_weight)), decimal("0.25")));
c0_Rack.extending(c0_Feature);
c0_Rack.addConstraint(equal(joinRef(join($this(), c0_cost)), decimal("34.50")));
c0_Rack.addConstraint(equal(joinRef(join($this(), c0_weight)), decimal("1.20")));
c0_Bell.extending(c0_Feature);
c0_Bell.addConstraint(equal(joinRef(join($this(), c0_cost)), decimal("4.75")));
c0_Bell.addConstraint(equal(joinRef(join($this(), c0_weight)), decimal("0.05")));
c0_Frame.extending(c0_Feature);
c0_Frame.addConstraint(equal(joinRef(join($this(), c0_cost)), constant(250)));
c0_Frame.addConstraint(equal(joinRef(join($this(), c0_weight)), decimal("9.80")));
c0_subtotal.refToUnique(Decimal);
c0_Bike.addConstraint(implies(some(join($this(), c0_subtotal)), equal(joinRef(join($this(), c0_subtotal)), sum(join(global(c0_Feature), c0_cost)))));
c0_tax.refToUnique(Decimal);
c0_Bike.addConstraint(implies(some(join($this(), c0_tax)), equal(joinRef(join($this(), c0_tax)), mul(joinRef(join($this(), c0_subtotal)), decimal("0.13")))));
c0_total.refToUnique(Decimal);
c0_Bike.addConstraint(implies(some(join($this(), c0_total)), equal(joinRef(join($this(), c0_total)), add(joinRef(join($this(), c0_subtotal)), joinRef(join($this(), c0_tax))))));
c0_weightPerFeature.refToUnique(Decimal);
c0_Bike.addConstraint(implies(some(join($this(), c0_weightPerFeature)), equal(joinRef(join($this(), c0_weightPerFeature)), div(sum(join(global(c0_Feature), c0_weight)), card(global(c0_Feature))))));
c0_Bike.addConstraint(lessThanEqual(joinRef(join($this(), c0_total)), constant(340)));
c0_Bike.addConstraint(lessThan(joinRef(join($this(), c0_weightPerFeature)), constant(5)));
c0_aBike.extending(c0_Bike);
c0_size.refToUnique(Decimal);
c0_size.addConstraint(or(equal(joinRef($this()), constant(1)), equal(joinRef($this()), decimal("2.50"))));
c0_size.addConstraint(notEqual(joinRef($this()), constant(1)));
c0_change.refToUnique(Decimal);
Constraint(implies(some(global(c0_change)), equal(joinRef(global(c0_change)), add(minus(joinRef(join(global(c0_aBike), c0_total))), constant(400)))));
c0_share.refToUnique(Decimal);
Constraint(implies(some(global(c0_share)), equal(joinRef(global(c0_share)), div(constant(2), constant(3)))));
c0_discount.refToUnique(Decimal);
Constraint(implies(some(global(c0_discount)), equal(joinRef(global(c0_discount)), ifThenElse(greaterThan(joinRef(join(global(c0_aBike), c0_total)), constant(300)), decimal("0.10"), constant(0)))));
max(joinRef(join(global(c0_aBike), c0_total)));
