open util/integer
pred show {}


abstract sig Dimension
{ r_levels : set levels }
{ all disj x, y : this.@r_levels | (x.@levels_ref) != (y.@levels_ref) 
  all  dl : this.@r_levels | (((dl.@levels_ref).@r_belongsTo).@belongsTo_ref) = this }

sig levels
{ levels_ref : one DimensionLevel }
{ one @r_levels.this }

abstract sig DimensionLevel
{ r_belongsTo : one belongsTo }

sig belongsTo
{ belongsTo_ref : one Dimension }
{ one @r_belongsTo.this }

one sig dim1 extends Dimension
{}

one sig dim2 extends Dimension
{}

one sig dimLevel1 extends DimensionLevel
{}

one sig dimLevel2 extends DimensionLevel
{}

fact { some disj dl1, dl2 : DimensionLevel | ((dl1.@r_belongsTo).@belongsTo_ref) = ((dl2.@r_belongsTo).@belongsTo_ref) }
