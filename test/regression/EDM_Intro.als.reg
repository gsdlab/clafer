open util/integer
pred show {}


one sig midYearReview extends Meeting
{ r_month : one month
, r_midYearReview__chair : one midYearReview__chair
, r_midYearReview__room : one midYearReview__room }
{ (some this.@r_month) => (((this.@r_month).@month_ref) = June)
  (some this.@r_midYearReview__chair) => (((this.@r_midYearReview__chair).@midYearReview__chair_ref) = Steven)
  (some this.@r_midYearReview__room) => (((this.@r_midYearReview__room).@midYearReview__room_ref) = C)
  some this.@r_onlineParticipant }

one sig month
{ month_ref : one Month }

one sig midYearReview__chair
{ midYearReview__chair_ref : one Member }

one sig midYearReview__room
{ midYearReview__room_ref : one Room }

one sig Steven extends Member
{}

one sig C extends Room
{ r_C__whiteboard : one C__whiteboard
, r_C__audioConferencing : one C__audioConferencing }

one sig C__whiteboard
{}

one sig C__audioConferencing
{}

one sig ondemandMeeting extends Meeting
{ r_ondemandMeeting__chair : one ondemandMeeting__chair
, r_ondemandMeeting__room : one ondemandMeeting__room }
{ (some this.@r_ondemandMeeting__chair) => (((this.@r_ondemandMeeting__chair).@ondemandMeeting__chair_ref) = Joanna)
  no this.@r_onlineParticipant
  (some this.@r_ondemandMeeting__room) => (((this.@r_ondemandMeeting__room).@ondemandMeeting__room_ref) = D) }

one sig ondemandMeeting__chair
{ ondemandMeeting__chair_ref : one Member }

one sig ondemandMeeting__room
{ ondemandMeeting__room_ref : one Room }

one sig Joanna extends Member
{}

one sig D extends Room
{ r_D__whiteboard : one D__whiteboard }

one sig D__whiteboard
{}

abstract sig Meeting
{ r_Meeting__chair : one Meeting__chair
, r_participant : some participant
, r_onlineParticipant : set onlineParticipant
, r_Meeting__room : one Meeting__room }
{ all disj x, y : this.@r_participant | (x.@participant_ref) != (y.@participant_ref) 
  ((this.@r_Meeting__chair).@Meeting__chair_ref) not in ((this.@r_participant).@participant_ref)
  all disj x, y : this.@r_onlineParticipant | (x.@onlineParticipant_ref) != (y.@onlineParticipant_ref) 
  ((this.@r_Meeting__chair).@Meeting__chair_ref) not in ((this.@r_onlineParticipant).@onlineParticipant_ref)
  (some this.@r_onlineParticipant) => (some ((this.@r_Meeting__room).@Meeting__room_ref).@r_Room__audioConferencing) }

sig Meeting__chair
{ Meeting__chair_ref : one Member }
{ one @r_Meeting__chair.this }

sig participant
{ participant_ref : one Member }
{ one @r_participant.this }

sig onlineParticipant
{ onlineParticipant_ref : one Member }
{ one @r_onlineParticipant.this }

sig Meeting__room
{ Meeting__room_ref : one Room }
{ one @r_Meeting__room.this
  (((this.@Meeting__room_ref).@r_capacity).@capacity_ref) >= ((#((this.~@r_Meeting__room).@r_participant)).plus[1]) }

abstract sig Month
{}

one sig June extends Month
{}

one sig July extends Month
{}

abstract sig Member
{}

abstract sig Room
{ r_capacity : one capacity
, r_Room__whiteboard : one Room__whiteboard
, r_projector : lone projector
, r_computer : lone computer
, r_Room__audioConferencing : lone Room__audioConferencing }

sig capacity
{ capacity_ref : one Int }
{ one @r_capacity.this }

sig Room__whiteboard
{ r_traditional : lone traditional
, r_electronic : lone electronic }
{ one @r_Room__whiteboard.this
  let children = (r_traditional + r_electronic) | some children }

sig traditional
{}
{ one @r_traditional.this }

sig electronic
{}
{ one @r_electronic.this }

sig projector
{}
{ one @r_projector.this }

sig computer
{}
{ one @r_computer.this }

sig Room__audioConferencing
{}
{ one @r_Room__audioConferencing.this }

fact { 5 <= #M and #M <= 5 }
sig M extends Member
{}

one sig SueAgenda extends Agenda
{ r_m1 : lone m1
, r_m2 : lone m2 }
{ (some this.@r_m1) => (((this.@r_m1).@m1_ref) = M1)
  (some this.@r_m2) => (((this.@r_m2).@m2_ref) = M2) }

lone sig m1
{ m1_ref : one Meeting }
{ one r_m1 }

lone sig m2
{ m2_ref : one Meeting }
{ one r_m2 }

lone sig M1 extends Meeting
{}

lone sig M2 extends Meeting
{ r_time : one time }
{ (some this.@r_time) => (((this.@r_time).@time_ref) = 10) }

lone sig time
{ time_ref : one Int }
{ one r_time }

abstract sig Agenda
{ r_mt : set mt }
{ all disj x, y : this.@r_mt | (x.@mt_ref) != (y.@mt_ref)  }

sig mt
{ mt_ref : one Meeting }
{ one @r_mt.this }

