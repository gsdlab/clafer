open util/integer
pred show {}


one sig A
{ r_b : lone b
, r_c : one c
, r_d : lone d }
{ let children = (r_b + r_c + r_d) | 2 <= #children and #children <= 3 }

lone sig b
{}
{ one r_b }

one sig c
{}

lone sig d
{}
{ one r_d }

one sig E
{ r_f : lone f
, r_g : lone g }
{ let children = (r_f + r_g) | one children }

lone sig f
{}
{ one r_f }

lone sig g
{}
{ one r_g }

assert assertAt_13_10 { (some E.@r_f) || (some E.@r_g) }
check assertAt_13_10 for 1

assert assertAt_14_10 { !((some E.@r_f) && (some E.@r_g)) }
check assertAt_14_10 for 1

one sig D
{ r_Z : one Z
, r_K : lone K }

one sig Z
{}

lone sig K
{}
{ one r_K }

assert assertAt_21_10 { one D }
check assertAt_21_10 for 1

assert assertAt_22_10 { one D.@r_Z }
check assertAt_22_10 for 1

one sig L
{ r_M : one M
, r_N : one N }

one sig M
{}

one sig N
{}

