digraph "Scotiabank_Mortgages"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Currency" [label="abstract Currency -&gt;&gt; integer" URL="#Currency" tooltip="abstract Currency -&gt;&gt; integer&#10;"];
"Percentage" [label="abstract Percentage -&gt;&gt; integer" URL="#Percentage" tooltip="abstract Percentage -&gt;&gt; integer&#10;  [ this >= 0 &amp;&amp; this <= 100 ]&#10;"];
"Mortgage" [label="abstract Mortgage" URL="#Mortgage" tooltip="abstract Mortgage&#10;  valueProposition -&gt; string&#10;  term -&gt; MortgageTerm&#10;  xor kind&#10;    open&#10;    closed&#10;  principalMortgageAmount -&gt; Currency&#10;  [ 5000 <= principalMortgageAmount &amp;&amp; principalMortgageAmount <= 9999999 ]&#10;  balance -&gt; Currency&#10;  [ balance <= principalMortgageAmount ]&#10;  propertyValue -&gt; Currency&#10;  loanToValue -&gt; Percentage&#10;  amortization -&gt; integer&#10;  [ 1 <= amortization &amp;&amp; amortization <= 30 ]&#10;  xor interestRate&#10;    fixedForTheFullTerm&#10;    resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges&#10;  currentInterestRate -&gt; Percentage&#10;  currentPayment -&gt; Currency&#10;  xor paymentFrequency&#10;    weekly&#10;    biweekly&#10;    semiMonthly&#10;    monthly&#10;  xor financingAvailable&#10;    conventional&#10;    insured&#10;"];
"Mortgage" -> "MortgageTerm" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="term"];
"Mortgage" -> "Currency" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="principalMortgageAmount"];
"Mortgage" -> "Currency" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="balance"];
"Mortgage" -> "Currency" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="propertyValue"];
"Mortgage" -> "Percentage" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="loanToValue"];
"Mortgage" -> "Percentage" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="currentInterestRate"];
"Mortgage" -> "Currency" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="currentPayment"];
}