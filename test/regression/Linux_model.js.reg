defaultScope(1);
stringLength(40);

$tristate = Abstract("tristate");
$module = $tristate.addChild("module").withCard(0, 1);
$MISC_FILESYSTEMS = Clafer("MISC_FILESYSTEMS").withCard(0, 1);
$MISC_FILESYSTEMS__display = $MISC_FILESYSTEMS.addChild("MISC_FILESYSTEMS__display").withCard(1, 1);
$JFFS2_FS = $MISC_FILESYSTEMS.addChild("JFFS2_FS").withCard(0, 1);
$JFFS2_FS__display = $JFFS2_FS.addChild("JFFS2_FS__display").withCard(1, 1);
$FFS2_FS_DEBUG = $JFFS2_FS.addChild("FFS2_FS_DEBUG").withCard(1, 1);
$FFS2_FS_DEBUG__display = $FFS2_FS_DEBUG.addChild("FFS2_FS_DEBUG__display").withCard(1, 1);
$JFFS2_FS_WRITEBUFFER = $JFFS2_FS.addChild("JFFS2_FS_WRITEBUFFER").withCard(0, 1);
$JFFS2_COMPRESS = $JFFS2_FS.addChild("JFFS2_COMPRESS").withCard(0, 1);
$JFFS2_COMPRESS__display = $JFFS2_COMPRESS.addChild("JFFS2_COMPRESS__display").withCard(1, 1);
$JFFS2_ZLIB = $JFFS2_COMPRESS.addChild("JFFS2_ZLIB").withCard(0, 1);
$JFFS2_ZLIB__display = $JFFS2_ZLIB.addChild("JFFS2_ZLIB__display").withCard(1, 1);
$CompressionChoice = $JFFS2_COMPRESS.addChild("CompressionChoice").withCard(1, 1);
$CompressionChoice__display = $CompressionChoice.addChild("CompressionChoice__display").withCard(1, 1);
$choice = $CompressionChoice.addChild("choice").withCard(1, 1).withGroupCard(1, 1);
$JFFS2_CMODE_NONE = $choice.addChild("JFFS2_CMODE_NONE").withCard(0, 1);
$JFFS2_CMODE_NONE__display = $JFFS2_CMODE_NONE.addChild("JFFS2_CMODE_NONE__display").withCard(1, 1);
$JFFS2_CMODE_PRIORITY = $choice.addChild("JFFS2_CMODE_PRIORITY").withCard(0, 1);
$JFFS2_CMODE_PRIORITY__display = $JFFS2_CMODE_PRIORITY.addChild("JFFS2_CMODE_PRIORITY__display").withCard(1, 1);
$JFFS2_CMODE_SIZE = $choice.addChild("JFFS2_CMODE_SIZE").withCard(0, 1);
$JFFS2_CMODE_SIZE__display = $JFFS2_CMODE_SIZE.addChild("JFFS2_CMODE_SIZE__display").withCard(1, 1);
$MTD = Clafer("MTD").withCard(1, 1);
$CRC32 = Clafer("CRC32").withCard(1, 1);
$HAS_IOMEM = Clafer("HAS_IOMEM").withCard(1, 1);
$ZLIB_INFLATE = Clafer("ZLIB_INFLATE").withCard(1, 1);
$JFFS2_FS.extending($tristate);
$MISC_FILESYSTEMS__display.refToUnique(string);
$JFFS2_FS__display.refToUnique(string);
$FFS2_FS_DEBUG.refToUnique(Int);
$FFS2_FS_DEBUG__display.refToUnique(string);
$JFFS2_COMPRESS__display.refToUnique(string);
$JFFS2_ZLIB__display.refToUnique(string);
$CompressionChoice__display.refToUnique(string);
$JFFS2_CMODE_NONE__display.refToUnique(string);
$JFFS2_CMODE_PRIORITY__display.refToUnique(string);
$JFFS2_CMODE_SIZE__display.refToUnique(string);
$MISC_FILESYSTEMS.addConstraint(implies(some(join($this(), $MISC_FILESYSTEMS__display)), equal(joinRef(join($this(), $MISC_FILESYSTEMS__display)), constant("\"Miscellaneous filesystems\""))));
$JFFS2_FS.addConstraint(implies(some(join($this(), $JFFS2_FS__display)), equal(joinRef(join($this(), $JFFS2_FS__display)), constant("\"Journalling Flash File System\""))));
$JFFS2_FS.addConstraint(some(global($MTD)));
$JFFS2_FS.addConstraint(implies(some(global($MTD)), some(global($CRC32))));
$FFS2_FS_DEBUG.addConstraint(equal(joinRef($this()), constant(0)));
$FFS2_FS_DEBUG.addConstraint(implies(some(join($this(), $FFS2_FS_DEBUG__display)), equal(joinRef(join($this(), $FFS2_FS_DEBUG__display)), constant("\"JFFS2 Debug level (0=quiet, 2=noisy)\""))));
$FFS2_FS_DEBUG.addConstraint(and(lessThanEqual(constant(0), joinRef($this())), lessThanEqual(joinRef($this()), constant(2))));
$JFFS2_FS.addConstraint(ifOnlyIf(some(join($this(), $JFFS2_FS_WRITEBUFFER)), some(global($HAS_IOMEM))));
$JFFS2_COMPRESS.addConstraint(implies(some(join($this(), $JFFS2_COMPRESS__display)), equal(joinRef(join($this(), $JFFS2_COMPRESS__display)), constant("\"Advanced compression options for JFFS2\""))));
$JFFS2_COMPRESS.addConstraint(some(join($this(), $JFFS2_ZLIB)));
$JFFS2_ZLIB.addConstraint(implies(some(join($this(), $JFFS2_ZLIB__display)), equal(joinRef(join($this(), $JFFS2_ZLIB__display)), constant("\"Compress w/zlib...\""))));
$JFFS2_ZLIB.addConstraint(some(global($ZLIB_INFLATE)));
$CompressionChoice.addConstraint(implies(some(join($this(), $CompressionChoice__display)), equal(joinRef(join($this(), $CompressionChoice__display)), constant("\"Default compression\""))));
$CompressionChoice.addConstraint(some(join(join($this(), $choice), $JFFS2_CMODE_PRIORITY)));
$JFFS2_CMODE_NONE.addConstraint(implies(some(join($this(), $JFFS2_CMODE_NONE__display)), equal(joinRef(join($this(), $JFFS2_CMODE_NONE__display)), constant("\"no compression\""))));
$JFFS2_CMODE_PRIORITY.addConstraint(implies(some(join($this(), $JFFS2_CMODE_PRIORITY__display)), equal(joinRef(join($this(), $JFFS2_CMODE_PRIORITY__display)), constant("\"priority\""))));
$JFFS2_CMODE_SIZE.addConstraint(implies(some(join($this(), $JFFS2_CMODE_SIZE__display)), equal(joinRef(join($this(), $JFFS2_CMODE_SIZE__display)), constant("\"size (EXPERIMENTAL)\""))));
