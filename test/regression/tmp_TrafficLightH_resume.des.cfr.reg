//# OPTIONS --explicit --tl=10
abstract 1..1 TrafficLight_H 0..* {
  1..1 on 0..1 {
    1..1 normal 0..1 {
      initial 0..* green 0..1 {
        [(some this) --> (some this.parent.yellow)]
      }
      0..* yellow 0..1 {
        [(some this) --> (some this.parent.red)]
      }
      0..* red 0..1 {
        [(some this) --> (some this.parent.green)]
      }
    }
    1..1 flashing 0..1 {
      initial 0..* yellow_on 0..1 {
        [(some this) --> (some this.parent.yellow_off)]
      }
      0..* yellow_off 0..1 {
        [(some this) --> (some this.parent.yellow_on)]
      }
      [(some this) -->> (some this.parent.normal)]
    }
    [(some this) -->> (some this.parent.off)]
  }
  0..* off 0..1 {
    [(some this) --> (some this.parent.on)]
  }
  [((some this.on.normal) && (X (no this.on))) => (X ((no this.on) W (some this.on.normal)))]
  [((some this.on.flashing) && (X (no this.on))) => (X ((no this.on) W (some this.on.flashing)))]
}
1..1 tl : TrafficLight_H 1..1 {
  [initially (some this.on.normal.green)]
  [initially ((some this.on.normal.green) --> (some this.on.flashing.yellow_on) --> (some this.off) --> (some this.on.flashing.yellow_on))]
}
