scope({$Thing:3, $a:2});
defaultScope(1);
stringLength(16);

$Thing = Abstract("Thing");
$a = Clafer("a").withCard(0, 2);
$b = Clafer("b").withCard(0, 1);
$c = Clafer("c").withCard(0, 1);
$d = $c.addChild("d").withCard(0, 1);
$a.extending($Thing);
$b.extending($Thing);
assert(equal(diff(union(union(global($Thing), global($c)), join(global($c), $d)), constant($Thing)), union(union(global($Thing), global($c)), join(global($c), $d))));
assert(equal(union(union(union(global($Thing), global($c)), join(global($c), $d)), constant($Thing)), union(union(global($Thing), global($c)), join(global($c), $d))));
assert(equal(inter(union(union(global($Thing), global($c)), join(global($c), $d)), constant($Thing)), constant($Thing)));
assert($in(global($a), union(union(global($Thing), global($c)), join(global($c), $d))));
assert($in(join(global($c), $d), union(union(global($Thing), global($c)), join(global($c), $d))));
assert(equal(card(union(union(global($Thing), global($c)), join(global($c), $d))), add(add(card(global($Thing)), card(global($c))), card(join(global($c), $d)))));
assert(none(constant($Thing)));
assert(equal(card(constant($Thing)), constant(0)));
assert(equal(union(global($a), constant($a)), global($a)));
assert(equal(union(constant($a), global($a)), global($a)));
assert(equal(card(union(global($a), constant($a))), card(global($a))));
assert(equal(inter(global($a), constant($a)), constant($a)));
assert(equal(inter(constant($a), global($a)), constant($a)));
assert(none(inter(global($Thing), constant($Thing))));
assert(equal(diff(global($a), constant($a)), global($a)));
assert(equal(diff(constant($a), global($a)), constant($a)));
assert($in(constant($a), global($a)));
assert($in(constant($Thing), global($Thing)));
assert(or(none(global($a)), not($in(global($a), constant($a)))));
assert(implies(some(global($c)), equal(ifThenElse(some(global($c)), global($a), constant($a)), global($a))));
assert(implies(none(global($c)), none(ifThenElse(some(global($c)), global($a), constant($a)))));
assert(implies(none(global($c)), equal(ifThenElse(none(global($c)), constant($b), global($b)), constant($b))));
assert(lessThanEqual(card(ifThenElse(some(global($c)), global($a), constant($a))), card(global($a))));
assert(equal(constant($Thing), constant($Thing)));
assert(not(notEqual(constant($Thing), constant($Thing))));
assert(none(constant($Thing)));
assert(none(constant($Thing)));
assert(equal(constant($Thing), constant($Thing)));
assert(equal(card(constant($Thing)), constant(0)));
