scope({c0_Thing:3, c0_a:2});
defaultScope(1);
stringLength(16);

c0_Thing = Abstract("c0_Thing");
c0_a = Clafer("c0_a").withCard(0, 2);
c0_b = Clafer("c0_b").withCard(0, 1);
c0_c = Clafer("c0_c").withCard(0, 1);
c0_d = c0_c.addChild("c0_d").withCard(0, 1);
c0_a.extending(c0_Thing);
c0_b.extending(c0_Thing);
assert(equal(diff(union(union(global(c0_Thing), global(c0_c)), join(global(c0_c), c0_d)), constant(c0_Thing)), union(union(global(c0_Thing), global(c0_c)), join(global(c0_c), c0_d))));
assert(equal(union(union(union(global(c0_Thing), global(c0_c)), join(global(c0_c), c0_d)), constant(c0_Thing)), union(union(global(c0_Thing), global(c0_c)), join(global(c0_c), c0_d))));
assert(equal(inter(union(union(global(c0_Thing), global(c0_c)), join(global(c0_c), c0_d)), constant(c0_Thing)), constant(c0_Thing)));
assert($in(global(c0_a), union(union(global(c0_Thing), global(c0_c)), join(global(c0_c), c0_d))));
assert($in(join(global(c0_c), c0_d), union(union(global(c0_Thing), global(c0_c)), join(global(c0_c), c0_d))));
assert(equal(card(union(union(global(c0_Thing), global(c0_c)), join(global(c0_c), c0_d))), add(add(card(global(c0_Thing)), card(global(c0_c))), card(join(global(c0_c), c0_d)))));
assert(none(constant(c0_Thing)));
assert(equal(card(constant(c0_Thing)), constant(0)));
assert(equal(union(global(c0_a), constant(c0_a)), global(c0_a)));
assert(equal(union(constant(c0_a), global(c0_a)), global(c0_a)));
assert(equal(card(union(global(c0_a), constant(c0_a))), card(global(c0_a))));
assert(equal(inter(global(c0_a), constant(c0_a)), constant(c0_a)));
assert(equal(inter(constant(c0_a), global(c0_a)), constant(c0_a)));
assert(none(inter(global(c0_Thing), constant(c0_Thing))));
assert(equal(diff(global(c0_a), constant(c0_a)), global(c0_a)));
assert(equal(diff(constant(c0_a), global(c0_a)), constant(c0_a)));
assert($in(constant(c0_a), global(c0_a)));
assert($in(constant(c0_Thing), global(c0_Thing)));
assert(or(none(global(c0_a)), not($in(global(c0_a), constant(c0_a)))));
assert(implies(some(global(c0_c)), equal(ifThenElse(some(global(c0_c)), global(c0_a), constant(c0_a)), global(c0_a))));
assert(implies(none(global(c0_c)), none(ifThenElse(some(global(c0_c)), global(c0_a), constant(c0_a)))));
assert(implies(none(global(c0_c)), equal(ifThenElse(none(global(c0_c)), constant(c0_b), global(c0_b)), constant(c0_b))));
assert(lessThanEqual(card(ifThenElse(some(global(c0_c)), global(c0_a), constant(c0_a))), card(global(c0_a))));
assert(equal(constant(c0_Thing), constant(c0_Thing)));
assert(not(notEqual(constant(c0_Thing), constant(c0_Thing))));
assert(none(constant(c0_Thing)));
assert(none(constant(c0_Thing)));
assert(equal(constant(c0_Thing), constant(c0_Thing)));
assert(equal(card(constant(c0_Thing)), constant(0)));
