scope({$Component:2, $Port:2, $TemperaturePort:2, $input:2, $output:2});
defaultScope(1);
stringLength(16);

$Component = Abstract("Component");
$Port = $Component.addAbstractChild("Port").withGroupCard(1);
$input = $Port.addChild("input").withCard(0, 1);
$output = $Port.addChild("output").withCard(0, 1);
$TemperaturePort = $Component.addAbstractChild("TemperaturePort").withGroupCard(1);
$TemperatureConnector = Abstract("TemperatureConnector");
$from = $TemperatureConnector.addChild("from").withCard(1, 1);
$to = $TemperatureConnector.addChild("to").withCard(1, 1);
$sensor = Clafer("sensor").withCard(1, 1);
$sensor__temperature = $sensor.addChild("sensor__temperature").withCard(1, 1).withGroupCard(1);
$controller = Clafer("controller").withCard(1, 1);
$controller__temperature = $controller.addChild("controller__temperature").withCard(1, 1).withGroupCard(1);
$con1 = Clafer("con1").withCard(1, 1);
$TemperaturePort.extending($Port);
$sensor.extending($Component);
$sensor__temperature.extending($TemperaturePort);
$controller.extending($Component);
$controller__temperature.extending($TemperaturePort);
$con1.extending($TemperatureConnector);
$from.refToUnique($TemperaturePort);
$to.refToUnique($TemperaturePort);
$TemperaturePort.refToUnique(Int);
$from.addConstraint(some(join(joinRef($this()), $output)));
$to.addConstraint(some(join(joinRef($this()), $input)));
$TemperatureConnector.addConstraint(equal(joinRef(joinRef(join($this(), $to))), joinRef(joinRef(join($this(), $from)))));
$sensor__temperature.addConstraint(some(join($this(), $output)));
$controller__temperature.addConstraint(some(join($this(), $input)));
$con1.addConstraint(equal(joinRef(join($this(), $from)), join(global($sensor), $sensor__temperature)));
$con1.addConstraint(equal(joinRef(join($this(), $to)), join(global($controller), $controller__temperature)));
assert(equal(joinRef(join(global($controller), $controller__temperature)), joinRef(join(global($sensor), $sensor__temperature))));
