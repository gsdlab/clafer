open util/integer
pred show {}


abstract sig FunctionalArchitecture
{}

abstract sig Deployment
{ r_Deployment__fa : set Deployment__fa }
{ all disj x, y : this.@r_Deployment__fa | (x.@Deployment__fa_ref) != (y.@Deployment__fa_ref)  }

abstract sig Deployment__fa
{ Deployment__fa_ref : one FunctionalArchitecture }
{ one @r_Deployment__fa.this }

abstract sig PowerWindowFAA extends FunctionalArchitecture
{}

abstract sig PowerWindowDpl extends Deployment
{ r_PowerWindowDpl__fa : set PowerWindowDpl__fa }
{ r_PowerWindowDpl__fa in r_Deployment__fa
  all disj x, y : this.@r_PowerWindowDpl__fa | (x.@PowerWindowDpl__fa_ref) != (y.@PowerWindowDpl__fa_ref)  }

abstract sig PowerWindowDpl__fa extends Deployment__fa
{ PowerWindowDpl__fa_ref : one PowerWindowFAA }
{ one @r_PowerWindowDpl__fa.this
  PowerWindowDpl__fa_ref in Deployment__fa_ref }

one sig System
{ r_DriverPowerWindowFAA : one DriverPowerWindowFAA
, r_DriverPowerWindowDpl : one DriverPowerWindowDpl }

one sig DriverPowerWindowFAA extends PowerWindowFAA
{}

one sig DriverPowerWindowDpl extends PowerWindowDpl
{ r_DriverPowerWindowDpl__fa : one DriverPowerWindowDpl__fa }
{ r_DriverPowerWindowDpl__fa in r_PowerWindowDpl__fa }

one sig DriverPowerWindowDpl__fa extends PowerWindowDpl__fa
{ DriverPowerWindowDpl__fa_ref : one DriverPowerWindowFAA }
{ DriverPowerWindowDpl__fa_ref in PowerWindowDpl__fa_ref }

