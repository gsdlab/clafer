defaultScope(1);
stringLength(16);

$claferA = Clafer("claferA").withCard(1, 1);
$claferB = $claferA.addChild("claferB").withCard(1, 1);
$claferC = $claferB.addChild("claferC").withCard(1, 1);
$Person = Clafer("Person").withCard(1, 1);
$maritalStatus = $Person.addChild("maritalStatus").withCard(1, 1);
$married = $maritalStatus.addChild("married").withCard(1, 1);
$claferB.addConstraint(some(joinParent($this())));
$claferC.addConstraint(some(joinParent($this())));
$claferC.addConstraint(some(join(joinParent($this()), $claferC)));
$married.addConstraint(some(joinParent(joinParent($this()))));
