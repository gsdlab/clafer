digraph "tmp_initializerClocks"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Val" [label="abstract Val -&gt;&gt; integer 0..3  := each 1" URL="#Val" tooltip="abstract Val -&gt;&gt; integer 0..3  := each 1&#10;"];
"Wal" [label="abstract Wal -&gt;&gt; integer 0..3  := together 1" URL="#Wal" tooltip="abstract Wal -&gt;&gt; integer 0..3  := together 1&#10;"];
"Vi" [label="Vi : Val *" URL="#Vi" tooltip="Vi : Val *&#10;"];
"Wi" [label="Wi : Wal *" URL="#Wi" tooltip="Wi : Wal *&#10;"];
"A" [label="A" URL="#A" tooltip="A&#10;  xs -&gt;&gt; integer 0..2  := each 2&#10;  ys -&gt;&gt; integer 0..2  := together 3&#10;  [ F # this.xs = 2 ]&#10;"];
}