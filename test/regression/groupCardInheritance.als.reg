open util/integer
pred show {}


abstract sig Port
{ r_input : lone input
, r_output : lone output }

sig input
{}
{ one @r_input.this }

sig output
{}
{ one @r_output.this }

abstract sig RelayPort extends Port
{ r_relay : lone relay }

sig relay
{}
{ one @r_relay.this }

one sig req extends RelayPort
{ r_flow : lone flow }
{ let children = (r_flow + r_relay + r_input + r_output) | one children
  some this.@r_flow }

lone sig flow
{}
{ one r_flow }

assert assertAt_16_10 { no req.@r_input }
check assertAt_16_10 for 1

assert assertAt_17_10 { no req.@r_output }
check assertAt_17_10 for 1

assert assertAt_18_10 { no req.@r_relay }
check assertAt_18_10 for 1

assert assertAt_19_10 { one req.@r_flow }
check assertAt_19_10 for 1

