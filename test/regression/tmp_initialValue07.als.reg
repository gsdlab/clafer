open util/integer
pred show {}


one sig root
{ var r_Box : set Box }
fact { always (lone root.@r_Box) }
fact { always ((not before some root) implies ((some alive_Box) && (after (no alive_Box)))) }

assert assertAt_12_10 { always ((not before some root) implies (((alive_Box.@r_x).@x_ref) = 2)) }
check assertAt_12_10 for 1 but 10 steps



sig Box
{ p_Box : lone root
, var r_flag : set flag
, var r_x : set x }
fun alive_Box : set Box { root.@r_Box }
fact { always ~@r_Box in @p_Box }

fact { all self_ : Box | always (self_ in alive_Box implies (lone self_.@r_flag)) }
fact { all self_ : Box | always (self_ in alive_Box implies (one self_.@r_x)) }


sig flag
{ p_flag : lone Box }
fun alive_flag : set flag { Box.@r_flag }
fact { always ~@r_flag in @p_flag
  always @r_flag.univ in alive_Box }


sig x
{ p_x : lone Box
, var x_ref : set Int }
{ always (this in alive_x implies (one this.@x_ref))
  always (this not in alive_x implies no this.@x_ref) }
fun alive_x : set x { Box.@r_x }
fact { always ~@r_x in @p_x
  always @r_x.univ in alive_Box }

fact { all self_ : x | always (self_ in alive_x implies ((not before self_ in alive_x) implies ((self_.@x_ref) = ((after (some (self_.(@p_x)).@r_flag)) => 1 else 2)))) }


