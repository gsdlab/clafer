open util/integer
pred show {}


abstract sig Measurable
{ r_performance : one performance }

sig performance
{ performance_ref : one Int }
{ one @r_performance.this }

one sig D extends Measurable
{}

one sig C extends Measurable
{}

fact { ((C.@r_performance).@performance_ref) = (-1.mul[((D.@r_performance).@performance_ref)]) }
