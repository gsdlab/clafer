<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/this_not_required.cfr</div>

<div>
<span class="claferDecl" id="Clafer1">Clafer1</span>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="Clafer1__type">type</span>
    <div class="indent">
    <span class="claferDecl" id="Clafer1__type__Type1">Type1</span></div>
    <div class="indent">
    <span class="claferDecl" id="Clafer1__type__Type2">Type2</span></div>
  </div>
</div>


<div>
<span class="claferDecl" id="Clafer2">Clafer2</span>
  <div class="indent">
  <span class="claferDecl" id="clafer1">clafer1</span><span class="keyword"> -> </span><a href="#Clafer1"><span class="reference">Clafer1</span></a></div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="Clafer2__type">type</span>
    <div class="indent">
    <span class="claferDecl" id="Clafer2__type__Type1">Type1</span></div>
    <div class="indent">
    <span class="claferDecl" id="Clafer2__type__Type2">Type2</span></div>
  </div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#Clafer2__type"><span class="reference">type</span></a>.<a href="#Clafer2__type__Type1"><span class="reference">Type1</span></a> =&gt; <a href="#clafer1"><span class="reference">clafer1</span></a>.<a href="#Clafer1__type"><span class="reference">type</span></a>.<a href="#Clafer1__type__Type2"><span class="reference">Type2</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#Clafer2__type"><span class="reference">type</span></a>.<a href="#Clafer2__type__Type1"><span class="reference">Type1</span></a> =&gt; <a href="#clafer1"><span class="reference">clafer1</span></a>.<a href="#Clafer1__type"><span class="reference">type</span></a>.<a href="#Clafer1__type__Type2"><span class="reference">Type2</span></a> <span class="keyword">]</span></div>
</div>

</body>
</html>