<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/compare_reference_targets.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_Port">Port</span></div>


<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="c0_B">B</span>
  <div class="indent">
  <span class="claferDecl" id="c0_a">a</span><span class="keyword"> -> </span><a href="#c0_Port"><span class="reference">Port</span></a></div>
</div>


<div>
<span class="claferDecl" id="c0_p1">p1</span><span class="keyword"> : </span><a href="#c0_Port"><span class="reference">Port</span></a></div>


<div>
<span class="claferDecl" id="c0_p2">p2</span><span class="keyword"> : </span><a href="#c0_Port"><span class="reference">Port</span></a></div>


<div>
<span class="claferDecl" id="c0_sys">sys</span>
  <div class="indent">
  <span class="claferDecl" id="c0_b1">b1</span><span class="keyword"> : </span><a href="#c0_B"><span class="reference">B</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="c0_b2">b2</span><span class="keyword"> : </span><a href="#c0_B"><span class="reference">B</span></a>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#c0_a"><span class="reference">a</span></a> = <span class="keyword">parent</span>.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#c0_a"><span class="reference">a</span></a> != sys.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a> &#124;&#124; <a href="#c0_a"><span class="reference">a</span></a> = sys.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a> <span class="keyword">]</span></div>
  </div>
</div>


<div>
<span class="claferDecl" id="c0_choice">choice</span><span class="keyword"> -> </span><a href="#c0_B"><span class="reference">B</span></a>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<a href="#c0_a"><span class="reference">a</span></a> in <a href="#c0_sys"><span class="reference">sys</span></a>.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="c0_sel">sel</span><span class="keyword"> -> </span><a href="#c0_sys"><span class="reference">sys</span></a>.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span> in <a href="#c0_sys"><span class="reference">sys</span></a>.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">this</span>.<span class="keyword">dref</span> = <a href="#c0_sys"><span class="reference">sys</span></a>.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">[</span> all x<span class="keyword"> : </span><a href="#c0_sys"><span class="reference">sys</span></a>.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a> | <a href="#x"><span class="reference">x</span></a> = <a href="#c0_sys"><span class="reference">sys</span></a>.<a href="#c0_b1"><span class="reference">b1</span></a>.<a href="#c0_a"><span class="reference">a</span></a> <span class="keyword">]</span></div>

</body>
</html>