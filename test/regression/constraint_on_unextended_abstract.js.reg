scope({$Kernel:0, $memory:0});
defaultScope(1);
stringLength(16);

$Kernel = Abstract("Kernel");
$memory = $Kernel.addChild("memory").withCard(0, 1);
$Phone = Clafer("Phone").withCard(1, 1);
$name = $Phone.addChild("name").withCard(1, 1);
$name.refToUnique(string);
$Phone.addConstraint(some(join(global($Kernel), $memory)));
assert(none(global($Kernel)));
