//# OPTIONS --explicit --core
0..* AlicePicks ->> int 0..* {}
0..* BobPicks ->> int 0..* {}
[AlicePicks.dref = (BobPicks.dref ++ 3)]
[(3 ++ BobPicks.dref) = AlicePicks.dref]
abstract 0..* Person 0..* {}
0..* p1 : Person 1..1 {}
0..* p2 : Person 1..1 {}
0..* p3 : Person 1..1 {}
0..* friends -> Person 0..* {}
0..* others -> Person 0..* {}
[friends.dref = (others.dref ++ p1)]
[others.dref = p2]
