open util/integer
pred show {}


one sig root
{ var r_c0_box : set c0_box }
fact { all self_ : root | always (2 <= #(self_.@r_c0_box)) }
fact { all self_ : root | always (#(self_.@r_c0_box) <= 2) }
fact { all self_ : root | always ((not before some root) implies (some alive_c0_box.@r_c0_item)) }
fact { all self_ : root | always ((not before some root) implies (all  i : alive_c0_box.@r_c0_item | after ((no i & (alive_c0_box.@r_c0_item)) && (after (some i & (alive_c0_box.@r_c0_item)))))) }

assert assertAt_8_10 { all self_ : root | always (all  b : alive_c0_box | all  i : b.@r_c0_item | always ((some i & (alive_c0_box.@r_c0_item)) => (some i & (b.@r_c0_item)))) }
check assertAt_8_10 for 1 but 2 c0_box, 2 c0_item, 10 steps



sig c0_box
{ p_c0_box : lone root
, var r_c0_item : set c0_item }
fun alive_c0_box : set c0_box { root.@r_c0_box }
fact { always ~@r_c0_box in @p_c0_box }

fact { all self_ : c0_box | always (self_ in alive_c0_box implies (lone self_.@r_c0_item)) }


sig c0_item
{ p_c0_item : lone c0_box }
fun alive_c0_item : set c0_item { c0_box.@r_c0_item }
fact { always ~@r_c0_item in @p_c0_item
  always @r_c0_item.univ in alive_c0_box }


