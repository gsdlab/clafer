open util/integer
pred show {}


one sig root
{ var r_signal : set signal
, var r_light : set light
, var r_door : set door }
fact { always (lone root.@r_signal) }
fact { always (one root.@r_light) }
fact { always (one root.@r_door) }

assert assertAt_21_11 { always (((some alive_light.@r_red) && (some alive_signal)) => (after (some alive_light.@r_green))) }
check assertAt_21_11 for 1 but 10 steps

assert assertAt_22_11 { always (((some alive_light.@r_green) && (no alive_signal)) => (eventually (some alive_light.@r_red))) }
check assertAt_22_11 for 1 but 10 steps

assert assertAt_23_11 { always (((some alive_door.@r_closed) && (some alive_signal)) => (after (some alive_door.@r_opened))) }
check assertAt_23_11 for 1 but 10 steps

assert assertAt_24_11 { always (((some alive_door.@r_opened) && (no alive_signal)) => (eventually (some alive_door.@r_closed))) }
check assertAt_24_11 for 1 but 10 steps



sig signal
{ p_signal : lone root }
fun alive_signal : set signal { root.@r_signal }
fact { always ~@r_signal in @p_signal }


sig light
{ p_light : lone root
, var r_red : set red
, var r_green : set green }
{ always (this in alive_light implies (let children = (this.@r_red + this.@r_green) | one children))
  always (this in alive_light and not before this in alive_light implies (some this.@r_red)) }
fun alive_light : set light { root.@r_light }
fact { always ~@r_light in @p_light }

fact { all self_ : light | always (self_ in alive_light implies (lone self_.@r_red)) }
fact { all self_ : light | always (self_ in alive_light implies (lone self_.@r_green)) }


sig red
{ p_red : lone light }
fun alive_red : set red { light.@r_red }
fact { always ~@r_red in @p_red
  always @r_red.univ in alive_light }

fact { all self_ : red | always (self_ in alive_red implies (((some (self_ & alive_red)) && (some alive_signal)) => (after (not some self_.(@p_red :> alive_light) or (some (self_.(@p_red :> alive_light)).@r_green))))) }


sig green
{ p_green : lone light }
fun alive_green : set green { light.@r_green }
fact { always ~@r_green in @p_green
  always @r_green.univ in alive_light }

fact { all self_ : green | always (self_ in alive_green implies (((some (self_ & alive_green)) && (no alive_signal)) => ((some self_.(@p_green :> alive_light) and (some (self_ & alive_green))) until (not some self_.(@p_green :> alive_light) or (some (self_.(@p_green :> alive_light)).@r_red))))) }


sig door
{ p_door : lone root
, var r_closed : set closed
, var r_opened : set opened }
{ always (this in alive_door implies (let children = (this.@r_closed + this.@r_opened) | one children))
  always (this in alive_door and not before this in alive_door implies (some this.@r_closed)) }
fun alive_door : set door { root.@r_door }
fact { always ~@r_door in @p_door }

fact { all self_ : door | always (self_ in alive_door implies (lone self_.@r_closed)) }
fact { all self_ : door | always (self_ in alive_door implies (lone self_.@r_opened)) }
fact { all self_ : door | always (self_ in alive_door implies (((some self_.@r_closed) && (some alive_signal)) => (after (some self_.@r_opened)))) }
fact { all self_ : door | always (self_ in alive_door implies (((some self_.@r_opened) && (no alive_signal)) => (((some (self_ & alive_door)) && (some self_.@r_opened)) until (some self_.@r_closed)))) }


sig closed
{ p_closed : lone door }
fun alive_closed : set closed { door.@r_closed }
fact { always ~@r_closed in @p_closed
  always @r_closed.univ in alive_door }


sig opened
{ p_opened : lone door }
fun alive_opened : set opened { door.@r_opened }
fact { always ~@r_opened in @p_opened
  always @r_opened.univ in alive_door }


