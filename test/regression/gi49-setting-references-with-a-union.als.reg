open util/integer
pred show {}


abstract sig x
{ x_ref : one Int }

fact {  all disj x, y : x | (x.@x_ref) != (y.@x_ref)  }
one sig A extends x
{}

fact { (some A) => ((A.@x_ref) = 1) }
one sig B extends x
{}

fact { (some B) => ((B.@x_ref) = 2) }
one sig C extends x
{}

fact { (some C) => ((C.@x_ref) = 3) }
sig xs
{ xs_ref : one x }

fact { (xs.@xs_ref) = ((A + B) + C) }
fact { (xs.@xs_ref) = ((A + B) + C) }
fact { ((xs.@xs_ref).@x_ref) = (((A.@x_ref) + (B.@x_ref)) + (C.@x_ref)) }
