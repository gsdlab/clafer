scope({$ASIL:4});
defaultScope(1);
stringLength(16);

$ASIL = Abstract("ASIL");
$A = Clafer("A").withCard(1, 1);
$B = Clafer("B").withCard(1, 1);
$C = Clafer("C").withCard(1, 1);
$D = Clafer("D").withCard(1, 1);
$A.extending($ASIL);
$B.extending($ASIL);
$C.extending($ASIL);
$D.extending($ASIL);
$ASIL.refTo(Int);
$A.refToUnique(Int);
$B.refToUnique(Int);
$C.refToUnique(Int);
$D.refToUnique(Int);
Constraint(implies(some(global($A)), equal(joinRef(global($A)), constant(1))));
Constraint(implies(some(global($B)), equal(joinRef(global($B)), constant(2))));
Constraint(implies(some(global($C)), equal(joinRef(global($C)), constant(3))));
Constraint(implies(some(global($D)), equal(joinRef(global($D)), constant(4))));
assert(equal(joinRef(global($A)), constant(1)));
assert(equal(joinRef(global($B)), constant(2)));
assert(equal(joinRef(global($C)), constant(3)));
assert(equal(joinRef(global($D)), constant(4)));
