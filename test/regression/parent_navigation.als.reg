open util/integer
pred show {}


one sig claferA
{ r_claferB : one claferB }

one sig claferB
{ r_claferC : one claferC }
{ some this.~@r_claferB }

one sig claferC
{}
{ some this.~@r_claferC
  some (this.~@r_claferC).@r_claferC }

one sig Person
{ r_maritalStatus : one maritalStatus }

one sig maritalStatus
{ r_married : one married }

one sig married
{}
{ some (this.~@r_married).~@r_maritalStatus }

