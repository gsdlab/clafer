open util/integer
pred show {}


one sig root
{ var r_c0_t2 : set c0_t2 }
{ always (one this.@r_c0_t2) }

abstract sig c0_TrafficLight_1
{ var r_c0_on : set c0_on
, var r_c0_off : set c0_off }
{ always (this in alive_c0_TrafficLight_1 implies (lone this.@r_c0_on))
  always (this in alive_c0_TrafficLight_1 implies (lone this.@r_c0_off))
  always (this in alive_c0_TrafficLight_1 implies ((some this.@r_c0_on) => ((some (this & alive_c0_TrafficLight_1) and ((some (this & alive_c0_TrafficLight_1)) && (some this.@r_c0_on))) until (not some (this & alive_c0_TrafficLight_1) or (some this.@r_c0_off)))))
  always (this in alive_c0_TrafficLight_1 implies ((some this.@r_c0_off) => (after (not some (this & alive_c0_TrafficLight_1) or (some this.@r_c0_on)))))
  always (this in alive_c0_TrafficLight_1 and not before this in alive_c0_TrafficLight_1 implies (some this.@r_c0_on)) }
fun alive_c0_TrafficLight_1 : set c0_TrafficLight_1 { alive_c0_t2 }

sig c0_on
{ p_c0_on : lone c0_TrafficLight_1
, var r_c0_normal : set c0_normal
, var r_c0_flashing : set c0_flashing }
{ always (this in alive_c0_on implies (let children = (this.@r_c0_normal + this.@r_c0_flashing) | one children))
  always (this in alive_c0_on implies (lone this.@r_c0_normal))
  always (this in alive_c0_on implies (lone this.@r_c0_flashing))
  always (this in alive_c0_on implies ((some this.@r_c0_flashing) => ((some (this & alive_c0_on) and ((some (this & alive_c0_on)) && (some this.@r_c0_flashing))) until (not some (this & alive_c0_on) or (some this.@r_c0_normal)))))
  always (this in alive_c0_on and not before this in alive_c0_on implies (some this.@r_c0_normal)) }
fun alive_c0_on : set c0_on { c0_TrafficLight_1.@r_c0_on }
fact { always ~@r_c0_on in @p_c0_on
  always @r_c0_on.univ in alive_c0_TrafficLight_1 }


sig c0_normal
{ p_c0_normal : lone c0_on
, var r_c0_green : set c0_green
, var r_c0_yellow : set c0_yellow
, var r_c0_red : set c0_red }
{ always (this in alive_c0_normal implies (let children = (this.@r_c0_green + this.@r_c0_yellow + this.@r_c0_red) | one children))
  always (this in alive_c0_normal implies (lone this.@r_c0_green))
  always (this in alive_c0_normal implies (lone this.@r_c0_yellow))
  always (this in alive_c0_normal implies (lone this.@r_c0_red))
  always (this in alive_c0_normal implies ((some this.@r_c0_green) => (after (not some (this & alive_c0_normal) or (some this.@r_c0_yellow)))))
  always (this in alive_c0_normal implies ((some this.@r_c0_yellow) => (after (not some (this & alive_c0_normal) or (some this.@r_c0_red)))))
  always (this in alive_c0_normal implies ((some this.@r_c0_red) => (after (not some (this & alive_c0_normal) or (some this.@r_c0_green)))))
  always (this in alive_c0_normal and not before this in alive_c0_normal implies (some this.@r_c0_green)) }
fun alive_c0_normal : set c0_normal { c0_on.@r_c0_normal }
fact { always ~@r_c0_normal in @p_c0_normal
  always @r_c0_normal.univ in alive_c0_on }


sig c0_green
{ p_c0_green : lone c0_normal }
fun alive_c0_green : set c0_green { c0_normal.@r_c0_green }
fact { always ~@r_c0_green in @p_c0_green
  always @r_c0_green.univ in alive_c0_normal }


sig c0_yellow
{ p_c0_yellow : lone c0_normal }
fun alive_c0_yellow : set c0_yellow { c0_normal.@r_c0_yellow }
