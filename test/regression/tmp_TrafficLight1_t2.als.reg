  always @r_c0_yellow_off.univ in alive_c0_flashing }


sig c0_off
{ p_c0_off : lone c0_TrafficLight_1 }
fun alive_c0_off : set c0_off { c0_TrafficLight_1.@r_c0_off }
fact { always ~@r_c0_off in @p_c0_off
  always @r_c0_off.univ in alive_c0_TrafficLight_1 }


sig c0_t2 extends c0_TrafficLight_1
{ p_c0_t2 : lone root }
{ always (this in alive_c0_t2 implies (let children = (this.@r_c0_on + this.@r_c0_off) | one children))
  always (this in alive_c0_t2 implies ((not before this in alive_c0_t2) implies ((some this.@r_c0_on) => (after (not some (this & alive_c0_t2) or ((some ((this.@r_c0_on).@r_c0_flashing).@r_c0_yellow_on) && (after (not some (this & alive_c0_t2) or ((some ((this.@r_c0_on).@r_c0_flashing).@r_c0_yellow_off) && (after (not some (this & alive_c0_t2) or (some ((this.@r_c0_on).@r_c0_flashing).@r_c0_yellow_on)))))))))))) }
fun alive_c0_t2 : set c0_t2 { root.@r_c0_t2 }
fact { always ~@r_c0_t2 in @p_c0_t2 }


