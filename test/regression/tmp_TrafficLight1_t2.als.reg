  always @r_c0_yellow.univ in alive_c0_normal }


sig c0_red
{ p_c0_red : lone c0_normal }
fun alive_c0_red : set c0_red { c0_normal.@r_c0_red }
fact { always ~@r_c0_red in @p_c0_red
  always @r_c0_red.univ in alive_c0_normal }


sig c0_flashing
{ p_c0_flashing : lone c0_on
, var r_c0_yellow_on : set c0_yellow_on
, var r_c0_yellow_off : set c0_yellow_off }
{ always (this in alive_c0_flashing implies (let children = (this.@r_c0_yellow_on + this.@r_c0_yellow_off) | one children))
  always (this in alive_c0_flashing implies (lone this.@r_c0_yellow_on))
  always (this in alive_c0_flashing implies (lone this.@r_c0_yellow_off))
  always (this in alive_c0_flashing implies ((some this.@r_c0_yellow_on) => (after (not some (this & alive_c0_flashing) or (some this.@r_c0_yellow_off)))))
  always (this in alive_c0_flashing implies ((some this.@r_c0_yellow_off) => (after (not some (this & alive_c0_flashing) or (some this.@r_c0_yellow_on)))))
  always (this in alive_c0_flashing and not before this in alive_c0_flashing implies (some this.@r_c0_yellow_on)) }
fun alive_c0_flashing : set c0_flashing { c0_on.@r_c0_flashing }
fact { always ~@r_c0_flashing in @p_c0_flashing
  always @r_c0_flashing.univ in alive_c0_on }


sig c0_yellow_on
{ p_c0_yellow_on : lone c0_flashing }
fun alive_c0_yellow_on : set c0_yellow_on { c0_flashing.@r_c0_yellow_on }
fact { always ~@r_c0_yellow_on in @p_c0_yellow_on
  always @r_c0_yellow_on.univ in alive_c0_flashing }


