digraph "abstract_reference_clafer"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  age -&gt; integer&#10;  married ?&#10;"];
"NewBorn" [label="abstract NewBorn -&gt; Person" URL="#NewBorn" tooltip="abstract NewBorn -&gt; Person&#10;  [ age = 0 ][  ! married ]&#10;"];
"NewBorn" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
"Alice" [label="Alice : Person" URL="#Alice" tooltip="Alice : Person&#10;"];
"baby" [label="baby : NewBorn" URL="#baby" tooltip="baby : NewBorn&#10;"];
}