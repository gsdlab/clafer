//# OPTIONS --explicit --core --tl=10
0..* Box 0..1 {
  0..* flag 0..1 {}
  0..* x -> int 1..1 {}
  [all x_1 : this.x | (!(previous (x_1 in this.x))) => (x_1.dref = (if (X (some this.flag)) then 1 else 2))] // :=, tmp_initialValue07.cfr:9:5
}
[(!(previous (some root))) => ((some Box) && (X (no Box)))]

assert [(!(previous (some root))) => (Box.x.dref = 2)]
