defaultScope(1);
stringLength(16);

$A = Clafer("A").withCard(1, 1);
$x = $A.addChild("x").withCard(1, 1);
$y = $A.addChild("y").withCard(1, 1);
$x.refToUnique(Int);
$y.refToUnique(Int);
$A.addConstraint(equal(mul(add(constant(1), constant(2)), constant(3)), constant(9)));
$A.addConstraint(equal(joinRef(join($this(), $x)), div(minus(mul(add(constant(6), sub(constant(5), constant(4))), constant(3))), add(constant(2), constant(1)))));
$A.addConstraint(equal(joinRef(join($this(), $y)), joinRef(join($this(), $x))));
