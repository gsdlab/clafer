digraph "mergeExpAndSetExp"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"intNumber" [label="abstract intNumber -&gt; integer" URL="#intNumber" tooltip="abstract intNumber -&gt; integer&#10;"];
"numberOne" [label="numberOne : intNumber -&gt; 1" URL="#numberOne" tooltip="numberOne : intNumber -&gt; 1&#10;"];
"name" [label="abstract name -&gt; string" URL="#name" tooltip="abstract name -&gt; string&#10;"];
"alice" [label="alice : name -&gt; &quot;Alice&quot;" URL="#alice" tooltip="alice : name -&gt; &quot;Alice&quot;&#10;"];
"realNumber" [label="abstract realNumber -&gt; real" URL="#realNumber" tooltip="abstract realNumber -&gt; real&#10;"];
"pi" [label="pi : realNumber -&gt; 3.1415" URL="#pi" tooltip="pi : realNumber -&gt; 3.1415&#10;"];
"piDouble" [label="piDouble : realNumber -&gt; 3.14e0" URL="#piDouble" tooltip="piDouble : realNumber -&gt; 3.14e0&#10;"];
"piInt" [label="piInt : realNumber -&gt; 3" URL="#piInt" tooltip="piInt : realNumber -&gt; 3&#10;"];
"doubleNumber" [label="abstract doubleNumber : realNumber -&gt; double" URL="#doubleNumber" tooltip="abstract doubleNumber : realNumber -&gt; double&#10;"];
"numberTwentyFive" [label="numberTwentyFive : doubleNumber -&gt; 2.5e1" URL="#numberTwentyFive" tooltip="numberTwentyFive : doubleNumber -&gt; 2.5e1&#10;"];
"intNumber2" [label="abstract intNumber2 : realNumber -&gt; integer" URL="#intNumber2" tooltip="abstract intNumber2 : realNumber -&gt; integer&#10;"];
"numberThree" [label="numberThree : intNumber2 -&gt; 3" URL="#numberThree" tooltip="numberThree : intNumber2 -&gt; 3&#10;"];
"intNumber3" [label="abstract intNumber3 : doubleNumber -&gt; integer" URL="#intNumber3" tooltip="abstract intNumber3 : doubleNumber -&gt; integer&#10;"];
"numberFour" [label="numberFour : intNumber2 -&gt; 4" URL="#numberFour" tooltip="numberFour : intNumber2 -&gt; 4&#10;"];
"likertScaleVal" [label="likertScaleVal -&gt; 1, 2, 3, 4, 5" URL="#likertScaleVal" tooltip="likertScaleVal -&gt; 1, 2, 3, 4, 5&#10;"];
"nonZero" [label="nonZero -&gt; integer--0" URL="#nonZero" tooltip="nonZero -&gt; integer--0&#10;"];
"Person" [label="abstract Person" URL="#Person" tooltip="abstract Person&#10;  abstract Head&#10;  likes -&gt; Person ?&#10;"];
"Person__Head" [label="abstract Head" URL="#Person__Head" tooltip="abstract Head&#10;"];
"Person" -> "Person" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=likes];
"Alice" [label="Alice : Person" URL="#Alice" tooltip="Alice : Person&#10;  `Head&#10;  [ likes = Ella ]&#10;"];
"Alice" -> "Person__Head" [arrowhead=vee arrowtail=diamond dir=both style=solid constraint=true weight=5 minlen=2 arrowsize=0.6 penwidth=0.5 ];
"Ella" [label="Ella : Person" URL="#Ella" tooltip="Ella : Person&#10;  h : Person.Head&#10;  [ no likes ]&#10;"];
"heads" [label="heads -&gt; Person.Head *" URL="#heads" tooltip="heads -&gt; Person.Head *&#10;"];
"friend" [label="friend -&gt; Alice++Ella *" URL="#friend" tooltip="friend -&gt; Alice++Ella *&#10;"];
"onlyAlice" [label="onlyAlice -&gt; Alice**Person" URL="#onlyAlice" tooltip="onlyAlice -&gt; Alice**Person&#10;"];
"exceptElla" [label="exceptElla -&gt; Person--Ella *" URL="#exceptElla" tooltip="exceptElla -&gt; Person--Ella *&#10;"];
}