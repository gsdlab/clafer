      <div class="indent">
      <span class="keyword">[</span> <a href="#serverKeyExchange"><span class="reference">serverKeyExchange</span></a><span class="tKeyword"> -[</span><span class="keyword">no</span> <a href="#clientAuthentication"><span class="reference">clientAuthentication</span></a><span class="tKeyword">]-&gt; </span><a href="#serverHelloDone"><span class="reference">serverHelloDone</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="certificateRequest">certificateRequest</span><span class="tKeyword"> --&gt; </span><a href="#serverHelloDone"><span class="reference">serverHelloDone</span></a>
        <div class="indent">
        <span class="keyword">[</span> <a href="#clientAuthentication"><span class="reference">clientAuthentication</span></a> <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#server"><span class="reference">server</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#serverCertificateRequestMessage"><span class="reference">serverCertificateRequestMessage</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="serverHelloDone">serverHelloDone</span>
        <div class="indent">
        <span class="keyword">[</span> <a href="#server"><span class="reference">server</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#serverHelloDoneMessage"><span class="reference">serverHelloDoneMessage</span></a> <span class="keyword">]</span></div>
      </div>
    </div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#serverResponse"><span class="reference">serverResponse</span></a><span class="tKeyword"> -[</span> ! (<a href="#serverResponse"><span class="reference">serverResponse</span></a>.<a href="#mismatch"><span class="reference">mismatch</span></a> &#124;&#124; <a href="#serverResponse"><span class="reference">serverResponse</span></a>.<a href="#serverHelloDone"><span class="reference">serverHelloDone</span></a>)<span class="tKeyword">]-&gt; </span><a href="#serverResponse"><span class="reference">serverResponse</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#serverResponse"><span class="reference">serverResponse</span></a>.<a href="#mismatch"><span class="reference">mismatch</span></a><span class="tKeyword"> --&gt; </span><a href="#fatalError"><span class="reference">fatalError</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#serverResponse"><span class="reference">serverResponse</span></a>.<a href="#serverHelloDone"><span class="reference">serverHelloDone</span></a><span class="tKeyword"> --&gt; </span><a href="#clientResponse"><span class="reference">clientResponse</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="clientResponse">clientResponse</span>
      <div class="indent">
      <span class="keyword">[</span> <a href="#handshakeStatus"><span class="reference">handshakeStatus</span></a> = <a href="#initiated"><span class="reference">initiated</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="tKeyword">initially </span><a href="#clientAuthentication"><span class="reference">clientAuthentication</span></a> =&gt; <a href="#clientCertificate"><span class="reference">clientCertificate</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="tKeyword">initially </span><span class="keyword">no</span> <a href="#clientAuthentication"><span class="reference">clientAuthentication</span></a> =&gt; <a href="#clientKeyExchange"><span class="reference">clientKeyExchange</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="clientCertificate">clientCertificate</span><span class="tKeyword"> --&gt; </span><a href="#clientKeyExchange"><span class="reference">clientKeyExchange</span></a>
        <div class="indent">
        <span class="keyword">[</span> <a href="#clientAuthentication"><span class="reference">clientAuthentication</span></a> <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#client"><span class="reference">client</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#clientCertificateMessage"><span class="reference">clientCertificateMessage</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="clientKeyExchange">clientKeyExchange</span>
        <div class="indent">
        <span class="keyword">[</span> <a href="#client"><span class="reference">client</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#clientKeyExchangeMessage"><span class="reference">clientKeyExchangeMessage</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="keyword">[</span> <a href="#clientKeyExchange"><span class="reference">clientKeyExchange</span></a><span class="tKeyword"> -[</span><a href="#clientAuthentication"><span class="reference">clientAuthentication</span></a> &amp;&amp; <span class="keyword">some</span> <a href="#client"><span class="reference">client</span></a>.<a href="#certificate"><span class="reference">certificate</span></a>.<a href="#signing"><span class="reference">signing</span></a><span class="tKeyword">]-&gt; </span><a href="#certificateVerify"><span class="reference">certificateVerify</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <a href="#clientKeyExchange"><span class="reference">clientKeyExchange</span></a><span class="tKeyword"> -[</span> ! (<a href="#clientAuthentication"><span class="reference">clientAuthentication</span></a> &amp;&amp; <span class="keyword">some</span> <a href="#client"><span class="reference">client</span></a>.<a href="#certificate"><span class="reference">certificate</span></a>.<a href="#signing"><span class="reference">signing</span></a>)<span class="tKeyword">]-&gt; </span><a href="#clientChangeCipherSpec"><span class="reference">clientChangeCipherSpec</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="certificateVerify">certificateVerify</span><span class="tKeyword"> --&gt; </span><a href="#clientChangeCipherSpec"><span class="reference">clientChangeCipherSpec</span></a>
        <div class="indent">
        <span class="keyword">[</span> <a href="#client"><span class="reference">client</span></a>.<a href="#certificate"><span class="reference">certificate</span></a>.<a href="#signing"><span class="reference">signing</span></a> <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#client"><span class="reference">client</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#certificateVerifyMessage"><span class="reference">certificateVerifyMessage</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="clientChangeCipherSpec">clientChangeCipherSpec</span><span class="tKeyword"> --&gt; </span><a href="#clientFinished"><span class="reference">clientFinished</span></a>
        <div class="indent">
        <span class="keyword">[</span> <a href="#client"><span class="reference">client</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#clientChangeCipherSpecMessage"><span class="reference">clientChangeCipherSpecMessage</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="clientFinished">clientFinished</span>
        <div class="indent">
        <span class="keyword">[</span> <a href="#client"><span class="reference">client</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#clientFinishedMessage"><span class="reference">clientFinishedMessage</span></a> <span class="keyword">]</span></div>
      </div>
    </div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#clientResponse"><span class="reference">clientResponse</span></a><span class="tKeyword"> -[</span><span class="keyword">no</span> <a href="#clientResponse"><span class="reference">clientResponse</span></a>.<a href="#clientFinished"><span class="reference">clientFinished</span></a><span class="tKeyword">]-&gt; </span><a href="#clientResponse"><span class="reference">clientResponse</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#clientResponse"><span class="reference">clientResponse</span></a>.<a href="#clientFinished"><span class="reference">clientFinished</span></a><span class="tKeyword"> --&gt; </span><a href="#serverFinish"><span class="reference">serverFinish</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="serverFinish">serverFinish</span>
      <div class="indent">
      <span class="tKeyword">initial</span> <span class="claferDecl" id="serverChangeCipherSpec">serverChangeCipherSpec</span><span class="tKeyword"> --&gt; </span><a href="#serverFinished"><span class="reference">serverFinished</span></a>
        <div class="indent">
        <span class="keyword">[</span> <a href="#handshakeStatus"><span class="reference">handshakeStatus</span></a> = <a href="#initiated"><span class="reference">initiated</span></a> <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#server"><span class="reference">server</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#serverChangeCipherSpecMessage"><span class="reference">serverChangeCipherSpecMessage</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="serverFinished">serverFinished</span>
        <div class="indent">
        <span class="keyword">[</span> <a href="#server"><span class="reference">server</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#serverFinishedMessage"><span class="reference">serverFinishedMessage</span></a> <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#handshakeStatus"><span class="reference">handshakeStatus</span></a> = <a href="#completed"><span class="reference">completed</span></a> <span class="keyword">]</span></div>
      </div>
    </div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#serverFinish"><span class="reference">serverFinish</span></a><span class="tKeyword"> -[</span><span class="keyword">no</span> <a href="#serverFinish"><span class="reference">serverFinish</span></a>.<a href="#serverFinished"><span class="reference">serverFinished</span></a><span class="tKeyword">]-&gt; </span><a href="#serverFinish"><span class="reference">serverFinish</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="keyword">[</span> <a href="#serverFinish"><span class="reference">serverFinish</span></a>.<a href="#serverFinished"><span class="reference">serverFinished</span></a><span class="tKeyword"> --&gt; </span><a href="#dataTransfer"><span class="reference">dataTransfer</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="claferDecl" id="dataTransfer">dataTransfer</span><span class="tKeyword"> --&gt;&gt; </span><a href="#clientHello"><span class="reference">clientHello</span></a>
      <div class="indent">
      <span class="keyword">[</span> <a href="#handshakeStatus"><span class="reference">handshakeStatus</span></a> = <a href="#completed"><span class="reference">completed</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <a href="#client"><span class="reference">client</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#applicationDataMessage"><span class="reference">applicationDataMessage</span></a> <span class="keyword">]</span></div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="fatalError">fatalError</span><span class="tKeyword"> --&gt; </span><a href="#this"><span class="reference">fatalError</span></a>
      <div class="indent">
      <span class="keyword">[</span> <a href="#handshakeStatus"><span class="reference">handshakeStatus</span></a> = <a href="#failed"><span class="reference">failed</span></a> <span class="keyword">]</span></div>
    </div>
  </div>
</div>

</body>
