      <div class="indent">
      <span class="claferDecl" id="serverKeyExchange">serverKeyExchange</span>
        <div class="indent">
        <span class="keyword">[</span> <a href="#server"><span class="reference">server</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#serverKeyExchangeMessage"><span class="reference">serverKeyExchangeMessage</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
