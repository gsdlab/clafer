      <div class="indent">
      <span class="keyword">[</span> <a href="#client"><span class="reference">client</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#clientHelloMessage"><span class="reference">clientHelloMessage</span></a> <span class="keyword">]</span></div>
    </div>
    <div class="indent">
    <span class="keyword">xor</span> <span class="claferDecl" id="serverResponse">serverResponse</span>
      <div class="indent">
      <span class="keyword">[</span> <a href="#handshakeStatus"><span class="reference">handshakeStatus</span></a> = <a href="#initiated"><span class="reference">initiated</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <span class="tKeyword">initially </span><a href="#serverHello"><span class="reference">serverHello</span></a> &#124;&#124; <a href="#mismatch"><span class="reference">mismatch</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="claferDecl" id="mismatch">mismatch</span>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">no</span> <a href="#client"><span class="reference">client</span></a>.<a href="#protocolversion"><span class="reference">protocolversion</span></a>**<a href="#server"><span class="reference">server</span></a>.<a href="#protocolversion"><span class="reference">protocolversion</span></a> <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#server"><span class="reference">server</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#protocolMismatch"><span class="reference">protocolMismatch</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="claferDecl" id="serverHello">serverHello</span>
        <div class="indent">
        <span class="keyword">[</span> <span class="keyword">some</span> <a href="#client"><span class="reference">client</span></a>.<a href="#protocolversion"><span class="reference">protocolversion</span></a>**<a href="#server"><span class="reference">server</span></a>.<a href="#protocolversion"><span class="reference">protocolversion</span></a> <span class="keyword">]</span></div>
        <div class="indent">
        <span class="keyword">[</span> <a href="#server"><span class="reference">server</span></a>.<a href="#send"><span class="reference">send</span></a> = <a href="#serverHelloMessage"><span class="reference">serverHelloMessage</span></a> <span class="keyword">]</span></div>
      </div>
      <div class="indent">
      <span class="keyword">[</span> <a href="#serverHello"><span class="reference">serverHello</span></a><span class="tKeyword"> -[</span><span class="keyword">no</span> <a href="#annonymousMode"><span class="reference">annonymousMode</span></a><span class="tKeyword">]-&gt; </span><a href="#serverCertificate"><span class="reference">serverCertificate</span></a> <span class="keyword">]</span></div>
      <div class="indent">
      <span class="keyword">[</span> <a href="#serverHello"><span class="reference">serverHello</span></a><span class="tKeyword"> -[</span><a href="#annonymousMode"><span class="reference">annonymousMode</span></a><span class="tKeyword">]-&gt; </span><a href="#serverKeyExchange"><span class="reference">serverKeyExchange</span></a> <span class="keyword">]</span></div>
      <div class="indent">
