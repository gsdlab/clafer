  <div class="indent">
  <span class="tKeyword">final</span> <span class="claferDecl" id="server">server</span><span class="keyword"> -> </span><a href="#OurServer"><span class="reference">OurServer</span></a></div>
  <div class="indent">
  <span class="claferDecl" id="handshakeStatus">handshakeStatus</span><span class="keyword"> -> </span><a href="#HandshakeStatus"><span class="reference">HandshakeStatus</span></a></div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="channel">channel</span>
    <div class="indent">
    <span class="tKeyword">initial</span> <span class="claferDecl" id="clientHello">clientHello</span><span class="tKeyword"> --&gt; </span><a href="#serverResponse"><span class="reference">serverResponse</span></a> &#124;&#124; <a href="#fatalError"><span class="reference">fatalError</span></a>
