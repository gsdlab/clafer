//# OPTIONS --explicit
0..* c0_midYearReview : c0_Meeting 1..1 {
  [((#this . c0_month) >= 1) => (this . c0_month . dref = c0_June)]
  [((#this . c0_chair) >= 1) => (this . c0_chair . dref = c0_Steven)]
  [((#this . c0_room) >= 1) => (this . c0_room . dref = c0_C)]
  [(#this . c0_onlineParticipant) >= 1]
  0..* c0_month -> c0_Month 1..1 {}
  0..* c0_chair -> c0_Member 1..1 {}
  0..* c0_room -> c0_Room 1..1 {}
}
0..* c0_Steven : c0_Member 1..1 {}
0..* c0_C : c0_Room 1..1 {
  0..* c0_whiteboard 1..1 {}
  0..* c0_audioConferencing 1..1 {}
}
0..* c0_ondemandMeeting : c0_Meeting 1..1 {
  [((#this . c1_chair) >= 1) => (this . c1_chair . dref = c0_Joanna)]
  [(#this . c0_onlineParticipant) = 0]
  [((#this . c1_room) >= 1) => (this . c1_room . dref = c0_D)]
  0..* c1_chair -> c0_Member 1..1 {}
  0..* c1_room -> c0_Room 1..1 {}
}
0..* c0_Joanna : c0_Member 1..1 {}
0..* c0_D : c0_Room 1..1 {
  0..* c1_whiteboard 1..1 {}
}
abstract 0..* c0_Meeting 0..* {
  [this . c2_chair . dref not in this . c0_participant . dref]
  [this . c2_chair . dref not in this . c0_onlineParticipant . dref]
  [((#this . c0_onlineParticipant) >= 1) => ((#this . c2_room . dref . c1_audioConferencing) >= 1)]
  0..* c2_chair -> c0_Member 1..1 {}
  0..* c0_participant -> c0_Member 1..* {}
  0..* c0_onlineParticipant -> c0_Member 0..* {}
  0..* c2_room -> c0_Room 1..1 {
    [this . dref . c0_capacity . dref >= ((#this . parent . c0_participant) + 1)]
  }
}
abstract 0..* c0_Month 0..* {}
0..* c0_June : c0_Month 1..1 {}
0..* c0_July : c0_Month 1..1 {}
abstract 0..* c0_Member 0..* {}
abstract 0..* c0_Room 0..* {
  0..* c0_capacity -> int 1..1 {}
  1..* c2_whiteboard 1..1 {
    0..* c0_traditional 0..1 {}
    0..* c0_electronic 0..1 {}
  }
  0..* c0_projector 0..1 {}
  0..* c0_computer 0..1 {}
  0..* c1_audioConferencing 0..1 {}
}
0..* c0_M : c0_Member 5..5 {}
0..* c0_SueAgenda : c0_Agenda 1..1 {
  [((#this . c0_m1) >= 1) => (this . c0_m1 . dref = c0_M1)]
  [((#this . c0_m2) >= 1) => (this . c0_m2 . dref = c0_M2)]
  0..* c0_m1 -> c0_Meeting 0..1 {}
  0..* c0_m2 -> c0_Meeting 0..1 {}
}
0..* c0_M1 : c0_Meeting 0..1 {}
0..* c0_M2 : c0_Meeting 0..1 {
  [((#this . c0_time) >= 1) => (this . c0_time . dref = 10)]
  0..* c0_time -> int 1..1 {}
}
abstract 0..* c0_Agenda 0..* {
  0..* c0_mt -> c0_Meeting 0..* {}
}
