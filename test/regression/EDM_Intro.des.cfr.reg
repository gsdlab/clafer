//# OPTIONS --explicit
0..* midYearReview : Meeting 1..1 {
  [(#this.onlineParticipant) >= 1]
  0..* month -> Month 1..1 = June {}
  0..* midYearReview__chair -> Member 1..1 = Steven {}
  0..* midYearReview__room -> Room 1..1 = C {}
}
0..* Steven : Member 1..1 {}
0..* C : Room 1..1 {
  0..* C__whiteboard 1..1 {}
  0..* C__audioConferencing 1..1 {}
}
0..* ondemandMeeting : Meeting 1..1 {
  [(#this.onlineParticipant) = 0]
  0..* ondemandMeeting__chair -> Member 1..1 = Joanna {}
  0..* ondemandMeeting__room -> Room 1..1 = D {}
}
0..* Joanna : Member 1..1 {}
0..* D : Room 1..1 {
  0..* D__whiteboard 1..1 {}
}
abstract 0..* Meeting 0..* {
  [this.Meeting__chair.dref not in this.participant.dref]
  [this.Meeting__chair.dref not in this.onlineParticipant.dref]
  [((#this.onlineParticipant) >= 1) => ((#this.Meeting__room.dref.Room__audioConferencing) >= 1)]
  0..* Meeting__chair -> Member 1..1 {}
  0..* participant -> Member 1..* {}
  0..* onlineParticipant -> Member 0..* {}
  0..* Meeting__room -> Room 1..1 {
    [this.dref.capacity.dref >= ((#this.parent.participant) + 1)]
  }
}
abstract 0..* Month 0..* {}
0..* June : Month 1..1 {}
0..* July : Month 1..1 {}
abstract 0..* Member 0..* {}
abstract 0..* Room 0..* {
  0..* capacity -> int 1..1 {}
  1..* Room__whiteboard 1..1 {
    0..* traditional 0..1 {}
    0..* electronic 0..1 {}
  }
  0..* projector 0..1 {}
  0..* computer 0..1 {}
  0..* Room__audioConferencing 0..1 {}
}
0..* M : Member 5..5 {}
0..* SueAgenda : Agenda 1..1 {
  0..* m1 -> Meeting 0..1 = M1 {}
  0..* m2 -> Meeting 0..1 = M2 {}
}
0..* M1 : Meeting 0..1 {}
0..* M2 : Meeting 0..1 {
  0..* time -> int 1..1 = 10 {}
}
abstract 0..* Agenda 0..* {
  0..* mt -> Meeting 0..* {}
}
