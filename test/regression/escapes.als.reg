open util/integer

open util/relation

fact {
symmetric[r_spouse . spouse_ref]
irreflexive[r_spouse . spouse_ref]
}

pred show {}


abstract sig Person
{ r_spouse : lone spouse }

sig spouse
{ spouse_ref : one Person }
{ one @r_spouse.this }

one sig Alice extends Person
{}
{ ((this.@r_spouse).@spouse_ref) = Bob }

one sig Bob extends Person
{}

assert assertAt_8_10 { ((Bob.@r_spouse).@spouse_ref) = Alice }
check assertAt_8_10 for 1 but 4 Person, 4 spouse

one sig Carol extends Person
{}
{ no this.@r_spouse }

one sig Dave extends Person
{}

assert assertAt_14_10 { no Dave.@r_spouse }
check assertAt_14_10 for 1 but 4 Person, 4 spouse

