//# OPTIONS --explicit
[all c : c0_Course | all t : c . c0_taughtBy | ((#t . c0_x) >= 1) && (c in t . dref . c0_teaches . dref)]
abstract 0..* c0_Course 0..* {
  0..* c0_taughtBy -> c0_Teacher 0..* {
    0..* c0_x 0..1 {}
  }
}
abstract 0..* c0_Teacher 0..* {
  0..* c0_teaches -> c0_Course 0..* {}
}
0..* c0_course : c0_Course 5..5 {}
0..* c0_teacher : c0_Teacher 3..3 {}
