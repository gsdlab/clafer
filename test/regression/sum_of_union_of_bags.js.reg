scope({$x:2, $y:2});
defaultScope(1);
stringLength(16);

$x = Clafer("x").withCard(2);
$y = Clafer("y").withCard(2);
$z = Clafer("z").withCard(1, 1);
$x.refTo(Int);
$x.addConstraint(and(greaterThanEqual(joinRef($this()), constant(-2)), lessThanEqual(joinRef($this()), constant(2))));
$y.refTo(Int);
$y.addConstraint(and(greaterThanEqual(joinRef($this()), constant(-2)), lessThanEqual(joinRef($this()), constant(2))));
$z.refToUnique(Int);
Constraint(implies(some(global($z)), equal(joinRef(global($z)), add(sum(global($x)), sum(global($y))))));
