scope({$ComfortFeature:7, $Feature:10, $FuelFeature:5, $comfort:7, $cost:10, $fuel:5});
defaultScope(1);
stringLength(16);

$Feature = Abstract("Feature");
$cost = $Feature.addChild("cost").withCard(1, 1);
$ComfortFeature = Abstract("ComfortFeature");
$comfort = $ComfortFeature.addChild("comfort").withCard(1, 1);
$FuelFeature = Abstract("FuelFeature");
$fuel = $FuelFeature.addChild("fuel").withCard(1, 1);
$Car = Abstract("Car");
$ABS = $Car.addChild("ABS").withCard(0, 1);
$CC = $Car.addChild("CC").withCard(0, 1);
$ACC = $CC.addChild("ACC").withCard(0, 1);
$Transmission = $Car.addChild("Transmission").withCard(1, 1).withGroupCard(1, 1);
$Automatic = $Transmission.addChild("Automatic").withCard(0, 1);
$Manual = $Transmission.addChild("Manual").withCard(0, 1);
$FCA = $Car.addChild("FCA").withCard(0, 1);
$Sensor = $FCA.addChild("Sensor").withCard(1, 1).withGroupCard(1, 1);
$Radar = $Sensor.addChild("Radar").withCard(0, 1);
$Lidar = $Sensor.addChild("Lidar").withCard(0, 1);
$Alert = $FCA.addChild("Alert").withCard(1, 1).withGroupCard(1, 1);
$Haptic = $Alert.addChild("Haptic").withCard(0, 1);
$Audible = $Alert.addChild("Audible").withCard(0, 1);
$total_cost = $Car.addChild("total_cost").withCard(1, 1);
$total_comfort = $Car.addChild("total_comfort").withCard(1, 1);
$total_fuel = $Car.addChild("total_fuel").withCard(1, 1);
$aCar = Clafer("aCar").withCard(1, 1);
$ComfortFeature.extending($Feature);
$FuelFeature.extending($ComfortFeature);
$ABS.extending($Feature);
$CC.extending($FuelFeature);
$ACC.extending($FuelFeature);
$Automatic.extending($FuelFeature);
$Manual.extending($FuelFeature);
$FCA.extending($FuelFeature);
$Radar.extending($Feature);
$Lidar.extending($Feature);
$Haptic.extending($ComfortFeature);
$Audible.extending($ComfortFeature);
$aCar.extending($Car);
$cost.refToUnique(Int);
$comfort.refToUnique(Int);
$fuel.refToUnique(Int);
$total_cost.refToUnique(Int);
$total_comfort.refToUnique(Int);
$total_fuel.refToUnique(Int);
$ABS.addConstraint(equal(joinRef(join($this(), $cost)), constant(2)));
$CC.addConstraint(equal(joinRef(join($this(), $fuel)), constant(1)));
$CC.addConstraint(equal(joinRef(join($this(), $comfort)), constant(3)));
$CC.addConstraint(equal(joinRef(join($this(), $cost)), constant(4)));
$ACC.addConstraint(equal(joinRef(join($this(), $fuel)), constant(2)));
$ACC.addConstraint(equal(joinRef(join($this(), $comfort)), constant(6)));
$ACC.addConstraint(equal(joinRef(join($this(), $cost)), constant(3)));
$ACC.addConstraint(some(join(joinParent(joinParent($this())), $FCA)));
$Automatic.addConstraint(equal(joinRef(join($this(), $fuel)), constant(2)));
$Automatic.addConstraint(equal(joinRef(join($this(), $comfort)), constant(2)));
$Automatic.addConstraint(equal(joinRef(join($this(), $cost)), constant(3)));
$Manual.addConstraint(equal(joinRef(join($this(), $fuel)), constant(0)));
$Manual.addConstraint(equal(joinRef(join($this(), $comfort)), constant(1)));
$Manual.addConstraint(equal(joinRef(join($this(), $cost)), constant(2)));
$FCA.addConstraint(equal(joinRef(join($this(), $fuel)), constant(2)));
$FCA.addConstraint(equal(joinRef(join($this(), $comfort)), constant(4)));
$FCA.addConstraint(equal(joinRef(join($this(), $cost)), constant(5)));
$Radar.addConstraint(equal(joinRef(join($this(), $cost)), constant(2)));
$Lidar.addConstraint(equal(joinRef(join($this(), $cost)), constant(4)));
$Haptic.addConstraint(equal(joinRef(join($this(), $comfort)), constant(4)));
$Haptic.addConstraint(equal(joinRef(join($this(), $cost)), constant(2)));
$Audible.addConstraint(equal(joinRef(join($this(), $comfort)), constant(2)));
$Audible.addConstraint(equal(joinRef(join($this(), $cost)), constant(1)));
$Car.addConstraint(implies(some(join($this(), $total_cost)), equal(joinRef(join($this(), $total_cost)), sum(join(global($Feature), $cost)))));
$Car.addConstraint(implies(some(join($this(), $total_comfort)), equal(joinRef(join($this(), $total_comfort)), sum(join(global($ComfortFeature), $comfort)))));
$Car.addConstraint(implies(some(join($this(), $total_fuel)), equal(joinRef(join($this(), $total_fuel)), sum(join(global($FuelFeature), $fuel)))));
min(joinRef(join(global($aCar), $total_cost)));
min(joinRef(join(global($aCar), $total_fuel)));
max(joinRef(join(global($aCar), $total_comfort)));
