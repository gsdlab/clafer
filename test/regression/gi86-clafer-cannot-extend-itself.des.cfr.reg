//# OPTIONS --explicit
abstract 0..* c0_FunctionalArchitecture 0..* {}
abstract 0..* c0_Deployment 0..* {
  abstract 0..* c0_fa -> c0_FunctionalArchitecture 0..* {}
}
abstract 0..* c0_PowerWindowFAA : c0_FunctionalArchitecture 0..* {}
abstract 0..* c0_PowerWindowDpl : c0_Deployment 0..* {
  abstract 0..* c1_fa : c0_fa -> c0_PowerWindowFAA 0..* {}
}
0..* c0_System 1..1 {
