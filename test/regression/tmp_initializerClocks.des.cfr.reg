//# OPTIONS --explicit --tl=10
abstract 0..* Val ->> int 0..3 := each 1 {}
abstract 0..* Wal ->> int 0..3 := together 1 {}
0..* Vi : Val 0..* {}
0..* Wi : Wal 0..* {}
[initially ((no Vi) && (no Wi))]
[(F (some Vi)) && (F (some Wi))]
0..* A 1..1 {
  0..* xs ->> int 0..2 := each 2 {}
  0..* ys ->> int 0..2 := together 3 {}
  [F ((#this.xs) = 2)]
}
