open util/integer
pred show {}


abstract sig A
{ r_a : one a }

sig a
{}
{ one @r_a.this }

abstract sig B extends A
{ r_b : lone b }

sig b
{}
{ one @r_b.this }

abstract sig C extends B
{ r_c : lone c }

sig c
{}
{ one @r_c.this }

abstract sig D extends C
{ r_d : lone d }

sig d
{}
{ one @r_d.this }

one sig E extends D
{ r_e : lone e }
{ let children = (r_e + r_d + r_c + r_b + r_a) | one children }

lone sig e
{}
{ one r_e }

assert assertAt_19_10 { ((((one E.@r_a) && (no E.@r_b)) && (no E.@r_c)) && (no E.@r_d)) && (no E.@r_e) }
check assertAt_19_10 for 1

