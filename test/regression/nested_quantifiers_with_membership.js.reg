scope({$Course:5, $Teacher:3, $course:5, $taughtBy:15, $teacher:3, $teaches:15, $x:15});
defaultScope(1);
stringLength(16);

$Course = Abstract("Course");
$taughtBy = $Course.addChild("taughtBy");
$x = $taughtBy.addChild("x").withCard(0, 1);
$Teacher = Abstract("Teacher");
$teaches = $Teacher.addChild("teaches");
$course = Clafer("course").withCard(5, 5);
$teacher = Clafer("teacher").withCard(3, 3);
$taughtBy.refToUnique($Teacher);
$teaches.refToUnique($Course);
Constraint(all([decl([$_c = local("c")], global($Course))], all([decl([$_t = local("t")], join($_c, $taughtBy))], and(some(join($_t, $x)), $in($_c, joinRef(join(joinRef($_t), $teaches)))))));
$course.extending($Course);
$teacher.extending($Teacher);
