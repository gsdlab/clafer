<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/ClaferToolsDemo_Existing_Android_Phones.cfr</div>

<div>
<span class="claferDecl" id="AndroidPhone1">AndroidPhone1</span>
  <div class="indent">
  <span class="claferDecl" id="AndroidPhone1__Connectivity">Connectivity</span>
    <div class="indent">
    <span class="claferDecl" id="Connectivity__Bluetooth40">Bluetooth40</span></div>
    <div class="indent">
    <span class="claferDecl" id="AndroidPhone1__Connectivity__GSM">GSM</span></div>
    <div class="indent">
    <span class="claferDecl" id="AndroidPhone1__Connectivity__WiFi">WiFi</span></div>
    <div class="indent">
    <span class="claferDecl" id="AndroidPhone1__Connectivity__USB">USB</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="AndroidPhone1__Battery">Battery</span>
    <div class="indent">
    <span class="claferDecl" id="LiBattery1450">LiBattery1450</span></div>
  </div>
</div>

