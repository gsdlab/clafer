</div>

<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="keyword">xor</span> <span class="claferDecl" id="root__Bluetooth">Bluetooth</span>
  <div class="indent">
  <span class="claferDecl" id="Bluetooth20">Bluetooth20</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="Bluetooth__Bluetooth21">Bluetooth21</span> ?</div>
  <div class="indent">
  <span class="claferDecl" id="Bluetooth__Bluetooth40">Bluetooth40</span> ?</div>
