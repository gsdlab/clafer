<!-- # FRAGMENT /-->

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="MobilePhone">MobilePhone</span>
  <div class="indent">
  <span class="claferDecl" id="MobilePhone__Connectivity">Connectivity</span>
    <div class="indent">
    `<a href="#root__Bluetooth"><span class="reference">Bluetooth</span></a></div>
    <div class="indent">
    <span class="claferDecl" id="MobilePhone__Connectivity__GSM">GSM</span></div>
    <div class="indent">
    <span class="claferDecl" id="LTE">LTE</span> ?
      <div class="indent">
      <span class="keyword">[</span> <a href="#LiBattery1400"><span class="reference">LiBattery1400</span></a> <span class="keyword">]</span></div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="MobilePhone__Connectivity__WiFi">WiFi</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="MobilePhone__Connectivity__USB">USB</span> ?</div>
  </div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="MobilePhone__Battery">Battery</span>
    <div class="indent">
    <span class="claferDecl" id="MobilePhone__Battery__LiBattery1150">LiBattery1150</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="LiBattery1400">LiBattery1400</span> ?</div>
  </div>
</div>

