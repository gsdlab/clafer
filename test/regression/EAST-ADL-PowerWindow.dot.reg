digraph "EAST-ADL-PowerWindow"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Feature" [label="abstract Feature" URL="#Feature" tooltip="abstract Feature&#10;"];
"express" [label="express : Feature ?" URL="#express" tooltip="express : Feature ?&#10;"];
"Component" [label="abstract Component" URL="#Component" tooltip="abstract Component&#10;  abstract xor Port&#10;    input&#10;    output&#10;"];
"Port" [label="abstract xor Port" URL="#Port" tooltip="abstract xor Port&#10;  input&#10;  output&#10;"];
"Request" [label="abstract Request" URL="#Request" tooltip="abstract Request&#10;"];
"up" [label="up : Request" URL="#up" tooltip="up : Request&#10;"];
"down" [label="down : Request" URL="#down" tooltip="down : Request&#10;"];
"downX" [label="downX : Request ?" URL="#downX" tooltip="downX : Request ?&#10;"];
"stop" [label="stop : Request" URL="#stop" tooltip="stop : Request&#10;"];
"WinCtrl" [label="WinCtrl : Component" URL="#WinCtrl" tooltip="WinCtrl : Component&#10;  cmd : Port -&gt; Command&#10;    [ output ]&#10;  req : Port -&gt; Request&#10;    [ input ]&#10;"];
"WinCtrl" -> "Command" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=cmd];
"WinCtrl" -> "Request" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=req];
}