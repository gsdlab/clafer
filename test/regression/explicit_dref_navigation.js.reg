scope({c0_Port:3, c0_b:2, c0_name:3, c0_p:2, c0_speed:3});
defaultScope(1);
stringLength(16);

c0_Port = Abstract("c0_Port");
c0_speed = c0_Port.addChild("c0_speed").withCard(1, 1);
c0_name = c0_Port.addChild("c0_name").withCard(1, 1);
c0_Hub = Clafer("c0_Hub").withCard(1, 1);
c0_p = c0_Hub.addChild("c0_p").withCard(2, 2);
c0_fast = Clafer("c0_fast").withCard(1, 1);
c0_Component = Abstract("c0_Component");
c0_link = c0_Component.addAbstractChild("c0_link");
c0_latency = c0_link.addChild("c0_latency").withCard(1, 1);
c1_speed = c0_link.addChild("c1_speed").withCard(1, 1);
c0_cam = Clafer("c0_cam").withCard(1, 1);
c0_l = c0_cam.addChild("c0_l").withCard(1, 1);
c0_b = Clafer("c0_b").withCard(2, 2);
c0_Plug = Abstract("c0_Plug");
c2_speed = c0_Plug.addChild("c2_speed").withCard(1, 1);
c0_plug = Clafer("c0_plug").withCard(1, 1);
c0_pl = Clafer("c0_pl").withCard(1, 1);
c0_u = Clafer("c0_u").withCard(1, 1);
c0_speed.refToUnique(Int);
c0_name.refToUnique(Int);
c0_p.extending(c0_Port);
c0_fast.extending(c0_Port);
c0_fast.addConstraint(equal(joinRef(join($this(), c0_speed)), constant(10)));
c0_link.refToUnique(c0_Port);
c0_latency.refToUnique(Int);
c1_speed.refToUnique(Int);
c0_link.addConstraint(greaterThanEqual(joinRef(join(joinRef($this()), c0_speed)), joinRef(join($this(), c1_speed))));
c0_link.addConstraint(all([decl([t = local("t")], joinRef($this()))], greaterThanEqual(joinRef(join(t, c0_speed)), joinRef(join($this(), c0_latency)))));
c0_cam.extending(c0_Component);
c0_l.extending(c0_link).refToUnique(c0_p);
c0_l.addConstraint(equal(joinRef(join(joinRef($this()), c0_speed)), constant(3)));
c0_l.addConstraint(equal(joinRef(join(joinRef($this()), c0_name)), constant(1)));
c0_cam.addConstraint(equal(joinRef(join(joinRef(join($this(), c0_l)), c0_speed)), constant(3)));
c0_b.refTo(c0_Port);
c0_b.addConstraint(equal(joinRef(join(joinRef($this()), c0_speed)), constant(3)));
c0_Plug.refToUnique(c0_Port);
c2_speed.refToUnique(Int);
c0_plug.extending(c0_Plug);
c0_pl.refToUnique(c0_Plug);
c0_pl.addConstraint(equal(joinRef(join(joinRef($this()), c2_speed)), constant(5)));
c0_u.refToUnique(c0_Port);
c0_u.addConstraint($in(joinRef($this()), union(join(global(c0_Hub), c0_p), global(c0_fast))));
c0_u.addConstraint(equal(joinRef(join(joinRef($this()), c0_speed)), constant(10)));
