scope({$Port:3, $Port__speed:3, $b:2, $name:3, $p:2});
defaultScope(1);
stringLength(16);

$Port = Abstract("Port");
$Port__speed = $Port.addChild("Port__speed").withCard(1, 1);
$name = $Port.addChild("name").withCard(1, 1);
$Hub = Clafer("Hub").withCard(1, 1);
$p = $Hub.addChild("p").withCard(2, 2);
$fast = Clafer("fast").withCard(1, 1);
$Component = Abstract("Component");
$link = $Component.addAbstractChild("link");
$latency = $link.addChild("latency").withCard(1, 1);
$link__speed = $link.addChild("link__speed").withCard(1, 1);
$cam = Clafer("cam").withCard(1, 1);
$l = $cam.addChild("l").withCard(1, 1);
$b = Clafer("b").withCard(2, 2);
$Plug = Abstract("Plug");
$Plug__speed = $Plug.addChild("Plug__speed").withCard(1, 1);
$plug = Clafer("plug").withCard(1, 1);
$pl = Clafer("pl").withCard(1, 1);
$u = Clafer("u").withCard(1, 1);
$p.extending($Port);
$fast.extending($Port);
$cam.extending($Component);
$l.extending($link);
$plug.extending($Plug);
$Port__speed.refToUnique(Int);
$name.refToUnique(Int);
$link.refToUnique($Port);
$latency.refToUnique(Int);
$link__speed.refToUnique(Int);
$b.refTo($Port);
$Plug.refToUnique($Port);
$Plug__speed.refToUnique(Int);
$pl.refToUnique($Plug);
$u.refToUnique($Port);
$l.refToUnique($p);
$fast.addConstraint(equal(joinRef(join($this(), $Port__speed)), constant(10)));
$link.addConstraint(greaterThanEqual(joinRef(join(joinRef($this()), $Port__speed)), joinRef(join($this(), $link__speed))));
$link.addConstraint(all([decl([$_t = local("t")], joinRef($this()))], greaterThanEqual(joinRef(join($_t, $Port__speed)), joinRef(join($this(), $latency)))));
$l.addConstraint(equal(joinRef(join(joinRef($this()), $Port__speed)), constant(3)));
$l.addConstraint(equal(joinRef(join(joinRef($this()), $name)), constant(1)));
$cam.addConstraint(equal(joinRef(join(joinRef(join($this(), $l)), $Port__speed)), constant(3)));
$b.addConstraint(equal(joinRef(join(joinRef($this()), $Port__speed)), constant(3)));
$pl.addConstraint(equal(joinRef(join(joinRef($this()), $Plug__speed)), constant(5)));
$u.addConstraint($in(joinRef($this()), union(join(global($Hub), $p), global($fast))));
$u.addConstraint(equal(joinRef(join(joinRef($this()), $Port__speed)), constant(10)));
