open util/integer
pred show {}


one sig root
{ var r_A : set A }
fact { all self_ : root | always (always (all  c : (alive_A.@r_B).@r_C | one c.@r_D)) }

assert assertAt_9_10 { all self_ : root | always (always (all  c : (alive_A.@r_B).@r_C | some c.@r_D)) }
check assertAt_9_10 for 1 but 10 steps



sig A
{ p_A : lone root
, var r_B : set B }
fun alive_A : set A { root.@r_A }
fact { always ~@r_A in @p_A }

fact { all self_ : A | always (self_ in alive_A implies (always (all  c : (self_.@r_B).@r_C | one c.@r_D))) }


sig B
{ p_B : lone A
, var r_C : set C }
fun alive_B : set B { A.@r_B }
fact { always ~@r_B in @p_B
  always @r_B.univ in alive_A }

fact { all self_ : B | always (self_ in alive_B implies ((not some self_.(@p_B :> alive_A)) releases (not some self_.(@p_B :> alive_A) or (one (self_.@r_C).@r_D)))) }


sig C
{ p_C : lone B
, var r_D : set D }
fun alive_C : set C { B.@r_C }
fact { always ~@r_C in @p_C
  always @r_C.univ in alive_B }

fact { all self_ : C | always (self_ in alive_C implies (lone self_.@r_D)) }


sig D
{ p_D : lone C }
fun alive_D : set D { C.@r_D }
fact { always ~@r_D in @p_D
  always @r_D.univ in alive_C }


