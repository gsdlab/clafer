//# OPTIONS --explicit
abstract 0..* Element 0..* {}
abstract 0..* End : Element 0..* {
  0..* attainable 0..1 {}
  1..1 End__term 1..1 {
    0..* End__term__short 0..1 {}
    0..* End__term__long 0..1 {}
  }
  1..1 focusedOn 1..1 {
    0..* enterprise 0..1 {}
    0..* businessArea 0..1 {}
  }
}
abstract 0..* Mean : Element 0..* {}
abstract 0..* Vision : End 0..* {
  [(#this . focusedOn . enterprise) >= 1]
  [(#this . End__term . End__term__long) >= 1]
  0..* amplifiedBy -> Goal 1..* {}
  0..* madeOperativeBy -> Mission 1..1 {}
}
abstract 0..* DesiredResult : End 0..* {
  0..* supportedBy -> CourseOfAction 1..* {}
  1..1 kind 1..1 {
    0..* qualitative 0..1 {}
    0..* quantitative 0..1 {}
  }
}
abstract 0..* Goal : DesiredResult 0..* {
  [(#this . focusedOn . businessArea) >= 1]
  [(#this . attainable) >= 1]
  [(#this . kind . qualitative) >= 1]
  [(#this . End__term . End__term__long) >= 1]
  0..* amplifies -> Vision 1..1 {}
  0..* general 1..1 {}
  0..* ongoing 1..1 {}
}
abstract 0..* Objective : DesiredResult 0..* {
  [(#this . focusedOn . businessArea) >= 1]
  [(#this . kind . quantitative) >= 1]
  [(#this . End__term . End__term__short) >= 1]
  0..* SMART 1..1 {
    [(#this . parent . attainable) >= 1]
    0..* specific 1..1 {}
    0..* relevant 1..1 {}
    0..* timeBound 1..1 {}
  }
  0..* limitedInTimeframe 1..1 {
    0..* cyclical 0..1 {}
  }
  0..* quantifies -> Goal 1..* {}
}
abstract 0..* CourseOfAction : Mean 0..* {
  [(((#this . scope . broad) >= 1) && ((#this . CourseOfAction__term . CourseOfAction__term__long) >= 1)) || (((#this . scope . narrow) >= 1) && ((#this . CourseOfAction__term . CourseOfAction__term__short) >= 1))]
  0..* channelsEffortsToward -> DesiredResult 1..1 {}
  0..* governedBy -> Directive 1..1 {}
  0..* formulatedBasedOn -> Directive 1..1 {}
  1..1 scope 1..1 {
    0..* broad 0..1 {}
    0..* narrow 0..1 {}
  }
  1..1 CourseOfAction__term 1..1 {
    0..* CourseOfAction__term__short 0..1 {}
    0..* CourseOfAction__term__long 0..1 {}
  }
  0..* CourseOfAction__includes -> CourseOfAction 0..* {}
  0..* enables -> CourseOfAction 0..* {}
}
abstract 0..* Strategy : CourseOfAction 0..* {
  0..* implementedBy -> Tactic 1..1 {}
  0..* aComponentOfThePlanFor -> Mission 1..1 {}
  0..* rightApproachGiven 1..1 {}
}
abstract 0..* Tactic : CourseOfAction 0..* {
  0..* implements -> Strategy 1..1 {}
  0..* effectsEnforcementLevelOf -> BusinessRule 1..1 {}
}
abstract 0..* Mission : Mean 0..* {
  0..* makesOperative -> Vision 1..1 {}
  0..* plannedByMeansOf -> Strategy 1..1 {}
}
abstract 0..* Directive : Mean 0..* {
  0..* Directive__governs -> CourseOfAction 1..1 {}
  0..* sourceOf -> CourseOfAction 1..1 {}
  0..* supportsTheAchievementOf -> DesiredResult 1..1 {}
  1..1 influencesAspectOfEnterprise 1..1 {
    0..* defines 0..1 {}
    0..* constraints 0..1 {}
    0..* liberates 0..1 {}
    0..* asserts 0..1 {}
    0..* controls 0..1 {}
  }
  0..* declarative 1..1 {}
  0..* actsAs -> Regulation 1..1 {}
  1..1 degreeOfStructure 1..1 {
    0..* lessStructured 0..1 {}
    0..* highlyStructured 0..1 {}
  }
  1..1 granularity 1..1 {
    0..* lessDiscreteAndComposite 0..1 {}
    0..* discreteAndAtomic 0..1 {}
  }
  0..* actionable 0..1 {}
  0..* automatable 0..1 {}
}
abstract 0..* BusinessPolicy : Directive 0..* {
  [(#this . degreeOfStructure . lessStructured) >= 1]
  [(#this . granularity . lessDiscreteAndComposite) >= 1]
  [(#this . actionable) = 0]
  [(#this . automatable) = 0]
  0..* providesBasisFor -> BusinessRule 1..* {}
  0..* BusinessPolicy__governs -> CourseOfAction 0..* {
    0..* control 1..1 {}
    0..* guide 1..1 {}
    0..* shape 1..1 {}
  }
  0..* BusinessPolicy__includes -> BusinessPolicy 0..* {}
}
abstract 0..* BusinessRule : Directive 0..* {
  [all o : this . supportsTheAchievementOf | o . dref in Objective]
  [(#this . degreeOfStructure . highlyStructured) >= 1]
  [(#this . granularity . discreteAndAtomic) >= 1]
  [(#this . actionable) >= 1]
  1..1 enforcementLevel 1..1 {
    0..* strictlyEnforced 0..1 {}
    0..* deferredEnforcement 0..1 {}
    0..* preAuthorizedOverride 0..1 {}
    0..* postJustifiedOverride 0..1 {}
    0..* overrideWithExplanation 0..1 {}
    0..* guideline 0..1 {}
  }
  0..* hasEnforcementLevelEffectedBy -> Tactic 1..1 {}
  0..* expressedUsingStandardBusinessVocabulary 1..1 {}
}
abstract 0..* Regulation : Element 0..* {
  0..* aRolePlayedBy -> Directive 1..1 {}
}
abstract 1..* Influencer : Element 0..* {
  1..* externalInfluencer 0..1 {
    0..* environment 0..1 {}
    0..* technology 0..1 {}
    0..* regulation 0..1 {
      1..1 prescribedBy 1..1 {
        0..* government 0..1 {}
        0..* management 0..1 {}
      }
    }
    0..* supplier 0..1 {
      1..1 provides 1..1 {
        0..* products 0..1 {}
        0..* services 0..1 {}
      }
    }
    0..* customer 0..1 {
      1..1 productsOrServices 1..1 {
        0..* investigated 0..1 {}
        0..* ordered 0..1 {}
        0..* received 0..1 {}
        0..* paidFor 0..1 {}
      }
    }
    0..* competitor 0..1 {}
    0..* partner 0..1 {}
  }
  1..* internalInfluencer 0..1 {
    0..* infrastructure 0..1 {}
    0..* issue 0..1 {}
    0..* assumption 0..1 {}
    0..* resource 0..1 {}
    0..* habit 0..1 {}
    0..* managementPrerogative 0..1 {}
    1..1 corporateValue 0..1 {
      0..* explicitCorporateValue 0..1 {}
      0..* implicitCorporateValue 0..1 {}
    }
  }
}
abstract 0..* Assessment : Element 0..* {
  0..* identifies -> PotentialImpact 1..1 {}
  0..* about -> Influencer 1..1 {}
  1..* affects 1..1 {
    0..* employmentOf -> Mean 1..* {}
    0..* achievementOf -> End 1..* {}
  }
  0..* madeBy -> OrganizationUnit 1..1 {}
  0..* uses -> Assessment 0..* {}
  1..1 SWOT 1..1 {
    0..* strength 0..1 {}
    0..* weakness 0..1 {}
    0..* opportunity 0..1 {}
    0..* threat 0..1 {}
  }
}
abstract 0..* PotentialImpact : Element 0..* {
  0..* significantTo -> Assessment 1..1 {}
  0..* providesImpetusFor -> Directive 1..1 {}
  1..1 type 1..1 {
    0..* risk 0..1 {
      0..* probabilityOfLoss -> int 1..1 {}
      0..* potentialLoss -> int 1..1 {}
      0..* risk__unitOfMeasure -> Currency 1..1 {}
    }
    0..* potentialReward 0..1 {
      0..* probabilityOfGain -> int 1..1 {}
      0..* potentialGain -> int 1..1 {}
      0..* potentialReward__unitOfMeasure -> Currency 1..1 {}
    }
  }
}
abstract 0..* Metric : Element 0..* {}
abstract 0..* KeyPerformanceIndicator : Metric 0..* {}
abstract 0..* CriticalSuccessFactor : Metric 0..* {}
abstract 0..* Currency 0..* {}
0..* USD : Currency 1..1 {}
0..* EUR : Currency 1..1 {}
0..* CAD : Currency 1..1 {}
abstract 0..* OrganizationUnit 0..* {}
abstract 0..* BusinessProcess 0..* {}
