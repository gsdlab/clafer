<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/stop_following_references.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="A">A</span>
  <div class="indent">
  <span class="claferDecl" id="A__b">b</span> ?</div>
</div>


<div>
<span class="claferDecl" id="A1">A1</span><span class="keyword"> : </span><a href="#A"><span class="reference">A</span></a>
  <div class="indent">
  <span class="keyword">[</span>  ! <a href="#A__b"><span class="reference">b</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="C">C</span>
  <div class="indent">
  <span class="claferDecl" id="C__b">b</span> ?</div>
  <div class="indent">
  <span class="keyword">[</span> <a href="#C"><span class="reference">C</span></a>.<a href="#C__b"><span class="reference">b</span></a> <span class="keyword">]</span></div>
  <div class="indent">
  <span class="claferDecl" id="a">a</span><span class="keyword"> -> </span><a href="#A"><span class="reference">A</span></a>
    <div class="indent">
    <span class="keyword">[</span> <a href="#d__b"><span class="reference">b</span></a> <span class="keyword">]</span></div>
    <div class="indent">
    <span class="claferDecl" id="d">d</span>
      <div class="indent">
      <span class="claferDecl" id="d__b">b</span> ?</div>
    </div>
  </div>
</div>

</body>
</html>