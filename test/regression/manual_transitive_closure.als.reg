open util/integer
pred show {}


abstract sig TimeLevel
{ r_aggregatesTo : lone aggregatesTo }

sig aggregatesTo
{ aggregatesTo_ref : one TimeLevel }
{ one @r_aggregatesTo.this }

abstract sig YearLevel extends TimeLevel
{}
{ no this.@r_aggregatesTo }

abstract sig MonthLevel extends TimeLevel
{}
{ ((this.@r_aggregatesTo).@aggregatesTo_ref) in YearLevel }

abstract sig WeekLevel extends TimeLevel
{}
{ ((this.@r_aggregatesTo).@aggregatesTo_ref) in MonthLevel }

one sig Year2012 extends YearLevel
{}

one sig Jan2012 extends MonthLevel
{}
{ ((this.@r_aggregatesTo).@aggregatesTo_ref) = Year2012 }

one sig Week1 extends WeekLevel
{}
{ ((this.@r_aggregatesTo).@aggregatesTo_ref) = Jan2012 }

sig Week1AggregatesTo
{ Week1AggregatesTo_ref : one TimeLevel }

fact {  all disj x, y : Week1AggregatesTo | (x.@Week1AggregatesTo_ref) != (y.@Week1AggregatesTo_ref)  }
fact { ((Week1.@r_aggregatesTo).@aggregatesTo_ref) in (Week1AggregatesTo.@Week1AggregatesTo_ref) }
fact { ((((Week1.@r_aggregatesTo).@aggregatesTo_ref).@r_aggregatesTo).@aggregatesTo_ref) in (Week1AggregatesTo.@Week1AggregatesTo_ref) }
fact { (Week1AggregatesTo.@Week1AggregatesTo_ref) = (Jan2012 + Year2012) }
