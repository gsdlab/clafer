scope({$Machine:3, $Requirements:10, $Resources:6, $Service:4, $cpu:10, $isFree:3, $limits:3, $machine:4, $requirements:4, $services:12, $utilization:3});
defaultScope(1);
stringLength(16);

$Service = Abstract("Service");
$requirements = $Service.addChild("requirements").withCard(1, 1);
$machine = $Service.addChild("machine").withCard(1, 1);
$Requirements = Abstract("Requirements");
$cpu = $Requirements.addChild("cpu").withCard(1, 1);
$Resources = Abstract("Resources");
$Machine = Abstract("Machine");
$services = $Machine.addChild("services");
$isFree = $Machine.addChild("isFree").withCard(0, 1);
$limits = $Machine.addChild("limits").withCard(1, 1);
$utilization = $Machine.addChild("utilization").withCard(1, 1);
$Task = Abstract("Task");
$total_free = $Task.addChild("total_free").withCard(1, 1);
$MyTask = Clafer("MyTask").withCard(1, 1);
$GoogleCA = $MyTask.addChild("GoogleCA").withCard(1, 1);
$GoogleNY = $MyTask.addChild("GoogleNY").withCard(1, 1);
$GoogleTX = $MyTask.addChild("GoogleTX").withCard(1, 1);
$MailService = $MyTask.addChild("MailService").withCard(1, 1);
$SearchService = $MyTask.addChild("SearchService").withCard(1, 1);
$CalendarService = $MyTask.addChild("CalendarService").withCard(1, 1);
$DriveService = $MyTask.addChild("DriveService").withCard(1, 1);
$requirements.extending($Requirements);
$machine.refToUnique($Machine);
$Service.addConstraint($in($this(), joinRef(join(joinRef(join($this(), $machine)), $services))));
$cpu.refTo(Int);
$Resources.extending($Requirements);
$services.refToUnique($Service);
$Machine.addConstraint(all([decl([$_s = local("s")], join($this(), $services))], equal(joinRef(join(joinRef($_s), $machine)), $this())));
$Machine.addConstraint(ifOnlyIf(some(join($this(), $isFree)), none(join($this(), $services))));
$limits.extending($Resources);
$utilization.extending($Resources);
$utilization.addConstraint(equal(joinRef(join($this(), $cpu)), sum(join(join(joinRef(join(joinParent($this()), $services)), $requirements), $cpu))));
$utilization.addConstraint(lessThan(joinRef(join($this(), $cpu)), joinRef(join(join(joinParent($this()), $limits), $cpu))));
$total_free.refToUnique(Int);
$Task.addConstraint(implies(some(join($this(), $total_free)), equal(joinRef(join($this(), $total_free)), card(join(global($Machine), $isFree)))));
$MyTask.extending($Task);
$GoogleCA.extending($Machine);
$GoogleCA.addConstraint(equal(joinRef(join(join($this(), $limits), $cpu)), constant(10)));
$GoogleNY.extending($Machine);
$GoogleNY.addConstraint(equal(joinRef(join(join($this(), $limits), $cpu)), constant(16)));
$GoogleTX.extending($Machine);
$GoogleTX.addConstraint(equal(joinRef(join(join($this(), $limits), $cpu)), constant(14)));
$MailService.extending($Service);
$MailService.addConstraint(equal(joinRef(join(join($this(), $requirements), $cpu)), constant(4)));
$SearchService.extending($Service);
$SearchService.addConstraint(equal(joinRef(join(join($this(), $requirements), $cpu)), constant(3)));
$CalendarService.extending($Service);
$CalendarService.addConstraint(equal(joinRef(join(join($this(), $requirements), $cpu)), constant(1)));
$DriveService.extending($Service);
$DriveService.addConstraint(equal(joinRef(join(join($this(), $requirements), $cpu)), constant(2)));
max(joinRef(join(global($MyTask), $total_free)));
