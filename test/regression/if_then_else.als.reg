open util/integer
pred show {}


lone sig emergencyVehicle
{}

lone sig allWayYellow
{}

lone sig allYellow
{ r_allYellow__flashing : lone allYellow__flashing }

lone sig allYellow__flashing
{}
{ one r_allYellow__flashing }

lone sig warning
{ r_warning__flashing : lone warning__flashing }

lone sig warning__flashing
{}
{ one r_warning__flashing }

fact { (some emergencyVehicle) => ((some allWayYellow) => (some allYellow) else (some warning)) }
fact { (some emergencyVehicle) => ((some allWayYellow) => (some allYellow) else (some warning)) }
one sig AliceAge
{ AliceAge_ref : one Int }

one sig BobAge
{ BobAge_ref : one Int }

lone sig BobsBirthday
{}

fact { ((some BobsBirthday) => (BobAge.@BobAge_ref) else (AliceAge.@AliceAge_ref)) = 5 }
