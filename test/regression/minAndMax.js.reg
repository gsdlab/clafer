scope({$A:2, $B:3});
defaultScope(1);
stringLength(16);

$A = Clafer("A").withCard(1, 2);
$B = Clafer("B").withCard(2, 3);
$A.refTo(Int);
$B.refToUnique(Int);
Constraint(equal(minimum(joinRef(global($A))), maximum(joinRef(global($B)))));
assert(greaterThanEqual(maximum(joinRef(global($A))), minimum(joinRef(global($B)))));
