scope({$Person:3, $friends:3, $others:3});
defaultScope(1);
stringLength(16);

$AlicePicks = Clafer("AlicePicks");
$BobPicks = Clafer("BobPicks");
$Person = Abstract("Person");
$p1 = Clafer("p1").withCard(1, 1);
$p2 = Clafer("p2").withCard(1, 1);
$p3 = Clafer("p3").withCard(1, 1);
$friends = Clafer("friends");
$others = Clafer("others");
$AlicePicks.refTo(Int);
$BobPicks.refTo(Int);
Constraint(equal(joinRef(global($AlicePicks)), union(joinRef(global($BobPicks)), constant(3))));
Constraint(equal(union(constant(3), joinRef(global($BobPicks))), joinRef(global($AlicePicks))));
$p1.extending($Person);
$p2.extending($Person);
$p3.extending($Person);
$friends.refToUnique($Person);
$others.refToUnique($Person);
Constraint(equal(joinRef(global($friends)), union(joinRef(global($others)), global($p1))));
Constraint(equal(joinRef(global($others)), global($p2)));
