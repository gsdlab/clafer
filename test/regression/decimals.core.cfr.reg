//# OPTIONS --explicit --core
abstract 0..* Feature 0..* {
  0..* cost -> decimal 1..1 {}
  0..* weight -> decimal 1..1 {}
}
abstract 0..* Bike 0..* {
  0..* Light : Feature 0..1 {
    [this.cost.dref = 19.99]
    [this.weight.dref = 0.25]
  }
  0..* Rack : Feature 0..1 {
    [this.cost.dref = 34.50]
    [this.weight.dref = 1.20]
  }
  0..* Bell : Feature 0..1 {
    [this.cost.dref = 4.75]
    [this.weight.dref = 0.05]
  }
  0..* Frame : Feature 1..1 {
    [this.cost.dref = 250]
    [this.weight.dref = 9.80]
  }
  0..* subtotal -> decimal 1..1 {}
  [(some this.subtotal) => (this.subtotal.dref = (sum Feature.cost.dref))] // =, decimals.cfr:23:5
  0..* tax -> decimal 1..1 {}
  [(some this.tax) => (this.tax.dref = (this.subtotal.dref * 0.13))] // =, decimals.cfr:24:5
  0..* total -> decimal 1..1 {}
  [(some this.total) => (this.total.dref = (this.subtotal.dref + this.tax.dref))] // =, decimals.cfr:25:5
  0..* weightPerFeature -> decimal 1..1 {}
  [(some this.weightPerFeature) => (this.weightPerFeature.dref = ((sum Feature.weight.dref) / (#Feature)))] // =, decimals.cfr:26:5
  [this.total.dref <= 340]
  [this.weightPerFeature.dref < 5]
}
0..* aBike : Bike 1..1 {}
0..* size -> decimal 1..1 {
  [(this.dref = 1) || (this.dref = 2.50)]
  [this.dref != 1]
}
0..* change -> decimal 1..1 {}
[(some change) => (change.dref = ((-aBike.total.dref) + 400))] // =, decimals.cfr:36:1
0..* share -> decimal 1..1 {}
[(some share) => (share.dref = (2 / 3))] // =, decimals.cfr:37:1
0..* discount -> decimal 1..1 {}
[(some discount) => (discount.dref = (if (aBike.total.dref > 300) then 0.10 else 0))] // =, decimals.cfr:38:1

<< max aBike.total.dref >>
