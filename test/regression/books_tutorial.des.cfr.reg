//# OPTIONS --explicit
abstract 0..* Book 0..* {
  [(this.year.dref >= 5) => ((#this.ISBN) >= 1)]
  0..* title -> string 1..1 {
    0..* subtitle -> string 0..1 {}
  }
  0..* year -> int 1..1 {}
  0..* page 2..* {}
  1..1 format 1..1 {
    0..* paper 0..1 {
      0..* hardcover 0..1 {}
    }
    0..* electronic 0..1 {}
  }
  1..1 kind 1..1 {
    0..* textbook 0..1 {}
    0..* manual 0..1 {}
    0..* reference 0..1 {}
    0..* fiction 0..1 {}
    0..* nonfiction 0..1 {}
    0..* other -> string 0..1 {}
  }
  0..* authors -> Author 1..* {}
  0..* ISBN -> string 0..1 {
    [(this.parent.year.dref >= 6) => ((#this.GS1) >= 1)]
    0..* GS1 -> string 0..1 {}
  }
}
abstract 0..* Person 0..* {
  0..* name -> string 1..1 {}
  0..* dob -> string 0..1 {}
}
abstract 0..* Author : Person 0..* {
  0..* books -> Book 1..* {}
}
0..* GenerativeProgramming : Book 1..1 {
  [((((((((this.title.dref = "name") && ((#this.title.subtitle) = 0)) && (this.year.dref = 5)) && ((#this.page) = 4)) && ((#this.format.paper) >= 1)) && ((#this.kind.nonfiction) >= 1)) && (this.authors.dref = (Czarnecki ++ Eisenecker))) && (this.ISBN.dref = "name")) && ((#this.ISBN.GS1) = 0)]
}
0..* Czarnecki : Author 1..1 {
  [(this.name.dref = "name") && (GenerativeProgramming in this.books.dref)]
}
0..* Eisenecker : Author 1..1 {
  [(this.name.dref = "name") && (GenerativeProgramming in this.books.dref)]
}
