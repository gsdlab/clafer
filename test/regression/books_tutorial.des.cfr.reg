//# OPTIONS --explicit
abstract 0..* Book 0..* {
  0..* title -> string 1..1 {
    0..* subtitle -> string 0..1 {}
  }
  0..* year -> int 1..1 {}
  0..* page 2..* {}
  1..1 format 1..1 {
    0..* paper 0..1 {
      0..* hardcover 0..1 {}
    }
    0..* electronic 0..1 {}
  }
  1..1 kind 1..1 {
    0..* textbook 0..1 {}
    0..* manual 0..1 {}
    0..* reference 0..1 {}
    0..* fiction 0..1 {}
    0..* nonfiction 0..1 {}
    0..* other -> string 0..1 {}
  }
  0..* authors -> Author 1..* {}
  [(this.year.dref >= 5) => (some this.ISBN)]
  0..* ISBN -> string 0..1 {
    0..* GS1 -> string 0..1 {}
    [(this.parent.year.dref >= 6) => (some this.GS1)]
  }
}
abstract 0..* Person 0..* {
  0..* name -> string 1..1 {}
  0..* dob -> string 0..1 {}
}
abstract 0..* Author : Person 0..* {
  0..* books -> Book 1..* {}
}
0..* GenerativeProgramming : Book 1..1 {
  [((((((((this.title.dref = "name") && (no this.title.subtitle)) && (this.year.dref = 5)) && ((#this.page) = 4)) && (some this.format.paper)) && (some this.kind.nonfiction)) && (this.authors.dref = (Czarnecki ++ Eisenecker))) && (this.ISBN.dref = "name")) && (no this.ISBN.GS1)]
}
0..* Czarnecki : Author 1..1 {
  [(this.name.dref = "name") && (GenerativeProgramming in this.books.dref)]
}
0..* Eisenecker : Author 1..1 {
  [(this.name.dref = "name") && (GenerativeProgramming in this.books.dref)]
}
