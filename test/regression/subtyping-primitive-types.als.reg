open util/integer
pred show {}


abstract sig percent
{ percent_ref : one Int }
{ ((this.@percent_ref) >= 0) && ((this.@percent_ref) <= 5) }

one sig twoPercent extends percent
{}

fact { (some twoPercent) => ((twoPercent.@percent_ref) = 2) }
one sig threePercent extends percent
{}

fact { (some threePercent) => ((threePercent.@percent_ref) = ((twoPercent.@percent_ref).plus[1])) }
abstract sig date
{ date_ref : one Int }

one sig today extends date
{}

fact { (some today) => ((today.@date_ref) = 0) }
abstract sig time
{ time_ref : one Int
, r_minute : one minute
, r_hour : one hour }

sig minute
{ minute_ref : one Int }
{ one @r_minute.this
  ((this.@minute_ref) >= 0) && ((this.@minute_ref) <= 5) }

sig hour
{ hour_ref : one Int }
{ one @r_hour.this
  ((this.@hour_ref) >= 0) && ((this.@hour_ref) <= 5) }

fact { (some time) => ((time.@time_ref) = (((time.@r_minute).@minute_ref).plus[((time.@r_hour).@hour_ref)])) }
one sig now extends time
{}
{ ((this.@r_minute).@minute_ref) = 3
  ((this.@r_hour).@hour_ref) = 1 }

