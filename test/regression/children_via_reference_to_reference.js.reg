scope({$A:2, $a:2, $x:2});
defaultScope(1);
stringLength(16);

$A = Abstract("A");
$x = $A.addChild("x").withCard(0, 1);
$a = Clafer("a").withCard(2, 2);
$ref1 = Clafer("ref1").withCard(1, 1);
$ref2 = Clafer("ref2").withCard(1, 1);
$a.extending($A);
$ref1.refToUnique($A);
$ref2.refToUnique($ref1);
$ref2.addConstraint(some(join(joinRef(joinRef($this())), $x)));
