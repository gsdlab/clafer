digraph "umlcd_model"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Boolean" [label="abstract Boolean" URL="#Boolean" tooltip="abstract Boolean&#10;"];
"Integer" [label="abstract Integer" URL="#Integer" tooltip="abstract Integer&#10;"];
"String" [label="abstract String" URL="#String" tooltip="abstract String&#10;"];
"UnlimitedNatural" [label="abstract UnlimitedNatural" URL="#UnlimitedNatural" tooltip="abstract UnlimitedNatural&#10;"];
"Sequence" [label="abstract Sequence" URL="#Sequence" tooltip="abstract Sequence&#10;"];
"Set" [label="abstract Set" URL="#Set" tooltip="abstract Set&#10;"];
"Element" [label="abstract Element" URL="#Element" tooltip="abstract Element&#10;  ownedElement -&gt; Element *&#10;  [ all x : this.ownedElement | this in x.owner ]&#10;  owner -&gt; Element ?&#10;  [ all x : this.owner | this in x.ownedElement ]&#10;"];
"Element" -> "Element" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="ownedElement"];
"Element" -> "Element" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="owner"];
"NamedElement" [label="abstract NamedElement : Element" URL="#NamedElement" tooltip="abstract NamedElement : Element&#10;  name : String ?&#10;  qualifiedName : String ?&#10;  visibility -&gt; VisibilityKind ?&#10;"];
"NamedElement" -> "VisibilityKind" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="visibility"];
"ValueSpecification" [label="abstract ValueSpecification : NamedElement" URL="#ValueSpecification" tooltip="abstract ValueSpecification : NamedElement&#10;"];
"DirectedRelationship" [label="abstract DirectedRelationship" URL="#DirectedRelationship" tooltip="abstract DirectedRelationship&#10;  relatedElement -&gt; Element +&#10;  source -&gt; Element +&#10;  target -&gt; Element +&#10;"];
"DirectedRelationship" -> "Element" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="relatedElement"];
"DirectedRelationship" -> "Element" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="source"];
"DirectedRelationship" -> "Element" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="target"];
"Class" [label="abstract Class : Classifier" URL="#Class" tooltip="abstract Class : Classifier&#10;  isActive ?&#10;  superClass -&gt; Class *&#10;  nestedClassifier : Classifier *&#10;"];
"Class" -> "Class" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="superClass"];
"Property" [label="abstract Property : StructuralFeature" URL="#Property" tooltip="abstract Property : StructuralFeature&#10;  default : String ?&#10;  isComposite ?&#10;  isDerived ?&#10;  isDerivedUnion ?&#10;  aggregation -&gt; AggregationKind ?&#10;  class -&gt; Class ?&#10;  opposite -&gt; Property ?&#10;  owningAssociation -&gt; Association ?&#10;  [ all x : this.owningAssociation | this in x.ownedEnd ]&#10;  redefinedProperty -&gt; Property *&#10;  subsettedProperty -&gt; Property *&#10;  datatype -&gt; DataType ?&#10;  [ all x : this.datatype | this in x.ownedAttribute ]&#10;  association -&gt; Association ?&#10;  [ all x : this.association | this in x.memberEnd ]&#10;  defaultValue : ValueSpecification ?&#10;  qualifier : Property *&#10;    [ parent in associationEnd ]&#10;  associationEnd -&gt; Property ?&#10;  [ all x : this.associationEnd | this in x.qualifier ]&#10;"];
"Property" -> "AggregationKind" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="aggregation"];
"Property" -> "Class" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="class"];
"Property" -> "Property" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="opposite"];
"Property" -> "Association" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="owningAssociation"];
"Property" -> "Property" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="redefinedProperty"];
"Property" -> "Property" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="subsettedProperty"];
"Property" -> "DataType" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="datatype"];
"Property" -> "Association" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="association"];
"Property" -> "Property" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="associationEnd"];
"Enumeration" [label="abstract Enumeration : DataType" URL="#Enumeration" tooltip="abstract Enumeration : DataType&#10;  ownedLiteral : EnumerationLiteral *&#10;    [ parent in enumeration ]&#10;"];
"DataType" [label="abstract DataType : Classifier" URL="#DataType" tooltip="abstract DataType : Classifier&#10;  ownedAttribute : Property *&#10;    [ parent in datatype ]&#10;"];
"EnumerationLiteral" [label="abstract EnumerationLiteral : InstanceSpecification" URL="#EnumerationLiteral" tooltip="abstract EnumerationLiteral : InstanceSpecification&#10;  enumeration -&gt; Enumeration ?&#10;  [ all x : this.enumeration | this in x.ownedLiteral ]&#10;"];
"EnumerationLiteral" -> "Enumeration" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="enumeration"];
"PrimitiveType" [label="abstract PrimitiveType : DataType" URL="#PrimitiveType" tooltip="abstract PrimitiveType : DataType&#10;"];
"Classifier" [label="abstract Classifier : NamedElement" URL="#Classifier" tooltip="abstract Classifier : NamedElement&#10;  isAbstract ?&#10;  feature -&gt; Feature *&#10;  [ all x : this.feature | this in x.featuringClassifier ]&#10;  inheritedMember -&gt; NamedElement *&#10;  general -&gt; Classifier *&#10;  generalization : Generalization *&#10;    [ parent in specific ]&#10;  attribute -&gt; Property *&#10;  redefinedClassifier -&gt; Classifier *&#10;  powertypeExtent -&gt; GeneralizationSet *&#10;  [ all x : this.powertypeExtent | this in x.powertype ]&#10;"];
"Classifier" -> "Feature" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="feature"];
"Classifier" -> "NamedElement" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="inheritedMember"];
"Classifier" -> "Classifier" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="general"];
"Classifier" -> "Property" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="attribute"];
"Classifier" -> "Classifier" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="redefinedClassifier"];
"Classifier" -> "GeneralizationSet" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="powertypeExtent"];
"Feature" [label="abstract Feature : NamedElement" URL="#Feature" tooltip="abstract Feature : NamedElement&#10;  isStatic ?&#10;  featuringClassifier -&gt; Classifier *&#10;  [ all x : this.featuringClassifier | this in x.feature ]&#10;"];
"Feature" -> "Classifier" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="featuringClassifier"];
"LiteralBoolean" [label="abstract LiteralBoolean : LiteralSpecification" URL="#LiteralBoolean" tooltip="abstract LiteralBoolean : LiteralSpecification&#10;  value ?&#10;"];
"LiteralSpecification" [label="abstract LiteralSpecification : ValueSpecification" URL="#LiteralSpecification" tooltip="abstract LiteralSpecification : ValueSpecification&#10;"];
"LiteralString" [label="abstract LiteralString : LiteralSpecification" URL="#LiteralString" tooltip="abstract LiteralString : LiteralSpecification&#10;  value : String ?&#10;"];
"LiteralNull" [label="abstract LiteralNull : LiteralSpecification" URL="#LiteralNull" tooltip="abstract LiteralNull : LiteralSpecification&#10;"];
"LiteralInteger" [label="abstract LiteralInteger : LiteralSpecification" URL="#LiteralInteger" tooltip="abstract LiteralInteger : LiteralSpecification&#10;  value -&gt; Integer ?&#10;"];
"LiteralInteger" -> "Integer" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="value"];
"LiteralUnlimitedNatural" [label="abstract LiteralUnlimitedNatural : LiteralSpecification" URL="#LiteralUnlimitedNatural" tooltip="abstract LiteralUnlimitedNatural : LiteralSpecification&#10;  value : UnlimitedNatural ?&#10;"];
"StructuralFeature" [label="abstract StructuralFeature : Feature" URL="#StructuralFeature" tooltip="abstract StructuralFeature : Feature&#10;  isReadOnly ?&#10;  isOrdered ?&#10;  isUnique ?&#10;  lower -&gt; Integer ?&#10;  upper : UnlimitedNatural ?&#10;  upperValue : ValueSpecification ?&#10;  lowerValue : ValueSpecification ?&#10;"];
"StructuralFeature" -> "Integer" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="lower"];
"InstanceSpecification" [label="abstract InstanceSpecification : NamedElement" URL="#InstanceSpecification" tooltip="abstract InstanceSpecification : NamedElement&#10;  slot : Slot *&#10;    [ parent in owningInstance ]&#10;  classifier -&gt; Classifier *&#10;  specification : ValueSpecification ?&#10;"];
"InstanceSpecification" -> "Classifier" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="classifier"];
"Slot" [label="abstract Slot : Element" URL="#Slot" tooltip="abstract Slot : Element&#10;  owningInstance -&gt; InstanceSpecification&#10;  [ all x : this.owningInstance | this in x.slot ]&#10;  value : ValueSpecification *&#10;  definingFeature -&gt; StructuralFeature&#10;"];
"Slot" -> "InstanceSpecification" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="owningInstance"];
"Slot" -> "StructuralFeature" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="definingFeature"];
"InstanceValue" [label="abstract InstanceValue : ValueSpecification" URL="#InstanceValue" tooltip="abstract InstanceValue : ValueSpecification&#10;  instance -&gt; InstanceSpecification&#10;"];
"InstanceValue" -> "InstanceSpecification" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="instance"];
"Generalization" [label="abstract Generalization : DirectedRelationship" URL="#Generalization" tooltip="abstract Generalization : DirectedRelationship&#10;  isSubstitutable ?&#10;  specific -&gt; Classifier&#10;  [ all x : this.specific | this in x.generalization ]&#10;  general -&gt; Classifier&#10;  generalizationSet -&gt; GeneralizationSet *&#10;  [ all x : this.generalizationSet | this in x.generalization ]&#10;"];
"Generalization" -> "Classifier" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="specific"];
"Generalization" -> "Classifier" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="general"];
"Generalization" -> "GeneralizationSet" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="generalizationSet"];
"Association" [label="abstract Association : Classifier" URL="#Association" tooltip="abstract Association : Classifier&#10;  relatedElement -&gt; Element +&#10;  isDerived ?&#10;  ownedEnd : Property *&#10;    [ parent in owningAssociation ]&#10;  endType -&gt; NamedElement +&#10;  memberEnd -&gt; Property 2..*&#10;  [ all x : this.memberEnd | this in x.association ]&#10;  [ # memberEnd > 2 => memberEnd in ownedEnd ]&#10;"];
"Association" -> "Element" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="relatedElement"];
"Association" -> "NamedElement" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="endType"];
"Association" -> "Property" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="memberEnd"];
"ExtensionEnd" [label="abstract ExtensionEnd : Property" URL="#ExtensionEnd" tooltip="abstract ExtensionEnd : Property&#10;"];
"GeneralizationSet" [label="abstract GeneralizationSet : NamedElement" URL="#GeneralizationSet" tooltip="abstract GeneralizationSet : NamedElement&#10;  isCovering ?&#10;  isDisjoint ?&#10;  powertype -&gt; Classifier ?&#10;  [ all x : this.powertype | this in x.powertypeExtent ]&#10;  generalization -&gt; Generalization *&#10;  [ all x : this.generalization | this in x.generalizationSet ]&#10;"];
"GeneralizationSet" -> "Classifier" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="powertype"];
"GeneralizationSet" -> "Generalization" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="generalization"];
}