scope({$Hand:4, $Hook:2, $Object:6, $Person:2});
defaultScope(1);
stringLength(16);

$Object = Abstract("Object");
$Person = Abstract("Person");
$Hand = $Person.addAbstractChild("Hand");
$Hook = $Person.addAbstractChild("Hook");
$CptHookHand = Clafer("CptHookHand").withCard(1, 1);
$CptHookHand__left = $CptHookHand.addChild("CptHookHand__left").withCard(1, 1);
$CptHookHand__right = $CptHookHand.addChild("CptHookHand__right").withCard(1, 1);
$CptHandHook = Clafer("CptHandHook").withCard(1, 1);
$CptHandHook__left = $CptHandHook.addChild("CptHandHook__left").withCard(1, 1);
$CptHandHook__right = $CptHandHook.addChild("CptHandHook__right").withCard(1, 1);
$Person.extending($Object);
$Hand.extending($Object);
$Hook.extending($Hand);
$CptHookHand.extending($Person);
$CptHookHand__left.extending($Hook);
$CptHookHand__right.extending($Hand);
$CptHandHook.extending($Person);
$CptHandHook__left.extending($Hand);
$CptHandHook__right.extending($Hook);
