$AndroidPhone2__Battery__LiBattery1150 = $AndroidPhone2__Battery.addChild("AndroidPhone2__Battery__LiBattery1150").withCard(1, 1);
$root__Bluetooth = Abstract("root__Bluetooth").withGroupCard(1, 1);
$Bluetooth20 = $root__Bluetooth.addChild("Bluetooth20").withCard(0, 1);
$Bluetooth__Bluetooth21 = $root__Bluetooth.addChild("Bluetooth__Bluetooth21").withCard(0, 1);
$Bluetooth__Bluetooth40 = $root__Bluetooth.addChild("Bluetooth__Bluetooth40").withCard(0, 1);
$MobilePhone = Abstract("MobilePhone");
$MobilePhone__Connectivity = $MobilePhone.addChild("MobilePhone__Connectivity").withCard(1, 1);
$Connectivity__Bluetooth = $MobilePhone__Connectivity.addChild("Connectivity__Bluetooth").withCard(1, 1).withGroupCard(1, 1);
$MobilePhone__Connectivity__GSM = $MobilePhone__Connectivity.addChild("MobilePhone__Connectivity__GSM").withCard(1, 1);
