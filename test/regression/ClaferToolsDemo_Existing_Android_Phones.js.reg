$LiBattery1400 = $MobilePhone__Battery.addChild("LiBattery1400").withCard(0, 1);
$LowEndPhones = Clafer("LowEndPhones").withCard(1, 1);
$HighEndPhones = Clafer("HighEndPhones").withCard(1, 1);
$QuadCPU = $HighEndPhones.addChild("QuadCPU").withCard(0, 1);
$Connectivity__Bluetooth.extending($root__Bluetooth);
$LowEndPhones.extending($MobilePhone);
$HighEndPhones.extending($MobilePhone);
$LTE.addConstraint(some(join(join(joinParent(joinParent($this())), $MobilePhone__Battery), $LiBattery1400)));
$LowEndPhones.addConstraint(none(join(join($this(), $MobilePhone__Connectivity), $MobilePhone__Connectivity__WiFi)));
$HighEndPhones.addConstraint(and(some(join(join($this(), $MobilePhone__Connectivity), $MobilePhone__Connectivity__USB)), some(join(join($this(), $MobilePhone__Connectivity), $MobilePhone__Connectivity__WiFi))));
