scope({$Bluetooth20:2, $Bluetooth__Bluetooth21:2, $Bluetooth__Bluetooth40:2, $Connectivity__Bluetooth:2, $LTE:2, $LiBattery1400:2, $MobilePhone:2, $MobilePhone__Battery:2, $MobilePhone__Battery__LiBattery1150:2, $MobilePhone__Connectivity:2, $MobilePhone__Connectivity__GSM:2, $MobilePhone__Connectivity__USB:2, $MobilePhone__Connectivity__WiFi:2, $root__Bluetooth:2});
defaultScope(1);
stringLength(16);

