defaultScope(1);
stringLength(16);

$x = Clafer("x").withCard(1, 1);
$y = Clafer("y").withCard(1, 1);
$z = Clafer("z").withCard(1, 1);
$x.refToUnique(Int);
$y.refToUnique($x);
$z.refToUnique($y);
$x.addConstraint(equal(joinRef($this()), constant(1)));
$x.addConstraint(equal(joinRef($this()), constant(1)));
Constraint(equal(joinRef(global($x)), constant(1)));
Constraint(equal(joinRef(global($x)), constant(1)));
$y.addConstraint(equal(joinRef(joinRef($this())), constant(1)));
$y.addConstraint(equal(joinRef(joinRef($this())), constant(1)));
$y.addConstraint(equal(joinRef(joinRef($this())), constant(1)));
Constraint(equal(joinRef(joinRef(global($y))), constant(1)));
Constraint(equal(joinRef(joinRef(global($y))), constant(1)));
Constraint(equal(joinRef(joinRef(global($y))), constant(1)));
$z.addConstraint(equal(joinRef(joinRef(joinRef($this()))), constant(1)));
$z.addConstraint(equal(joinRef(joinRef(joinRef($this()))), constant(1)));
$z.addConstraint(equal(joinRef(joinRef(joinRef($this()))), constant(1)));
$z.addConstraint(equal(joinRef(joinRef(joinRef($this()))), constant(1)));
Constraint(equal(joinRef(joinRef(joinRef(global($z)))), constant(1)));
Constraint(equal(joinRef(joinRef(joinRef(global($z)))), constant(1)));
Constraint(equal(joinRef(joinRef(joinRef(global($z)))), constant(1)));
Constraint(equal(joinRef(joinRef(joinRef(global($z)))), constant(1)));
