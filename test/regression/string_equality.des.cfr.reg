//# OPTIONS --explicit
0..* text -> string 1..1 = "some text" {}
0..* text1 -> string 1..1 = "some text" {}
0..* text2 -> string 1..1 = "some text" {}
0..* equal1 0..1 {}
[(text.dref = text1.dref) => ((#equal1) >= 1)]
0..* equal2 0..1 {}
[(text1.dref = text2.dref) => ((#equal2) >= 1)]

assert [(#equal1) >= 1]
assert [(#equal2) >= 1]
