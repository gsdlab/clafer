//# OPTIONS --explicit
abstract 0..* c0_Object 0..* {}
abstract 0..* c0_Person : c0_Object 0..* {
  abstract 0..* c0_Hand : c0_Object 0..* {}
  abstract 0..* c0_Hook : c0_Hand 0..* {}
}
0..* c0_CptHookHand : c0_Person 1..1 {
  0..* c0_left : c0_Hook 1..1 {}
  0..* c0_right : c0_Hand 1..1 {}
}
0..* c0_CptHandHook : c0_Person 1..1 {
  0..* c1_left : c0_Hand 1..1 {}
  0..* c1_right : c0_Hook 1..1 {}
}
