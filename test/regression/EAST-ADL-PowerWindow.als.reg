open util/integer
pred show {}


abstract sig Feature
{}

lone sig express extends Feature
{}

fact { (some express) <=> (some downX) }
abstract sig Component
{ r_Port : set Port }

abstract sig Port
{ r_input : lone input
, r_output : lone output }
{ one @r_Port.this }

sig input
{}
{ one @r_input.this }

sig output
{}
{ one @r_output.this }

abstract sig Command
{}

one sig motorUp extends Command
{}

one sig motorDown extends Command
{}

one sig motorStop extends Command
{}

abstract sig Request
{}

one sig up extends Request
{}

one sig down extends Request
{}

lone sig downX extends Request
{}

one sig stop extends Request
{}

one sig WinCtrl extends Component
{ r_cmd : one cmd
, r_req : one req }
{ r_cmd in r_Port
  r_req in r_Port }

one sig cmd extends Port
{ cmd_ref : one Command }
{ let children = (r_input + r_output) | one children
  some this.@r_output }

one sig req extends Port
{ req_ref : one Request }
{ let children = (r_input + r_output) | one children
  some this.@r_input }

