//# OPTIONS --explicit --tl=10
1..1 s 1..1 {
  initial 0..* a 0..1 {
    [(some this) --> (some this.parent.b)]
  }
  0..* b 0..1 {
    [(some this) --> (some this.parent.a)]
  }
}

assert [all this_ : s | (some this_.a) => (X (some this_.b))]
assert [all this_ : s | (some this_.b) => (X (some this_.a))]
assert [always (some s)]
