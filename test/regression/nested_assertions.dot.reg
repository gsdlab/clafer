digraph "nested_assertions"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"a" [label="a ?" URL="#a" tooltip="a ?&#10;"];
"b" [label="b ?" URL="#b" tooltip="b ?&#10;"];
"P" [label="abstract P" URL="#P" tooltip="abstract P&#10;  age -&gt; integer&#10;  [ age >= 0 ]&#10;  assert [ age >= 0 ]&#10;"];
"x" [label="x : P" URL="#x" tooltip="x : P&#10;  assert [ age >= 0 ]&#10;"];
}