digraph "manual_transitive_closure"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"TimeLevel" [label="abstract TimeLevel" URL="#TimeLevel" tooltip="abstract TimeLevel&#10;  aggregatesTo -&gt; TimeLevel ?&#10;"];
"TimeLevel" -> "TimeLevel" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="aggregatesTo"];
"YearLevel" [label="abstract YearLevel : TimeLevel" URL="#YearLevel" tooltip="abstract YearLevel : TimeLevel&#10;  [ no aggregatesTo ]&#10;"];
"MonthLevel" [label="abstract MonthLevel : TimeLevel" URL="#MonthLevel" tooltip="abstract MonthLevel : TimeLevel&#10;  [ aggregatesTo in YearLevel ]&#10;"];
"WeekLevel" [label="abstract WeekLevel : TimeLevel" URL="#WeekLevel" tooltip="abstract WeekLevel : TimeLevel&#10;  [ aggregatesTo in MonthLevel ]&#10;"];
"Year2012" [label="Year2012 : YearLevel" URL="#Year2012" tooltip="Year2012 : YearLevel&#10;"];
"Jan2012" [label="Jan2012 : MonthLevel" URL="#Jan2012" tooltip="Jan2012 : MonthLevel&#10;  [ this.aggregatesTo = Year2012 ]&#10;"];
"Week1" [label="Week1 : WeekLevel" URL="#Week1" tooltip="Week1 : WeekLevel&#10;  [ this.aggregatesTo = Jan2012 ]&#10;"];
"Week1AggregatesTo" [label="Week1AggregatesTo -&gt; TimeLevel *" URL="#Week1AggregatesTo" tooltip="Week1AggregatesTo -&gt; TimeLevel *&#10;"];
"Week1AggregatesTo" -> "TimeLevel" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent];
}