digraph "top_level_constraints_with_relational_joins"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Course" [label="abstract Course" URL="#Course" tooltip="abstract Course&#10;  assistants -&gt; TA *&#10;"];
"Course" -> "TA" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="assistants"];
"TA" [label="abstract TA" URL="#TA" tooltip="abstract TA&#10;  first -&gt; Course ?&#10;    [ parent in this.assistants ]&#10;"];
"TA" -> "Course" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label="first"];
"CompilerGradStudent" [label="CompilerGradStudent : TA" URL="#CompilerGradStudent" tooltip="CompilerGradStudent : TA&#10;"];
"AIGradStudent" [label="AIGradStudent : TA" URL="#AIGradStudent" tooltip="AIGradStudent : TA&#10;"];
"CompilerCourse" [label="CompilerCourse : Course" URL="#CompilerCourse" tooltip="CompilerCourse : Course&#10;"];
"MachineLearningCourse" [label="MachineLearningCourse : Course" URL="#MachineLearningCourse" tooltip="MachineLearningCourse : Course&#10;"];
"numerOfAssistants" [label="numerOfAssistants -&gt; integer = # Course.assistants" URL="#numerOfAssistants" tooltip="numerOfAssistants -&gt; integer = # Course.assistants&#10;"];
}