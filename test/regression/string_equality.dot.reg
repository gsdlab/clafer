digraph "string_equality"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"text" [label="text -&gt; string = &quot;some text&quot;" URL="#text" tooltip="text -&gt; string = &quot;some text&quot;&#10;"];
"text1" [label="text1 -&gt; string = &quot;some text&quot;" URL="#text1" tooltip="text1 -&gt; string = &quot;some text&quot;&#10;"];
"text2" [label="text2 -&gt; string = &quot;some text&quot;" URL="#text2" tooltip="text2 -&gt; string = &quot;some text&quot;&#10;"];
"equal1" [label="equal1 ?" URL="#equal1" tooltip="equal1 ?&#10;"];
"equal2" [label="equal2 ?" URL="#equal2" tooltip="equal2 ?&#10;"];
}