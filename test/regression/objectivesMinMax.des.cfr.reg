//# OPTIONS --explicit
0..* x -> int 3..3 {}
0..* total_x -> int 1..1 = sum x.dref {}
0..* y 1..1 {
  0..* total_y -> int 1..1 = sum x.dref {}
}

<< min max x.dref >>
<< min max x.dref >>
<< max min x.dref >>
<< max min x.dref >>
<< min sum x.dref >>
<< max product x.dref >>
<< min #x >>
<< min total_x.dref >>
<< min y.total_y.dref >>
