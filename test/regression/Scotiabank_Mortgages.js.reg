scope({$Currency:0, $Mortgage:0, $MortgageTerm:2, $Percentage:0, $amortization:0, $balance:0, $biweekly:0, $closed:0, $conventional:0, $currentInterestRate:0, $currentPayment:0, $financingAvailable:0, $fixedForTheFullTerm:0, $insured:0, $interestRate:0, $kind:0, $loanToValue:0, $monthly:0, $open:0, $paymentFrequency:0, $principalMortgageAmount:0, $propertyValue:0, $resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges:0, $semiMonthly:0, $term:0, $valueProposition:0, $weekly:0});
defaultScope(1);
stringLength(16);

$Currency = Abstract("Currency");
$Percentage = Abstract("Percentage");
$Mortgage = Abstract("Mortgage");
$valueProposition = $Mortgage.addChild("valueProposition").withCard(1, 1);
$term = $Mortgage.addChild("term").withCard(1, 1);
$kind = $Mortgage.addChild("kind").withCard(1, 1).withGroupCard(1, 1);
$open = $kind.addChild("open").withCard(0, 1);
$closed = $kind.addChild("closed").withCard(0, 1);
$principalMortgageAmount = $Mortgage.addChild("principalMortgageAmount").withCard(1, 1);
$balance = $Mortgage.addChild("balance").withCard(1, 1);
$propertyValue = $Mortgage.addChild("propertyValue").withCard(1, 1);
$loanToValue = $Mortgage.addChild("loanToValue").withCard(1, 1);
$amortization = $Mortgage.addChild("amortization").withCard(1, 1);
$interestRate = $Mortgage.addChild("interestRate").withCard(1, 1).withGroupCard(1, 1);
$fixedForTheFullTerm = $interestRate.addChild("fixedForTheFullTerm").withCard(0, 1);
$resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges = $interestRate.addChild("resetTogetherWithPaymentAmountEachTimeScotiabankPrimeRateChanges").withCard(0, 1);
$currentInterestRate = $Mortgage.addChild("currentInterestRate").withCard(1, 1);
$currentPayment = $Mortgage.addChild("currentPayment").withCard(1, 1);
$paymentFrequency = $Mortgage.addChild("paymentFrequency").withCard(1, 1).withGroupCard(1, 1);
$weekly = $paymentFrequency.addChild("weekly").withCard(0, 1);
$biweekly = $paymentFrequency.addChild("biweekly").withCard(0, 1);
$semiMonthly = $paymentFrequency.addChild("semiMonthly").withCard(0, 1);
$monthly = $paymentFrequency.addChild("monthly").withCard(0, 1);
$financingAvailable = $Mortgage.addChild("financingAvailable").withCard(1, 1).withGroupCard(1, 1);
$conventional = $financingAvailable.addChild("conventional").withCard(0, 1);
$insured = $financingAvailable.addChild("insured").withCard(0, 1);
$MortgageTerm = Abstract("MortgageTerm");
$sixMonths = Clafer("sixMonths").withCard(1, 1);
$oneYear = Clafer("oneYear").withCard(1, 1);
$sixMonths.extending($MortgageTerm);
$oneYear.extending($MortgageTerm);
$Currency.refTo(Int);
$Percentage.refTo(Int);
$valueProposition.refToUnique(string);
$term.refToUnique($MortgageTerm);
$principalMortgageAmount.refToUnique($Currency);
$balance.refToUnique($Currency);
$propertyValue.refToUnique($Currency);
$loanToValue.refToUnique($Percentage);
$amortization.refToUnique(Int);
$currentInterestRate.refToUnique($Percentage);
$currentPayment.refToUnique($Currency);
$Percentage.addConstraint(and(greaterThanEqual(joinRef($this()), constant(0)), lessThanEqual(joinRef($this()), constant(100))));
$Mortgage.addConstraint(and(lessThanEqual(constant(5000), joinRef(joinRef(join($this(), $principalMortgageAmount)))), lessThanEqual(joinRef(joinRef(join($this(), $principalMortgageAmount))), constant(9999999))));
$Mortgage.addConstraint(lessThanEqual(joinRef(joinRef(join($this(), $balance))), joinRef(joinRef(join($this(), $principalMortgageAmount)))));
$Mortgage.addConstraint(and(lessThanEqual(constant(1), joinRef(join($this(), $amortization))), lessThanEqual(joinRef(join($this(), $amortization)), constant(30))));
