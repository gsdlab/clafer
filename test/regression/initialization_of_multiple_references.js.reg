scope({$Person:3, $people:3});
defaultScope(1);
stringLength(16);

$x = Clafer("x");
$Person = Abstract("Person");
$p1 = Clafer("p1").withCard(1, 1);
$p2 = Clafer("p2").withCard(1, 1);
$p3 = Clafer("p3").withCard(1, 1);
$people = Clafer("people");
$p1.extending($Person);
$p2.extending($Person);
$p3.extending($Person);
$x.refToUnique(Int);
$people.refToUnique($Person);
Constraint(implies(some(global($x)), equal(joinRef(global($x)), union(union(constant(1), constant(2)), constant(3)))));
Constraint(implies(some(global($people)), equal(joinRef(global($people)), union(union(global($p1), global($p1)), global($p3)))));
