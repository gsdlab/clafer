<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9">
<style>.identifier{}
.keyword{font-weight: bold;}
.tKeyword{font-style: oblique;}
.reference{}
.code { background-color: lightgray; padding: 5px 5px 5px 5px; border: 1px solid darkgray; margin-bottom: 15px;
        font-family: Pragmata, Menlo, 'DejaVu LGC Sans Mono', 'DejaVu Sans Mono', Consolas, 'Everson Mono', 'Lucida Console', 'Andale Mono', 'Nimbus Mono L', 'Liberation Mono', FreeMono, 'Osaka Monospaced', Courier, 'New Courier', monospace; }
.standalonecomment { color: green; font-style:italic }
.inlinecomment { color: green; padding-left:20px; font-style:italic }
.error{background-color: yellow; color: red }
.deprecated{color: orange }
.indent{padding-left:20px}
.file { font-weight: bold; border-bottom: 1px solid darkgray; margin: 1em 0 0.5em 0 }
a[href$='Lookup failed'] {color: red}
a[href$='Uid not found'] {color: red}
a[href$='Ambiguous name'] {color: yellow}
</style></head>
<body>
<div class="file">positive/constraints.cfr</div>

<div>
<span class="keyword">abstract</span> <span class="claferDecl" id="Phone">Phone</span>
  <div class="indent">
  <span class="claferDecl" id="networking">networking</span>
    <div class="indent">
    <span class="claferDecl" id="wifi">wifi</span> ?
      <div class="indent">
      <span class="claferDecl" id="typeB">typeB</span> ?</div>
      <div class="indent">
      <span class="claferDecl" id="typeG">typeG</span> ?</div>
      <div class="indent">
      <span class="claferDecl" id="typeN">typeN</span> ?</div>
    </div>
    <div class="indent">
    <span class="claferDecl" id="bluetooth">bluetooth</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="mobile">mobile</span> ?</div>
    <div class="indent">
    <span class="claferDecl" id="nfc">nfc</span> ?</div>
  </div>
  <div class="indent">
  <span class="keyword">xor</span> <span class="claferDecl" id="location">location</span> ?
    <div class="indent">
    <span class="claferDecl" id="gps">gps</span></div>
    <div class="indent">
    <span class="claferDecl" id="agps">agps</span></div>
  </div>
  <div class="indent">
  <span class="claferDecl" id="gpu">gpu</span> *</div>
</div>


<div>
<span class="claferDecl" id="PhoneWithGps">PhoneWithGps</span><span class="keyword"> : </span><a href="#Phone"><span class="reference">Phone</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#gps"><span class="reference">gps</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="PhoneWithWifi">PhoneWithWifi</span><span class="keyword"> : </span><a href="#Phone"><span class="reference">Phone</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#networking"><span class="reference">networking</span></a>.<a href="#wifi"><span class="reference">wifi</span></a>.<a href="#typeN"><span class="reference">typeN</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="PhonewithWifiAndGpsNoBluetoothOrNfc">PhonewithWifiAndGpsNoBluetoothOrNfc</span><span class="keyword"> : </span><a href="#Phone"><span class="reference">Phone</span></a>
  <div class="indent">
  <span class="keyword">[</span> <a href="#wifi"><span class="reference">wifi</span></a> &amp;&amp; <a href="#gps"><span class="reference">gps</span></a> &amp;&amp;  ! (<a href="#bluetooth"><span class="reference">bluetooth</span></a> &#124;&#124; <a href="#nfc"><span class="reference">nfc</span></a>) <span class="keyword">]</span></div>
</div>


<div>
<span class="claferDecl" id="PhoneWithGpu">PhoneWithGpu</span><span class="keyword"> : </span><a href="#Phone"><span class="reference">Phone</span></a>
  <div class="indent">
  <span class="keyword">[</span> <span class="keyword">some</span> <a href="#gpu"><span class="reference">gpu</span></a> <span class="keyword">]</span></div>
</div>


<div>
<span class="keyword">[</span> all p<span class="keyword"> : </span><a href="#Phone"><span class="reference">Phone</span></a> | <a href="#p"><span class="reference">p</span></a>.<a href="#networking"><span class="reference">networking</span></a>.<a href="#mobile"><span class="reference">mobile</span></a> <span class="keyword">]</span></div>

</body>
</html>