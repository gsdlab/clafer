digraph "accesscontrol_Intro"
{
rankdir=BT;
ranksep=0.3;
nodesep=0.1;
graph [fontname=Sans fontsize=11];
node [shape=box color=lightgray fontname=Sans fontsize=11 margin="0.02,0.02" height=0.2 ];
edge [fontname=Sans fontsize=11];
"Value" [label="abstract Value" URL="#Value" tooltip="abstract Value&#10;"];
"Attribute" [label="abstract Attribute" URL="#Attribute" tooltip="abstract Attribute&#10;  value -&gt; Value&#10;"];
"Attribute" -> "Value" [arrowhead=vee arrowsize=0.6 penwidth=0.5 constraint=true weight=10 color=transparent fontcolor=transparent label=value];
"ActionName" [label="abstract ActionName : Attribute" URL="#ActionName" tooltip="abstract ActionName : Attribute&#10;"];
"Role" [label="abstract Role : Attribute" URL="#Role" tooltip="abstract Role : Attribute&#10;"];
"ResourceName" [label="abstract ResourceName : Attribute" URL="#ResourceName" tooltip="abstract ResourceName : Attribute&#10;"];
"Element" [label="abstract Element" URL="#Element" tooltip="abstract Element&#10;  abstract attributes : Attribute *&#10;"];
"attributes" [label="abstract attributes : Attribute *" URL="#attributes" tooltip="abstract attributes : Attribute *&#10;"];
}