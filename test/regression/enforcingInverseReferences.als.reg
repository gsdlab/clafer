open util/integer
pred show {}


abstract sig Book
{ r_author : some author }
{ all disj x, y : this.@r_author | (x.@author_ref) != (y.@author_ref)  }

sig author
{ author_ref : one Author }
{ one @r_author.this
  (this.~@r_author) in (((this.@author_ref).@r_book).@book_ref) }

abstract sig Author
{ r_book : some book }
{ all disj x, y : this.@r_book | (x.@book_ref) != (y.@book_ref)  }

sig book
{ book_ref : one Book }
{ one @r_book.this
  (this.~@r_book) in (((this.@book_ref).@r_author).@author_ref) }

fact { 5 <= #B and #B <= 5 }
sig B extends Book
{}

fact { 6 <= #A and #A <= 6 }
sig A extends Author
{}

